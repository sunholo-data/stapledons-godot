module stapledons/ai/stub_test

-- The stub provider and the request handler (design (a2), plan change
-- 2026-10-02, AI.5): stub text and its fixture cases, stub images and voice,
-- routing stamped into meta.route on every route, refusals before routing,
-- budget, the order of the acts (blob and usage before the result) and of
-- the blob writes (temp file, rename, then the index line). Hashes are
-- checked against shasum -a 256 vectors.
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/string (concat, join, length, contains, startsWith, endsWith)
import std/bytes (fromBase64, fromString, toString, slice)
import std/crypto (sha256Bytes)
import ./key (CacheKey)
import ./route (Routing, parseRouting)
import ./wire (Request, Out, OOk, OErr, CtxField, CStr, encodeOut, usdStr)
import ./spend (Price, Ledger, ledgerOf, total, spentBy, cost, usdOf)
import ./cache (Blob, Op, Mkdir, Write, WriteSide, Rename, Append, blobOps)
import ./provider (Ctx, Case, Png, Step, Act, WriteBlob, AppendUsage, Say, Prep, Done, Run, prepare, failed, handle, reservation, textCallCap, ttsCallCap, stubText, spelled, textBody, parseStubText, providerOf, providerName, requestError, Stub, Live)
import ./reply (pngSize)

pure func routing() -> Routing = match parseRouting(join("", [
  "{\"v\":1,\"routes\":{\"text\":[{\"provider\":\"openrouter\",\"model\":\"openrouter:v/m\"},{\"provider\":\"gemini\",\"model\":\"gtext\"}],",
  "\"portrait\":[{\"provider\":\"gemini\",\"model\":\"gimage\"}],\"avatar\":[{\"provider\":\"gemini\",\"model\":\"gimage\"}],\"voice\":[{\"provider\":\"gemini\",\"model\":\"gtts\"}]}}"])) {
  Ok(r) => r, Err(_) => { routes: [] } }
-- n$ per token and per call: 0.02/0.04 $/Mtok, 0.3/2.5 $/Mtok, 0.039 $/image, 0.5/10 $/Mtok.
pure func stubPrices() -> [Price] = [{ provider: "openrouter", model: "openrouter:v/m", inTok: 20, outTok: 40, perCall: 0 },
  { provider: "gemini", model: "gtext", inTok: 300, outTok: 2500, perCall: 0 }, { provider: "gemini", model: "gimage", inTok: 0, outTok: 0, perCall: 39000000 },
  { provider: "gemini", model: "gtts", inTok: 500, outTok: 10000, perCall: 0 }]
-- The committed neutral placeholder (ai/fixtures/stub_portrait_neutral.png), 64x64.
pure func neutralPng() -> string =
  "iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAIAAAAlC+aJAAAAU0lEQVR42u3YQQkAAAgEQaMZzeiWEORgtsF8tya8AgAAAAAAAAAAAAAAAAB4APRRAAAAAAAAAAAAAAAAAAAAAABZAGcOAAAAAAAAAAAAAAAAILgFvGdRS4UpY/4AAAAASUVORK5CYII="
pure func pngSha() -> string = "8976b7f3272ddb0aefac9ed00c3012ac0a79c5c75d4fe3e11429e19bbb04c731"
pure func cases() -> [Case] = [{ purpose: "news", name: "digits", body: "{neutral} We left 42 years ago." },
  { purpose: "line", name: "non_ascii", body: "{loving} Élise — 星." }]
pure func ctx(keys: [string], textOnly: bool) -> Ctx =
  { routing: routing(), keys: keys, textOnly: textOnly, cases: cases(), portraits: [{ emotion: "neutral", b64: neutralPng() }], lore: [], prices: stubPrices(), styles: [] }
pure func bothCtx() -> Ctx = ctx(["gemini", "openrouter"], false)
pure func half() -> Ledger = ledgerOf(0.5)

pure func ckey(kind: string, em: string, va: string) -> CacheKey = { kind: kind, entityId: "medic", emotion: em, ageStage: 0, variant: va }
pure func rq(req: string, kind: string, purpose: string, k: CacheKey) -> Request =
  { req: req, kind: kind, purpose: purpose, lineReq: None, key: k, seed: 11, constraints: { maxChars: 280, noNumerals: true, emotions: ["neutral", "loving", "grieving"] },
    context: [], expiresTick: 9, cast: None, segments: None }
pure func textRq(req: string) -> Request = rq(req, "text", "line", ckey("text", "-", "-"))
pure func voiceRq(req: string) -> Request = {rq(req, "voice", "line", ckey("voice", "-", "-")) | segments: Some([{ emotion: "neutral", text: "Stub line one for medic." }])}
pure func withCase(r: Request, name: string) -> Request = {r | context: [{ name: "stub_case", value: CStr(name) }]}
pure func answer(c: Ctx, r: Request) -> Step = handle(c, half(), r)

type OkView = { body: string, sha: string, route: string, model: string, provider: string, usd: float }
pure func said(acts: [Act]) -> Option[Out] = match acts { [] => None, a :: r => match a { Say(o) => Some(o), _ => said(r) } }
pure func blobOf(acts: [Act]) -> Option[Blob] = match acts { [] => None, a :: r => match a { WriteBlob(b) => Some(b), _ => blobOf(r) } }
pure func okOf(s: Step) -> Option[OkView] =
  match said(s.acts) { Some(o) => (match o { OOk(k) => Some({ body: k.body, sha: k.sha256, route: k.meta.route, model: k.meta.model, provider: k.meta.provider, usd: k.meta.usd }), _ => None }), None => None }
-- Not `isErr`: under `ailang test` a private helper named like a stdlib
-- export (std/result.isErr) is replaced by it (ailang#1516).
pure func errIs(s: Step, code: string, route: string) -> bool =
  match s.acts { [a] => (match a { Say(o) => (match o { OErr(e) => e.code == code && e.route == route && e.provider == "stub", _ => false }), _ => false }), _ => false }

-- Stub text: shape, words for the request number, first allowed emotion,
-- trimming to max_chars (code points).
pure func checkStubText() -> bool {
  let r = textRq("7");
  stubText(r) == "{neutral} Stub line seven for medic." &&
  stubText({r | req: "120", purpose: "news"}) == "{neutral} Stub news one-two-zero for medic." &&
  stubText({r | purpose: "archive", constraints: {r.constraints | noNumerals: false}}) == "{neutral} Stub archive entry 7 for medic." &&
  stubText({r | constraints: {r.constraints | emotions: ["loving"]}}) == "{loving} Stub line seven for medic." &&
  stubText({r | constraints: {r.constraints | maxChars: 10}}) == "{neutral} Stub line" &&
  spelled("9081") == "nine-zero-eight-one" &&
  textBody(cases(), withCase({r | purpose: "news"}, "digits")) == Some("{neutral} We left 42 years ago.") &&
  textBody(cases(), withCase(r, "digits")) == None && textBody(cases(), r) == Some(stubText(r))
}

-- The handler stamps the route the table chose; the hash is the body's
-- sha256 (shasum -a 256 vectors); the stub prices what the route would charge.
export pure func checkStubRoutes() -> bool {
  let a = answer(bothCtx(), textRq("7"));
  let g = answer(ctx(["gemini"], false), textRq("7"));
  (match okOf(a) { Some(o) => o.route == "openrouter" && o.model == "openrouter:v/m" && o.provider == "stub" && o.sha == "3d16852a198ef8d987536857b6e99cfab4fa5a7d7ff57742889f738eaeff5fde" && o.usd > 0.0, None => false }) &&
  (match okOf(g) { Some(o) => o.route == "gemini" && o.model == "gtext" && o.sha == "3d16852a198ef8d987536857b6e99cfab4fa5a7d7ff57742889f738eaeff5fde", None => false }) &&
  spentBy(a.ledger, "openrouter") > 0 && spentBy(a.ledger, "gemini") == 0 && spentBy(g.ledger, "gemini") > spentBy(a.ledger, "openrouter") &&
  errIs(answer(ctx([], false), textRq("7")), "no_key", "none") &&
  errIs(answer(ctx(["openrouter"], false), rq("8", "portrait", "line", ckey("portrait", "neutral", "0"))), "no_key", "none") &&
  errIs(answer(ctx(["gemini"], true), rq("8", "portrait", "line", ckey("portrait", "neutral", "0"))), "text_only", "none") &&
  errIs(answer(ctx(["gemini"], true), voiceRq("8")), "text_only", "none") &&
  (match blobOf(a.acts) { Some(b) => b.ext == "txt" && contains(b.index, "\"route\":\"openrouter\"") && contains(b.index, "\"seed\":11") && startsWith(b.index, "{\"key\":{\"kind\":\"text\""), None => false }) &&
  (match okOf(answer(bothCtx(), withCase(textRq("4"), "non_ascii"))) { Some(o) => o.body == "{loving} Élise — 星." && o.sha == "909995c43af3eaaa3b7c3c889b853fb7a2a192bb941fa26f3af98bb0d0eeedc0", None => false })
}

-- Stub images: the committed PNG, its size from IHDR, the descriptor body.
export pure func checkStubImage() -> bool {
  let p = answer(bothCtx(), rq("9", "portrait", "line", ckey("portrait", "neutral", "0")));
  let av = answer(bothCtx(), rq("10", "avatar", "line", ckey("avatar", "-", "0")));
  (match fromBase64(neutralPng()) { Some(b) => (match pngSize(b) { Some(z) => z.w == 64 && z.h == 64, None => false }), None => false }) &&
  (match okOf(p) { Some(o) => o.route == "gemini" && o.model == "gimage" && o.sha == pngSha() && o.usd == 0.039 &&
      o.body == "{\"key\":{\"kind\":\"portrait\",\"entity_id\":\"medic\",\"emotion\":\"neutral\",\"age_stage\":0,\"variant\":\"0\"},\"mime\":\"image/png\",\"bytes\":140,\"width\":64,\"height\":64}", None => false }) &&
  (match blobOf(p.acts) { Some(b) => b.ext == "png" && contains(b.index, "\"width\":64,\"height\":64"), None => false }) &&
  (match okOf(av) { Some(o) => o.sha == pngSha(), None => false }) &&
  errIs(answer(bothCtx(), rq("11", "portrait", "line", ckey("portrait", "happy", "0"))), "provider_error", "gemini")
}

-- Stub voice (AI.5): one Ogg Opus clip, the descriptor with the derived key variant.
export pure func checkStubVoice() -> bool {
  let v = answer(bothCtx(), voiceRq("12"));
  (match okOf(v) { Some(o) => o.route == "gemini" && o.model == "gtts" && o.provider == "stub" &&
      startsWith(o.body, "{\"key\":{\"kind\":\"voice\",\"entity_id\":\"medic\",\"emotion\":\"-\",\"age_stage\":0,\"variant\":\"") &&
      contains(o.body, "\"mime\":\"audio/ogg\"") && endsWith(o.body, "\"duration_ms\":1200,\"segments_ms\":[0]}"), None => false }) &&
  (match blobOf(v.acts) { Some(b) => b.ext == "ogg" && b.mime == "audio/ogg" && contains(b.index, "\"kind\":\"voice\""), None => false }) &&
  errIs(answer(bothCtx(), {voiceRq("12") | segments: None}), "bad_request", "none") && errIs(answer(bothCtx(), {voiceRq("12") | segments: Some([])}), "bad_request", "none")
}

-- Budget: the total plus the call's worst case may not pass the ceiling; a text
-- request's worst case is three attempts at the token cap.
export pure func checkStubBudget() -> bool {
  let l1 = handle(bothCtx(), ledgerOf(0.05), rq("9", "portrait", "line", ckey("portrait", "neutral", "0")));
  let l2 = handle(bothCtx(), l1.ledger, rq("10", "portrait", "line", ckey("portrait", "neutral", "0")));
  let l3 = handle(bothCtx(), l2.ledger, textRq("7"));
  errIs(handle(bothCtx(), ledgerOf(0.00002), textRq("7")), "budget", "openrouter") && (match okOf(handle(bothCtx(), ledgerOf(0.00004), textRq("7"))) { Some(_) => true, None => false }) &&
  total(l1.ledger) == 39000000 && errIs(l2, "budget", "gemini") && total(l2.ledger) == 39000000 &&
  (match okOf(l3) { Some(o) => o.route == "openrouter", None => false }) && total(l3.ledger) > 39000000
}

-- An ok result's acts: the blob (with its index line), the usage line, then
-- the result. A refusal prints only.
pure func shape(acts: [Act]) -> [string] = match acts { [] => [], a :: r => (match a { WriteBlob(_) => "blob", AppendUsage(_) => "usage", Say(_) => "say" }) :: shape(r) }
pure func usageOf(acts: [Act]) -> string = match acts { [] => "", a :: r => match a { AppendUsage(u) => u, _ => usageOf(r) } }
export pure func checkStubActs() -> bool {
  let a = answer(bothCtx(), textRq("7"));
  shape(a.acts) == ["blob", "usage", "say"] && shape(answer(bothCtx(), voiceRq("12")).acts) == ["blob", "usage", "say"] &&
  shape(answer(ctx([], false), textRq("7")).acts) == ["say"] &&
  startsWith(usageOf(a.acts), "{\"req\":\"7\",\"provider\":\"stub\",\"route\":\"openrouter\",\"model\":\"openrouter:v/m\",\"kind\":\"text\",") &&
  contains(usageOf(a.acts), "\"totals\":{\"gemini\":0,\"openrouter\":")
}

-- Blob writes: shard dir, bytes to <path>.tmp, rename onto <path>, then the
-- index line; an existing blob only gains an index line.
pure func opNames(ops: [Op]) -> [string] =
  match ops { [] => [], o :: r => (match o { Mkdir(d) => concat(["mkdir ", d]), Write(p) => concat(["write ", p]), WriteSide(p) => concat(["side ", p]), Rename(x, y) => concat(["rename ", x, " ", y]), Append(p, l) => concat(["append ", p, " ", l]) }) :: opNames(r) }
export pure func checkCacheOps() -> bool {
  let b = { sha256: "ab12", ext: "txt", mime: "text/plain", data: fromString("x"), index: "{}", side: None };
  let v = {b | ext: "ogg", side: Some({ ext: "wav", data: fromString("w") })};
  opNames(blobOps("c", b, false)) == ["mkdir c/blobs/ab", "write c/blobs/ab/ab12.txt.tmp", "rename c/blobs/ab/ab12.txt.tmp c/blobs/ab/ab12.txt", "append c/index.ndjson {}\n"] &&
  opNames(blobOps("c", b, true)) == ["mkdir c/blobs/ab", "append c/index.ndjson {}\n"] &&
  opNames(blobOps("c", v, false)) == ["mkdir c/blobs/ab", "write c/blobs/ab/ab12.ogg.tmp", "rename c/blobs/ab/ab12.ogg.tmp c/blobs/ab/ab12.ogg",
    "side c/blobs/ab/ab12.wav.tmp", "rename c/blobs/ab/ab12.wav.tmp c/blobs/ab/ab12.wav", "append c/index.ndjson {}\n"] &&
  opNames(blobOps("c", v, true)) == ["mkdir c/blobs/ab", "side c/blobs/ab/ab12.wav.tmp", "rename c/blobs/ab/ab12.wav.tmp c/blobs/ab/ab12.wav", "append c/index.ndjson {}\n"]
}

-- A failed live call still costs what it used (AI.5 evaluation): the ledger
-- is charged for the units, the usage line comes before the error; a call
-- that used nothing charges nothing and logs no usage.
pure func errCode(acts: [Act]) -> string = match said(acts) { Some(o) => (match o { OErr(e) => concat([e.code, "@", e.provider, "@", e.route]), _ => "" }), None => "" }
export pure func checkFailedCharges() -> bool =
  match prepare(bothCtx(), half(), textRq("3"), "live") {
    Done(_) => false,
    Run(j) => {
      let f = failed(half(), j, "openrouter", { tokensIn: 100, tokensOut: 50, calls: 2 }, "bad_output");
      let z = failed(half(), j, "openrouter", { tokensIn: 0, tokensOut: 0, calls: 0 }, "provider_error");
      total(f.ledger) == 4000 && spentBy(f.ledger, "openrouter") == 4000 && shape(f.acts) == ["usage", "say"] &&
      errCode(f.acts) == "bad_output@openrouter@openrouter" &&
      contains(usageOf(f.acts), "\"tokens_in\":100,\"tokens_out\":50,\"calls\":2") &&
      total(z.ledger) == 0 && shape(z.acts) == ["say"] && errCode(z.acts) == "provider_error@openrouter@openrouter"
    }
  }

-- AI.9 hardening: a call sent but never answered is charged at its cap (the
-- prompt's tokens in, the output cap out, one call), which the worst case
-- `est` covers; the reservation the service writes before a live call is a
-- provisional usage line at `est`, with the running totals after it.
export pure func checkInterruptedCharges() -> bool =
  match prepare(bothCtx(), half(), textRq("3"), "live") {
    Done(_) => false,
    Run(j) => {
      let cap = textCallCap(j);
      let rv = reservation(charge1(), j, "openrouter");
      let t = ttsCallCap({ emotion: "neutral", text: "Stub line one for medic." });
      cap.tokensOut == 172 && cap.calls == 1 && cap.tokensIn > 0 && cost(j.price, cap) > 0 && j.est == 3 * cost(j.price, cap) &&
      t.tokensIn == 6 && t.tokensOut == 98 && t.calls == 1 &&
      startsWith(rv, "{\"req\":\"3\",\"provider\":\"openrouter\",\"route\":\"openrouter\",\"model\":\"openrouter:v/m\",\"kind\":\"text\",\"tokens_in\":0,\"tokens_out\":0,\"calls\":0,\"usd\":") &&
      endsWith(rv, ",\"provisional\":true}") && contains(rv, concat(["\"usd\":", usdStr(usdOf(j.est)), ","])) &&
      contains(rv, concat(["\"all\":", usdStr(usdOf(j.est + 39000000)), "}"]))
    }
  }
pure func charge1() -> Ledger = handle(bothCtx(), half(), rq("9", "portrait", "line", ckey("portrait", "neutral", "0"))).ledger

pure func refusedProvider(n: string, why: string) -> bool = match providerOf(n) { Ok(_) => false, Err(e) => e == why }
-- Refused before routing: bad id, kind, purpose, key, or key of another kind;
-- a stub_case the table lacks; the provider names; the fixture table.
export pure func checkStubRefusals() -> bool =
  errIs(answer(bothCtx(), textRq("x7")), "bad_request", "none") && errIs(answer(bothCtx(), textRq("07")), "bad_request", "none") &&
  errIs(answer(bothCtx(), rq("1", "music", "line", ckey("text", "-", "-"))), "bad_request", "none") &&
  errIs(answer(bothCtx(), rq("1", "text", "gossip", ckey("text", "-", "-"))), "bad_request", "none") &&
  errIs(answer(bothCtx(), rq("1", "text", "line", {ckey("text", "-", "-") | entityId: "Medic"})), "bad_request", "none") &&
  errIs(answer(bothCtx(), rq("1", "text", "line", ckey("portrait", "neutral", "0"))), "bad_request", "none") &&
  errIs(answer(ctx([], false), rq("1", "text", "line", ckey("portrait", "neutral", "0"))), "bad_request", "none") &&
  errIs(answer(bothCtx(), withCase(textRq("1"), "nope")), "bad_request", "openrouter") &&
  errIs(answer(bothCtx(), {textRq("1") | context: [{ name: "canon", value: CStr("archive.unknown") }]}), "bad_request", "openrouter") &&
  providerOf("stub") == Ok(Stub) && providerOf("gemini") == Ok(Live(["gemini"])) && providerOf("openrouter") == Ok(Live(["openrouter"])) &&
  providerOf("live") == Ok(Live([])) && providerName(Live([])) == "live" && providerName(Live(["gemini"])) == "gemini" &&
  refusedProvider("ollama", "config: unknown provider ollama") &&
  (match parseStubText("{\"line\":{\"a\":\"{neutral} x\"},\"news\":{}}") { Ok(cs) => (match cs { [c] => c.purpose == "line" && c.name == "a", _ => false }), Err(_) => false }) &&
  (match parseStubText("{\"gossip\":{}}") { Ok(_) => false, Err(e) => e == "config: stub_text: unknown purpose gossip" }) &&
  (match parseStubText("{\"line\":{\"a\":1}}") { Ok(_) => false, Err(e) => e == "config: stub_text line.a is not a string" })

-- AI.10a task 1: a voice index line carries duration_ms and segments_ms (so
-- a library voice is a cache hit), equal to the descriptor's; the offsets
-- are exact, strictly increasing and below the duration; the blob carries a
-- WAV playback copy of the same PCM (Godot cannot decode Ogg Opus).
pure func increasing(xs: [int], prev: int, dur: int) -> bool = match xs { [] => true, x :: r => x > prev && x < dur && increasing(r, x, dur) }
pure func noSide(b: Blob) -> bool = match b.side { Some(_) => false, None => true }
pure func wavHead(b: Blob) -> bool = match b.side {
  Some(s) => s.ext == "wav" && (match slice(s.data, 0, 4) { Some(h) => toString(h) == "RIFF", None => false }) && contains(b.index, concat(["\"wav_sha256\":\"", sha256Bytes(s.data), "\""])),
  None => false }
export pure func checkVoiceIndex() -> bool {
  let three = {voiceRq("13") | segments: Some([{ emotion: "neutral", text: "Hi" }, { emotion: "grieving", text: "I know, I know." }, { emotion: "loving", text: "Sleep." }])};
  let v = answer(bothCtx(), three);
  (match okOf(v) { Some(o) => endsWith(o.body, "\"duration_ms\":1248,\"segments_ms\":[0,200,949]}"), None => false }) &&
  (match blobOf(v.acts) { Some(b) => contains(b.index, "\"duration_ms\":1248,\"segments_ms\":[0,200,949]") && wavHead(b), None => false }) &&
  (match blobOf(answer(bothCtx(), voiceRq("12")).acts) { Some(b) => contains(b.index, "\"duration_ms\":1200,\"segments_ms\":[0]") && wavHead(b), None => false }) &&
  increasing([0, 200, 949], -1, 1248) && !increasing([0, 200, 200], -1, 1248) && !increasing([0, 1248], -1, 1248) &&
  (match blobOf(answer(bothCtx(), textRq("7")).acts) { Some(b) => !contains(b.index, "duration_ms") && noSide(b), None => false }) &&
  (match blobOf(answer(bothCtx(), rq("9", "portrait", "line", ckey("portrait", "neutral", "0"))).acts) { Some(b) => !contains(b.index, "duration_ms") && noSide(b), None => false })
}

export pure func stubChecks() -> bool = checkStubText() && checkStubRoutes() && checkStubImage() && checkStubVoice() && checkStubBudget() && checkStubActs() && checkCacheOps() && checkStubRefusals() && checkFailedCharges() && checkInterruptedCharges() && checkVoiceIndex()

test "AI.4 stub text: words for numbers, first allowed emotion, trimmed, fixture cases" { checkStubText() }
test "AI.4 stub answers every route and stamps meta.route" { checkStubRoutes() }
test "AI.4 stub portrait and avatar: committed PNG and descriptor" { checkStubImage() }
test "AI.5 stub voice: one Ogg Opus clip and its descriptor" { checkStubVoice() }
test "AI.5 budget refused once the total would pass the ceiling" { checkStubBudget() }
test "AI.5 acts: blob and usage before the result" { checkStubActs() }
test "AI.5 blob writes: temp file, rename, then the index line" { checkCacheOps() }
test "AI.4 requests refused before routing; provider names" { checkStubRefusals() }
test "AI.5 a failed live call is charged and logged before its error" { checkFailedCharges() }
test "AI.9 a sent but unanswered call is charged at its cap; the reservation is the worst case" { checkInterruptedCharges() }
test "AI.10a a voice index line carries duration_ms and segments_ms; a WAV playback copy" { checkVoiceIndex() }
