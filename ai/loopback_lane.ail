module stapledons/ai/loopback_lane

-- `make ai-loopback` (AI.7, carried from the AI.5 evaluation): the effectful
-- halves of the std/net adapters (ai/adapters.ail) against a local fixture
-- server (tests/fixtures/ai_loopback.py) instead of a provider. Run with
-- `--caps IO,FS,Net,Env --net-allow-localhost --net-allow-http`, fake keys
-- in GOOGLE_API_KEY and OPENROUTER_API_KEY, and no AI capability:
--   * OpenRouter text (req 1, routed to OpenRouter with both keys): POST to
--     <base>/api/v1/chat/completions with "Authorization: Bearer <key>"; the
--     server answers the "Wait" fixture first, so the adapter retries once;
--   * Gemini TTS (req 12): one POST per segment to
--     <base>/v1beta/models/<tts model>:generateContent with x-goog-api-key.
-- Each outcome runs through the service's acts (blob, index line, usage
-- line) into <out>/cache, and its result line is printed: the make target
-- then checks the server's log (paths, headers, bodies, the retry) and that
-- no key text reached stdout or the cache.
import std/io (println)
import std/fs (readFileResult, mkdirAll)
import std/env (getEnvOr)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/string (concat, split, intToStr)
import ./wire (Request, WRequest, decodeIn, encodeOut)
import ./spend (Units, ledgerOf, total)
import ./provider (Ctx, Act, Say, WriteBlob, AppendUsage, Job, Run, Done, prepare, okText, okVoice, failed, castVoice, reservation)
import ./service (start)
import ./cache (writeBlob, appendUsage, reserveUsage)
import ./adapters (openRouterTextAt, geminiVoiceAt)

export type Loop = { routing: string, fixtures: string, requests: string, out: string, base: string }

func text(path: string) -> string ! {FS} = match readFileResult(path) { Ok(t) => t, Err(_) => "" }
pure func reqOf(line: string) -> Option[Request] = match decodeIn(line) { Ok(m) => (match m { WRequest(r) => Some(r), _ => None }), Err(_) => None }
pure func find(lines: [string], id: string) -> Option[Request] =
  match lines { [] => None, l :: rest => match reqOf(l) { Some(r) => if r.req == id then Some(r) else find(rest, id), None => find(rest, id) } }
func job(c: Ctx, lines: [string], id: string) -> Option[Job] =
  match find(lines, id) { None => None, Some(r) => match prepare(c, ledgerOf(0.5), r, "live") { Run(j) => Some(j), Done(_) => None } }

func act(dir: string, acts: [Act]) -> () ! {IO, FS} =
  match acts {
    [] => (),
    a :: r => { (match a { WriteBlob(b) => writeBlob(dir, b), AppendUsage(l) => appendUsage(dir, l), Say(o) => println(encodeOut(o)) }); act(dir, r) }
  }

func orCheck(cfg: Loop, c: Ctx, lines: [string], key: string) -> () ! {IO, FS, Net} =
  match job(c, lines, "1") {
    None => println("FAIL openrouter: no job"),
    Some(j) => {
      let a = openRouterTextAt(cfg.base, j, key);
      println(concat(["openrouter: route ", j.hop.provider, ", ", intToStr(a.tries), " attempts, ", intToStr(a.units.calls), " calls"]));
      match a.outcome {
        Ok(b) => act(concat([cfg.out, "/cache"]), okText(ledgerOf(0.5), j, "openrouter", a.units, 0, b).acts),
        Err(code) => act(concat([cfg.out, "/cache"]), failed(ledgerOf(0.5), j, "openrouter", a.units, code).acts)
      }
    }
  }
func ttsCheck(cfg: Loop, c: Ctx, lines: [string], key: string) -> () ! {IO, FS, Net} =
  match job(c, lines, "12") {
    None => println("FAIL tts: no job"),
    Some(j) => {
      let s = geminiVoiceAt(cfg.base, j, key, castVoice(j.r), c.styles);
      println(concat(["tts: route ", j.hop.provider, ", ", intToStr(s.units.calls), " calls"]));
      match s.outcome {
        Ok(clip) => act(concat([cfg.out, "/cache"]), okVoice(ledgerOf(0.5), j, "gemini", s.units, 0, clip).acts),
        Err(code) => act(concat([cfg.out, "/cache"]), failed(ledgerOf(0.5), j, "gemini", s.units, code).acts)
      }
    }
  }

-- AI.9 (AI.7 finding): a billed reply that does not parse is charged. The
-- server answers <base>/nocontent with a chat completion that has usage but
-- no content, and <base>/capped with speech over its token cap; each failure
-- must count one call and its tokens, and move the ledger.
func billedLine(what: string, j: Job, prov: string, u: Units, code: string, dir: string) -> () ! {IO, FS} {
  let s = failed(ledgerOf(0.5), j, prov, u, code);
  println(concat(["billed ", what, ": ", code, ", ", intToStr(u.calls), " calls, ", intToStr(u.tokensIn), "+", intToStr(u.tokensOut), " tokens, ledger 0 -> ", intToStr(total(s.ledger)), " nano-USD"]));
  act(dir, s.acts)
}
func billedCheck(cfg: Loop, c: Ctx, lines: [string], kg: string, ko: string) -> () ! {IO, FS, Net} {
  let dir = concat([cfg.out, "/cache"]);
  match job(c, lines, "1") {
    None => println("FAIL billed openrouter: no job"),
    Some(j) => {
      let jb = {j | r: {j.r | req: "b1"}};
      let a = openRouterTextAt(concat([cfg.base, "/nocontent"]), jb, ko);
      match a.outcome { Ok(_) => println("FAIL billed openrouter: parsed"), Err(code) => billedLine("openrouter", jb, "openrouter", a.units, code, dir) }
    }
  };
  match job(c, lines, "12") {
    None => println("FAIL billed tts: no job"),
    Some(j) => {
      let jb = {j | r: {j.r | req: "b12"}};
      let s = geminiVoiceAt(concat([cfg.base, "/capped"]), jb, kg, castVoice(jb.r), c.styles);
      match s.outcome { Ok(_) => println("FAIL billed tts: parsed"), Err(code) => billedLine("tts", jb, "gemini", s.units, code, dir) }
    }
  }
}

-- AI.9 hardening: a call that was sent but got no reply is charged at its
-- cap. The server reads <base>/drop requests and closes the connection
-- without answering (a transport error after send). Then the reservation the
-- live loop writes before a call (<cache>/inflight.json, the request's worst
-- case), which Godot appends to usage.ndjson if it kills the service mid-call.
func droppedCheck(cfg: Loop, c: Ctx, lines: [string], kg: string, ko: string) -> () ! {IO, FS, Net} {
  let dir = concat([cfg.out, "/cache"]);
  match job(c, lines, "1") {
    None => println("FAIL dropped openrouter: no job"),
    Some(j) => {
      let jd = {j | r: {j.r | req: "d1"}};
      let a = openRouterTextAt(concat([cfg.base, "/drop"]), jd, ko);
      match a.outcome { Ok(_) => println("FAIL dropped openrouter: answered"), Err(code) => billedLine("dropped openrouter", jd, "openrouter", a.units, code, dir) }
    }
  };
  match job(c, lines, "12") {
    None => println("FAIL dropped tts: no job"),
    Some(j) => {
      let jd = {j | r: {j.r | req: "d12"}};
      let s = geminiVoiceAt(concat([cfg.base, "/drop"]), jd, kg, castVoice(jd.r), c.styles);
      match s.outcome { Ok(_) => println("FAIL dropped tts: answered"), Err(code) => billedLine("dropped tts", jd, "gemini", s.units, code, dir) };
      reserveUsage(dir, reservation(ledgerOf(0.5), jd, "gemini"));
      println(concat(["reserved d12: ", intToStr(jd.est), " nano-USD"]))
    }
  }
}

export func loopback(cfg: Loop) -> () ! {IO, FS, Net, Env} {
  let kg = getEnvOr("GOOGLE_API_KEY", "");
  let ko = getEnvOr("OPENROUTER_API_KEY", "");
  let s = { provider: "stub", keys_present: ["gemini", "openrouter"], text_only: false, cache_dir: concat([cfg.out, "/cache"]), routing: cfg.routing, fixtures: cfg.fixtures, ceiling_usd: 0.5, spent: [] };
  if kg == "" || ko == "" then println("FAIL loopback needs fake GOOGLE_API_KEY and OPENROUTER_API_KEY")
  else match start(s, ["gemini", "openrouter"]) {
    Err(e) => println(concat(["FAIL start: ", e])),
    Ok(c) => {
      mkdirAll(concat([cfg.out, "/cache"]));
      let lines = split(text(cfg.requests), "\n");
      orCheck(cfg, c, lines, ko);
      ttsCheck(cfg, c, lines, kg);
      billedCheck(cfg, c, lines, kg, ko);
      droppedCheck(cfg, c, lines, kg, ko);
      println("loopback-done")
    }
  }
}
