module stapledons/ai/prompt

-- Prompts (design (a2) ai/prompt.ail): request + cast entry + lore snippets
-- + guardrails -> a system and a user message. Pure; the goldens are
-- tests/ai/prompts/<purpose>.golden.txt (`make ai-adapter`), and the strict
-- VM prints the same bytes as the interpreter (aiWireVm).
--
-- Guardrails in every text prompt: the marker grammar of sim/markers.ail
-- with the request's allowed palette; no numerals (D-21: every generated
-- text, so numbers on screen come only from sim fields); the length cap in
-- characters of display text; no verdict on the player's choices. Lore
-- comes from data/ai/lore.json by the ids in context.canon; an unknown id
-- is a bad_request (a prompt never cites canon it does not have).
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/json (Json, JString, decode, get, getString, getArray, asObject)
import std/string (concat, join, intToStr, foldChars)
import ./key (member)
import ./wire (Request, CtxField, CStr, CList)

export type Lore = { id: string, text: string }
export type Prompt = { system: string, user: string }

@allow_empty_ok("a lore table may be empty; a request citing canon is then refused")
pure func loreOf(kvs: [{key: string, value: Json}]) -> Result[[Lore], string] =
  match kvs {
    [] => Ok([]),
    e :: r => match e.value {
      JString(t) => (match loreOf(r) { Ok(ls) => Ok({ id: e.key, text: t } :: ls), Err(x) => Err(x) }),
      _ => Err(concat(["config: lore ", e.key, " is not a string"]))
    }
  }
export pure func parseLore(text: string) -> Result[[Lore], string] =
  match decode(text) {
    Ok(j) => (match get(j, "lore") { Some(l) => (match asObject(l) { Some(kvs) => loreOf(kvs), None => Err("config: lore is not an object") }), None => Err("config: lore has no lore") }),
    Err(_) => Err("config: lore is not JSON")
  }
pure func loreText(ls: [Lore], id: string) -> Option[string] = match ls { [] => None, l :: r => if l.id == id then Some(l.text) else loreText(r, id) }

pure func role(purpose: string) -> string =
  if purpose == "news" then "one short ship news item, read aloud to the crew"
  else if purpose == "archive" then "the Archive's answer: the ship's library speaking, precise and unhurried"
  else if purpose == "probe" then "one short line that tests the voice of the speaker"
  else if purpose == "crew_reply" then "one short reply, spoken by a crew member to the captain"
  else "one line of dialogue, spoken by the speaker to the player"

pure func markerList(es: [string]) -> string = join(", ", map1(\e. concat(["{", e, "}"]), es))
pure func map1(g: a -> b, xs: [a]) -> [b] = match xs { [] => [], x :: r => g(x) :: map1(g, r) }
pure func firstOr(xs: [string], d: string) -> string = match xs { [] => d, x :: _ => x }

-- The rules, in a fixed order; the numeral rule only while no_numerals holds.
export pure func rules(r: Request) -> [string] =
  [concat(["Write ", role(r.purpose), " for Stapledon's Voyage, a game aboard a ship travelling near the speed of light."]),
   "Reply with the text only: no preface, no quotation marks, no lists, no stage directions.",
   concat(["Mark the feeling of each part with an emotion marker in curly braces before it, and start with one, e.g. {", firstOr(r.constraints.emotions, "neutral"), "} The hull is quiet tonight."]),
   concat(["Use only these markers: ", markerList(r.constraints.emotions), ". Never use square brackets."])] ++
  (if r.constraints.noNumerals then ["Write no digits at all. Numbers on screen come from the ship's instruments; refer to them in words or not at all."] else []) ++
  [concat(["Keep the text, not counting markers, under ", intToStr(r.constraints.maxChars), " characters."]),
   "Describe and feel; never judge the player's choices or say whether a decision was right or wrong.",
   "Speak in-world (D-67): to everyone aboard the voyage and its physics are simply real; never mention games, players, simulations, approximations or anything being invented."]

-- ------------------------------------------------------------ the Archive (R1-ARCHIVE-VOICE)
-- The Archive's prompt is its own boot record, entirely in-world (D-67, D-68): it names no
-- game, player or story and addresses "the captain". It is sandboxed: it is told none of the
-- lore's mechanics and infers what it can from its entries and sensors (Mark, 2026-10-13).
-- Persona, style and the bounds of its knowledge come from the cast (data/ai/cast/archive.json via AiRelay).
pure func castStr(r: Request, k: string) -> string =
  match r.cast { Some(c) => (match getString(c, k) { Some(v) => v, None => "" }), None => "" }
pure func strsOf(xs: [Json]) -> [string] = match xs { [] => [], x :: r => (match x { JString(v) => [v], _ => [] }) ++ strsOf(r) }
pure func castBounds(r: Request) -> [string] =
  match r.cast { Some(c) => (match getArray(c, "bounds") { Some(xs) => strsOf(xs), None => [] }), None => [] }
pure func bullets(xs: [string]) -> [string] = map1(\x. concat(["- ", x]), xs)
pure func nonEmpty(xs: [string]) -> [string] = match xs { [] => [], x :: r => (if x == "" then [] else [x]) ++ nonEmpty(r) }

export pure func archiveRules(r: Request) -> [string] =
  nonEmpty([castStr(r, "persona"), (if castStr(r, "style") == "" then "" else concat(["Your manner: ", castStr(r, "style")]))]) ++
  ["You are at the Archive terminal in the spire, answering the captain of the bubble ship. The ship, the bubble and this voyage are real; they are all you have ever known.",
   "Your memory has gaps and damage. You cannot always tell a true memory from a reconstructed one. When you are unsure, say so in your own words; never invent certainty.",
   "Answer from your entries and your sensors. If they do not cover the question, say what you do not know."] ++
  (match castBounds(r) { [] => [], ss => "How you know what you know:" :: bullets(ss) }) ++
  ["Never step outside the ship: everything you say is said aboard, to the captain, about the voyage as it is.",
   "Reply with the text only: no preface, no quotation marks, no lists, no stage directions.",
   concat(["Mark the feeling of each part with an emotion marker in curly braces before it, and start with one, e.g. {", firstOr(r.constraints.emotions, "neutral"), "} My records here are thin, Captain."]),
   concat(["Use only these markers: ", markerList(r.constraints.emotions), ". Never use square brackets."])] ++
  (if r.constraints.noNumerals then ["Write no digits and state no quantities, not even in words. The ship's instruments show every figure to the captain beside you; point the captain to them instead."] else []) ++
  [concat(["Keep the text, not counting markers, under ", intToStr(r.constraints.maxChars), " characters."]),
   "Describe and interpret; never judge the captain's choices or say whether a decision was right or wrong."]

-- The Archive's entries carry figures (0.99c, 4.414 years); the Archive itself states none
-- (instruments do), so its copy of an entry names each figure as "a figure on the instruments".
-- A figure is a run of digits with the dots, commas, signs and units-free glue between them.
pure func isDigit(c: string) -> bool = c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
-- held: a "." or "," right after a figure, kept back until the next character shows whether it
-- is inside the figure (a digit follows) or punctuation after it.
pure func figStep(acc: {out: [string], inFig: bool, held: string}, c: string) -> {out: [string], inFig: bool, held: string} =
  if isDigit(c) then (if acc.inFig then { out: acc.out, inFig: true, held: "" } else { out: "a figure on the instruments" :: (if acc.held == "" then acc.out else acc.held :: acc.out), inFig: true, held: "" })
  else if acc.inFig && acc.held == "" && (c == "." || c == ",") then { out: acc.out, inFig: true, held: c }
  else if acc.inFig && acc.held == "" && (c == "%" || c == "c" || c == "\u00d7" || c == "^" || c == "\u2212") then acc
  else { out: c :: (if acc.held == "" then acc.out else acc.held :: acc.out), inFig: false, held: "" }
pure func revStrs(xs: [string], acc: [string]) -> [string] = match xs { [] => acc, x :: r => revStrs(r, x :: acc) }
pure func figDone(acc: {out: [string], inFig: bool, held: string}) -> [string] = if acc.held == "" then acc.out else acc.held :: acc.out
export pure func figureless(t: string) -> string = concat(revStrs(figDone(foldChars(figStep, { out: [], inFig: false, held: "" }, t)), []))

pure func ctxOf(cs: [CtxField], name: string) -> string =
  match cs { [] => "", c :: r => if c.name == name then (match c.value { CStr(v) => v, CList(vs) => join(", ", vs) }) else ctxOf(r, name) }
pure func sensorLines(cs: [CtxField]) -> [string] =
  match cs { [] => [], c :: r => (if c.name == "canon" || c.name == "stub_case" || c.name == "question" then [] else ctxLine(c)) ++ sensorLines(r) }
pure func archiveUser(r: Request, sn: [string]) -> string =
  join("\n", (match sensorLines(r.context) { [] => [], ls => "Your sensors report:" :: ls }) ++
    (if sn == [] then [] else ["From your entries:"] ++ sn) ++
    [concat(["The captain asks: ", (if ctxOf(r.context, "question") == "" then "What do you see?" else ctxOf(r.context, "question"))])])

pure func ctxLine(c: CtxField) -> [string] =
  if c.name == "canon" || c.name == "stub_case" then []
  else match c.value { CStr(v) => [concat([c.name, ": ", v])], CList(vs) => [concat([c.name, ": ", join(", ", vs)])] }
pure func ctxLines(cs: [CtxField]) -> [string] = match cs { [] => [], c :: r => ctxLine(c) ++ ctxLines(r) }
pure func canonIds(cs: [CtxField]) -> [string] =
  match cs { [] => [], c :: r => if c.name == "canon" then (match c.value { CList(vs) => vs, CStr(v) => [v] }) else canonIds(r) }
@allow_empty_ok("a request without canon cites no lore")
pure func snippets(ls: [Lore], ids: [string]) -> Result[[string], string] =
  match ids {
    [] => Ok([]),
    i :: r => match loreText(ls, i) {
      Some(t) => (match snippets(ls, r) { Ok(xs) => Ok(concat(["- ", i, ": ", t]) :: xs), Err(e) => Err(e) }),
      None => Err("bad_request")
    }
  }
pure func speaker(r: Request) -> string =
  match r.cast { Some(c) => (match getString(c, "name") { Some(n) => concat([n, " (", r.key.entityId, ")"]), None => r.key.entityId }), None => r.key.entityId }

-- R2-CREW C5: a crew member's reply. The reaction was decided by the ship (crew_core's authored
-- policy, D-20); the words only express it. The persona and manner come from the cast
-- (data/ai/cast/<role>.json via AiRelay), as for the Archive. Internal ids and personality scores
-- never reach the prompt, and the sim rejects a reply that names them (sim/ai.ail ai_internal).
export pure func crewRules(r: Request) -> [string] =
  rules(r) ++ nonEmpty([castStr(r, "persona"), (if castStr(r, "style") == "" then "" else concat(["Your manner: ", castStr(r, "style")]))]) ++
  [concat(["Your answer is already decided: ", (if ctxOf(r.context, "reaction") == "" then "neutral" else ctxOf(r.context, "reaction")), ". Express exactly that, in your own words; do not change it, hedge it into another answer, or explain how it was decided."]),
   "Speak only as yourself, about the work and how you feel about it. Never mention scores, traits, labels or the names of tasks in code form."]

-- D-74: a crew member speaks under their generated name (context `name`), with the role after it.
pure func crewSpeaker(r: Request) -> string = if ctxOf(r.context, "name") == "" then speaker(r) else concat([ctxOf(r.context, "name"), ", ", speaker(r)])
pure func withoutName(cs: [CtxField]) -> [CtxField] = match cs { [] => [], c :: r => (if c.name == "name" then [] else [c]) ++ withoutName(r) }

export pure func buildPrompt(r: Request, lore: [Lore]) -> Result[Prompt, string] =
  match snippets(lore, canonIds(r.context)) {
    Err(e) => Err(e),
    Ok(sn) => if r.purpose == "archive" then Ok({ system: join("\n", archiveRules(r)), user: archiveUser(r, map1(figureless, sn)) })
      else if r.purpose == "crew_reply" then Ok({ system: join("\n", crewRules(r)), user: join("\n", [concat(["Speaker: ", crewSpeaker(r)])] ++ ctxLines(withoutName(r.context))) })
      else Ok({ system: join("\n", rules(r)),
      user: join("\n", [concat(["Speaker: ", speaker(r)])] ++ ctxLines(r.context) ++ (if sn == [] then [] else ["Canon:"] ++ sn)) })
  }
export pure func promptText(p: Prompt) -> string = concat([p.system, "\n\n", p.user, "\n"])

-- Portraits and avatars: one image prompt (no golden; the image model is
-- bound to the handler, gap G2).
export pure func imagePrompt(r: Request) -> string =
  concat(["Head-and-shoulders portrait of ", speaker(r), ", aboard a generation ship, ",
    if r.kind == "avatar" then "a calm neutral expression, as a small round avatar" else concat(["expression: ", r.key.emotion]),
    ", ", intToStr(r.key.ageStage), " years after departure. Painterly, soft cabin light, no text, no frame."])
