module stapledons/audio/synth_test
-- R2-SOUND / R2-SUNHOLO-AUDIO (make sound-synth-check): the game's pin on the synthesis package.
-- The named checks of the synthesis live in sunholo/audio's own tests; this keeps the game's
-- reference loop (a 0.25 s loop: 440 Hz, 220 Hz, filtered legacy noise, a 4 Hz swell) and prints
-- the sha256 of its PCM, run on the strict VM and the interpreter (outputs must be byte-identical),
-- so a change in the pinned package's maths shows here before any WAV is regenerated. It also
-- checks that the game's schema id parses through parseRecipesAs and the package's own id does not.
import pkg/sunholo/audio/recipe (Recipe, Layer, Env, render, parseRecipesAs)
import pkg/sunholo/audio/pcm (pcm16)
import std/list (foldl, length as size)
import std/result (Result, Ok, Err)
import std/crypto (sha256Bytes)
import std/string (join)
import std/io (println)

pure func noEnv() -> Env = {delay: 0.0, attack: 0.0, tau: 0.0, stop: 0.0}
pure func sine(f: float, a: float) -> Layer = {kind: "sine", freq: f, freqTo: f, glide0: 0.0, glide1: 0.0, amp: a, lowpass: 0.0, highpass: 0.0, seed: 1, env: noEnv(), vibRate: 0.0, vibCents: 0.0, amRate: 0.0, amDepth: 0.0, lowpassTo: 0.0, lpPoles: 1}
pure func hiss(lp: float) -> Layer = {kind: "noise", freq: 0.0, freqTo: 0.0, glide0: 0.0, glide1: 0.0, amp: 0.3, lowpass: lp, highpass: 0.0, seed: 7, env: noEnv(), vibRate: 0.0, vibCents: 0.0, amRate: 0.0, amDepth: 0.0, lowpassTo: 0.0, lpPoles: 1}

pure func loopRecipe() -> Recipe = {id: "t_loop", seconds: 0.25, loop: true, peakDb: -6.0, fadeMs: 0.0, swellRate: 4.0, swellDepth: 0.2, drive: 0.0, rate: 48000,
  layers: [sine(440.0, 0.5), sine(220.0, 0.3), hiss(800.0)]}

pure func file(schema: string) -> string = "{\"schema\":\"${schema}\",\"recipes\":[{\"id\":\"x\",\"seconds\":0.5,\"layers\":[{\"kind\":\"sine\",\"freq\":440,\"amp\":0.5}]}]}"

pure func checks() -> [string] = [
  match parseRecipesAs("stapledons.audio.recipes/1", file("stapledons.audio.recipes/1")) { Ok([r]) => if r.rate == 48000 then "" else "the default rate is not 48 kHz", _ => "the game's schema id does not parse" },
  match parseRecipesAs("stapledons.audio.recipes/1", file("sunholo.audio.recipes/1")) { Err(_) => "", Ok(_) => "a file with another schema id is accepted" }
]

export func main() -> () ! {IO} {
  let failed = foldl(\acc x. if x == "" then acc else acc ++ [x], [], checks());
  let sha = sha256Bytes(pcm16(render(loopRecipe())));
  if size(failed) == 0 then println("synth-ok ${sha}") else println("synth-FAIL ${join("; ", failed)}")
}
