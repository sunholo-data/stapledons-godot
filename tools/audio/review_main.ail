module stapledons/audio/review_main
-- R2-SOUND S0b (make sound-review): the listening page's audio. Re-renders each recipe with the
-- synthesis core (so the page hears exactly what the game ships), applies one gain per item (the
-- cue's in-game level plus one preview gain shared by every sound, so their balance is the game's),
-- and writes <out>/<id>.ogg (Ogg Opus via std/audio.encode, deterministic) and <out>/<id>.wav (a
-- fallback for browsers without Opus), named by each item's `file`. A mix tiles loops to a common length
-- and sums them. A second plan over the previous recipes renders the <id>_v1 files for A/B listening.
--   ailang run --quiet --bytecode --caps IO,FS --package-dir tools/audio --entry main --args-json '<plan>' \
--     tools/audio/review_main.ail
import pkg/sunholo/audio/recipe (defaultRate)
import pkg/sunholo/audio/sound (Sound, parseSoundsAs, renderSound)
import pkg/sunholo/audio/pcm (pcm16)
import pkg/sunholo/audio/mix (tile)
import pkg/sunholo/audio/dsp (dbToGain)
import std/audio (wavFromPcm, encode, OggOpus)
import std/fs (readFileResult, writeFileBytesResult)
import std/list (map, range, foldl, filter, length as size, head)
import std/array (fromList, toList, get, add, scale, make)
import std/math (pow, round, floatToInt)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/io (println)
import std/string (intToStr)

export type Item = {id: string, file: string, gain_db: float}
export type MixPart = {recipe: string, gain_db: float, at: [float]}
export type Mix = {id: string, seconds: float, parts: [MixPart]}
export type Plan = {recipes: string, out: string, items: [Item], mixes: [Mix]}

pure func gain(db: float) -> float = dbToGain(db)

pure func find(rs: [Sound], id: string) -> Option[Sound] = head(filter(\r. r.base.id == id, rs))

-- A recipe over n samples (sunholo/audio mix.tile): a loop tiles from 0; a one-shot plays once at
-- each start in `at` (seconds; empty = at 0) and is silent elsewhere (a later start cuts an earlier
-- one short, like one voice). The package takes the greatest start at or before each sample; the
-- review plans list starts in ascending order, where that equals the old last-matching rule.
pure func tiled(r: Sound, g: float, n: int, at: [float]) -> Array[float] =
  fromList(tile(renderSound(r), r.base.loop, g, n, map(\s. floatToInt(round(s * 48000.0)), at)))

func writeSound(out: string, id: string, xs: [float]) -> Result[(), string] ! {FS, IO} {
  let pcm = pcm16(xs);
  match encode(pcm, defaultRate(), 1, OggOpus(96000)) {
    Err(e) => Err("${id}: ${e}"),
    Ok(ogg) => match writeFileBytesResult("${out}/${id}.ogg", ogg) {
      Err(e) => Err("${id}.ogg: ${e}"),
      Ok(_) => match writeFileBytesResult("${out}/${id}.wav", wavFromPcm(pcm, defaultRate(), 1, 16)) {
        Err(e) => Err("${id}.wav: ${e}"),
        Ok(_) => { println("sound-review: ${id}"); Ok(()) }
      }
    }
  }
}

func items(p: Plan, rs: [Sound], is: [Item]) -> Result[(), string] ! {FS, IO} =
  match is {
    [] => Ok(()),
    it :: more => match find(rs, it.id) {
      None => Err("${it.id}: no such recipe"),
      Some(r) => match writeSound(p.out, it.file, toList(scale(gain(it.gain_db), fromList(renderSound(r))))) {
        Err(e) => Err(e),
        Ok(_) => items(p, rs, more)
      }
    }
  }

func mixes(p: Plan, rs: [Sound], ms: [Mix]) -> Result[(), string] ! {FS, IO} =
  match ms {
    [] => Ok(()),
    m :: more => {
      let n = floatToInt(round(m.seconds * 48000.0));
      let found = map(\pt. (find(rs, pt.recipe), (pt.gain_db, pt.at)), m.parts);
      let missing = filter(\x. match x { (None, _) => true, _ => false }, found);
      if size(missing) > 0 then Err("${m.id}: a part names no recipe")
      else {
        let sum = foldl(\acc x. match x { (Some(r), (g, at)) => add(acc, tiled(r, gain(g), n, at)), (None, _) => acc }, make(n, 0.0), found);
        match writeSound(p.out, m.id, toList(sum)) { Err(e) => Err(e), Ok(_) => mixes(p, rs, more) }
      }
    }
  }

export func main(p: Plan) -> () ! {FS, IO} =
  match readFileResult(p.recipes) {
    Err(e) => println("sound-review: FAIL reading ${p.recipes}: ${e}"),
    Ok(text) => match parseSoundsAs("stapledons.audio.recipes/1", text) {
      Err(e) => println("sound-review: FAIL ${e}"),
      Ok(rs) => match items(p, rs, p.items) {
        Err(e) => println("sound-review: FAIL ${e}"),
        Ok(_) => match mixes(p, rs, p.mixes) {
          Err(e) => println("sound-review: FAIL ${e}"),
          Ok(_) => println("sound-review: ${intToStr(size(p.items) + size(p.mixes))} files written to ${p.out}")
        }
      }
    }
  }
