extends SceneTree

const ProjectionMath = preload("res://physics/observation_projection.gd")
var passed := 0
var failed := 0
const WCS = {"crpixX": -5951.0, "crpixY": 3975.0, "crvalRaDeg": 52.7887505, "crvalDecDeg": -52.5, "cd11": -2.777777777778e-5, "cd12": 0.0, "cd21": 0.0, "cd22": 2.777777777778e-5}
# Independent analytical spherical TAN oracle; FITS one-based pixel centres.
const ANCHORS = [
	[52.49173224571941, -52.59225486229888, 544.6214203582722, 640.4482788747],
	[52.49516153451485, -52.602943682621635, 468.0604411137465, 255.95798384947284],
	[52.50469028742163, -52.60478789109956, 259.4614439434199, 190.40081939305037],
	[52.49105413229542, -52.60838661917309, 557.0574955302427, 59.64415275198235],
	[52.50914561860414, -52.5955019864996, 163.34787393608258, 525.0740320903224]
]
# Generated by celestial 0.7.0 _smoke.projectionProbe(24), strict VM/interpreter
# identical and independently checked by tools/projection_ref.py. Five field samples.
const PACKAGE = [
	[697.0, 409.0, 52.48472017189266, -52.598666239097525],
	[523.0, 307.0, 52.49265837617902, -52.60151963330296],
	[349.0, 205.0, 52.50059761744564, -52.604372497783196],
	[175.0, 103.0, 52.50853789559083, -52.60722483235918],
	[1.0, 1.0, 52.51647921051262, -52.61007663685193]
]

func check(ok: bool, label: String) -> void:
	if ok:
		passed += 1
	else:
		failed += 1
		printerr("FAIL ", label)

func pixel_close(p: Dictionary, x: float, y: float, tolerance := 0.000001) -> bool:
	return p.get("ok", false) and absf(p.x - x) < tolerance and absf(p.y - y) < tolerance

func _init() -> void:
	for a in ANCHORS:
		check(pixel_close(ProjectionMath.sky_to_pixel(WCS, a[0], a[1]), a[2], a[3]), "independent real-source analytical anchor")
	for a in PACKAGE:
		var sky := ProjectionMath.pixel_to_sky(WCS, a[0], a[1])
		check(sky.get("ok", false) and absf(sky.ra_deg - a[2]) < 1e-10 and absf(sky.dec_deg - a[3]) < 1e-10, "package forward number table")
		check(pixel_close(ProjectionMath.sky_to_pixel(WCS, a[2], a[3]), a[0], a[1]), "package inverse number table")
	var simple := {"crpixX": 1.0, "crpixY": 1.0, "crvalRaDeg": 0.0, "crvalDecDeg": 0.0, "cd11": 1.0, "cd12": 0.0, "cd21": 0.0, "cd22": 1.0}
	check(pixel_close(ProjectionMath.sky_to_pixel(simple, 0.0, 0.0), 1.0, 1.0), "FITS one-based centre")
	var sky := ProjectionMath.pixel_to_sky(simple, 2.0, 1.0)
	check(sky.get("ok", false) and absf(sky.ra_deg - rad_to_deg(atan(PI / 180.0))) < 1e-12, "gnomonic known one-degree tangent coordinate")
	var rotated := simple.duplicate()
	rotated.cd11 = -0.02
	rotated.cd12 = 0.01
	rotated.cd21 = 0.015
	rotated.cd22 = 0.03
	sky = ProjectionMath.pixel_to_sky(rotated, 2.0, 3.0)
	check(sky.get("ok", false) and absf(sky.ra_deg) < 1e-12 and absf(sky.dec_deg - rad_to_deg(atan(0.075 * PI / 180.0))) < 1e-12, "independent full CD axis and orientation control")
	for xy in [[12.0, -7.0], [-300.0, 200.0], [1.0, 1.0]]:
		sky = ProjectionMath.pixel_to_sky(rotated, xy[0], xy[1])
		check(sky.get("ok", false) and pixel_close(ProjectionMath.sky_to_pixel(rotated, sky.get("ra_deg", 0.0), sky.get("dec_deg", 0.0)), xy[0], xy[1]), "full CD rotated reflected off-image roundtrip")
	rotated = simple.duplicate()
	rotated.crvalRaDeg = 359.99
	sky = ProjectionMath.pixel_to_sky(rotated, 2.0, 1.0)
	check(sky.get("ok", false) and sky.ra_deg < 1.0 and pixel_close(ProjectionMath.sky_to_pixel(rotated, sky.ra_deg, sky.dec_deg), 2.0, 1.0), "RA wrap")
	for pole in [-90.0, 90.0]:
		rotated.crvalDecDeg = pole
		sky = ProjectionMath.pixel_to_sky(rotated, 1.2, 1.4)
		check(sky.get("ok", false) and pixel_close(ProjectionMath.sky_to_pixel(rotated, sky.ra_deg, sky.dec_deg), 1.2, 1.4), "pole tangent basis")
	for ra in [90.0, 180.0, 270.0]:
		check(ProjectionMath.sky_to_pixel(simple, ra, 0.0).get("error") == "OutsideTangentHemisphere", "horizon or back hemisphere refused")
	for value in [NAN, INF, -INF, 360.0, -0.1]:
		check(ProjectionMath.sky_to_pixel(simple, value, 0.0).get("error") == "InvalidSky", "invalid RA refused")
	check(ProjectionMath.sky_to_pixel(simple, 0.0, 90.1).get("error") == "InvalidSky", "invalid Dec refused")
	for value in [NAN, INF, -INF, 1e9 + 1.0]:
		check(ProjectionMath.pixel_to_sky(simple, value, 0.0).get("error") == "InvalidPixel", "invalid pixel refused")
	var tiny := simple.duplicate()
	tiny.cd11 = 2e-12
	tiny.cd22 = 2e-12
	check(ProjectionMath.sky_to_pixel(tiny, 1.0, 0.0).get("error") == "InvalidPixel", "inverse numerical pixel domain refused without clipping")
	for invalid in [{}, {"cd11": 0.0}, {"crpixX": NAN}, {"crvalRaDeg": 360.0}, {"cd22": 1e-25}, {"cd12": "0"}]:
		var broken := simple.duplicate()
		if invalid.is_empty():
			broken.erase("cd11")
		else:
			broken.merge(invalid, true)
		check(ProjectionMath.sky_to_pixel(broken, 0.0, 0.0).get("error") == "InvalidWcs", "invalid WCS refused")
	var manifest: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/observations/euclid_dr1/manifest.json"))
	var plate: Dictionary = manifest.plates[0]
	check(ProjectionMath.errors(plate.registration).is_empty(), "supported registered ICRS TAN metadata")
	for a in plate.registration.anchors:
		var point := ProjectionMath.display_point(plate, a)
		check(point.distance_to(Vector2(a.source_x, a.source_y)) < 0.1, "analytic source pixel to top-down display within 0.1 pixel")
		check(point.distance_to(Vector2(a.reference_x, a.reference_y)) < 1.0, "independently measured VIS centroid within one source pixel")
	for invalid in [{"projection": "SIN"}, {"frame": "FK5"}, {"height": 0}, {"height": 10.5}, {"width": NAN}, {"wcs": {}}, {"wcs": "invalid"}]:
		var registration: Dictionary = plate.registration.duplicate(true)
		registration.merge(invalid, true)
		check(not ProjectionMath.errors(registration).is_empty(), "unsupported registration metadata refused")
	var unregistered: Dictionary = plate.duplicate(true)
	unregistered.registered = false
	check(not ProjectionMath.display_point(unregistered, plate.registration.anchors[0]).is_finite(), "unregistered plate has no object point")
	check(not ProjectionMath.display_point(plate, {}).is_finite(), "absent object astrometry has no point")
	var wrong_plate: Dictionary = plate.registration.anchors[0].duplicate()
	wrong_plate.plate_id = "unrelated"
	check(not ProjectionMath.display_point(plate, wrong_plate).is_finite(), "object belonging to another plate refused")
	print("observation-coordinate-test: %d passed, %d failures" % [passed, failed])
	quit(1 if failed else 0)
