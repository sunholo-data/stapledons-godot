module stapledons/sim/protocol

-- Protocol v2 (design m2-journey-core §M2.1): typed messages, hand-written
-- inverse codec pairs and the session server. Pure: runs on the strict VM
-- (`make strict`, protocolVm). I/O stays in ship.ail.
--
-- Floats are written by `num`: std/json's shortest round-trip digits, with two
-- repairs for std/json v0.50.0 (whole floats >= 1e17 are printed as integer
-- digits, which decode saturates at 2^63-1; -0.0 is printed as "0"): those are
-- written in exponent form and as "-0.0". Exact integers stay in [0, 2^53).
import std/json (Json, encode, decode, js, jnum, get, has, getNumber, getString, getBool, getArray, asObject)
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)
import std/string (concat, join, length, substring, startsWith, endsWith, contains, intToStr, split)
import std/math (floor, floatToInt, intToFloat)
import pkg/sunholo/relativity/optics (Vec3, norm)
import pkg/sunholo/relativity/kinematics (betaOf, gammaOf, oneMinusBeta)
import pkg/sunholo/relativity/hyper (absf)
import pkg/sunholo/celestial/rings (RingBand)
import ./data/sol (Ring, rings)
import ./solar_departure (TourLeg, initialize as solarInitialize, legs as solarLegs, approximation as solarApproximation, earthStandoffKm)
import ./core (Ship, position, phaseName, World, newWorld, tick, scenarioError, Ledger,
  Target, PlanReq, Intent, IPlan, IPlanBody, ICommit, ICancel, IThrust, IHeading, IRecord, IDraw, IEcho, IAiOpen, IAiCancel, Refusal, Event, Crossing, Residuals, Params, defaultParams,
  Drawn, PlanView, JourneyView, Energy, Ism, journeyView, cruisePhiMin, cruisePhiMax, cruisePhiDefault,
  CqView, cqView, ismNow, dragEnergyJ, withArchive, navOf, departureOf)
import ./consequence (News, Entry, ArchiveRow, IsmNow, tierName, isHint)
import ./rng (Rng, streamName, streamOf, rngId)
import ./ai (AiEvent, ERequest, EAcceptedText, EAcceptedMedia, EFallback, AiRequest, AiSeg, CacheKey, Constraints, CtxVal, CStr, CList, CtxField,
  AiView, OpenView, aiView, isCancelReason, isSha256Hex, defaultAiMaxOpen, defaultAiTtlTicks)
import ./celestial (SystemView, BodyView, solSystem, systemAt, jdAt, defaultEpochJd, lyKm)
import ./navigation (BodyReq, NavPlan, Pass)

export type Override = { name: string, value: float }
export type Input =
  GHello({major: int, minor: int})
  | GNewGame({seed: int, scenario: string, diag: bool, params: [Override], aiCore: Option[string]})
  | GInput({tick: int, dtau: float, intents: [Intent]})
  | GQuit
export type Clock = { tau: float, t: float, year: float, age: float }
-- flown: x - x0, the distance along the current line of motion since its
-- origin (since the commit while committed; 0 again once arrived, when the
-- line is rebased at the target). The UI reads progress from it (M2.6b).
export type ShipView = { phase: string, beta: float, oneMinusBeta: float, gamma: float, heading: Vec3, pos: Vec3, x: float, flown: float }
-- Ledger readout (design §M2.1 change-sets): radiated = boost + drag.
export type LedgerView = { mEffKg: float, availableKg: float, radiatedJ: float, boostJ: float, dragJ: float }
-- rng: the stream counters (design §M2.1 change-sets, M2.4).
-- ai: open AI requests (2.1, AI.2); the last section, sent only when it
-- changed, and always in full states (2.1, AI.3: the last section).
export type StateMsg = { tick: int, status: string, clock: Option[Clock], ship: Option[ShipView], journey: Option[JourneyView], ledger: Option[LedgerView], rng: Option[Rng], params: Option[Params], ai: Option[AiView], events: [Event], refused: [Refusal], full: bool }
export type HelloMsg = { major: int, minor: int, sim: string, relativity: string, rng: string }

-- relativity: below minor 4 the hello keeps the string every recorded stream and golden
-- carries ("0.4.0", stale since the 0.5 pins); from 2.4 it is the pinned release,
-- relativityPin(), which `make hello-pin` checks against sim/ailang.toml.
export pure func helloMsg() -> HelloMsg = { major: 2, minor: 1, sim: "stapledons/sim 0.1.0", relativity: "0.4.0", rng: rngId() }
export pure func relativityPin() -> string = "0.7.0"
-- Protocol 2.2 (M4.1): a client that asks for minor >= 2 is answered minor 2 and gets the
-- `consequence` section and `ship.ism`; every other client sees the 2.1 stream byte for byte.
export pure func helloFor(want: int) -> HelloMsg =
  if want >= departureMinor() then {helloMsg() | minor: departureMinor(), relativity: relativityPin()}
  else if want >= navMinor() then {helloMsg() | minor: navMinor(), relativity: relativityPin()}
  else if want >= systemMinor() then {helloMsg() | minor: systemMinor()} else if want >= 2 then {helloMsg() | minor: 2} else helloMsg()
-- Protocol 2.3 (M5.1b): a client that asks for minor >= 3 also gets the `system` section
-- (Sol's bodies as seen from the ship). Tests read the minor from here, never a literal (F4).
export pure func systemMinor() -> int = 3
-- Protocol 2.4 (M5.5a): body targets. A client that asks for minor >= 4 may send the
-- plan intent's body form, and a body plan's journey.plan carries target_kind,
-- intercept, and pass (flyby) or hold (stop). Below 4 a body plan is bad_intent.
export pure func navMinor() -> int = 4
-- 2.5 adds the exact recorded plan departure; older replay bytes are unchanged.
export pure func departureMinor() -> int = 5
pure func sessionMinor(want: int) -> int = if want >= departureMinor() then departureMinor() else if want >= navMinor() then navMinor() else if want >= systemMinor() then systemMinor() else if want >= 2 then 2 else want

-- ------------------------------------------------------------ writing
pure func trimZeros(s: string) -> string = if endsWith(s, "0") then trimZeros(substring(s, 0, length(s) - 1)) else s
pure func mantissa(d: string) -> string = if length(d) == 1 then d else concat([substring(d, 0, 1), ".", substring(d, 1, length(d))])
pure func zeros(z: int) -> string = if z <= 0 then "" else concat(["0", zeros(z - 1)])
pure func small(frac: string, z: int) -> string =
  if startsWith(frac, "0") then small(substring(frac, 1, length(frac)), z + 1)
  else if z < 6 then concat(["0.", zeros(z), frac])
  else concat([mantissa(frac), "e-", intToStr(z + 1)])
-- std/json writes |x| >= 1e21 as `1e+21` since v0.52.0 (ailang#1460); the wire keeps `1e21`.
pure func mag(s: string) -> string =
  if contains(s, "e+") then join("e", split(s, "e+"))
  else if startsWith(s, "0.") then small(substring(s, 2, length(s)), 0)
  else if contains(s, ".") || contains(s, "e") || length(s) <= 17 then s
  else concat([mantissa(trimZeros(s)), "e", intToStr(length(s) - 1)])
export pure func num(x: float) -> string =
  if x == 0.0 then (if 1.0 / x < 0.0 then "-0.0" else "0")
  else if x < 0.0 then concat(["-", mag(encode(jnum(0.0 - x)))])
  else mag(encode(jnum(x)))

pure func q(s: string) -> string = encode(js(s))
pure func f(k: string, v: string) -> string = concat([q(k), ":", v])
pure func obj(fs: [string]) -> string = concat(["{", join(",", fs), "}"])
pure func arr(xs: [string]) -> string = concat(["[", join(",", xs), "]"])
pure func each(g: a -> string, xs: [a]) -> [string] = match xs { [] => [], x :: r => g(x) :: each(g, r) }
pure func bool(b: bool) -> string = if b then "true" else "false"
pure func vec(v: Vec3) -> string = obj([f("x", num(v.x)), f("y", num(v.y)), f("z", num(v.z))])
pure func envelope(t: string, fs: [string]) -> string = obj([f("v", "2"), f("type", q(t))] ++ fs)
pure func opt(k: string, g: a -> string, o: Option[a]) -> [string] = match o { Some(x) => [f(k, g(x))], None => [] }

pure func paramPairs(p: Params) -> [Override] = [
  {name: "epoch", value: p.epoch}, {name: "start_age", value: p.startAge}, {name: "boost_g", value: p.boostG},
  {name: "m_eff_kg", value: p.mEffKg}, {name: "ism_n_cm3", value: p.ismNCm3}, {name: "bubble_radius_m", value: p.bubbleRadiusM},
  {name: "glow_eps", value: p.glowEps}, {name: "glow_f_in", value: p.glowFIn}, {name: "cruise_min_beta", value: p.cruiseMinBeta},
  {name: "cap_one_minus_beta", value: p.capOneMinusBeta}]
-- The params echo: the scenario params, then the cruise-rapidity bounds and
-- default the planner uses (derived, read-only; the decoder ignores them),
-- then (2.1, AI.3) the AI request limits as the last two keys.
pure func paramsEcho(p: Params) -> string =
  overrides(paramPairs(p) ++ [{name: "cruise_phi_min", value: cruisePhiMin(p)}, {name: "cruise_phi_max", value: cruisePhiMax(p)}, {name: "cruise_phi_default", value: cruisePhiDefault(p)},
    {name: "ai_max_open", value: intToFloat(p.aiMaxOpen)}, {name: "ai_ttl_ticks", value: intToFloat(p.aiTtlTicks)}])
pure func overrides(os: [Override]) -> string = obj(each(\o. f(o.name, num(o.value)), os))

pure func targetObj(t: Target) -> string = obj([f("index", intToStr(t.index)), f("id", q(t.id)), f("pos", vec(t.pos))])
pure func planFields(p: PlanReq) -> [string] =
  [f("target", targetObj(p.target)), f("cruise_phi", num(p.cruisePhi))] ++ opt("flip_g", num, p.flipG)
pure func encodeIntent(i: Intent) -> string =
  match i {
    IPlan(p) => obj([f("k", q("plan"))] ++ planFields(p)),
    IPlanBody(b) => obj([f("k", q("plan")), f("target", obj([f("kind", q("body")), f("id", q(b.id))])), f("cruise_phi", num(b.cruisePhi)), f("approach", approachObj(b))]),
    IEcho(p) => obj([f("k", q("echo"))] ++ planFields(p)),
    ICommit(n) => obj([f("k", q("commit")), f("plan_id", intToStr(n))]),
    ICancel => obj([f("k", q("cancel"))]),
    IThrust(t) => obj([f("k", q("thrust")), f("thrust", num(t))]),
    IHeading(h) => obj([f("k", q("heading")), f("heading", vec(h))]),
    IRecord(r) => obj([f("k", q("record")), f("source", q(r.source)), f("req", q(r.req)), f("kind", q(r.kind)), f("sha256", q(r.sha256)), f("body", q(r.body))]),
    IDraw(s) => obj([f("k", q("draw")), f("stream", q(streamName(s)))]),
    IAiOpen(o) => obj([f("k", q("ai_open")), f("kind", q(o.kind)), f("purpose", q(o.purpose)), f("entity_id", q(o.entityId))] ++
      opt("emotion", q, o.emotion) ++ opt("age_stage", num, o.ageStage) ++ opt("line_req", q, o.lineReq) ++ opt("emotions", strArr, o.emotions) ++
      (match o.context { [] => [], _ => [f("context", ctxObj(o.context))] })),
    IAiCancel(c) => obj([f("k", q("ai_cancel")), f("req", q(c.req)), f("reason", q(c.reason))])
  }
-- 2.4 body plan: approach {mode: "stop", standoff_km?} or {mode: "flyby", b_km, clock_deg, run_out_km?}.
pure func approachObj(b: BodyReq) -> string =
  if b.mode == "stop" then obj([f("mode", q("stop"))] ++ opt("standoff_km", num, b.standoffKm))
  else obj([f("mode", q(b.mode)), f("b_km", num(b.bKm)), f("clock_deg", num(b.clockDeg))] ++ opt("run_out_km", num, b.runOutKm))
-- AI payloads (2.1): context values are strings or string lists; the cache
-- key and constraints are fixed-order objects.
pure func strArr(xs: [string]) -> string = arr(each(q, xs))
pure func ctxVal(v: CtxVal) -> string = match v { CStr(x) => q(x), CList(xs) => strArr(xs) }
pure func ctxObj(cs: [CtxField]) -> string = obj(each(\c. f(c.name, ctxVal(c.value)), cs))
pure func keyObj(k: CacheKey) -> string =
  obj([f("kind", q(k.kind)), f("entity_id", q(k.entityId)), f("emotion", q(k.emotion)), f("age_stage", intToStr(k.ageStage)), f("variant", q(k.variant))])
pure func constraintsObj(c: Constraints) -> string = obj([f("max_chars", intToStr(c.maxChars)), f("no_numerals", bool(c.noNumerals)), f("emotions", strArr(c.emotions))])
pure func segObj(x: AiSeg) -> string = obj([f("emotion", q(x.emotion)), f("text", q(x.text))])
pure func aiFields(e: AiEvent) -> [string] =
  match e {
    ERequest(r) => [f("req", q(r.req)), f("kind", q(r.kind)), f("purpose", q(r.purpose))] ++ opt("line_req", q, r.lineReq) ++
      [f("key", keyObj(r.key)), f("seed", intToStr(r.seed)), f("constraints", constraintsObj(r.constraints)), f("context", ctxObj(r.context)), f("expires_tick", intToStr(r.expiresTick))],
    EAcceptedText(x) => [f("req", q(x.req)), f("kind", q(x.kind)), f("sha256", q(x.sha256)), f("text", q(x.text)), f("segments", arr(each(segObj, x.segments)))],
    EAcceptedMedia(x) => [f("req", q(x.req)), f("kind", q(x.kind)), f("sha256", q(x.sha256)), f("descriptor", encode(x.descriptor))],
    EFallback(x) => [f("req", q(x.req)), f("reason", q(x.reason))]
  }
pure func encodeAiView(v: AiView) -> string =
  obj([f("last_req", intToStr(v.lastReq)), f("open", arr(each(\o. obj([f("req", q(o.req)), f("kind", q(o.kind)), f("expires_tick", intToStr(o.expiresTick))]), v.open))), f("core", q(v.core))])
export pure func encodeInput(m: Input) -> string =
  match m {
    GHello(h) => envelope("hello", [f("want", obj([f("major", intToStr(h.major)), f("minor", intToStr(h.minor))]))]),
    GNewGame(g) => envelope("new_game", [f("seed", intToStr(g.seed)), f("scenario", q(g.scenario)), f("diag", bool(g.diag))] ++ (match g.params { [] => [], _ => [f("params", overrides(g.params))] }) ++ opt("ai_core", q, g.aiCore)),
    GInput(i) => envelope("input", [f("tick", intToStr(i.tick)), f("dtau", num(i.dtau)), f("intents", arr(each(encodeIntent, i.intents)))]),
    GQuit => envelope("quit", [])
  }
pure func encodeClock(c: Clock) -> string = obj([f("tau", num(c.tau)), f("t", num(c.t)), f("year", num(c.year)), f("age", num(c.age))])
pure func encodeShip(s: ShipView) -> string = obj(shipFields(s))
pure func shipFields(s: ShipView) -> [string] =
  [f("phase", q(s.phase)), f("beta", num(s.beta)), f("one_minus_beta", num(s.oneMinusBeta)), f("gamma", num(s.gamma)), f("heading", vec(s.heading)), f("pos", vec(s.pos)), f("x", num(s.x)), f("flown", num(s.flown))]
pure func encodePlanView(v: PlanView) -> string = obj(planViewFields(v))
pure func planViewFields(v: PlanView) -> [string] =
  [f("target", targetObj(v.target)), f("distance", num(v.distance)), f("profile", q(v.profile)), f("fell_back", bool(v.fellBack)),
    f("cruise_phi", num(v.cruisePhi)), f("cruise_beta", num(v.cruiseBeta)), f("cruise_one_minus_beta", num(v.cruiseOneMinusBeta)), f("cruise_gamma", num(v.cruiseGamma)),
    f("boost_minutes", num(v.boostMinutes)), f("ship_years", num(v.shipYears)), f("earth_years", num(v.earthYears)),
    f("arrive_year", num(v.arriveYear)), f("age_on_arrival", num(v.ageOnArrival)), f("years_left", num(v.yearsLeft)),
    f("energy", obj([f("boost_j", num(v.energy.boostJ)), f("brake_j", num(v.energy.brakeJ)), f("drag_j", num(v.energy.dragJ)), f("total_j", num(v.energy.totalJ)), f("total_kg", num(v.energy.totalKg))])),
    f("ism", obj([f("drag_n", num(v.ism.dragN)), f("hold_w", num(v.ism.holdW)), f("load_w_m2", num(v.ism.loadWM2)), f("glow_w_m2", num(v.ism.glowWM2))])),
    f("cmb_forward_k", num(v.cmbForwardK))]
-- 2.4: a body plan's panel is the M2 panel plus target_kind, intercept{t, pos} (when and
-- where the body is at arrival or at the pass; galaxy years, ly), and pass{t, b_km, beta,
-- d_at_pass} for a flyby or hold{body, offset_km} for a stop. A star plan's bytes are M2's.
pure func navFields(n: NavPlan) -> [string] =
  [f("target_kind", q("body")), f("intercept", obj([f("t", num(n.interceptT)), f("pos", vec(n.interceptLy))]))] ++
  (match n.pass { Some(p) => [f("pass", obj([f("t", num(p.t)), f("b_km", num(p.bKm)), f("beta", num(p.beta)), f("d_at_pass", num(p.dAtPass))]))],
                  None => [f("hold", obj([f("body", q(n.bodyId)), f("offset_km", num(n.standoffKm))]))] })
pure func encodeJourneyNav(j: JourneyView, nav: Option[NavPlan]) -> string =
  match nav { None => encodeJourney(j), Some(n) => obj([f("state", q(j.state)), f("plan_id", intToStr(j.planId))] ++ opt("plan", \v. obj(planViewFields(v) ++ navFields(n)), j.plan)) }
pure func encodeJourneyDeparture(w: World) -> string {
  let j = journeyView(w);
  let extra = (match navOf(w) { Some(n) => navFields(n), None => [] }) ++ opt("departure", vec, departureOf(w));
  obj([f("state", q(j.state)), f("plan_id", intToStr(j.planId))] ++ opt("plan", \v. obj(planViewFields(v) ++ extra), j.plan))
}
pure func withDeparture(s: Session, before: World, after: World, x: Extras) -> Extras =
  if s.minor < departureMinor() then x
  else { let ja = encodeJourneyDeparture(after); {x | journey: if encodeJourneyDeparture(before) == ja then None else Some(ja)} }
-- Events: {k} plus the echo's plan fields, a phase crossing {from, to, tau}
-- the arrival residuals {residual_x, residual_t, residual_phi} or a draw
-- {stream, n, value} (value: the top 53 bits, an exact JSON integer).
pure func encodeEvent(e: Event) -> string =
  obj([f("k", q(e.kind))] ++ (match e.echo { Some(p) => planFields(p), None => [] }) ++
    opt("from", \c. q(c.from), e.phase) ++ opt("to", \c. q(c.to), e.phase) ++ opt("tau", \c. num(c.tau), e.phase) ++
    opt("residual_x", \r. num(r.x), e.arrived) ++ opt("residual_t", \r. num(r.t), e.arrived) ++ opt("residual_phi", \r. num(r.phi), e.arrived) ++
    opt("stream", \d. q(d.stream), e.drew) ++ opt("n", \d. intToStr(d.n), e.drew) ++ opt("value", \d. intToStr(d.value), e.drew) ++
    (match e.ai { Some(x) => aiFields(x), None => [] }))
pure func encodeJourney(j: JourneyView) -> string = obj([f("state", q(j.state)), f("plan_id", intToStr(j.planId))] ++ opt("plan", encodePlanView, j.plan))
pure func encodeRng(r: Rng) -> string =
  obj([f("journey", intToStr(r.journey)), f("crew", intToStr(r.crew)), f("events", intToStr(r.events)), f("galaxy", intToStr(r.galaxy)), f("ai", intToStr(r.ai)), f("news", intToStr(r.news))])
pure func encodeLedger(l: LedgerView) -> string =
  obj([f("m_eff_kg", num(l.mEffKg)), f("available_kg", num(l.availableKg)), f("radiated_j", num(l.radiatedJ)), f("boost_j", num(l.boostJ)), f("drag_j", num(l.dragJ))])
-- 2.2: `ship` already encoded with its `ism` (the override), and the members appended to `changes`.
-- 2.4: `journey` already encoded with a body plan's fields (the override), when it changed.
export type Extras = { ship: Option[string], tail: [string], journey: Option[string] }
pure func noExtras() -> Extras = { ship: None, tail: [], journey: None }
export pure func encodeState(m: StateMsg) -> string = encodeStateX(m, noExtras())
export pure func encodeStateX(m: StateMsg, x: Extras) -> string =
  envelope("state", [f("tick", intToStr(m.tick)), f("status", q(m.status)),
    f("changes", obj(opt("clock", encodeClock, m.clock) ++ (match x.ship { Some(sh) => [f("ship", sh)], None => opt("ship", encodeShip, m.ship) }) ++ (match x.journey { Some(js) => [f("journey", js)], None => opt("journey", encodeJourney, m.journey) }) ++ opt("ledger", encodeLedger, m.ledger) ++ opt("rng", encodeRng, m.rng) ++ opt("params", paramsEcho, m.params) ++ opt("ai", encodeAiView, m.ai) ++ x.tail)),
    f("events", arr(each(encodeEvent, m.events))),
    f("refused", arr(each(\r. obj([f("i", intToStr(r.i)), f("reason", q(r.reason))]), m.refused))),
    f("full", bool(m.full))])
export pure func encodeHello(h: HelloMsg) -> string =
  envelope("hello", [f("proto", obj([f("major", intToStr(h.major)), f("minor", intToStr(h.minor))])), f("sim", q(h.sim)), f("relativity", q(h.relativity)), f("rng", q(h.rng))])

-- 2.2 consequence section: whole when anything in it changed; the legacy log carries
-- only the entries appended since `from` (append-only, never rewritten), with the running count.
pure func newsObj(n: News) -> string =
  obj([f("tier", intToStr(n.tier)), f("tier_name", q(tierName(n.tier))), f("template_id", intToStr(n.templateId)), f("star_id", q(n.starId)),
    f("slots", obj([f("elapsed_years", num(n.elapsedYears)), f("news_epoch", num(n.newsEpoch)), f("news_age_years", num(n.newsAgeYears))]))] ++
    opt("ai_request_id", q, n.aiRequestId) ++ [f("body_source", q(n.bodySource))] ++ opt("fallback_reason", q, n.fallbackReason))
pure func entryObj(e: Entry) -> string =
  obj([f("tick", intToStr(e.tick)), f("kind", q(e.kind)), f("star_id", q(e.starId)), f("tau", num(e.tau)), f("t", num(e.t)), f("gap_years", num(e.gapYears))])
pure func dropN(xs: [a], n: int) -> [a] = if n <= 0 then xs else match xs { [] => [], _ :: r => dropN(r, n - 1) }
pure func countOf(xs: [a]) -> int = match xs { [] => 0, _ :: r => 1 + countOf(r) }
export pure func encodeCq(v: CqView, from: int) -> string =
  obj([f("gap_years", num(v.gapYears)), f("news_epoch", num(v.newsEpoch)), f("news_age_years", num(v.newsAgeYears)), f("progress", num(v.progress)),
    f("standoff_ly", num(v.standoffLy))] ++ opt("news", newsObj, v.cq.news) ++
    [f("archive", obj([f("unlocked", strArr(v.cq.unlocked))])), f("legacy", obj([f("count", intToStr(countOf(v.cq.log))), f("appended", arr(each(entryObj, dropN(v.cq.log, from))))]))])
pure func shipWithIsm(s: ShipView, i: IsmNow, dragEnergy: float) -> string =
  obj(shipFields(s) ++ [f("ism", obj([f("load_w_m2", num(i.loadWM2)), f("drag_n", num(i.dragN)), f("glow_w_m2", num(i.glowWM2)), f("drag_energy_j", num(dragEnergy))]))])

-- 2.3 system section (M5.1b, design m5-planets §M5.1): the bodies as seen from the
-- ship, at the retarded time, galactic frame. Culling is Godot's (the sim stays presentation-free).
-- sun_dir is a unit vector for planets and moons and {0, 0, 0} for the star (kind "star").
pure func bodyObj(b: BodyView) -> string =
  obj([f("id", q(b.id)), f("name", q(b.name)), f("kind", q(b.kind)), f("host", q(b.host)), f("status", q(b.status)),
    f("rel_km", vec(b.relKm)), f("radius_km", num(b.radiusKm)), f("flattening", num(b.flattening)), f("pole", vec(b.pole)), f("w_deg", num(b.wDeg)),
    f("sun_dir", vec(b.sunDir)), f("r_au", num(b.rAu)), f("phase_deg", num(b.phaseDeg)), f("e_v_lux", num(b.eVLux)), f("p_v", num(b.pV)),
    f("minnaert_k", num(b.minnaertK)), f("ring_id", q(b.ringId)), f("light_age_s", num(b.lightAgeS)), f("visitable", bool(b.visitable)), f("source", q(b.source))])
export pure func encodeSystem(v: SystemView) -> string =
  obj([f("jd", num(v.jd)), f("ephemeris", q(v.ephemeris)), f("frame", q(v.frame)), f("bodies", arr(each(bodyObj, v.bodies)))])
-- 2.5 exposes the already-cited profiles without changing old system bytes.
-- Radius km, optical depth and single-scattering albedo come from data/sol;
-- assumed tints retain their provenance instead of becoming renderer constants.
pure func bandObj(b: RingBand) -> string =
  obj([f("r_in_km", num(b.rIn)), f("r_out_km", num(b.rOut)), f("tau", num(b.tau)), f("w0", num(b.w0))])
pure func ringObj(r: Ring) -> string =
  obj([f("host", q(r.host)), f("names", strArr(r.names)), f("bands", arr(each(bandObj, r.bands))),
    f("tint", obj([f("r", num(r.tint.r)), f("g", num(r.tint.g)), f("b", num(r.tint.b))])),
    f("cite", q(r.cite)), f("tau_cite", q(r.tauCite)), f("w0_cite", q(r.w0Cite)), f("tint_cite", q(r.tintCite))])
pure func encodeSystemRings(v: SystemView) -> string =
  obj([f("jd", num(v.jd)), f("ephemeris", q(v.ephemeris)), f("frame", q(v.frame)),
    f("bodies", arr(each(bodyObj, v.bodies))), f("rings", arr(each(ringObj, rings())))])
pure func solarLegObj(leg: TourLeg) -> string =
  obj([f("id", q(leg.id)), f("kind", q(leg.kind)), f("cruise_phi", num(leg.cruisePhi))])
pure func solarTour(p: Params) -> string =
  obj([f("approximation", q(solarApproximation())), f("earth_standoff_km", num(earthStandoffKm())),
    f("legs", arr(each(solarLegObj, solarLegs(p))))])
-- system.jd = epoch_jd + Earth time; the ship's galactic position in ly.
pure func systemOf(w: World) -> SystemView = systemAt(solSystem(), jdAt(w.params.epochJd, w.ship.motion.t), position(w.ship))
pure func systemFull(s: Session, w: World) -> [string] =
  if s.minor >= departureMinor() then [f("system", encodeSystemRings(systemOf(w)))]
  else if s.minor >= systemMinor() then [f("system", encodeSystem(systemOf(w)))] else []
-- Sent on a tick only when it can have changed: the clock (jd) or the ship's position moved.
pure func withSystem(s: Session, before: World, after: World, x: Extras) -> Extras =
  if s.minor < systemMinor() || (before.ship.motion.t == after.ship.motion.t && encodeVec(position(before.ship)) == encodeVec(position(after.ship)) && before.params.epochJd == after.params.epochJd) then x
  else {x | tail: x.tail ++ systemFull(s, after)}
pure func encodeVec(v: Vec3) -> string = vec(v)

-- ------------------------------------------------------------ reading
pure func bind(r: Result[a, string], g: a -> Result[b, string]) -> Result[b, string] = match r { Ok(x) => g(x), Err(c) => Err(c) }
pure func req(o: Option[a], c: string) -> Result[a, string] = match o { Some(x) => Ok(x), None => Err(c) }
pure func check(ok: bool, x: a, c: string) -> Result[a, string] = if ok then Ok(x) else Err(c)
pure func finite(x: float) -> bool = x - x == 0.0
pure func numF(j: Json, k: string) -> Option[float] = match getNumber(j, k) { Some(x) => if finite(x) then Some(x) else None, None => None }
pure func natF(j: Json, k: string) -> Option[int] =
  match getNumber(j, k) { Some(x) => if x >= 0.0 && x <= 9007199254740991.0 && floor(x) == x then Some(floatToInt(x)) else None, None => None }
pure func vecF(j: Json, k: string) -> Option[Vec3] =
  match get(j, k) { Some(v) => match numF(v, "x") { Some(x) => match numF(v, "y") { Some(y) => match numF(v, "z") { Some(z) => Some({x: x, y: y, z: z}), None => None }, None => None }, None => None }, None => None }
@allow_empty_ok("an empty list decodes to an empty list: no intents, events or refusals")
pure func all(g: a -> Result[b, string], xs: [a]) -> Result[[b], string] =
  match xs { [] => Ok([]), x :: r => bind(g(x), \y. bind(all(g, r), \ys. Ok(y :: ys))) }
pure func str(j: Json, k: string) -> Result[string, string] = req(getString(j, k), "bad_intent")

pure func decodeIntent(j: Json) -> Result[Intent, string] =
  match getString(j, "k") { Some(k) => intentOf(k, j), None => Err("bad_intent") }
pure func targetOf(j: Json, c: string) -> Result[Target, string] =
  bind(req(get(j, "target"), c), \t.
  bind(req(natF(t, "index"), c), \index. bind(req(getString(t, "id"), c), \id. bind(req(vecF(t, "pos"), c), \pos.
  Ok({index: index, id: id, pos: pos})))))
pure func planOf(j: Json, c: string) -> Result[PlanReq, string] =
  bind(targetOf(j, c), \tg.
  bind(req(numF(j, "cruise_phi"), c), \phi.
  bind(if has(j, "flip_g") then bind(req(numF(j, "flip_g"), c), \g. Ok(Some(g))) else Ok(None), \flip.
  Ok({target: tg, cruisePhi: phi, flipG: flip}))))
-- 2.4: a target {kind: "body", id} is the body form; any index or pos it carries is ignored.
pure func isBodyTarget(j: Json) -> bool = match get(j, "target") { Some(t) => getString(t, "kind") == Some("body"), None => false }
pure func bodyPlanOf(j: Json, c: string) -> Result[BodyReq, string] =
  bind(req(get(j, "target"), c), \t. bind(req(getString(t, "id"), c), \id. bind(req(numF(j, "cruise_phi"), c), \phi.
  bind(approachOf(j, c), \ap. Ok({ap | id: id, cruisePhi: phi})))))
pure func stopReq(s: Option[float]) -> BodyReq = { id: "", cruisePhi: 0.0, mode: "stop", standoffKm: s, bKm: 0.0, clockDeg: 0.0, runOutKm: None }
-- approach absent: a stop at the default stand-off; flyby clock_deg absent: 0 (north).
pure func approachOf(j: Json, c: string) -> Result[BodyReq, string] =
  if !has(j, "approach") then Ok(stopReq(None))
  else bind(req(get(j, "approach"), c), \a. bind(req(getString(a, "mode"), c), \m.
    if m == "stop" then bind(optIf(a, "standoff_km", \x. req(numF(x, "standoff_km"), c)), \s. Ok(stopReq(s)))
    else if m == "flyby" then bind(req(numF(a, "b_km"), c), \b. bind(if has(a, "clock_deg") then req(numF(a, "clock_deg"), c) else Ok(0.0), \ck.
      bind(optIf(a, "run_out_km", \x. req(numF(x, "run_out_km"), c)), \ro. Ok({stopReq(None) | mode: "flyby", bKm: b, clockDeg: ck, runOutKm: ro}))))
    else Err(c)))
pure func intentOf(k: string, j: Json) -> Result[Intent, string] =
    if k == "plan" && isBodyTarget(j) then bind(bodyPlanOf(j, "bad_intent"), \b. Ok(IPlanBody(b)))
    else if k == "plan" then bind(planOf(j, "bad_intent"), \p. Ok(IPlan(p)))
    else if k == "echo" then bind(planOf(j, "bad_intent"), \p. Ok(IEcho(p)))
    else if k == "commit" then bind(req(natF(j, "plan_id"), "bad_intent"), \n. Ok(ICommit(n)))
    else if k == "cancel" then Ok(ICancel)
    else if k == "thrust" then bind(req(numF(j, "thrust"), "bad_step"), \t. check(absf(t) <= 1.0, IThrust(t), "bad_step"))
    else if k == "heading" then bind(req(vecF(j, "heading"), "bad_heading"), \h. check(absf(norm(h) - 1.0) <= 0.000000001, IHeading(h), "bad_heading"))
    else if k == "record" then bind(str(j, "source"), \s. bind(str(j, "req"), \r. bind(str(j, "kind"), \kd. bind(str(j, "sha256"), \h. bind(str(j, "body"), \b.
      Ok(IRecord({source: s, req: r, kind: kd, sha256: h, body: b})))))))
    else if k == "draw" then bind(str(j, "stream"), \s. bind(req(streamOf(s), "bad_intent"), \st. Ok(IDraw(st))))
    else if k == "ai_open" then bind(str(j, "kind"), \kd. bind(str(j, "purpose"), \pu. bind(str(j, "entity_id"), \eid.
      bind(optStr(j, "emotion", "bad_intent"), \em. bind(optIf(j, "age_stage", \x. req(numF(x, "age_stage"), "bad_intent")), \ag.
      bind(optStr(j, "line_req", "bad_intent"), \lr. bind(optIf(j, "emotions", \x. strsAt(x, "emotions", "bad_intent")), \ems. bind(ctxOf(j, "bad_intent"), \cx.
      Ok(IAiOpen({kind: kd, purpose: pu, entityId: eid, emotion: em, ageStage: ag, lineReq: lr, emotions: ems, context: cx}))))))))))
    else if k == "ai_cancel" then bind(str(j, "req"), \r. bind(str(j, "reason"), \why. check(isCancelReason(why), IAiCancel({req: r, reason: why}), "bad_intent")))
    else Err("bad_intent")
pure func optStr(j: Json, k: string, c: string) -> Result[Option[string], string] =
  if has(j, k) then bind(req(getString(j, k), c), \x. Ok(Some(x))) else Ok(None)
pure func strOf(x: Json, c: string) -> Result[string, string] = match x { JString(v) => Ok(v), _ => Err(c) }
pure func strsAt(j: Json, k: string, c: string) -> Result[[string], string] = bind(req(getArray(j, k), c), \xs. all(\x. strOf(x, c), xs))
pure func ctxValOf(x: Json, c: string) -> Result[CtxVal, string] =
  match x { JString(v) => Ok(CStr(v)), JArray(xs) => bind(all(\y. strOf(y, c), xs), \vs. Ok(CList(vs))), _ => Err(c) }
pure func len(xs: [a]) -> int = match xs { [] => 0, _ :: r => 1 + len(r) }
-- `context`: absent, or an object of at most 8 string or string-list fields.
@allow_empty_ok("absent context means no context fields")
pure func ctxOf(j: Json, c: string) -> Result[[CtxField], string] =
  if !has(j, "context") then Ok([])
  else match get(j, "context") {
    Some(o) => bind(req(asObject(o), c), \kvs. bind(check(len(kvs) <= 8, kvs, c), \_k. all(\e. bind(ctxValOf(e.value, c), \v. Ok({name: e.key, value: v})), kvs))),
    None => Err(c)
  }

-- Scenario-parameter ranges; anything outside is a schema error (bad_params).
pure func inRange(n: string, v: float) -> bool =
  if n == "epoch" then absf(v) <= 1000000.0
  else if n == "epoch_jd" then absf(v) <= 1000000000.0
  else if n == "start_age" then v >= 0.0 && v <= 1000.0
  else if n == "boost_g" then v > 0.0 && v <= 1000000000.0
  else if n == "m_eff_kg" then v > 0.0 && v <= 1.0e30
  else if n == "ism_n_cm3" then v >= 0.0 && v <= 1000000.0
  else if n == "bubble_radius_m" then v > 0.0 && v <= 1000000.0
  else if n == "glow_eps" || n == "glow_f_in" then v >= 0.0 && v <= 1.0
  else if n == "standoff_au" then v >= 0.0 && v <= 1000000.0
  else if n == "cruise_min_beta" || n == "cap_one_minus_beta" then v > 0.0 && v < 1.0
  else if n == "ai_max_open" then v >= 1.0 && v <= 64.0 && floor(v) == v
  else if n == "ai_ttl_ticks" then v >= 1.0 && v <= 1000000.0 && floor(v) == v
  else false
pure func decodeOverride(e: {key: string, value: Json}) -> Result[Override, string] =
  match e.value { JNumber(v) => check(finite(v) && inRange(e.key, v), {name: e.key, value: v}, "bad_params"), _ => Err("bad_params") }
@allow_empty_ok("absent params means no overrides; the scenario defaults apply")
pure func decodeParams(j: Json) -> Result[[Override], string] =
  if !has(j, "params") then Ok([])
  else match get(j, "params") { Some(p) => bind(req(asObject(p), "bad_params"), \kvs. all(decodeOverride, kvs)), None => Err("bad_params") }
pure func applyOverride(p: Params, o: Override) -> Params =
  if o.name == "epoch" then {p | epoch: o.value} else if o.name == "start_age" then {p | startAge: o.value}
  else if o.name == "epoch_jd" then {p | epochJd: o.value}
  else if o.name == "boost_g" then {p | boostG: o.value} else if o.name == "m_eff_kg" then {p | mEffKg: o.value}
  else if o.name == "ism_n_cm3" then {p | ismNCm3: o.value} else if o.name == "bubble_radius_m" then {p | bubbleRadiusM: o.value}
  else if o.name == "glow_eps" then {p | glowEps: o.value} else if o.name == "glow_f_in" then {p | glowFIn: o.value}
  else if o.name == "cruise_min_beta" then {p | cruiseMinBeta: o.value}
  else if o.name == "standoff_au" then {p | standoffAu: o.value}
  else if o.name == "ai_max_open" then {p | aiMaxOpen: floatToInt(o.value)} else if o.name == "ai_ttl_ticks" then {p | aiTtlTicks: floatToInt(o.value)}
  else {p | capOneMinusBeta: o.value}
pure func applyAll(p: Params, os: [Override]) -> Params = match os { [] => p, o :: r => applyAll(applyOverride(p, o), r) }

pure func envelopeOf(line: string, t: string) -> Result[Json, string] =
  match decode(line) { Ok(j) => check(getNumber(j, "v") == Some(2.0), j, "bad_v"), Err(_) => Err("bad_json") }
export pure func decodeInput(line: string) -> Result[Input, string] =
  bind(envelopeOf(line, ""), \j. match getString(j, "type") { Some(t) => inputOf(t, j), None => Err("bad_cmd") })
pure func inputOf(t: string, j: Json) -> Result[Input, string] =
    if t == "hello" then bind(req(get(j, "want"), "bad_cmd"), \w. bind(req(natF(w, "major"), "bad_cmd"), \ma. bind(req(natF(w, "minor"), "bad_cmd"), \mi. Ok(GHello({major: ma, minor: mi})))))
    else if t == "new_game" then bind(req(natF(j, "seed"), "bad_game"), \seed. bind(req(getString(j, "scenario"), "bad_game"), \sc.
      bind(check(sc == "sol" || sc == "solar_departure", sc, "bad_game"), \_s. bind(req(getBool(j, "diag"), "bad_game"), \diag. bind(decodeParams(j), \ps.
      bind(optStr(j, "ai_core", "bad_game"), \core. bind(check(match core { Some(h) => isSha256Hex(h), None => true }, core, "bad_game"), \_c.
      Ok(GNewGame({seed: seed, scenario: sc, diag: diag, params: ps, aiCore: core})))))))))
    -- ailang#1467: `\tick.` would be captured by the imported core.tick, hence `\tk.`
    else if t == "input" then bind(req(natF(j, "tick"), "bad_tick"), \tk.
      bind(req(numF(j, "dtau"), "bad_step"), \dtau. bind(check(dtau >= 0.0 && dtau <= 1.0, dtau, "bad_step"), \_d.
      bind(req(getArray(j, "intents"), "bad_intent"), \xs. bind(all(decodeIntent, xs), \is.
      Ok(GInput({tick: tk, dtau: dtau, intents: is})))))))
    else if t == "quit" then Ok(GQuit)
    else Err("bad_cmd")

-- 2.2: new_game may carry the codex table `archive: [{id, unlock}]`; an unknown hint is bad_game.
@allow_empty_ok("absent archive means an empty codex table")
pure func archiveRows(line: string) -> Result[[ArchiveRow], string] =
  match decode(line) {
    Ok(j) => if !has(j, "archive") then Ok([]) else bind(req(getArray(j, "archive"), "bad_game"), \xs. all(archiveRow, xs)),
    Err(_) => Err("bad_game")
  }
pure func archiveRow(r: Json) -> Result[ArchiveRow, string] =
  bind(req(getString(r, "id"), "bad_game"), \id. bind(req(getString(r, "unlock"), "bad_game"), \u. check(isHint(u) && length(id) >= 1 && length(id) <= 64, {id: id, unlock: u}, "bad_game")))

pure func bad() -> string = "bad_state"
pure func optF(j: Json, k: string, g: Json -> Result[a, string]) -> Result[Option[a], string] =
  match get(j, k) { Some(v) => bind(g(v), \x. Ok(Some(x))), None => Ok(None) }
pure func n(j: Json, k: string) -> Result[float, string] = req(numF(j, k), bad())
pure func decodeClock(j: Json) -> Result[Clock, string] =
  bind(n(j, "tau"), \tau. bind(n(j, "t"), \t. bind(n(j, "year"), \y. bind(n(j, "age"), \a. Ok({tau: tau, t: t, year: y, age: a})))))
pure func decodeShip(j: Json) -> Result[ShipView, string] =
  bind(req(getString(j, "phase"), bad()), \ph. bind(n(j, "beta"), \b. bind(n(j, "one_minus_beta"), \omb. bind(n(j, "gamma"), \g.
  bind(req(vecF(j, "heading"), bad()), \h. bind(req(vecF(j, "pos"), bad()), \p. bind(n(j, "x"), \x. bind(n(j, "flown"), \fl.
  Ok({phase: ph, beta: b, oneMinusBeta: omb, gamma: g, heading: h, pos: p, x: x, flown: fl})))))))))
pure func sub(j: Json, k: string, g: Json -> Result[a, string]) -> Result[a, string] = bind(req(get(j, k), bad()), g)
pure func decodeEnergy(j: Json) -> Result[Energy, string] =
  bind(n(j, "boost_j"), \b. bind(n(j, "brake_j"), \k. bind(n(j, "drag_j"), \d. bind(n(j, "total_j"), \t. bind(n(j, "total_kg"), \kg.
  Ok({boostJ: b, brakeJ: k, dragJ: d, totalJ: t, totalKg: kg}))))))
pure func decodeIsm(j: Json) -> Result[Ism, string] =
  bind(n(j, "drag_n"), \d. bind(n(j, "hold_w"), \h. bind(n(j, "load_w_m2"), \l. bind(n(j, "glow_w_m2"), \g.
  Ok({dragN: d, holdW: h, loadWM2: l, glowWM2: g})))))
pure func decodePlanView(j: Json) -> Result[PlanView, string] =
  bind(targetOf(j, bad()), \tg. bind(n(j, "distance"), \dist. bind(req(getString(j, "profile"), bad()), \prof. bind(req(getBool(j, "fell_back"), bad()), \fb.
  bind(n(j, "cruise_phi"), \phi. bind(n(j, "cruise_beta"), \cb. bind(n(j, "cruise_one_minus_beta"), \comb. bind(n(j, "cruise_gamma"), \cg.
  bind(n(j, "boost_minutes"), \bm. bind(n(j, "ship_years"), \sy. bind(n(j, "earth_years"), \ey.
  bind(n(j, "arrive_year"), \ay. bind(n(j, "age_on_arrival"), \aa. bind(n(j, "years_left"), \yl.
  bind(sub(j, "energy", decodeEnergy), \en. bind(sub(j, "ism", decodeIsm), \ism. bind(n(j, "cmb_forward_k"), \tk.
  Ok({target: tg, distance: dist, profile: prof, fellBack: fb, cruisePhi: phi, cruiseBeta: cb, cruiseOneMinusBeta: comb, cruiseGamma: cg,
      boostMinutes: bm, shipYears: sy, earthYears: ey, arriveYear: ay, ageOnArrival: aa, yearsLeft: yl, energy: en, ism: ism, cmbForwardK: tk}))))))))))))))))))
pure func decodeJourney(j: Json) -> Result[JourneyView, string] =
  bind(req(getString(j, "state"), bad()), \st. bind(req(natF(j, "plan_id"), bad()), \id. bind(optF(j, "plan", decodePlanView), \pl.
  Ok({state: st, planId: id, plan: pl}))))
pure func decodeLedger(j: Json) -> Result[LedgerView, string] =
  bind(n(j, "m_eff_kg"), \m. bind(n(j, "available_kg"), \a. bind(n(j, "radiated_j"), \r. bind(n(j, "boost_j"), \b. bind(n(j, "drag_j"), \d.
  Ok({mEffKg: m, availableKg: a, radiatedJ: r, boostJ: b, dragJ: d}))))))
pure func decodeRng(j: Json) -> Result[Rng, string] =
  bind(req(natF(j, "journey"), bad()), \a. bind(req(natF(j, "crew"), bad()), \b. bind(req(natF(j, "events"), bad()), \c.
  bind(req(natF(j, "galaxy"), bad()), \d. bind(req(natF(j, "ai"), bad()), \e. bind(req(natF(j, "news"), bad()), \g.
  Ok({journey: a, crew: b, events: c, galaxy: d, ai: e, news: g})))))))
pure func decodeDrawn(e: Json) -> Result[Drawn, string] =
  bind(req(getString(e, "stream"), bad()), \s. bind(req(natF(e, "n"), bad()), \k. bind(req(natF(e, "value"), bad()), \v. Ok({stream: s, n: k, value: v}))))
pure func decodeFullParams(j: Json) -> Result[Params, string] =
  bind(n(j, "epoch"), \e. bind(n(j, "start_age"), \sa. bind(n(j, "boost_g"), \bg. bind(n(j, "m_eff_kg"), \m. bind(n(j, "ism_n_cm3"), \ism.
  bind(n(j, "bubble_radius_m"), \r. bind(n(j, "glow_eps"), \ge. bind(n(j, "glow_f_in"), \gf. bind(n(j, "cruise_min_beta"), \cb. bind(n(j, "cap_one_minus_beta"), \cap.
  bind(natOr(j, "ai_max_open", defaultAiMaxOpen()), \mo. bind(natOr(j, "ai_ttl_ticks", defaultAiTtlTicks()), \tt.
  Ok({epoch: e, startAge: sa, boostG: bg, mEffKg: m, ismNCm3: ism, bubbleRadiusM: r, glowEps: ge, glowFIn: gf, cruiseMinBeta: cb, capOneMinusBeta: cap, aiMaxOpen: mo, aiTtlTicks: tt, standoffAu: 0.0, epochJd: defaultEpochJd()})))))))))))))
-- The AI params are echoed since 2.1 (AI.3); a 2.0 echo lacks them and reads as the defaults.
pure func natOr(j: Json, k: string, d: int) -> Result[int, string] = if has(j, k) then req(natF(j, k), bad()) else Ok(d)
pure func decodeCrossing(e: Json) -> Result[Crossing, string] =
  bind(req(getString(e, "from"), bad()), \fr. bind(req(getString(e, "to"), bad()), \to. bind(n(e, "tau"), \tau. Ok({from: fr, to: to, tau: tau}))))
pure func decodeResiduals(e: Json) -> Result[Residuals, string] =
  bind(n(e, "residual_x"), \x. bind(n(e, "residual_t"), \t. bind(n(e, "residual_phi"), \ph. Ok({x: x, t: t, phi: ph}))))
pure func optIf(e: Json, k: string, g: Json -> Result[a, string]) -> Result[Option[a], string] =
  if has(e, k) then bind(g(e), \x. Ok(Some(x))) else Ok(None)
pure func decodeEvent(e: Json) -> Result[Event, string] =
  bind(req(getString(e, "k"), bad()), \k. bind(optIf(e, "target", \x. planOf(x, bad())), \echo.
  bind(optIf(e, "from", decodeCrossing), \ph. bind(optIf(e, "residual_x", decodeResiduals), \ar. bind(optIf(e, "stream", decodeDrawn), \dr.
  bind(aiEventOf(k, e), \ae.
  Ok({kind: k, echo: echo, phase: ph, arrived: ar, drew: dr, ai: ae})))))))
pure func sOf(j: Json, k: string) -> Result[string, string] = req(getString(j, k), bad())
pure func nat(j: Json, k: string) -> Result[int, string] = req(natF(j, k), bad())
pure func decodeKey(j: Json) -> Result[CacheKey, string] =
  bind(sOf(j, "kind"), \kd. bind(sOf(j, "entity_id"), \eid. bind(sOf(j, "emotion"), \em. bind(nat(j, "age_stage"), \ag. bind(sOf(j, "variant"), \va.
  Ok({kind: kd, entityId: eid, emotion: em, ageStage: ag, variant: va}))))))
pure func decodeConstraints(j: Json) -> Result[Constraints, string] =
  bind(nat(j, "max_chars"), \mc. bind(req(getBool(j, "no_numerals"), bad()), \nn. bind(strsAt(j, "emotions", bad()), \ems.
  Ok({maxChars: mc, noNumerals: nn, emotions: ems}))))
pure func decodeAiRequest(j: Json) -> Result[AiRequest, string] =
  bind(sOf(j, "req"), \r. bind(sOf(j, "kind"), \kd. bind(sOf(j, "purpose"), \pu. bind(optStr(j, "line_req", bad()), \lr.
  bind(sub(j, "key", decodeKey), \ky. bind(nat(j, "seed"), \sd. bind(sub(j, "constraints", decodeConstraints), \cs. bind(ctxOf(j, bad()), \cx.
  bind(nat(j, "expires_tick"), \ex.
  Ok({req: r, kind: kd, purpose: pu, lineReq: lr, key: ky, seed: sd, constraints: cs, context: cx, expiresTick: ex}))))))))))
pure func decodeSeg(j: Json) -> Result[AiSeg, string] = bind(sOf(j, "emotion"), \em. bind(sOf(j, "text"), \tx. Ok({emotion: em, text: tx})))
pure func aiEventOf(k: string, e: Json) -> Result[Option[AiEvent], string] =
  if k == "ai_request" then bind(decodeAiRequest(e), \r. Ok(Some(ERequest(r))))
  else if k == "ai_fallback" then bind(sOf(e, "req"), \r. bind(sOf(e, "reason"), \why. Ok(Some(EFallback({req: r, reason: why})))))
  else if k == "ai_accepted" then bind(sOf(e, "req"), \r. bind(sOf(e, "kind"), \kd. bind(sOf(e, "sha256"), \h.
    if has(e, "descriptor") then bind(req(get(e, "descriptor"), bad()), \d. Ok(Some(EAcceptedMedia({req: r, kind: kd, sha256: h, descriptor: d}))))
    else bind(sOf(e, "text"), \tx. bind(bind(req(getArray(e, "segments"), bad()), \xs. all(decodeSeg, xs)), \sg.
      Ok(Some(EAcceptedText({req: r, kind: kd, sha256: h, text: tx, segments: sg}))))))))
  else Ok(None)
pure func decodeOpenView(j: Json) -> Result[OpenView, string] =
  bind(sOf(j, "req"), \r. bind(sOf(j, "kind"), \kd. bind(nat(j, "expires_tick"), \ex. Ok({req: r, kind: kd, expiresTick: ex}))))
pure func decodeAiView(j: Json) -> Result[AiView, string] =
  bind(nat(j, "last_req"), \lr. bind(bind(req(getArray(j, "open"), bad()), \xs. all(decodeOpenView, xs)), \op. bind(sOf(j, "core"), \co.
  Ok({lastReq: lr, open: op, core: co}))))
-- ailang#1467: lambda parameter `\tk.`, not `\tick.` (shadowed by core.tick).
-- 2.3: the inverse of encodeSystem (bad_state on any missing or mistyped field).
pure func decodeBody(j: Json) -> Result[BodyView, string] =
  bind(sOf(j, "id"), \id. bind(sOf(j, "name"), \nm. bind(sOf(j, "kind"), \kd. bind(sOf(j, "host"), \ho. bind(sOf(j, "status"), \st.
  bind(req(vecF(j, "rel_km"), bad()), \rel. bind(n(j, "radius_km"), \rk. bind(n(j, "flattening"), \fl. bind(req(vecF(j, "pole"), bad()), \po. bind(n(j, "w_deg"), \wd.
  bind(req(vecF(j, "sun_dir"), bad()), \sd. bind(n(j, "r_au"), \ra. bind(n(j, "phase_deg"), \ph. bind(n(j, "e_v_lux"), \ev. bind(n(j, "p_v"), \pv.
  bind(n(j, "minnaert_k"), \mk. bind(sOf(j, "ring_id"), \ri. bind(n(j, "light_age_s"), \la. bind(req(getBool(j, "visitable"), bad()), \vi. bind(sOf(j, "source"), \so.
  Ok({id: id, name: nm, kind: kd, host: ho, status: st, relKm: rel, radiusKm: rk, flattening: fl, pole: po, wDeg: wd, sunDir: sd, rAu: ra, phaseDeg: ph,
      eVLux: ev, pV: pv, minnaertK: mk, ringId: ri, lightAgeS: la, visitable: vi, source: so})))))))))))))))))))))
export pure func decodeSystem(text: string) -> Result[SystemView, string] =
  match decode(text) {
    Ok(j) => bind(n(j, "jd"), \jd. bind(sOf(j, "ephemeris"), \ep. bind(sOf(j, "frame"), \fr. bind(req(getArray(j, "bodies"), bad()), \bs.
      bind(all(decodeBody, bs), \bodies. Ok({jd: jd, ephemeris: ep, frame: fr, bodies: bodies})))))),
    Err(_) => Err(bad())
  }

export pure func decodeState(line: string) -> Result[StateMsg, string] =
  bind(envelopeOf(line, "state"), \j. bind(check(getString(j, "type") == Some("state"), j, bad()), \_j.
  bind(req(natF(j, "tick"), bad()), \tk. bind(req(getString(j, "status"), bad()), \st. bind(req(get(j, "changes"), bad()), \ch.
  bind(optF(ch, "clock", decodeClock), \c. bind(optF(ch, "ship", decodeShip), \s. bind(optF(ch, "journey", decodeJourney), \jy. bind(optF(ch, "ledger", decodeLedger), \lg. bind(optF(ch, "rng", decodeRng), \rg. bind(optF(ch, "params", decodeFullParams), \p. bind(optF(ch, "ai", decodeAiView), \av.
  bind(bind(req(getArray(j, "events"), bad()), \es. all(decodeEvent, es)), \evs.
  bind(bind(req(getArray(j, "refused"), bad()), \rs. all(\r. bind(req(natF(r, "i"), bad()), \i. bind(req(getString(r, "reason"), bad()), \why. Ok({i: i, reason: why}))), rs)), \refs.
  bind(req(getBool(j, "full"), bad()), \full.
  Ok({tick: tk, status: st, clock: c, ship: s, journey: jy, ledger: lg, rng: rg, params: p, ai: av, events: evs, refused: refs, full: full}))))))))))))))))
export pure func decodeHello(line: string) -> Result[HelloMsg, string] =
  bind(envelopeOf(line, "hello"), \j. bind(check(getString(j, "type") == Some("hello"), j, bad()), \_j. bind(req(get(j, "proto"), bad()), \pr.
  bind(req(natF(pr, "major"), bad()), \ma. bind(req(natF(pr, "minor"), bad()), \mi.
  bind(req(getString(j, "sim"), bad()), \sim. bind(req(getString(j, "relativity"), bad()), \rel. bind(req(getString(j, "rng"), bad()), \rng.
  Ok({major: ma, minor: mi, sim: sim, relativity: rel, rng: rng})))))))))

-- ------------------------------------------------------------ session
-- The world and its tick live in core.ail; this is the wire adapter. Diag
-- `thrust`/`heading` drive core.tick, diag `echo` (test hook) comes back as
-- an event; plan/commit/cancel follow core's journey rules (M2.3a); diag
-- draw comes back as a `draw` event (M2.4); ai_open/ai_cancel open and close
-- AI requests (sim/ai.ail, 2.1); record validates an AI result and closes its request (AI.3).
-- Malformed lines
-- (including a new_game that fails scenario validation) change nothing;
-- refused intents are listed and the tick proceeds.
-- minor: the negotiated protocol minor (2 turns on the consequence section and ship.ism).
export type Session = { hello: bool, minor: int, game: Option[World] }
export type Served = { session: Session, reply: string }

export pure func newSession() -> Session = { hello: false, minor: 0, game: None }
pure func clockOf(p: Params, s: Ship) -> Clock = { tau: s.motion.tau, t: s.motion.t, year: p.epoch + s.motion.t, age: p.startAge + s.motion.tau }
pure func shipOf(s: Ship) -> ShipView {
  let phi = s.motion.phi;
  { phase: phaseName(s.phase), beta: betaOf(phi), oneMinusBeta: oneMinusBeta(phi), gamma: gammaOf(phi), heading: s.heading, pos: position(s), x: s.motion.x, flown: s.motion.x - s.x0 }
}
pure func ledgerOf(l: Ledger) -> LedgerView = { mEffKg: l.mEffKg, availableKg: l.availableKg, radiatedJ: l.boostJ + l.dragJ, boostJ: l.boostJ, dragJ: l.dragJ }
pure func tickOf(s: Session) -> int = match s.game { Some(w) => w.tick, None => 0 }
pure func malformed(s: Session, c: string) -> Served =
  { session: s, reply: encodeState({tick: tickOf(s), status: c, clock: None, ship: None, journey: None, ledger: None, rng: None, params: None, ai: None, events: [], refused: [], full: false}) }
pure func changed(enc: a -> string, before: a, after: a) -> Option[a] = if enc(before) == enc(after) then None else Some(after)

pure func shipSection(w: World) -> string = shipWithIsm(shipOf(w.ship), ismNow(w), dragEnergyJ(w))
-- 2.2 members for a tick: ship (with ism) and consequence, each only when changed.
pure func cqExtras(before: World, after: World) -> Extras {
  let n0 = countOf(before.cq.log);
  let sb = shipSection(before);
  let sa = shipSection(after);
  { ship: if sb == sa then None else Some(sa),
    tail: if encodeCq(cqView(before), n0) == encodeCq(cqView(after), n0) then [] else [f("consequence", encodeCq(cqView(after), n0))],
    journey: navJourney(before, after) }
}
-- 2.4: a body plan's journey section (with its nav fields) when it changed; None otherwise.
pure func navJourney(before: World, after: World) -> Option[string] =
  match navOf(after) {
    None => None,
    Some(n) => { let ja = encodeJourneyNav(journeyView(after), Some(n)); if encodeJourneyNav(journeyView(before), navOf(before)) == ja then None else Some(ja) }
  }
pure func hasBodyPlan(xs: [Intent]) -> bool = match xs { [] => false, x :: r => (match x { IPlanBody(_) => true, _ => false }) || hasBodyPlan(r) }

export pure func serve(s: Session, line: string) -> Served =
  match decodeInput(line) {
    Err(c) => malformed(s, c),
    Ok(m) => match m {
      GHello(h) => { session: {s | hello: true, minor: sessionMinor(h.minor)}, reply: encodeHello(helloFor(h.minor)) },
      GQuit => { session: s, reply: "" },
      GNewGame(g) => if !s.hello then malformed(s, "no_hello") else if g.scenario == "solar_departure" && s.minor < departureMinor() then malformed(s, "bad_game") else {
        let p = applyAll(defaultParams(), g.params);
        match scenarioError(p) {
          Some(c) => malformed(s, c),
          None => match (if s.minor >= 2 then archiveRows(line) else Ok([])) {
            Err(c) => malformed(s, c),
            Ok(rows) => {
              let initial = newWorld(g.seed, g.diag, p);
              match (if g.scenario == "solar_departure" then solarInitialize(initial) else Ok(initial)) {
              Err(c) => malformed(s, c),
              Ok(w0) => {
              let w1 = {w0 | ai: {w0.ai | core: match g.aiCore { Some(h) => h, None => "" }}};
              -- below minor 2 the consequence tracking is off: the stream is exactly M2's
              let w = if s.minor >= 2 then withArchive(w1, rows) else {w1 | cq: {w1.cq | on: false}};
              let st = {tick: 0, status: "ok", clock: Some(clockOf(w.params, w.ship)), ship: Some(shipOf(w.ship)),
                journey: Some(journeyView(w)), ledger: Some(ledgerOf(w.ledger)), rng: Some(w.rng), params: Some(w.params), ai: Some(aiView(w.ai)), events: [], refused: [], full: true};
              { session: {s | game: Some(w)}, reply: if s.minor >= 2 then encodeStateX({st | ship: None}, { ship: Some(shipSection(w)), tail: [f("consequence", encodeCq(cqView(w), 0))] ++ systemFull(s, w) ++ (if g.scenario == "solar_departure" then [f("solar_departure", solarTour(w.params))] else []), journey: None }) else encodeState(st) }
              }
              }
            }
          }
        }
      },
      GInput(i) => if !s.hello then malformed(s, "no_hello") else match s.game {
        None => malformed(s, "no_game"),
        Some(w) => if i.tick != w.tick + 1 then malformed(s, "bad_tick") else if s.minor < navMinor() && hasBodyPlan(i.intents) then malformed(s, "bad_intent") else {
          let t = tick(w, {dtau: i.dtau, intents: i.intents});
          let next = t.world;
          let state = { tick: next.tick, status: "ok", clock: changed(encodeClock, clockOf(w.params, w.ship), clockOf(next.params, next.ship)),
            ship: changed(encodeShip, shipOf(w.ship), shipOf(next.ship)), journey: changed(encodeJourney, journeyView(w), journeyView(next)),
            ledger: changed(encodeLedger, ledgerOf(w.ledger), ledgerOf(next.ledger)), rng: changed(encodeRng, w.rng, next.rng), params: None,
            ai: changed(encodeAiView, aiView(w.ai), aiView(next.ai)), events: t.events, refused: t.refused, full: false };
          { session: {s | game: Some(next)}, reply: if s.minor >= 2 then encodeStateX({state | ship: None}, withSystem(s, w, next, withDeparture(s, w, next, cqExtras(w, next)))) else encodeState(state) }
        }
      }
    }
  }
