module stapledons/sim/protocol_crew

-- R2-CREW C2 (design crew-integration.md §CI-1 "Protocol 2.x minor", AC6): the crew intents and
-- the `crew` state section. An intent carries exactly one crew_core input line; the sim checks
-- that its command matches the intent, then crew_core validates it (sim/crew.ail crewCommand).
-- A refusal is "crew:<crew_core error>". The sim never reads AI text here: crew words arrive only
-- through `record` (D-20).
--   crew_offer  offer       a task to one crew member (captain)
--   crew_ask    ask         the captain asks; the crew member answers at once (authored, SCrew)
--   crew_start  start_task  start agreed (consent) or ordered (orders) work
--   crew_relief resolve_relief  grant or deny a relief request
--   crew_cancel cancel_request  withdraw an open request
--   crew_reply  captain_reply   answer a crew concern (conversations)
--   crew_policy policy          switch consent and orders (C3, D-70 OQ5; journalled by crew_core)
--   crew_orders orders          C8: the auto-run preset {"preset": off | critical_only | hands_on} (the sim's)
--   crew_resume resume          C8: the captain has dealt with a hold {"hold": id} (the sim's)
import std/string (concat, join, intToStr, startsWith)
import std/math (intToFloat)
import std/list (map, filter, take, reverse, length, foldl, contains, any)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/json (Json, JNull, JObject, decode, getString, encode, jo, ja, kv, js, jnum)
import pkg/sunholo/crew_core/session (Session, Request, Bank, moot)
import pkg/sunholo/crew_core/conversations (Issue, Suggestion, suggestions)
import pkg/sunholo/social_dynamics/model (State, Actor, Value, Task, TaskStatus, Offered, Working, Completed, Stopped, Relief, Evidence, Resource)
import ./crew (CrewState, CrewCmd, CrewLine, CrewName, CrewHold, crewTurn, workTerms)
import ./crew_names (nameOf)
import ./crew_resources (usedOf)
import pkg/sunholo/crew_core/units (Amount)

export pure func crewIntentNames() -> [string] =
  ["crew_offer", "crew_ask", "crew_start", "crew_relief", "crew_cancel", "crew_reply", "crew_policy", "crew_orders", "crew_resume"]

-- The crew_core command each intent may carry.
export pure func commandFor(kind: string) -> Option[string] =
  if kind == "crew_offer" then Some("offer") else if kind == "crew_ask" then Some("ask")
  else if kind == "crew_start" then Some("start_task") else if kind == "crew_relief" then Some("resolve_relief")
  else if kind == "crew_cancel" then Some("cancel_request") else if kind == "crew_reply" then Some("captain_reply")
  else if kind == "crew_policy" then Some("policy")
  else if kind == "crew_orders" then Some("orders") else if kind == "crew_resume" then Some("resume")
  else None

export pure func refusalReason(e: string) -> string = concat(["crew:", e])

-- Decode an intent's line. Err is the refusal reason ("bad_intent" for a malformed line, so the
-- shape errors stay the protocol's; crew_core's own errors come later as crew:<error>).
export pure func decodeCrewIntent(kind: string, line: string) -> Result[CrewCmd, string] = match commandFor(kind) {
  None => Err("bad_intent"),
  Some(cmd) => match decode(line) {
    Err(_) => Err("bad_intent"),
    Ok(j) => if getString(j, "command") != Some(cmd) then Err("bad_intent")
      else Ok({ kind: kind, line: line, askId: if cmd == "ask" then getString(j, "id") else None, asMode: "", startMode: "" })
  }
}
-- R2-CREW-CONSOLE-V2 V1 (protocol 2.11): the envelope fields beside the line. `as` ("consent" or
-- "orders") only on crew_start; `start` ("on_accept" or "now") only on crew_offer; "" is absent.
-- Anything else is bad_intent (the minor gate is the protocol's: sim/protocol.ail serve).
export pure func decodeCrewEnvelope(kind: string, line: string, asMode: string, startMode: string) -> Result[CrewCmd, string] =
  if asMode != "" && (kind != "crew_start" || (asMode != "consent" && asMode != "orders")) then Err("bad_intent")
  else if startMode != "" && (kind != "crew_offer" || (startMode != "on_accept" && startMode != "now")) then Err("bad_intent")
  else match decodeCrewIntent(kind, line) {
    Err(e) => Err(e),
    Ok(c) => Ok({ c | asMode: asMode, startMode: startMode })
  }
export pure func hasEnvelope(c: CrewCmd) -> bool = c.asMode != "" || c.startMode != ""

-- ------------------------------------------------------------------ the `crew` state section
-- Compact by design: crew_core's own trace is ~40 KB a line. Godot reads only these fields.
--   turn, captaincy
--   members  [{id, indicators {id: value}, trust (in the captain), work {task, recipe, status} | null, regard_low [{to, value}]}]
--   requests [{id, actor, task, legal [label]}]   open asks awaiting the captain's side
--   reliefs  [{id, task, author}]                 unresolved relief requests
--   heard    [{id, author, kind, text}]           the latest heardMax evidence lines, oldest first
--   resources [{id, available, reserved, consumed}]
--   used     [{id, units, amount, physical}]      consumed stock in physical units (C3 crew.used readout)
--   auto     the auto-run preset ("off" when none); holds [{id, rule, actor, name, task, tick, detail}] (C8)
--   (2.10: each member and line also carries `emotion`, emotionOf below)
--   lines    [{request, actor, name, label, text, ai_req}]  C5: the latest answers. `text` is the
--            authored template line for the decided reaction; Godot shows it until the ai_request
--            `ai_req` is accepted, then the AI words ("" ai_req: the template stands).
export pure func heardMax() -> int = 6
-- Regard is shown only when it is low (design CI-4: "regard shown only when it is low").
export pure func regardLow() -> int = 30

pure func valuesObj(vs: [Value]) -> Json = jo(map(\v. kv(v.id, jnum(intToFloat(v.value))), vs))
pure func statusName(t: TaskStatus) -> string = match t { Offered => "offered", Working => "working", Completed => "completed", Stopped => "stopped" }
pure func live(t: Task) -> bool = match t.status { Offered => true, Working => true, _ => false }

-- Live work, with its start and due turns (the Crew console shows "day k of n").
pure func workOf(st: State, id: string) -> Json = match filter(\t. live(t) && contains(t.participants, id), st.tasks) {
  t :: _ => jo([kv("task", js(t.id)), kv("recipe", js(t.recipe)), kv("status", js(statusName(t.status))),
    kv("started", jnum(intToFloat(t.started))), kv("due", jnum(intToFloat(t.due)))]),
  [] => JNull
}
-- The member's most recently finished work (the latest due turn among completed tasks), or null.
pure func doneOf(st: State, id: string) -> Json =
  match foldl(\acc t. match acc { Some(b) => if t.due >= b.due then Some(t) else acc, None => Some(t) }, None,
    filter(\t. t.status == Completed && contains(t.participants, id), st.tasks)) {
    Some(t) => jo([kv("task", js(t.id)), kv("recipe", js(t.recipe)), kv("at", jnum(intToFloat(t.due)))]),
    None => JNull
  }
pure func regardOf(st: State, id: string) -> Json =
  ja(map(\r. jo([kv("to", js(r.to)), kv("value", jnum(intToFloat(r.value)))]),
    filter(\r. r.from == id && r.dimension == "regard" && r.value < regardLow(), st.relationships)))
-- Trust in the captain is a relationship (member -> captain, dimension "trust"), not an indicator.
pure func trustOf(st: State, id: string) -> Json = match filter(\r. r.from == id && r.to == "captain" && r.dimension == "trust", st.relationships) {
  r :: _ => jnum(intToFloat(r.value)),
  [] => JNull
}
pure func memberObj(st: State, names: [CrewName], a: Actor) -> Json =
  jo([kv("id", js(a.id)), kv("name", js(match nameOf(names, a.id) { Some(n) => n, None => a.id })), kv("indicators", valuesObj(a.indicators)), kv("trust", trustOf(st, a.id)), kv("work", workOf(st, a.id)), kv("done", doneOf(st, a.id)), kv("regard_low", regardOf(st, a.id))])
-- 2.10: the face each member shows (their latest line's label and their stress).
pure func memberObjE(c: CrewState, a: Actor) -> Json = match memberObj(c.session.state, c.names, a) {
  JObject(kvs) => JObject(kvs ++ [kv("emotion", js(emotionOf(latestLabel(c.lines, a.id, ""), stressIn(a))))]),
  j => j
}
pure func requestObj(q: Request) -> Json =
  jo([kv("id", js(q.id)), kv("actor", js(q.actor)), kv("task", js(q.task)), kv("legal", ja(map(js, q.legal)))])
pure func reliefObj(r: Relief) -> Json = jo([kv("id", js(r.id)), kv("task", js(r.task)), kv("author", js(r.author))])
pure func evidenceObj(e: Evidence) -> Json = jo([kv("id", js(e.id)), kv("author", js(e.author)), kv("kind", js(e.kind)), kv("text", js(e.text))])
pure func resourceObj(r: Resource) -> Json =
  jo([kv("id", js(r.id)), kv("available", jnum(intToFloat(r.available))), kv("reserved", jnum(intToFloat(r.reserved))), kv("consumed", jnum(intToFloat(r.consumed)))])
pure func lastN(xs: [a], n: int) -> [a] = reverse(take(n, reverse(xs)))

-- C5 fallback words: one authored line per reaction, in-world (D-67), no numerals (D-21). The
-- content_library starter text is a test placeholder, so the game keeps its own table.
export pure func templateLine(label: string) -> string =
  if label == "accept" then "I'll take it on, Captain."
  else if label == "decline" then "Not this one, Captain. I can't take it on."
  else if label == "concern" then "Before I start, there's something about this that worries me."
  else if label == "request_relief" then "I need to step back from this for a while."
  else if label == "captain_ask_advice" then "You asked what I think. I'll tell you straight, Captain."
  else if label == "captain_clear_scope" then "That makes the job clearer. I can work with that."
  else if label == "captain_explain_priority" then "I see why it matters now."
  else if label == "captain_stage_plan" then "A step at a time, then. That I can do."
  else if label == "captain_assert_authority" then "Understood, Captain. I'll do it."
  else if label == "continue" then "I can keep going for now."
  else if label == "defer" then "Let me think about it before I answer."
  else "I hear you, Captain."
-- R2-INTERLUDE I2: a face's emotion (D-7's eight), moved here from ui/crew_page.gd (LABEL_EMOTION,
-- STRAINED_LABELS, WARM_LABELS, STRAINED): a decline shows anger, a concern fear; asking to step
-- back, or stress at the strained line (the pack's overextended threshold), sadness; accepting,
-- happiness; anything else is neutral. Godot keeps only the portrait fallback list.
export pure func strainedAt() -> int = 70
export pure func emotionOf(label: string, stress: int) -> string =
  if label == "decline" then "angry" else if label == "concern" then "fearful"
  else if label == "request_relief" || stress >= strainedAt() then "sad"
  else if label == "accept" then "happy" else "neutral"
pure func stressIn(a: Actor) -> int = match filter(\v. v.id == "stress", a.indicators) { v :: _ => v.value, [] => 0 }
pure func latestLabel(ls: [CrewLine], id: string, acc: string) -> string = match ls { [] => acc, l :: r => latestLabel(r, id, if l.actor == id then l.label else acc) }
pure func actorStress(st: State, id: string) -> int = match filter(\a. a.id == id, st.actors) { a :: _ => stressIn(a), [] => 0 }
-- The crew_hold event's `hold` (2.9, C8): the hold as stored (names live in the crew section).
export pure func crewHoldJson(h: CrewHold) -> string =
  encode(jo([kv("id", js(h.id)), kv("rule", js(h.rule)), kv("actor", js(h.actor)), kv("task", js(h.task)), kv("tick", jnum(intToFloat(h.tick))), kv("detail", js(h.detail))]))
export pure func holdObj(c: CrewState, h: CrewHold) -> Json =
  jo([kv("id", js(h.id)), kv("rule", js(h.rule)), kv("actor", js(h.actor)), kv("name", js(match nameOf(c.names, h.actor) { Some(n) => n, None => h.actor })),
    kv("task", js(h.task)), kv("tick", jnum(intToFloat(h.tick))), kv("detail", js(h.detail))])
-- A hold in words, after the crew member's name (D-21: no digits). One source (R2-INTERLUDE I3):
-- the crew view's holds carry it at 2.10 (`line`), and the cruise digest's hold moments use it, so
-- the Crew page and the crossing review's Hold page read the same words.
export pure func holdLine(rule: string) -> string =
  if rule == "breakdown" then "is close to breaking down."
  else if rule == "trust_floor" then "has lost trust in you."
  else if rule == "refusal_under_orders" then "refused an order."
  else if rule == "major" then "is shaken by news the whole ship heard."
  else if rule == "argument" then "is arguing with the crew over what the ship lost."
  else if rule == "uncovered" then "has raised something only you can answer."
  else if rule == "stuck" then "is stuck: the same thing keeps failing, and auto-run can't get past it."
  else "needs the captain."
pure func holdObjE(c: CrewState, h: CrewHold) -> Json = match holdObj(c, h) {
  JObject(kvs) => JObject(kvs ++ [kv("line", js(holdLine(h.rule)))]),
  j => j
}
pure func lineObj(c: CrewState, l: CrewLine) -> Json =
  jo([kv("request", js(l.request)), kv("actor", js(l.actor)), kv("name", js(match nameOf(c.names, l.actor) { Some(n) => n, None => l.actor })),
    kv("label", js(l.label)), kv("text", js(templateLine(l.label))), kv("ai_req", js(l.aiReq))])
pure func lineObjE(c: CrewState, l: CrewLine) -> Json = match lineObj(c, l) {
  JObject(kvs) => JObject(kvs ++ [kv("emotion", js(emotionOf(l.label, actorStress(c.session.state, l.actor))))]),
  j => j
}

-- crew_core 0.4.1: open concerns the captain can still answer (not moot: the offer still stands
-- and its agreement hasn't lapsed), with crew_core's suggested reply for each approach. The page
-- answers with crew_reply (captain_reply: id, issue, text, approach, tick, revision).
pure func concernObj(i: Issue) -> Json =
  jo([kv("issue", js(i.id)), kv("actor", js(i.worker)), kv("task", js(i.task)), kv("kind", js(i.kind)), kv("prompt", js(i.prompt)),
    kv("replies", jnum(intToFloat(i.replyCount))),
    kv("options", ja(map(\o. jo([kv("approach", js(o.approach)), kv("text", js(o.text))]), suggestions(i, 1))))])
pure func concernsOf(s: Session) -> [Issue] = filter(\i. i.status == "open" && !moot(s, i), s.chat.issues)

-- ------------------------------------------------------------------ R2-CREW-CONSOLE-V2 V1
-- The sim names each member's work state (design crew-console-v2.md §V1; D-20: the page decides
-- nothing). Precedence is top-down; the first match wins. stand_down_asked is crew_core 0.6's and
-- is inactive below it (V8); resting is live work whose recipe starts rest_ until then.
export pure func workStates() -> [string] =
  ["held", "stand_down_asked", "relief_asked", "concern", "declined", "deferred", "asked", "agreed", "offered", "resting", "working", "done", "stopped", "free"]
pure func liveOf(st: State, id: string) -> Option[Task] = match filter(\t. live(t) && contains(t.participants, id), st.tasks) { t :: _ => Some(t), [] => None }
-- An offer's agreement is active and accepted by both, and not yet due (crew_core consent()).
pure func agreedOn(s: Session, task: string) -> bool = match filter(\b. b.task == task, s.bindings) {
  b :: _ => any(\k. k.id == b.agreement && k.active && k.accepted == k.parties && k.due > s.state.tick, s.state.commitments),
  [] => false
}
-- An open issue's latest answer: the line that answered its request, else crew_core's bank entry.
pure func issueLabel(c: CrewState, i: Issue) -> string = match filter(\l. l.request == i.request, c.lines) {
  l :: _ => l.label,
  [] => match filter(\b. b.request.id == i.request, c.session.bank) { b :: _ => if b.selected == "" then "concern" else b.selected, [] => "concern" }
}
-- A pending ask counts only while its task is still an offer: a reconsideration left pending when
-- the captain ordered the work started is moot (the work is under way).
pure func offeredTask(st: State, task: string) -> bool = any(\t. t.id == task && t.status == Offered, st.tasks)
pure func issueState(label: string) -> string = if label == "decline" then "declined" else if label == "defer" then "deferred" else "concern"
pure func finishedLatest(st: State, id: string) -> Option[Task] =
  foldl(\acc t. match acc { Some(b) => if t.due >= b.due then Some(t) else acc, None => Some(t) }, None,
    filter(\t. (t.status == Completed || t.status == Stopped) && contains(t.participants, id), st.tasks))
export pure func workState(c: CrewState, id: string) -> string
  ensures { contains(workStates(), result) }
{
  let s = c.session;
  let st = s.state;
  if any(\h. h.actor == id, c.holds) then "held"
  else if any(\r. !r.resolved && r.author == id, st.reliefs) then "relief_asked"
  else match filter(\i. i.worker == id, concernsOf(s)) {
    i :: _ => issueState(issueLabel(c, i)),
    [] => if any(\q. q.actor == id && offeredTask(st, q.task), s.pending) then "asked" else match liveOf(st, id) {
      Some(t) => if t.status == Offered then (if agreedOn(s, t.id) then "agreed" else "offered")
        else if startsWith(t.recipe, "rest_") then "resting" else "working",
      None => match finishedLatest(st, id) { Some(t) => if t.status == Stopped then "stopped" else "done", None => "free" }
    }
  }
}
-- At 2.11 a member carries work_state, and working work its start terms.
pure func memberObjC(c: CrewState, a: Actor) -> Json = match memberObjE(c, a) {
  JObject(kvs) => JObject(map(\p. if p.key == "work" then { key: p.key, value: withTerms(c.session, p.value) } else p, kvs) ++ [kv("work_state", js(workState(c, a.id)))]),
  j => j
}
pure func withTerms(s: Session, w: Json) -> Json = match w {
  JObject(kvs) => match getString(w, "task") {
    Some(t) => if getString(w, "status") == Some("working") && workTerms(s, t) != "" then JObject(kvs ++ [kv("terms", js(workTerms(s, t)))]) else w,
    None => w
  },
  _ => w
}

export pure func crewView(c: CrewState) -> string = crewViewWith(c, false)
-- emotions (protocol 2.10, R2-INTERLUDE I2): members and lines carry `emotion`, the face Godot shows;
-- holds carry `line`, their words (I3).
export pure func crewViewWith(c: CrewState, emotions: bool) -> string = crewViewAt(c, emotions, false)
-- console (protocol 2.11, R2-CREW-CONSOLE-V2 V1): members carry `work_state`, working work `terms`.
export pure func crewViewAt(c: CrewState, emotions: bool, console: bool) -> string {
  let s = c.session;
  let st = s.state;
  encode(jo([
    kv("turn", jnum(intToFloat(crewTurn(c)))), kv("captaincy", js(s.command)),
    kv("members", ja(map(\a. if console then memberObjC(c, a) else if emotions then memberObjE(c, a) else memberObj(st, c.names, a), filter(\a. a.id != "captain", st.actors)))),
    kv("requests", ja(map(requestObj, s.pending))),
    kv("reliefs", ja(map(reliefObj, filter(\r. !r.resolved, st.reliefs)))),
    kv("heard", ja(map(evidenceObj, lastN(filter(\e. e.author != "host", st.evidence), heardMax())))),
    kv("resources", ja(map(resourceObj, st.resources))),
    kv("lines", ja(map(\l. if emotions then lineObjE(c, l) else lineObj(c, l), c.lines))),
    kv("auto", js(match c.auto { Some(a) => a.preset, None => "off" })),
    kv("holds", ja(map(\h. if emotions then holdObjE(c, h) else holdObj(c, h), c.holds))),
    kv("used", ja(map(\u. jo([kv("id", js(u.id)), kv("units", jnum(intToFloat(u.units))), kv("amount", jnum(intToFloat(u.amount))), kv("physical", js(u.physical))]),
      usedOf(map(\r. { id: r.id, value: r.consumed }, filter(\r. r.consumed > 0, st.resources)))))),
    kv("tick", jnum(intToFloat(st.tick))), kv("revision", jnum(intToFloat(st.revision))),
    kv("concerns", ja(map(concernObj, concernsOf(s))))
  ]))
}
