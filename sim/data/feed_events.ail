module stapledons/sim/data/feed_events

-- R3-EARTH-LINK EL3b (design r3/earth-link.md EL3b; Mark, attended 2026-10-28): the catalogue of
-- Earth's events the comms feed shows, one per Earth week of the newest light. Home's own news at
-- the scale a voyage receives (weeks to a couple of centuries; the home-time tiers 0-8 of
-- sim/home_tiers.ail), never the ship (no plan, port or crew): "its news from home, outside the
-- bubble". A row fits the weeks whose era tier is in [minTier, maxTier].
--
-- words: the caption chip, two to seven words, no digits (D-21), in the news voice, never judging
-- (Pillar 2). The picture prompts and the shipped pictures are data/feed/events.json and
-- data/feed/SOURCES; `make feed-art-check` checks their ids against ids() here.
import std/list (map)
import std/string (join)

export type FeedEvent = { id: string, category: string, minTier: int, maxTier: int, words: string }

pure func ev(id: string, category: string, minTier: int, maxTier: int, words: string) -> FeedEvent =
  { id: id, category: category, minTier: minTier, maxTier: maxTier, words: words }

-- The ids one per line, for make feed-art-check (events.json and data/feed/SOURCES name the same).
export pure func feedIdsText(_u: int) -> string = join("\n", map(\e. e.id, feedEvents()))

export pure func categories() -> [string] = ["family", "home", "town", "world", "science", "sky"]

