-- The LIC: a star-shaped surface about its centre (Linsky et al. 2019 Table 3), r = sum a_lm Y_lm,
-- coefficients refit to their Table 2 (ism-structure.md section 3), order (0,0) (1,-1) (1,0) (1,1) (2,-2) (2,-1) (2,0) (2,1) (2,2).
export pure func licCentre() -> V3 = dataV3(-2.6092510217339466, 2.2830946440172033, -1.3046255108669733)
export pure func licCoeffs() -> [float] = [16.653613804929844, 1.4284835015808168, -0.5060109650692936, 0.7054920631413317, -0.5878545062092428, -0.5205307255394859, -0.2025123096755665, -1.8946689113206596, 2.2229180344224786]

