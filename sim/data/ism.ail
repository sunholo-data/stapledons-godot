module stapledons/sim/data/ism

-- GENERATED by sim/tools/ism_build.ail from data/ism/sources/*.tsv (make ism-data). Do not edit.
-- The lism-1 interstellar medium (stapledons-design physics/ism-structure.md, ledger D-60/D-61).
-- Lengths in light years, heliocentric galactic Cartesian (x to the Galactic centre, z north).
-- Every scalar is a Field with its provenance; the plain accessors are the Fields' values.

export type Field = { value: float, prov: string, cite: string }
export type V3 = { x: float, y: float, z: float }
-- A Redfield & Linsky 2008 cloud as a cone shell, apex at the Sun (a game approximation, labelled).
export type Cloud = { name: string, axis: V3, cosHalf: float, rIn: float, rOut: float, nH: float, delta: float, cite: string }
-- A Redfield & Linsky 2008 Tables 1-15 member within 15 pc (SIMBAD ICRS -> galactic), with its assigned cloud (AC6a).
export type Member = { cloud: string, star: string, pos: V3 }

export pure func ismModelName() -> string = "lism-1"

export pure func ismFields() -> [(string, Field)] = [
  ("n_hi_warm", { value: 0.192, prov: "measured", cite: "Slavin & Frisch 2008 model 26, solar location (IS-16)" }),
  ("n_p_warm", { value: 0.0554, prov: "measured", cite: "Slavin & Frisch 2008 model 26 (IS-17)" }),
  ("n_h_warm", { value: 0.2474, prov: "inferred", cite: "n_HI + n_p (IS-18)" }),
  ("n_e_hot", { value: 0.00468, prov: "measured", cite: "Snowden et al. 2014 ApJ 791 L14 (IS-19)" }),
  ("n_h_hot", { value: 0.0039000000000000003, prov: "inferred", cite: "n_e / 1.2, fully ionised H and He (IS-20)" }),
  ("rho_dust_lic", { value: 2.1e-24, prov: "measured", cite: "Krueger et al. 2015 ApJ 812 139 section 5.3, kg m^-3 (IS-21)" }),
  ("m_h", { value: 1.6735575e-27, prov: "constant", cite: "hydrogen atom mass, CODATA 2018, kg" }),
  ("delta_local", { value: 0.005071996685000932, prov: "inferred", cite: "rho_d / (n_H m_H), dust mass per H nucleon (IS-22)" }),
  ("delta_dense", { value: 0.01, prov: "measured", cite: "Draine 2011, M_dust / M_H (IS-23)" }),
  ("mu_h", { value: 1.4, prov: "measured", cite: "Draine 2011 Table 1.4, gas mass per H nucleon (IS-24)" }),
  ("n_hi_edge", { value: 0.2, prov: "measured", cite: "Linsky et al. 2019 section 4; RL08: n_HI for path lengths (IS-15)" }),
  ("grain_rho", { value: 3300.0, prov: "measured", cite: "Krueger et al. 2015 section 6, kg m^-3 (HB-113)" }),
  ("grain_a_min", { value: 5e-9, prov: "measured", cite: "Mathis, Rumpl & Nordsieck 1977, m (HB-114)" }),
  ("grain_a_break", { value: 2.5e-7, prov: "measured", cite: "Mathis, Rumpl & Nordsieck 1977, m (HB-115)" }),
  ("grain_a_max", { value: 8.977026012029016e-06, prov: "inferred", cite: "radius of 1e-11 kg (Krueger 2015 detector limit) at 3,300 kg m^-3, m (HB-116; scenario parameter)" }),
  ("grain_q", { value: 3.1, prov: "inferred", cite: "tail slope maximising the >= 1e-13 kg flux under the mass constraint (HB-117)" }),
  ("lic_median_residual_pc", { value: 0.3781764242135064, prov: "inferred", cite: "refit vs Linsky et al. 2019 Table 2, 63.0 rows (IS-13)" })
]

