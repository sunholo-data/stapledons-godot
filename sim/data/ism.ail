-- In precedence order (first match wins; the LIC and then the hot gas come after).
export pure func clouds() -> [Cloud] = [
cloudG(),
cloudBlue(),
cloudAql(),
cloudEri(),
cloudAur(),
cloudHyades(),
cloudMic(),
cloudOph(),
cloudGem(),
cloudNGP(),
cloudLeo(),
cloudDor(),
cloudVel(),
cloudCet()
]
-- Cheap runtime metadata: planes are loaded only after conservative bounds pass.
export pure func cloudMetas() -> [Cloud] = [
cloudMetaG(),
cloudMetaBlue(),
cloudMetaAql(),
cloudMetaEri(),
cloudMetaAur(),
cloudMetaHyades(),
cloudMetaMic(),
cloudMetaOph(),
cloudMetaGem(),
cloudMetaNGP(),
cloudMetaLeo(),
cloudMetaDor(),
cloudMetaVel(),
cloudMetaCet()
]
export pure func hasOutline(name: string) -> bool = match name {
"G" => true,
"Blue" => true,
"Aql" => true,
"Eri" => true,
"Aur" => true,
"Hyades" => true,
"Mic" => true,
"Oph" => true,
"Gem" => true,
"NGP" => true,
"Leo" => true,
"Dor" => true,
"Vel" => true,
"Cet" => true,
_ => false }
export pure func cloudPlanesFor(name: string) -> [[V3]] = match name {
"G" => cloudPlanesG(),
"Blue" => cloudPlanesBlue(),
"Aql" => cloudPlanesAql(),
"Eri" => cloudPlanesEri(),
"Aur" => cloudPlanesAur(),
"Hyades" => cloudPlanesHyades(),
"Mic" => cloudPlanesMic(),
"Oph" => cloudPlanesOph(),
"Gem" => cloudPlanesGem(),
"NGP" => cloudPlanesNGP(),
"Leo" => cloudPlanesLeo(),
"Dor" => cloudPlanesDor(),
"Vel" => cloudPlanesVel(),
"Cet" => cloudPlanesCet(),
_ => [] }
