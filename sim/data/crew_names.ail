module stapledons/sim/data/crew_names

-- R2-CREW C5, ledger D-74 (Mark, 2026-10-13): "we will name them, generated from a big list of
-- international name combinations". Common given and family names, romanised, grouped by region so
-- that a generated name pairs a given and a family name from the same naming tradition. The pick is
-- seeded per new game (sim/crew_names.ail); role ids stay the internal entity_id (D-70 OQ2).
-- Adding names only widens the pool; reordering changes which names a seed gives.
export type NameRegion = { region: string, given: [string], family: [string] }

