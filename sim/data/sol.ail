pure func neptunian() -> [Moon] = [
  -- NEP097: P is sidereal; Triton is retrograde (i 157.3 deg), so its node advances.
  -- JPL tabulates P node 340.379 yr, half the ~688 yr pole precession that the
  -- IAU N7 term (52.316 deg/century) and Neptune's J2 imply; transcribed as published.
  moon("triton", "Triton", "neptune", jplSat(354800.0, 0.000, 0.0, 63.0, 157.3, 178.1, 5.876994, 0.0, 340.379, 299.8, 43.1, true, 1.0, 1.0),
    pole(299.36, 0.0, 41.17, 0.0, 296.53, 0.0 - 61.2572637, 0.0,
      [term(177.85, 52.316, 0.0 - 32.35, 22.55, 22.25), term(355.70, 104.632, 0.0 - 6.28, 2.10, 6.73), term(533.55, 156.948, 0.0 - 2.08, 0.55, 2.05),
       term(711.40, 209.264, 0.0 - 0.74, 0.16, 0.74), term(889.25, 261.580, 0.0 - 0.28, 0.05, 0.28), term(1067.10, 313.896, 0.0 - 0.11, 0.02, 0.11),
       term(1244.95, 366.212, 0.0 - 0.07, 0.01, 0.05), term(1422.80, 418.528, 0.0 - 0.02, 0.0, 0.02), term(1600.65, 470.844, 0.0 - 0.01, 0.0, 0.01)]),
    1352.6, 1352.6, 1428.495462910464, 0.72)
]

-- Ring profiles in the host's equatorial plane, km (celestial's RingBand).
pure func band(rIn: float, rOut: float, tau: float, w0: float) -> RingBand = { rIn: rIn, rOut: rOut, tau: tau, w0: w0 }
-- A narrow ring tabulated by radius and width.
pure func narrow(r: float, width: float, tau: float, w0: float) -> RingBand = band(r - width / 2.0, r + width / 2.0, tau, w0)

export pure func rings() -> [Ring] = [
  -- Saturn: D, C, B (B1..B5: inner, core B3), Cassini Division, A with the Encke gap, F (PDS);
  -- w0 = NSSDC particle albedo (D has none: C's value).
  { host: "saturn", names: ["D", "C", "B1", "B2", "B3 core", "B4", "B5", "Cassini Division", "A inner", "A outer", "F"],
    bands: [band(66900.0, 74491.0, 0.0001, 0.21), band(74491.0, 91975.0, 0.2, 0.21), band(91975.0, 99000.0, 1.3, 0.5),
            band(99000.0, 104000.0, 2.75, 0.5), band(104000.0, 110000.0, 3.6, 0.5), band(110000.0, 116500.0, 2.5, 0.5),
            band(116500.0, 117570.0, 2.75, 0.5), band(117570.0, 122050.0, 0.1, 0.3), band(122050.0, 133423.0, 0.7, 0.5),
            band(133745.0, 136770.0, 0.7, 0.5), band(139826.0, 140612.0, 0.105, 0.6)],
    tint: { r: 0.83, g: 0.77, b: 0.66 }, cite: "pds-rings", tauCite: "pds-rings", w0Cite: "nssdc-rings", tintCite: "tint-design" },
  -- Jupiter: halo, main, gossamer (Amalthea, Thebe). Only the main ring has a tabulated albedo.
  { host: "jupiter", names: ["halo", "main", "Amalthea gossamer", "Thebe gossamer"],
    bands: [band(89400.0, 123000.0, 0.000003, 0.015), band(123000.0, 128940.0, 0.000005, 0.015),
            band(128940.0, 181350.0, 0.0000001, 0.015), band(181350.0, 221900.0, 0.0000001, 0.015)],
    tint: { r: 0.60, g: 0.45, b: 0.35 }, cite: "nssdc-rings", tauCite: "nssdc-rings", w0Cite: "w0-assumed", tintCite: "tint-design" },
  -- Uranus: 6, 5, 4, alpha, beta, eta, gamma, delta, epsilon (radius +- width/2; albedo x 1e-3).
  { host: "uranus", names: ["6", "5", "4", "alpha", "beta", "eta", "gamma", "delta", "epsilon"],
    bands: [narrow(41837.0, 1.5, 0.3, 0.015), narrow(42234.0, 2.0, 0.5, 0.015), narrow(42571.0, 2.0, 0.3, 0.015),
            narrow(44718.0, 7.0, 0.4, 0.015), narrow(45661.0, 8.0, 0.3, 0.015), narrow(47176.0, 1.6, 0.4, 0.015),
            narrow(47627.0, 2.5, 0.3, 0.015), narrow(48300.0, 5.0, 0.5, 0.015), narrow(51149.0, 58.0, 1.4, 0.018)],
    tint: { r: 0.40, g: 0.40, b: 0.40 }, cite: "nssdc-rings", tauCite: "nssdc-rings", w0Cite: "nssdc-rings", tintCite: "tint-design" },
  -- Neptune: Galle, Le Verrier, Lassell (out to Arago), Arago, Adams. Widths "< 100" use 100 km;
  -- Arago has no tabulated tau (Lassell's is used). The Adams arcs (tau 0.12) are not modelled here.
  { host: "neptune", names: ["Galle", "Le Verrier", "Lassell", "Arago", "Adams"],
    bands: [narrow(41900.0, 2000.0, 0.0001, 0.015), narrow(53200.0, 100.0, 0.01, 0.015), band(53250.0, 57150.0, 0.0001, 0.015),
            narrow(57200.0, 100.0, 0.0001, 0.015), narrow(62933.0, 15.0, 0.055, 0.015)],
    tint: { r: 0.55, g: 0.42, b: 0.38 }, cite: "nssdc-rings", tauCite: "nssdc-rings", w0Cite: "nssdc-rings", tintCite: "tint-design" }
]
