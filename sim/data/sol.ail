-- A JPL SSD satellite row as tabulated: a (km), e, w, M, i, node (deg), P (d),
-- P apsis and P node (yr, magnitudes), Laplace pole RA/Dec (deg). The trap in
-- the celestial AGENT.md: P is the sidereal period in some tables (Moon,
-- SAT441, NEP097) and the anomalistic one in JUP365, and the rates' signs are
-- not tabulated. `sidereal` says which P this is; wSign/nSign are the apse and
-- node directions (+1 advance, -1 regress). celestial_test checks every moon
-- against its published sidereal period, so a wrong reading fails.
pure func jplSat(a: float, e: float, w: float, m: float, i: float, n: float, p: float, pw: float, pn: float,
                 ra: float, dec: float, sidereal: bool, wSign: float, nSign: float) -> SatElements {
  let wdot = if pw == 0.0 then 0.0 else wSign * 6.283185307179586 / (pw * 365.25);
  let ndot = if pn == 0.0 then 0.0 else nSign * 6.283185307179586 / (pn * 365.25);
  { a: a, e: e, argPeri: rad(w), meanAnom: rad(m), incl: rad(i), node: rad(n), epochJd: 2451545.0,
    meanAnomRate: if sidereal then 6.283185307179586 / p - wdot - ndot else 6.283185307179586 / p,
    periRate: wdot, nodeRate: ndot, poleRa: rad(ra), poleDec: rad(dec) }
}

pure func moonCite() -> Cite = { orbit: "jplsat", pole: "archinal2018", shape: "archinal2018", gm: "park2021", albedo: "nssdc-sats", limb: "lambert-assumed" }
pure func moon(id: string, name: string, host: string, s: SatElements, p: PoleModel, req: float, rpol: float, gm: float, pv: float) -> Moon =
  { id: id, name: name, host: host, sat: s, pole: p, radiusKm: req, polarKm: rpol, gm: gm, pV: pv, cite: moonCite() }

-- The Moon's elements are referred to the ecliptic: its "Laplace pole" is the ecliptic pole.
pure func eclRa() -> float = 270.0
pure func eclDec() -> float = 90.0 - obliquityJ2000() * 180.0 / 3.141592653589793

-- Split per system: one 12-element literal exceeds the bytecode VM's register
-- budget under --strict-bytecode (evaluator-only; reported to AILANG, message
-- inbox_1791037931866_b80f2b7c, v0.52.0).
export pure func moons() -> [Moon] = earthMoon() ++ galilean() ++ saturnian() ++ neptunian()

pure func earthMoon() -> [Moon] = [
  moon("moon", "Moon", "earth", jplSat(384400.0, 0.0554, 318.15, 135.27, 5.16, 125.08, 27.322, 5.997, 18.600, eclRa(), eclDec(), true, 1.0, 0.0 - 1.0),
    pole(269.9949, 0.0031, 66.5392, 0.0130, 38.3213, 13.17635815, 0.0 - 0.0000000000014,
      [term(125.045, 0.0 - 1935.5364525, 0.0 - 3.8787, 1.5419, 3.5610), term(250.089, 0.0 - 3871.072905, 0.0 - 0.1204, 0.0239, 0.1208),
