module stapledons/sim/data/sol

-- M5.1a: Sol's system as data (design m5-planets §M5.1). Pure, no I/O.
-- Every row carries citation keys (Cite) that resolve in citations(); the
-- numbers are copied digit for digit from the cited table. Angles are
-- written in degrees as tabulated and converted once, here, to radians.
-- The Sun, 8 planets, the 12 moons design §M5.1 names (Q7 default; it says "11") and 4 ring systems.
import pkg/sunholo/celestial/ephemeris (MeanElements, ElementRates, SatElements)
import pkg/sunholo/celestial/frames (PoleModel, PoleTerm, obliquityJ2000)
import pkg/sunholo/celestial/rings (RingBand)

-- Citation keys, one per field group. "" is never allowed (celestial_test).
export type Cite = { orbit: string, pole: string, shape: string, gm: string, albedo: string, limb: string }
export type Star = { id: string, name: string, pole: PoleModel, radiusKm: float, gm: float, cite: Cite }
-- radiusKm is the equatorial radius the albedo goes with; polarKm the polar one.
export type Planet = { id: string, name: string, el: MeanElements, rates: ElementRates, pole: PoleModel,
  radiusKm: float, polarKm: float, gm: float, pV: float, minnaertK: float, ring: string, cite: Cite }
export type Moon = { id: string, name: string, host: string, sat: SatElements, pole: PoleModel,
  radiusKm: float, polarKm: float, gm: float, pV: float, cite: Cite }
-- tint is a rest-frame sRGB tint from imagery, labelled as a tint, not a spectrum.
export type Tint = { r: float, g: float, b: float }
export type Ring = { host: string, names: [string], bands: [RingBand], tint: Tint, cite: string, tauCite: string, w0Cite: string, tintCite: string }

-- key -> full reference. Every Cite field and ring cite must be a key here.
export pure func citations() -> [(string, string)] = [
  ("standish1992", "Standish & Williams 1992, JPL SSD 'Approximate Positions of the Planets', Tables 2a/2b (3000 BC-3000 AD); Earth row is the Earth-Moon barycentre"),
  ("archinal2018", "Archinal et al. 2018, CMDA 130:22, IAU WGCCRE 2015 report, as tabulated in NAIF pck00011.tpc (2022-12-27): poles, W, radii"),
  ("park2021", "Park et al. 2021, AJ 161:105, DE440 GM values, NAIF gm_de440.tpc"),
  ("mallama2017", "Mallama, Krobusek & Pavlov 2017, Icarus 282:19, V-band geometric albedo p_V"),
  ("binder1973", "Binder & McCarthy 1973, AJ 78:939, Minnaert k 1.0 over Jupiter's disc, 0.75-0.90 on Saturn (0.6-2.0 um); Saturn uses the midpoint 0.825"),
  ("lambert-assumed", "assumed: Lambert (Minnaert k = 1); no citable visible-continuum k for this body was found"),
  ("jplsat", "JPL SSD 'Planetary Satellite Mean Elements' (Moon DE405/LE405 ecliptic; JUP365, SAT441, NEP097 Laplace), retrieved 2026-10-03"),
  ("nssdc-sats", "NASA NSSDC Moon, Jovian, Saturnian and Neptunian satellite fact sheets: visual geometric albedo"),
  ("pds-rings", "PDS Rings Node, 'Vital Statistics for Saturn's Rings': boundaries and optical depth (range midpoint; log midpoint for decade ranges)"),
  ("nssdc-rings", "NASA NSSDC Jupiter/Saturn/Uranus/Neptune ring fact sheets: radius, width, optical depth, albedo (range midpoints)"),
  ("w0-assumed", "assumed: no tabulated particle albedo for this band; the nearest tabulated band's value is used"),
  ("tint-design", "assumed tint: colours of stapledons-design features/future/planetary-rings.md (white/tan, rusty red, grey/dark, reddish)")
]

pure func rad(d: float) -> float = d * 3.141592653589793 / 180.0
pure func perDay(dPerCy: float) -> float = rad(dPerCy) / 36525.0

-- Standish Table 2a row (degrees) and its rates per century plus Table 2b (b, c, s, f).
pure func me(a: float, e: float, i: float, l: float, w: float, n: float) -> MeanElements =
  { a: a, e: e, incl: rad(i), meanLong: rad(l), longPeri: rad(w), node: rad(n) }
pure func rt(a: float, e: float, i: float, l: float, w: float, n: float, b: float, c: float, s: float, f: float) -> ElementRates =
  { a: a, e: e, incl: rad(i), meanLong: rad(l), longPeri: rad(w), node: rad(n), b: rad(b), c: rad(c), s: rad(s), f: rad(f) }

-- WGCCRE model as in pck00011: ra1, dec1 deg/century; w1 deg/day, w2 deg/day^2;
-- each periodic term (phase0 deg, rate deg/century, ra, dec, w amplitudes in deg).
pure func pole(ra0: float, ra1: float, dec0: float, dec1: float, w0: float, w1: float, w2: float, ts: [PoleTerm]) -> PoleModel =
  { ra0: rad(ra0), ra1: rad(ra1), dec0: rad(dec0), dec1: rad(dec1), w0: rad(w0), w1: rad(w1), w2: rad(w2), terms: ts }
pure func term(p: float, r: float, a: float, d: float, w: float) -> PoleTerm =
  { phase0: rad(p), rate: perDay(r), ra: rad(a), dec: rad(d), w: rad(w) }

pure func planetCite(albedo: string, limb: string) -> Cite =
  { orbit: "standish1992", pole: "archinal2018", shape: "archinal2018", gm: "park2021", albedo: albedo, limb: limb }

export pure func sun() -> Star =
  { id: "sun", name: "Sun", pole: pole(286.13, 0.0, 63.87, 0.0, 84.176, 14.1844, 0.0, []), radiusKm: 695700.0,
    gm: 132712440041.27942, cite: { orbit: "standish1992", pole: "archinal2018", shape: "archinal2018", gm: "park2021", albedo: "archinal2018", limb: "archinal2018" } }

pure func planet(id: string, name: string, el: MeanElements, r: ElementRates, p: PoleModel, req: float, rpol: float, gm: float, pv: float, k: float, ring: string, limb: string) -> Planet =
  { id: id, name: name, el: el, rates: r, pole: p, radiusKm: req, polarKm: rpol, gm: gm, pV: pv, minnaertK: k, ring: ring, cite: planetCite("mallama2017", limb) }

