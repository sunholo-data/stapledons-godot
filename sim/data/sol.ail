       term(357.529, 35999.0509575, 0.0, 0.0, 0.0252), term(311.589, 964468.49931, 0.0072, 0.0 - 0.0029, 0.0 - 0.0066),
       term(134.963, 477198.869325, 0.0, 0.0009, 0.0 - 0.0047), term(276.617, 12006.300765, 0.0, 0.0, 0.0 - 0.0046),
       term(34.226, 63863.5132425, 0.0, 0.0, 0.0028), term(15.134, 0.0 - 5806.6093575, 0.0 - 0.0052, 0.0008, 0.0052),
