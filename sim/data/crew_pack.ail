  "{\n \"schema\": \"crew_scenario/1\",\n \"id\": \"stapledon-last-messages-home\",\n \"indicators\": [\n  \"fatigue\",\n  \"stress\",\n  \"morale\",\n  \"readiness\",\n  \"observations\",\n  \"trust\"\n ],\n \"indicator_defaults\": {\n  \"fatigue\": 0,\n  \"stress\": 0,\n  \"morale\": 50,\n  \"readiness\": 50,\n  \"observations\": 0\n },\n \"captain\": {\n  \"id\": \"captain\",\n  \"values\": {\n   \"mission\": 85\n  },\n  \"start\": {\n   \"fatigue\": 10,\n   \"stress\": 40,\n   \"morale\": 60\n  }\n },\n \"crew\": [\n  {\n   \"id\": \"medic\",\n   \"role\": \"Medic\",\n   \"ocean\": {\n    \"openness\": 55,\n    \"conscientiousness\": 60,\n    \"extraversion\": 45,\n    \"agreeableness\": 85,\n    \"neuroticism\": 55\n   },\n   \"values\": {\n    \"care\": 90,\n    \"family\": 85\n   },\n   \"start\": {\n    \"fatigue\": 30,\n    \"stress\": 70,\n    \"morale\": 50\n   },\n   \"work\": [\n    {\n     \"id\": \"work_medic\",\n     \"name\": \"Record the household messages\",\n     \"purpose\": \"Help families record the last messages Earth will receive while they still know the people they address.\",\n     \"duration\": 2,\n     \"costs\": [\n      {\n       \"resource\": \"signal\",\n       \"reserve\": 1,\n       \"consume\": 0\n      },\n      {\n       \"resource\": \"power\",\n       \"reserve\": 1,\n       \"consume\": 0\n      }\n     ],\n     \"effects\": {\n      \"morale\": 10,\n      \"stress\": 10,\n      \"fatigue\": 10,\n      \"readiness\": 5\n     }\n    }\n   ]\n  },\n  {\n   \"id\": \"engineer\",\n   \"role\": \"Chief Engineer\",\n   \"ocean\": {\n    \"openness\": 20,\n    \"conscientiousness\": 85,\n    \"extraversion\": 25,\n    \"agreeableness\": 45,\n    \"neuroticism\": 30\n   },\n   \"values\": {\n    \"reliability\": 90,\n    \"family\": 70\n   },\n   \"start\": {\n    \"fatigue\": 35,\n    \"stress\": 55,\n    \"morale\": 55\n   },\n   \"work\": [\n    {\n     \"id\": \"work_engineer\",\n     \"name\": \"Seal the drive for the first leg\",\n     \"purpose\": \"Run the final drive checks before the bubble closes; afterwards nothing physical can be fetched from home.\",\n     \"duration\": 3,\n     \"costs\": [\n      {\n       \"resource\": \"compute\",\n       \"reserve\": 1,\n       \"consume\": 0\n      },\n      {\n       \"resource\": \"mass\",\n       \"reserve\": 1,\n       \"consume\": 1\n      }\n     ],\n     \"effects\": {\n      \"readiness\": 20,\n      \"fatigue\": 15,\n      \"stress\": 5\n     }\n    }\n   ]\n  },\n  {\n   \"id\": \"analyst\",\n   \"role\": \"Analyst\",\n   \"ocean\": {\n    \"openness\": 60,\n    \"conscientiousness\": 80,\n    \"extraversion\": 15,\n    \"agreeableness\": 40,\n    \"neuroticism\": 45\n   },\n   \"values\": {\n    \"truth\": 85,\n    \"autonomy\": 70\n   },\n   \"start\": {\n    \"fatigue\": 25,\n    \"stress\": 45,\n    \"morale\": 50\n   },\n   \"work\": [\n    {\n     \"id\": \"work_analyst\",\n     \"name\": \"Compress the Archive's Earth snapshot\",\n     \"purpose\": \"Choose what the Archive keeps of Earth as it is today; the copy will never be updated by hand again.\",\n     \"duration\": 3,\n     \"costs\": [\n      {\n       \"resource\": \"compute\",\n       \"reserve\": 1,\n       \"consume\": 0\n      },\n      {\n       \"resource\": \"signal\",\n       \"reserve\": 1,\n       \"consume\": 0\n      },\n      {\n       \"resource\": \"power\",\n       \"reserve\": 1,\n       \"consume\": 0\n      }\n     ],\n     \"effects\": {\n      \"observations\": 20,\n      \"fatigue\": 15,\n      \"stress\": 10\n     }\n    }\n   ]\n  },\n  {\n   \"id\": \"pilot\",\n   \"role\": \"Pilot\",\n   \"ocean\": {\n    \"openness\": 35,\n    \"conscientiousness\": 30,\n    \"extraversion\": 80,\n    \"agreeableness\": 55,\n    \"neuroticism\": 25\n   },\n   \"values\": {\n    \"safety\": 75,\n    \"adventure\": 80\n   },\n   \"start\": {\n    \"fatigue\": 20,\n    \"stress\": 40,\n    \"morale\": 70\n   },\n   \"work\": [\n    {\n     \"id\": \"work_pilot\",\n     \"name\": \"Plot the first leg\",\n     \"purpose\": \"Lay in the first leg; every light-year flown costs a year at home, and no leg can be taken back.\",\n     \"duration\": 2,\n     \"costs\": [\n      {\n       \"resource\": \"compute\",\n       \"reserve\": 1,\n       \"consume\": 0\n      }\n     ],\n     \"effects\": {\n      \"readiness\": 15,\n      \"fatigue\": 10,\n      \"stress\": 5\n     }\n    }\n   ]\n  },\n  {\n   \"id\": \"counselor\",\n   \"role\": \"Counselor\",\n   \"ocean\": {\n    \"openness\": 70,\n    \"conscientiousness\": 60,\n    \"extraversion\": 60,\n    \"agreeableness\": 90,\n    \"neuroticism\": 30\n   },\n   \"values\": {\n    \"care\": 90,\n    \"cooperation\": 80\n   },\n   \"start\": {\n    \"fatigue\": 25,\n    \"stress\": 50,\n    \"morale\": 65\n   },\n   \"work\": [\n    {\n     \"id\": \"work_counselor\",\n     \"name\": \"Hold the founders' farewell\",\n     \"purpose\": \"Gather the crew in the Cathedral to say goodbye together; grief shared now is easier to carry later.\",\n     \"duration\": 2,\n     \"costs\": [],\n     \"effects\": {\n      \"morale\": 15,\n      \"fatigue\": 10,\n      \"stress\": -5\n     }\n    }\n   ]\n  }\n ],\n \"rest\": {\n  \"purpose\": \"Step back to rest and recover before another assignment.\",\n  \"duration\": 2,\n  \"effects\": {\n   \"fatigue\": -20,\n   \"stress\": -15,\n   \"morale\": 5\n  }\n },\n \"overextended\": {\n  \"indicator\": \"stress\",\n  \"threshold\": 70,\n  \"recovery\": 45,\n  \"duration\": 2,\n  \"cooldown\": 3\n },\n \"trust_in_captain\": 55,\n \"resources\": [\n  {\n   \"id\": \"mass\",\n   \"name\": \"Free mass (10 kg blocks)\",\n   \"initial\": 3,\n   \"kind\": \"stock\"\n  },\n  {\n   \"id\": \"power\",\n   \"name\": \"Power headroom (50 kW)\",\n   \"initial\": 3,\n   \"kind\": \"capacity\"\n  },\n  {\n   \"id\": \"compute\",\n   \"name\": \"Archive compute slots\",\n   \"initial\": 2,\n   \"kind\": \"capacity\"\n  },\n  {\n   \"id\": \"signal\",\n   \"n