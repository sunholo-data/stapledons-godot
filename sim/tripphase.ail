module stapledons/sim/tripphase

-- The package's phaseAt as an index, so core.ail can use it without
-- importing the TripPhase constructors: their `Arrived` would clash with the
-- Journey constructor of the same name, and an aliased constructor import
-- (`Arrived as X`) is accepted but never matches (ailang#1478).
--   0 Accelerating (boost), 1 Coasting (cruise), 2 Decelerating (brake), 3 Arrived
import pkg/sunholo/relativity/journey (TripPlan, phaseAt, Accelerating, Coasting, Decelerating, Arrived)

export pure func tripPhaseIndex(p: TripPlan, tau: float) -> int =
  match phaseAt(p, tau) { Accelerating => 0, Coasting => 1, Decelerating => 2, Arrived => 3 }
