module stapledons/sim/navigation

-- M5.5a: planning a leg to a body of the system (design m5-planets §M5.5,
-- sprint R1-M5-PLANETS §M5.5a). Pure: no I/O, no hidden state, clean under
-- --strict-bytecode (`make strict-m5`, navigationVm). core.ail dispatches the
-- `plan` intent's body form here and stores what comes back.
--
-- One journey model: a body leg is an M2 burn-coast-burn (with its
-- flip-and-burn fallback) from the ship to an arrival point the sim computes
-- itself; the client sends only the body id (its `pos` is never read).
-- Every formula is a package function: bodyAt (sim/celestial.ail, built on
-- sunholo/celestial) for where a body is, planBurnCoastBurn and motionAt
-- (sunholo/relativity) for the leg, doppler for D at the pass. What is here
-- is geometry and composition: the intercept iteration, the pass point, and
-- the safety checks.
--
-- Units: geometry in km (bodyAt's galactic frame), the leg and its trip in
-- light years and years (core.ail's frame; c = 1). Times are galaxy (Earth)
-- years since the scenario epoch, as in the ship's clock; jd = jdAt(epoch, t).
import std/math (sqrt, cos, sin)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import pkg/sunholo/celestial/kepler (Vec3, add, sub, scale, norm, dot, cross, absf)
import pkg/sunholo/celestial/ephemeris (auKm)
import pkg/sunholo/relativity/journey (TripPlan, planBurnCoastBurn, planBurnCoastBrakeApproach, motionAt, rapidityForTimedLeg, rapidityForTimedApproach)
import pkg/sunholo/relativity/kinematics (betaOf, rapidityOfBeta)
import pkg/sunholo/relativity/optics (doppler)
import ./celestial (System, BodyState, bodyAt, jdAt, lyKm)
import ./data/sol (Planet, Moon, Ring, rings, planets, sun)
import ./stops (starStopKm, planetStopKm, denseRingTau)
import ./alpha_centauri (alphaBodyAt, stellarRadiusKm, catalogueA, catalogueId as alphaCatalogueId)
import ./destination_stars (isDestinationStar, destinationBodyAt, destinationRadiusKm, destinationLy, destinationIds, destinationCatalogueId)
import ./trappist1 (isTrappistPlanet, trappistPlanetAt, trappistPlanetIds, planetRadiusKm, hostId as trappistHostId)

-- ------------------------------------------------------------ intent and result
-- The plan intent's body form. mode is "stop" or "flyby". standoffKm: None
-- takes the default stand-off; bKm and clockDeg are the flyby's pass distance
-- and side (0 = the body's north, 90 = right of it as seen from the ship,
-- i.e. clockwise on the sky); runOutKm: None takes the default run-out.
export type BodyReq = { id: string, cruisePhi: float, mode: string, standoffKm: Option[float], bKm: float, clockDeg: float, runOutKm: Option[float], timing: Option[Timing] }
-- A timed stop (D-46, guided tour): the sim chooses this leg's acceleration
-- and cruise speed so the boost lasts boostS and the cruise about cruiseS
-- (seconds), and ends with a gentler final approach lasting approachS that
-- begins where the body is approachDeg across. cruisePhi is then ignored.
export type Timing = { boostS: float, cruiseS: float, approachS: float, approachDeg: float }
-- A final approach: its proper acceleration (c/yr) and starting rapidity.
export type Approach = { a: float, phi: float }
-- The flyby's pass: galaxy time, closest distance to the centre (km), beta
-- and the Doppler factor of the body's light there (rest-frame direction).
export type Pass = { t: float, bKm: float, beta: float, dAtPass: float }
-- What the planner adds to an M2 plan. index: the body's place in
-- system.bodies; t0: the galaxy time the plan was made at (a commit at any
-- other time is stale: the body has moved); interceptT/interceptLy: when
-- and where the body is at arrival (stop) or at the pass (flyby);
-- standoffKm: the stop's distance from the centre (0 for a flyby);
-- residual: the intercept iteration's last step, as a fraction of the leg.
export type NavPlan = { bodyId: string, index: int, mode: string, t0: float, interceptT: float, interceptLy: Vec3, standoffKm: float, pass: Option[Pass], residual: float }
-- The leg core.ail stores: the arrival point (ly), its heading and trip.
export type Leg = { arrivalLy: Vec3, heading: Vec3, trip: TripPlan, nav: NavPlan }
-- Everything the planner reads from the world: the system, the scenario
-- epoch (JD), the ship's galaxy time and position (ly), the drive's proper
-- acceleration (c/yr) and the bubble radius (km).
export type NavCtx = { sys: System, epochJd: float, t0: float, hereLy: Vec3, accel: float, bubbleKm: float, capPhi: float, approach: Option[Approach] }

-- ------------------------------------------------------------ constants
-- The intercept iteration count, fixed (deterministic on both runtimes). The
-- contraction is v_body / v_ship <= 50 km/s / 0.001c = 0.17, so 12 steps leave
-- less than 1e-9 of the leg (design §M5.5).
export pure func interceptIterations() -> int = 12
export pure func residualMax() -> float = 0.000000001
-- In-system cruise speeds: 0.001c to 0.99c, as rapidities (both ends accepted).
export pure func bodyPhiMin() -> float = rapidityOfBeta(0.001)
export pure func bodyPhiMax() -> float = rapidityOfBeta(0.99)
-- The longest stand-off a player may set (larger values are clamped to it).
export pure func standoffMaxKm() -> float = 0.1 * auKm()
-- The flyby's default run-out beyond the braking distance.
export pure func runOutMarginKm() -> float = 1000000.0
-- The safety minimum for a stand-off or a pass distance: the body's radius
-- with a 10 % margin (above every atmosphere in Sol: Jupiter's 1 mbar level is
-- about 0.4 % of its radius) plus the bubble. Below it the plan is too_close.
export pure func safetyMinKm(radiusKm: float, bubbleKm: float) -> float = 1.1 * radiusKm + bubbleKm
-- The default stand-off (D-54, sim/stops.ail): a star where it looks
-- 2 atan(tan 5 deg sqrt(R / R_sun)) across, a planet or moon where it looks
-- 2 atan(tan 15 deg sqrt(R / R_earth)) across, above the atmosphere and outside
-- dense rings. R_sun and R_earth are this data's Sun and Earth radii.
export pure func earthRefKm() -> float = navFold(\acc p. if p.id == "earth" then p.radiusKm else acc, 0.0, planets())
export pure func sunRefKm() -> float = (sun()).radiusKm
export pure func isStarStop(id: string) -> bool = id == "sun" || id == "acen-a" || id == "acen-b" || isDestinationStar(id)
-- The outer edge of a host's dense rings (optical depth >= denseRingTau), 0 if none.
export pure func denseRingKm(host: string) -> float =
  navFold(\acc r. if r.host == host then navFold(\m b. if b.tau >= denseRingTau() && b.rOut > m then b.rOut else m, acc, r.bands) else acc, 0.0, rings())
export pure func defaultStopKm(id: string, radiusKm: float, bubbleKm: float) -> float =
  if isStarStop(id) then starStopKm(radiusKm, sunRefKm())
  else planetStopKm(radiusKm, earthRefKm(), denseRingKm(id), safetyMinKm(radiusKm, bubbleKm))

-- ------------------------------------------------------------ bodies
-- What the checks need about a body: its place in system.bodies, radius,
-- outer ring radius (0 if none) and whether it may be a plan target
-- (a measured radius and albedo).
export type Facts = { id: string, index: int, radiusKm: float, ringKm: float, visitable: bool }
pure func ringOuterKm(host: string) -> float =
  navFold(\acc r. if r.host == host then navFold(\m b. if b.rOut > m then b.rOut else m, acc, r.bands) else acc, 0.0, rings())
pure func navFold(g: (b, a) -> b, z: b, xs: [a]) -> b = match xs { [] => z, x :: r => navFold(g, g(z, x), r) }
pure func planetFacts(ps: [Planet], i: int) -> [Facts] =
  match ps { [] => [], p :: r => { id: p.id, index: i, radiusKm: p.radiusKm, ringKm: ringOuterKm(p.id), visitable: p.radiusKm > 0.0 && p.pV > 0.0 } :: planetFacts(r, i + 1) }
pure func moonFacts(ms: [Moon], i: int) -> [Facts] =
  match ms { [] => [], m :: r => { id: m.id, index: i, radiusKm: m.radiusKm, ringKm: 0.0, visitable: m.radiusKm > 0.0 && m.pV > 0.0 } :: moonFacts(r, i + 1) }
-- Every body in system.bodies order: the star (not a target: no albedo), planets, moons.
export pure func allFacts(sys: System) -> [Facts] =
  { id: sys.star.id, index: 0, radiusKm: sys.star.radiusKm, ringKm: 0.0, visitable: false } :: (planetFacts(sys.planets, 1) ++ moonFacts(sys.moons, 1 + navLen(sys.planets)))
pure func alphaFacts(sys:System)->[Facts] = [
 {id:"acen-a",index:1+navLen(sys.planets)+navLen(sys.moons),radiusKm:stellarRadiusKm("acen-a"),ringKm:0.0,visitable:true},
 {id:"acen-b",index:2+navLen(sys.planets)+navLen(sys.moons),radiusKm:stellarRadiusKm("acen-b"),ringKm:0.0,visitable:true}]
-- Destination stars (finite-destination-stars.md) follow alpha Cen in system.bodies order.
pure func destinationFacts(sys: System) -> [Facts] = destFactsOf(destinationIds(), 3 + navLen(sys.planets) + navLen(sys.moons))
pure func destFactsOf(ids: [string], i: int) -> [Facts] = match ids { [] => [], d :: rest => { id: d, index: i, radiusKm: destinationRadiusKm(d), ringKm: 0.0, visitable: true } :: destFactsOf(rest, i + 1) }
pure func nearDestination(c: NavCtx, id: string) -> bool = isDestinationStar(id) && norm(sub(c.hereLy, destinationLy(id))) < 0.1
pure func nearDestinationFacts(c: NavCtx) -> [Facts] = navFilterNear(c, destinationFacts(c.sys)) ++ (if nearDestination(c, trappistHostId()) then trappistFacts(c.sys) else [])
-- TRAPPIST-1's planets (trappist1-planets-sprint.md) follow the destination stars in
-- system.bodies order, b..h, fed within 0.1 ly; collision bodies, not plan targets.
export pure func trappistFacts(sys: System) -> [Facts] = tFactsOf(trappistPlanetIds(), 3 + navLen(sys.planets) + navLen(sys.moons) + navLen(destinationIds()))
pure func tFactsOf(ids: [string], i: int) -> [Facts] = match ids { [] => [], d :: rest => { id: d, index: i, radiusKm: planetRadiusKm(d), ringKm: 0.0, visitable: false } :: tFactsOf(rest, i + 1) }
pure func navFilterNear(c: NavCtx, fs: [Facts]) -> [Facts] = match fs { [] => [], f :: rest => if nearDestination(c, f.id) then f :: navFilterNear(c, rest) else navFilterNear(c, rest) }
pure func navLen(xs: [a]) -> int = match xs { [] => 0, _ :: r => 1 + navLen(r) }
pure func factsOf(fs: [Facts], id: string) -> Option[Facts] = match fs { [] => None, f :: r => if f.id == id then Some(f) else factsOf(r, id) }
-- Bodies outside this system (the alpha Cen worlds, R1) and unknown ids are not_visitable too.
export pure func targetFacts(sys: System, id: string) -> Result[Facts, string] =
  match factsOf(allFacts(sys), id) { Some(f) => if f.visitable then Ok(f) else Err("not_visitable"), None => Err("not_visitable") }

pure func navZero() -> Vec3 = { x: 0.0, y: 0.0, z: 0.0 }
pure func navUnit(v: Vec3) -> Vec3 { let n = norm(v); if n > 0.0 then scale(1.0 / n, v) else navZero() }
pure func navStateAt(c: NavCtx, id: string, t: float) -> BodyState =
  match (if id=="acen-a" || id=="acen-b" then alphaBodyAt(id,jdAt(c.epochJd,t)) else if isDestinationStar(id) then destinationBodyAt(id) else if isTrappistPlanet(id) then trappistPlanetAt(id, jdAt(c.epochJd, t)) else bodyAt(c.sys, id, jdAt(c.epochJd, t))) { Some(b) => b, None => { pos: navZero(), vel: navZero(), pole: navZero(), wDeg: 0.0 } }
pure func navPosAt(c: NavCtx, id: string, t: float) -> Vec3 = (navStateAt(c, id, t)).pos
pure func navHereKm(c: NavCtx) -> Vec3 = scale(lyKm(), c.hereLy)
pure func navIterate(g: float -> float, t: float, n: int) -> float = if n <= 0 then t else navIterate(g, g(t), n - 1)
pure func navTripOf(c: NavCtx, legKm: float, phi: float) -> TripPlan = navTripLy(c, legKm / lyKm(), phi)
-- Every leg's trip: burn-coast-burn, or with the context's final approach.
pure func navTripLy(c: NavCtx, legLy: float, phi: float) -> TripPlan =
  match c.approach { Some(ap) => planBurnCoastBrakeApproach(legLy, c.accel, phi, ap.a, ap.phi), None => planBurnCoastBurn(legLy, c.accel, phi) }

-- ------------------------------------------------------------ time along the leg
-- Proper time at which the trip has covered x ly: bisection on the package's
-- closed-form motionAt (monotonic in tau), 64 fixed halvings, so no formula
-- of the trip is restated here.
export pure func tauAtX(p: TripPlan, x: float) -> float = navBisect(p, x, 0.0, p.tauTotal, 64)
pure func navBisect(p: TripPlan, x: float, lo: float, hi: float, n: int) -> float =
  if n <= 0 then (lo + hi) / 2.0
  else { let mid = (lo + hi) / 2.0; if (motionAt(p, mid)).x < x then navBisect(p, x, mid, hi, n - 1) else navBisect(p, x, lo, mid, n - 1) }
-- Galaxy time at which the ship is xKm along the leg.
pure func timeAtKm(c: NavCtx, p: TripPlan, xKm: float) -> float = c.t0 + (motionAt(p, tauAtX(p, xKm / lyKm()))).t

-- ------------------------------------------------------------ stop geometry
-- The arrival point standoffKm short of the body's centre at time tA, on the
-- line from the ship; the leg is that distance.
type Aim = { pointKm: Vec3, bodyKm: Vec3, legKm: float }
pure func stopAim(c: NavCtx, id: string, s: float, tA: float) -> Aim {
  let b = navPosAt(c, id, tA);
  let d = sub(b, navHereKm(c));
  let dn = norm(d);
  { pointKm: sub(b, scale(s / dn, d)), bodyKm: b, legKm: dn - s }
}
-- t_a <- t0 + planBurnCoastBurn(|aim(t_a) - x0|).galaxyTime, n times from t0.
export pure func stopArrivalT(c: NavCtx, id: string, s: float, phi: float, n: int) -> float =
  navIterate(\t. c.t0 + (navTripOf(c, (stopAim(c, id, s, t)).legKm, phi)).trip.galaxyTime, c.t0, n)

-- ------------------------------------------------------------ flyby geometry
-- The pass point: the foot of the perpendicular from the body's centre (at
-- time tP) to the leg's line, at exactly bKm, on the side clockDeg. North is
-- the body's pole projected across the approach direction u (the galactic
-- pole, then +x, if the pole is along u); 90 deg is right of it as seen from
-- the ship (cross(u, north)). With sin a = b / D the point is
-- B + b (cos a n - sin a u), so |Q - B| = b and (Q - B).(Q - x0) = 0.
type PassAim = { pointKm: Vec3, bodyKm: Vec3, toPassKm: float, legKm: float, endKm: Vec3 }
pure func navPerpTo(u: Vec3, v: Vec3) -> Vec3 = sub(v, scale(dot(v, u), u))
pure func northAcross(u: Vec3, pole: Vec3) -> Vec3 {
  let p = navPerpTo(u, pole);
  if norm(p) > 0.000000001 then navUnit(p)
  else { let g = navPerpTo(u, { x: 0.0, y: 0.0, z: 1.0 }); if norm(g) > 0.000000001 then navUnit(g) else navUnit(navPerpTo(u, { x: 1.0, y: 0.0, z: 0.0 })) }
}
pure func passAim(c: NavCtx, rq: BodyReq, runOut: float, tP: float) -> PassAim {
  let st = navStateAt(c, rq.id, tP);
  let x0 = navHereKm(c);
  let d = sub(st.pos, x0);
  let dn = norm(d);
  let u = scale(1.0 / dn, d);
  let north = northAcross(u, st.pole);
  let rad = rq.clockDeg * 3.141592653589793 / 180.0;
  let side = add(scale(cos(rad), north), scale(sin(rad), cross(u, north)));
  let sa = rq.bKm / dn;
  let q = add(st.pos, scale(rq.bKm, sub(scale(sqrt(1.0 - sa * sa), side), scale(sa, u))));
  let toPass = norm(sub(q, x0));
  let w = scale(1.0 / toPass, sub(q, x0));
  { pointKm: q, bodyKm: st.pos, toPassKm: toPass, legKm: toPass + runOut, endKm: add(q, scale(runOut, w)) }
}
-- t_p <- t0 + (galaxy time at the pass point of planBurnCoastBurn(|end - x0|)), n times from t0.
export pure func flybyPassT(c: NavCtx, rq: BodyReq, runOut: float, n: int) -> float =
  navIterate(\t. { let a = passAim(c, rq, runOut, t); timeAtKm(c, navTripOf(c, a.legKm, rq.cruisePhi), a.toPassKm) }, c.t0, n)
-- The braking distance at the cruise rapidity (the package's dBurn) plus the margin.
pure func defaultRunOutKm(c: NavCtx, phi: float) -> float = (planBurnCoastBurn(1000000000.0, c.accel, phi)).dBurn * lyKm() + runOutMarginKm()

-- ------------------------------------------------------------ safety
-- For each body: the time the ship is nearest it on the leg (two refinements
-- from t0, the body moving), its centre then, and the leg's nearest point.
type Near = { t: float, bodyKm: Vec3, pole: Vec3, distKm: float }
pure func clampLeg(s: float, legKm: float) -> float = if s < 0.0 then 0.0 else if s > legKm then legKm else s
pure func nearestAt(c: NavCtx, p: TripPlan, w: Vec3, legKm: float, id: string, t: float, n: int) -> Near {
  let st = navStateAt(c, id, t);
  let x0 = navHereKm(c);
  let s = clampLeg(dot(sub(st.pos, x0), w), legKm);
  if n <= 0 then { t: t, bodyKm: st.pos, pole: st.pole, distKm: norm(sub(add(x0, scale(s, w)), st.pos)) }
  else nearestAt(c, p, w, legKm, id, timeAtKm(c, p, s), n - 1)
}
-- collision: the leg passes within R + bubble of any body (the target included:
-- its stand-off and pass distance already clear 1.1 R).
pure func collides(c: NavCtx, p: TripPlan, w: Vec3, legKm: float) -> bool = collidesFrom(c, p, w, legKm, false)
-- startInside true: a body the ship starts inside does not count. Only a D-54
-- free-navigation leg (planFiniteStop) uses it: the "sol" scenario starts at Sol's
-- origin, the Sun's centre (M2's convention). Every other plan still refuses a start
-- inside a body (AC15).
pure func collidesFrom(c: NavCtx, p: TripPlan, w: Vec3, legKm: float, startInside: bool) -> bool =
  navFold(\acc f. acc || ((nearestAt(c, p, w, legKm, f.id, c.t0, 2)).distKm < f.radiusKm + c.bubbleKm
    && !(startInside && norm(sub(navPosAt(c, f.id, c.t0), navHereKm(c))) < f.radiusKm + c.bubbleKm)), false, allFacts(c.sys) ++ (if norm(sub(c.hereLy,catalogueA()))<0.1 then alphaFacts(c.sys) else []) ++ nearDestinationFacts(c))
-- ring_crossing: the leg crosses a ring host's equatorial plane inside its outer
-- ring radius (host and pole taken at the ship's nearest approach to it).
pure func crossesRing(c: NavCtx, p: TripPlan, w: Vec3, legKm: float, f: Facts) -> bool {
  let nr = nearestAt(c, p, w, legKm, f.id, c.t0, 2);
  let x0 = navHereKm(c);
  let den = dot(w, nr.pole);
  if f.ringKm <= 0.0 || absf(den) < 0.000000000001 then false
  else { let s = dot(sub(nr.bodyKm, x0), nr.pole) / den; s >= 0.0 && s <= legKm && norm(sub(add(x0, scale(s, w)), nr.bodyKm)) < f.ringKm }
}
pure func ringCrossing(c: NavCtx, p: TripPlan, w: Vec3, legKm: float) -> bool =
  navFold(\acc f. acc || crossesRing(c, p, w, legKm, f), false, allFacts(c.sys))

-- ------------------------------------------------------------ the planner
pure func navFinite(x: float) -> bool = x - x == 0.0
pure func navPhiOk(phi: float) -> bool = phi == phi && phi >= bodyPhiMin() && phi <= bodyPhiMax()
-- The leg from the ship to endKm, its trip, and the checks every plan shares
-- (no_converge, then collision, then ring_crossing).
pure func navFinish(c: NavCtx, endKm: Vec3, phi: float, residual: float, nav: NavPlan) -> Result[Leg, string] = navFinishFrom(c, endKm, phi, residual, nav, false)
pure func navFinishFrom(c: NavCtx, endKm: Vec3, phi: float, residual: float, nav: NavPlan, startInside: bool) -> Result[Leg, string] {
  let endLy = scale(1.0 / lyKm(), endKm);
  let dLy = sub(endLy, c.hereLy);
  let legLy = norm(dLy);
  let trip = navTripLy(c, legLy, phi);
  let w = navUnit(sub(endKm, navHereKm(c)));
  let legKm = legLy * lyKm();
  if !(residual < residualMax()) || !navFinite(legLy) then Err("no_converge")
  else if collidesFrom(c, trip, w, legKm, startInside) then Err("collision")
  else if ringCrossing(c, trip, w, legKm) then Err("ring_crossing")
  else Ok({ arrivalLy: endLy, heading: scale(1.0 / legLy, dLy), trip: trip, nav: {nav | residual: residual} })
}
pure func navToLy(v: Vec3) -> Vec3 = scale(1.0 / lyKm(), v)

-- Stop: arrive standoffKm from the body's centre at the arrival time.
pure func planStop(c: NavCtx, rq: BodyReq, f: Facts, n: int) -> Result[Leg, string] = planStopFrom(c, rq, f, n, false)
pure func planStopFrom(c: NavCtx, rq: BodyReq, f: Facts, n: int, startInside: bool) -> Result[Leg, string] {
  let asked = match rq.standoffKm { Some(x) => x, None => defaultStopKm(rq.id, f.radiusKm, c.bubbleKm) };
  let maxS = if rq.id=="acen-a" || rq.id=="acen-b" || isDestinationStar(rq.id) then 10.0 * auKm() else standoffMaxKm();
  let s = if asked > maxS then maxS else asked;
  if !(s >= safetyMinKm(f.radiusKm, c.bubbleKm)) then Err("too_close")
  else if !(norm(sub(navPosAt(c, rq.id, c.t0), navHereKm(c))) > s) then Err("out_of_range")
  else {
    let tA = stopArrivalT(c, rq.id, s, rq.cruisePhi, n);
    let aim = stopAim(c, rq.id, s, tA);
    let tNext = c.t0 + (navTripOf(c, aim.legKm, rq.cruisePhi)).trip.galaxyTime;
    let res = norm(sub((stopAim(c, rq.id, s, tNext)).pointKm, aim.pointKm)) / aim.legKm;
    let arrive = c.t0 + (navTripLy(c, norm(sub(navToLy(aim.pointKm), c.hereLy)), rq.cruisePhi)).trip.galaxyTime;
    navFinishFrom(c, aim.pointKm, rq.cruisePhi, res,
      { bodyId: rq.id, index: f.index, mode: "stop", t0: c.t0, interceptT: arrive, interceptLy: navToLy(navPosAt(c, rq.id, arrive)), standoffKm: s, pass: None, residual: res }, startInside)
  }
}

-- Flyby: pass at bKm on the side clockDeg at cruise speed, stop runOut beyond.
pure func planFlyby(c: NavCtx, rq: BodyReq, f: Facts, n: int) -> Result[Leg, string] {
  let runOut = match rq.runOutKm { Some(x) => x, None => defaultRunOutKm(c, rq.cruisePhi) };
  if !(rq.bKm >= safetyMinKm(f.radiusKm, c.bubbleKm)) then Err("too_close")
  else if !(runOut > 0.0) || !navFinite(rq.clockDeg) || !(norm(sub(navPosAt(c, rq.id, c.t0), navHereKm(c))) > 2.0 * rq.bKm) then Err("out_of_range")
  else {
    let tP = flybyPassT(c, rq, runOut, n);
    let a = passAim(c, rq, runOut, tP);
    let trip = navTripLy(c, norm(sub(navToLy(a.endKm), c.hereLy)), rq.cruisePhi);
    let tauP = tauAtX(trip, a.toPassKm / lyKm());
    let m = motionAt(trip, tauP);
    let tPass = c.t0 + m.t;
    let res = norm(sub((passAim(c, rq, runOut, tPass)).pointKm, a.pointKm)) / a.legKm;
    let w = navUnit(sub(a.endKm, navHereKm(c)));
    let bodyThen = navPosAt(c, rq.id, tPass);
    let pass = { t: tPass, bKm: rq.bKm, beta: betaOf(m.phi), dAtPass: doppler(navUnit(sub(bodyThen, a.pointKm)), w, m.phi) };
    navFinish(c, a.endKm, rq.cruisePhi, res,
      { bodyId: rq.id, index: f.index, mode: "flyby", t0: c.t0, interceptT: tPass, interceptLy: navToLy(bodyThen), standoffKm: 0.0, pass: Some(pass), residual: res })
  }
}

-- A timed stop (D-46): from the straight distance to the stand-off point now,
-- the package solvers give the cruise rapidity (boost lasts boostS at
-- a = phi / boostS, cruise about cruiseS) and the approach (begins where the
-- body is approachDeg across, at least the stand-off out, lasts approachS).
-- The cruise may exceed the in-system 0.99c up to the session cap (capPhi).
-- If the approachDeg point lies before the brake (approach rapidity >= cruise),
-- the approach starts at half the cruise rapidity instead.
pure func navStandoff(c: NavCtx, rq: BodyReq, f: Facts) -> float {
  let asked = match rq.standoffKm { Some(x) => x, None => defaultStopKm(rq.id, f.radiusKm, c.bubbleKm) };
  let maxS = if rq.id=="acen-a" || rq.id=="acen-b" || isDestinationStar(rq.id) then 10.0 * auKm() else standoffMaxKm();
  if asked > maxS then maxS else asked
}
pure func yearS() -> float = 31557600.0
pure func planTimedStop(c: NavCtx, rq: BodyReq, tm: Timing, f: Facts, n: int) -> Result[Leg, string] {
  let s = navStandoff(c, rq, f);
  let dKm = norm(sub(navPosAt(c, rq.id, c.t0), navHereKm(c))) - s;
  let tB = tm.boostS / yearS();
  let phi = rapidityForTimedLeg(dKm / lyKm(), tB, tm.cruiseS / yearS());
  let xKm = f.radiusKm / sin(tm.approachDeg * 3.141592653589793 / 360.0) - s;
  let xA = if xKm > s then xKm else s;
  let tA = tm.approachS / yearS();
  let phiA = rapidityForTimedApproach(xA / lyKm(), tA);
  -- A body already approachDeg across before the brake could begin (the Sun) still
  -- gets an approachS-long approach, from half the cruise rapidity.
  let phiUse = if phiA < phi then phiA else 0.5 * phi;
  let ap = if phiUse > 0.0 && tA > 0.0 then Some({ a: phiUse / tA, phi: phiUse }) else None;
  if !(tB > 0.0) || !(tm.cruiseS >= 0.0) || !(phi >= bodyPhiMin()) || !(phi <= c.capPhi) then Err("out_of_range")
  else planStop({c | accel: phi / tB, approach: ap}, {rq | cruisePhi: phi}, f, n)
}

-- ------------------------------------------------------------ a stop beside a planet
-- trappist1-planets-sprint.md (TB5): a stop at TRAPPIST-1 keeps its stand-off r from
-- the star (D-47: the habitable zone, sqrt(L) AU) but is placed on that sphere beside
-- the planet that looks largest there while more than half lit. The planner's own
-- stop geometry places it: a stop s short of planet P on the line from the ship lands
-- at P - s u, on the sphere when s^2 - 2 s (p.u) + |p|^2 - r^2 = 0 (p: P about the
-- star; u: the leg's direction). The nearer root above the planet's safety minimum is
-- taken; P is more than half lit from there when p.u > 0. The arrival time comes from
-- the planner itself: the plain star stop's, then three planner rounds (each moves the
-- arrival by about v_planet / c of the last). It is reported as the stop at the star
-- with stand-off r. With no planet reachable it is the plain star stop.
type Anchor = { id: string, s: float, score: float }
pure func anchorAt(c: NavCtx, id: string, r: float, t: float) -> Option[Anchor] {
  let star = navPosAt(c, trappistHostId(), t);
  let p = sub(navPosAt(c, id, t), star);
  let h = sub(navHereKm(c), star);
  let u = navUnit(sub(p, h));
  let pu = dot(p, u);
  let disc = pu * pu - dot(p, p) + r * r;
  let minS = safetyMinKm(planetRadiusKm(id), c.bubbleKm);
  if disc < 0.0 || !(pu > 0.0) then None else {
    let lo = pu - sqrt(disc);
    let s = if lo >= minS then lo else pu + sqrt(disc);
    if s >= minS && s < norm(sub(p, h)) then Some({ id: id, s: s, score: planetRadiusKm(id) / s }) else None
  }
}
pure func betterAnchor(acc: Option[Anchor], a: Option[Anchor]) -> Option[Anchor] =
  match a { None => acc, Some(x) => match acc { None => a, Some(y) => if x.score > y.score then a else acc } }
export pure func bestAnchorId(c: NavCtx, r: float, t: float) -> string =
  match navFold(\acc id. betterAnchor(acc, anchorAt(c, id, r, t)), None, trappistPlanetIds()) { Some(a) => a.id, None => "" }
pure func planStopKind(c: NavCtx, rq: BodyReq, f: Facts, n: int) -> Result[Leg, string] =
  match rq.timing { Some(tm) => planTimedStop(c, rq, tm, f, n), None => if navPhiOk(rq.cruisePhi) then planStop(c, rq, f, n) else Err("out_of_range") }
pure func anchoredRound(c: NavCtx, rq: BodyReq, id: string, r: float, t: float, n: int, k: int) -> Result[Leg, string] =
  match (anchorAt(c, id, r, t), factsOf(trappistFacts(c.sys), id)) {
    (Some(a), Some(fa)) => match planStopKind(c, {rq | id: id, standoffKm: Some(a.s)}, fa, n) {
      Err(why) => Err(why),
      Ok(l) => if k <= 1 then Ok(l) else anchoredRound(c, rq, id, r, l.nav.interceptT, n, k - 1)
    },
    _ => Err("no_converge")
  }
pure func planBesidePlanet(c: NavCtx, rq: BodyReq, f: Facts, n: int) -> Result[Leg, string] =
  match planStopKind(c, rq, f, n) {
    Err(why) => Err(why),
    Ok(base) => {
      let r = navStandoff(c, rq, f);
      let id = bestAnchorId(c, r, base.nav.interceptT);
      if id == "" then Ok(base) else match anchoredRound(c, rq, id, r, base.nav.interceptT, n, 3) {
        Err(why) => Err(why),
        Ok(l) => Ok({l | nav: {l.nav | bodyId: rq.id, index: f.index, standoffKm: r, interceptLy: navToLy(navPosAt(c, rq.id, l.nav.interceptT))}})
      }
    }
  }

-- A body plan with n intercept iterations (tests vary n; the game uses 12).
-- Refusals, in order: not_visitable, out_of_range (cruise speed, mode,
-- run-out, already inside the stand-off), too_close, no_converge, collision,
-- ring_crossing. `committed` is core.ail's (the commit rule).
export pure func planBodyN(c: NavCtx, rq: BodyReq, n: int) -> Result[Leg, string] =
  -- Bounded Solar demo adapter: measured Sun, stop only. The original stop
  -- solver and geometric checks apply; no new emitter flyby or stellar model.
  match (if c.sys.id == "sol" && rq.id == "sun" && rq.mode == "stop" && c.sys.star.id == "sun" && c.sys.star.radiusKm > 0.0
    then Ok({id: "sun", index: 0, radiusKm: c.sys.star.radiusKm, ringKm: 0.0, visitable: true})
    else if c.sys.id=="sol" && (rq.id=="acen-a" || rq.id=="acen-b") && rq.mode=="stop" && norm(sub(c.hereLy,catalogueA()))<0.1 then match factsOf(alphaFacts(c.sys),rq.id) {Some(f)=>Ok(f),None=>Err("not_visitable")}
    else if c.sys.id=="sol" && rq.mode=="stop" && nearDestination(c, rq.id) then match factsOf(destinationFacts(c.sys),rq.id) {Some(f)=>Ok(f),None=>Err("not_visitable")}
    else targetFacts(c.sys, rq.id)) {
    Err(why) => Err(why),
    Ok(f) =>
      if rq.mode == "stop" && rq.id == trappistHostId() && nearDestination(c, rq.id) then planBesidePlanet(c, rq, f, n) else
      match rq.timing {
        Some(tm) => if rq.mode == "stop" then planTimedStop(c, rq, tm, f, n) else Err("out_of_range"),
        None =>
      if !navPhiOk(rq.cruisePhi) then Err("out_of_range")
      else if rq.mode == "stop" then planStop(c, rq, f, n)
      else if rq.mode == "flyby" then planFlyby(c, rq, f, n)
      else Err("out_of_range")
      }
  }
export pure func planBody(c: NavCtx, rq: BodyReq) -> Result[Leg, string] = planBodyN(c, rq, interceptIterations())

-- A body plan made at galaxy time t0 is stale at any other time (the body has
-- moved); a star plan never is (M2's rule: position only).
export pure func staleAt(nav: Option[NavPlan], t: float) -> bool = match nav { Some(n) => n.t0 != t, None => false }

-- ------------------------------------------------------------ D-54 free-navigation stops
-- A free-navigation star leg to a star with a cited finite body (sim/data/acen.ail,
-- sim/data/stars.ail) stops at that body, where it looks 2 atan(tan 5 deg sqrt(R / R_sun))
-- across (defaultStopKm); Sol, home, stops at Earth's D-54 stop (30 degrees across), so the
-- Solar System is around the ship. Other catalogue stars have no radius here yet (their
-- inference needs a bolometric correction the packages do not have) and keep standoff_au.
export pure func finiteStopBody(catalogueId: string) -> string =
  if catalogueId == "Sol" then "earth"
  else if catalogueId == alphaCatalogueId("acen-a") then "acen-a"
  else if catalogueId == alphaCatalogueId("acen-b") then "acen-b"
  else navFold(\acc d. if acc == "" && destinationCatalogueId(d) == catalogueId then d else acc, "", destinationIds())
-- The leg is an ordinary stop (planStop: intercept, collision and ring checks) at the
-- star plan's cruise rapidity, up to the session cap (interstellar, so not bodyPhiMax).
export pure func planFiniteStop(c: NavCtx, catalogueId: string, phi: float) -> Result[Leg, string] {
  let id = finiteStopBody(catalogueId);
  match factsOf(allFacts(c.sys) ++ alphaFacts(c.sys) ++ destinationFacts(c.sys), id) {
    None => Err("not_visitable"),
    Some(f) =>
      if !(phi == phi) || phi < bodyPhiMin() || phi > c.capPhi then Err("out_of_range")
      else planStopFrom(c, { id: id, cruisePhi: phi, mode: "stop", standoffKm: None, bKm: 0.0, clockDeg: 0.0, runOutKm: None, timing: None }, f, interceptIterations(), true)
  }
}
