module stapledons/sim/crew_resources

-- R2-CREW C3 (design crew-integration.md §CI-2): the eight bubble resources at crew scale
-- (stapledons-design bubble-resources.md §6, D-69). Since crew_core 0.5.0 the rules live in
-- the package (crew_core/units: allocate, lintPack, lintAgainstShip, usedOf, each taking the
-- table first); the game owns only its table, here, and the ship's spare capacity.
--
-- The crew's pool stays as the scenario authors it: those are the units the ship has handed to
-- crew work, and the lab's claims are verified on exactly those numbers. The ship is the cap:
-- at new game every scenario resource must be one of the eight with the right kind, and its
-- opening units must fit within what the ship can spare (mass from the ledger's availableKg, the
-- rest from sim/data/crew_ship.ail). bubble-resources §6: units "later read straight from the
-- ship's ledger" (the resource-ledger milestone).
import std/list (map)
import std/option (Option)
import std/math (floatToInt)
import pkg/sunholo/crew_core/scenario (Scenario)
import pkg/sunholo/crew_core/units (UnitTable, UnitDef, Amount, Used, unitOf, allocate as uAllocate, lintPack as uLintPack, lintAgainstShip as uLintAgainstShip, usedOf as uUsedOf)
import stapledons/sim/data/crew_ship (shipAmounts)

export pure func bubbleResources() -> [UnitDef] = [
  { id: "mass", kind: "stock", unit: "10 kg block", physical: "kg", per: 10 },
  { id: "water", kind: "stock", unit: "1 t", physical: "kg", per: 1000 },
  { id: "power", kind: "capacity", unit: "50 kW of headroom", physical: "kW", per: 50 },
  { id: "heat", kind: "capacity", unit: "50 kW of headroom", physical: "kW", per: 50 },
  { id: "garden", kind: "capacity", unit: "100 m2 of lit beds", physical: "m2", per: 100 },
  { id: "fabrication", kind: "capacity", unit: "one bay for one shift", physical: "bay-shifts", per: 1 },
  { id: "compute", kind: "capacity", unit: "one Archive slot", physical: "slots", per: 1 },
  { id: "signal", kind: "capacity", unit: "one antenna window", physical: "windows", per: 1 }
]
pure func bubble() -> UnitTable = { name: "bubble", units: bubbleResources() }

export pure func bubbleOf(id: string) -> Option[UnitDef] = unitOf(bubble(), id)
export pure func allocate(ship: [Amount]) -> [Amount] = uAllocate(bubble(), ship)

-- The ship's spare capacity in crew units: mass from the ledger, the rest from crew_ship.
export pure func shipUnits(availableKg: float) -> [Amount] =
  allocate({ id: "mass", value: if availableKg > 0.0 then floatToInt(availableKg) else 0 } :: map(\s. { id: s.id, value: s.value }, shipAmounts()))

export pure func lintPack(sc: Scenario) -> [string] = uLintPack(bubble(), sc)
export pure func lintAgainstShip(sc: Scenario, ship: [Amount]) -> [string] = uLintAgainstShip(bubble(), sc, ship)
-- What the crew have used, in physical units (the design's crew.used readout; not enforced
-- against the ledger in R2).
export pure func usedOf(consumed: [Amount]) -> [Used] = uUsedOf(bubble(), consumed)
