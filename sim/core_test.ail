module stapledons/sim/core_test

import ./core (Ship, initShip, step, turn, position, scriptedOffAxis, beta,
  World, Params, Ledger, Journey, Idle, Planned, Committed, Arrived, Plan, Commitment, ShipPhase, AtRest, Boosting, Cruising, Braking,
  Intent, IPlan, ICommit, IThrust, IHeading, ICancel, IRecord, IDraw, IEcho, IAiOpen, IAiCancel, Target, PlanReq, Refusal, Event, Crossing, Residuals, TickInput, Ticked,
  PlanView, JourneyView, journeyView, minutesPerYear, arrivalResiduals,
  defaultParams, newWorld, tick, derivePhase, phaseName, scenarioError, restTolerance, availableKgStart)
import ./rng (Rng, Stream, SJourney, SCrew, SEvents, SGalaxy, SAi, SNews, value, top53, zeroRng)
import pkg/sunholo/relativity/optics (Vec3)
import pkg/sunholo/relativity/medium (photonDriveEnergy, mirrorDragPower, julianYearS, cSI, tripEnergy)
import pkg/sunholo/relativity/kinematics (rapidityOfOneMinusBeta, rapidityOfBeta, oneMinusBeta, standardGravity)
import pkg/sunholo/relativity/journey (planBurnCoastBurn, planFlipAndBurn, motionAt)
import std/math (sqrt, floatToInt, intToFloat)
import std/option (Option, Some, None)
import std/string (join, intToStr)
import pkg/sunholo/relativity/hyper (cosh, absf)

pure func checkTurnAtRest() -> bool {
  let s = step(initShip(), 0.0000000005, 1.0);
  let r = turn(s, {x: 1.0, y: 0.0, z: 0.0});
  r.accepted && r.ship.motion.phi == 0.0
}
pure func checkMovingTurnRejected() -> bool {
  let s = step(initShip(), 1.0, 1.0);
  let r = turn(s, {x: 1.0, y: 0.0, z: 0.0});
  !r.accepted && r.ship.motion.phi == s.motion.phi && r.ship.motion.x == s.motion.x && r.ship.heading.z == s.heading.z
}
pure func checkPositionAfterTurn() -> bool {
  let s = step(initShip(), 1.0, 1.0);
  let rest = step(s, -1.0, 1.0);
  let p = position(rest);
  let t = turn(rest, {x: 1.0, y: 0.0, z: 0.0}).ship;
  let out = step(t, 1.0, 1.0);
  let q = position(out);
  q.x > 0.0 && q.z == p.z && q.y == 0.0
}
pure func checkScriptedOffAxis() -> bool {
  let g = 1.032295275553596;
  let d = 2.0 * (cosh(g * 1.0) - 1.0) / g;
  let got = scriptedOffAxis(100);
  got > sqrt(2.0) * d - 0.000000001 && got < sqrt(2.0) * d + 0.000000001
}

-- ------------------------------------------------------------ M2.2 world
pure func diagWorld() -> World = newWorld(7, true, defaultParams())
pure func go(w: World, thrust: float, dtau: float) -> World = tick(w, {dtau: dtau, intents: [IThrust(thrust)]}).world
pure func goN(w: World, thrust: float, dtau: float, n: int) -> World = if n <= 0 then w else goN(go(w, thrust, dtau), thrust, dtau, n - 1)
pure func rel(a: float, b: float, tol: float) -> bool = absf(a - b) <= tol * absf(b)

-- Closed mass budget (higgs-bubble §8): no tick sequence changes available_kg.
pure func checkMassClosed() -> bool {
  let w0 = diagWorld();
  let boosted = goN(w0, 1.0, 0.01, 50);
  let cruised = goN(boosted, 0.0, 0.5, 4);
  let braked = goN(cruised, -1.0, 0.01, 50);
  let turned = tick(braked, {dtau: 0.0, intents: [IHeading({x: 1.0, y: 0.0, z: 0.0}), ICancel, IDraw(SNews)]}).world;
  let play = goN(newWorld(1, false, defaultParams()), 1.0, 0.1, 3);
  availableKgStart() == 20000.0 && w0.ledger.availableKg == 20000.0 && boosted.ledger.availableKg == 20000.0 &&
  cruised.ledger.availableKg == 20000.0 && braked.ledger.availableKg == 20000.0 && turned.ledger.availableKg == 20000.0 &&
  play.ledger.availableKg == 20000.0 && braked.ledger.boostJ > 0.0 && cruised.ledger.dragJ > 0.0
}

-- |phi| < 1e-9 is AtRest (the turn threshold). A tolerance mutated to 0.5
-- would call phi = 1e-8 and 0.4 at rest; both must be moving.
pure func checkPhaseDerivedDiag() -> bool {
  restTolerance() == 0.000000001 &&
  derivePhase(0.0, 0.0) == AtRest && derivePhase(0.0000000005, 1.0) == AtRest && derivePhase(-0.0000000005, -1.0) == AtRest &&
  derivePhase(0.00000001, 0.0) == Cruising && derivePhase(0.4, 0.0) == Cruising && derivePhase(-0.4, 0.0) == Cruising &&
  derivePhase(0.4, 1.0) == Boosting && derivePhase(-0.4, -1.0) == Boosting &&
  derivePhase(0.4, -1.0) == Braking && derivePhase(-0.4, 1.0) == Braking &&
  phaseName(AtRest) == "at_rest" && phaseName(Boosting) == "boosting" && phaseName(Cruising) == "cruising" && phaseName(Braking) == "braking"
}

-- M1.6a follow-up (M1.6b): the turn's rest tolerance is pinned at 1e-9 on
-- both sides. A turn at phi = 0.9e-9 is accepted (and snaps phi to 0); at
-- 1.1e-9 the turn is refused and, through a diag tick, reported `moving`
-- with the ship unchanged. A tolerance raised to 0.5 (or lowered to 1e-10)
-- fails one side.
pure func checkRestToleranceEdge() -> bool {
  let w = plWorld(true, defaultParams());
  let s = w.ship;
  let below = {s | motion: {phi: 0.0000000009, tau: 0.0, t: 0.0, x: 0.0}};
  let above = {s | motion: {phi: 0.0000000011, tau: 0.0, t: 0.0, x: 0.0}};
  let east = {x: 1.0, y: 0.0, z: 0.0};
  let ok = turn(below, east);
  let no = turn(above, east);
  let tb = plDo({w | ship: below}, [IHeading(east)]);
  let ta = plDo({w | ship: above}, [IHeading(east)]);
  ok.accepted && ok.ship.motion.phi == 0.0 && ok.ship.heading.x == 1.0 &&
  !no.accepted && no.ship.motion.phi == 0.0000000011 && no.ship.heading.z == -1.0 &&
  refusalsAre(tb.refused, []) && tb.world.ship.heading.x == 1.0 && tb.world.ship.motion.phi == 0.0 &&
  refusalsAre(ta.refused, ["0:moving"]) && ta.world.ship.heading.z == -1.0 && ta.world.ship.motion.phi == 0.0000000011
}

-- The world's phase follows the diag thrust; tick and ship tick move together.
pure func checkWorldPhases() -> bool {
  let w0 = diagWorld();
  let b = go(w0, 1.0, 0.1);
  let c = go(b, 0.0, 0.1);
  let r = go(c, -1.0, 0.1);
  let idle = go(newWorld(7, false, defaultParams()), 1.0, 0.1);
  w0.tick == 0 && w0.ship.phase == AtRest && isIdle(w0.journey) && w0.seed == 7 && w0.diag &&
  b.ship.phase == Boosting && c.ship.phase == Cruising && r.ship.phase == AtRest &&
  r.tick == 3 && idle.ship.phase == AtRest && idle.tick == 1 && idle.ship.motion.phi == 0.0
}

-- Ledger accumulation: boost/brake add m_eff c^2 |dphi|; cruise adds the
-- drag-holding power times dtau in seconds. Values from the package only.
pure func checkLedgerDiag() -> bool {
  let p = defaultParams();
  let b = go(diagWorld(), 1.0, 0.25);
  let phi = b.ship.motion.phi;
  let c = go(b, 0.0, 0.5);
  let r = go(c, -1.0, 0.25);
  let drag = mirrorDragPower(p.ismNCm3 * 1000000.0, phi, p.bubbleRadiusM) * 0.5 * julianYearS();
  rel(b.ledger.boostJ, photonDriveEnergy(1.0, phi), 0.000000000001) && b.ledger.dragJ == 0.0 &&
  c.ledger.boostJ == b.ledger.boostJ && rel(c.ledger.dragJ, drag, 0.000000000001) &&
  rel(r.ledger.boostJ, 2.0 * photonDriveEnergy(1.0, phi), 0.000000001) && r.ledger.dragJ == c.ledger.dragJ &&
  b.ledger.mEffKg == 1.0 && checkLedgerMEff()
}
-- The ledger uses the scenario's m_eff, not a constant 1 kg.
pure func checkLedgerMEff() -> bool {
  let d = defaultParams();
  let b = go(newWorld(7, true, {d | mEffKg: 0.5}), 1.0, 0.25);
  b.ledger.mEffKg == 0.5 && rel(b.ledger.boostJ, photonDriveEnergy(0.5, b.ship.motion.phi), 0.000000000001)
}

-- Scenario rule: the brake must hold against the drag at the cap
-- (V12: threshold 0.0321 kg at the sol defaults).
pure func checkScenarioMEff() -> bool {
  let d = defaultParams();
  scenarioError(d) == None && scenarioError({d | mEffKg: 0.033}) == None &&
  scenarioError({d | mEffKg: 0.03}) == Some("m_eff_too_small") && scenarioError({d | mEffKg: 0.032}) == Some("m_eff_too_small")
}

-- Rng counters start at zero.
pure func checkRngZero() -> bool {
  let r = diagWorld().rng;
  r.journey == 0 && r.crew == 0 && r.events == 0 && r.galaxy == 0 && r.ai == 0 && r.news == 0
}

-- Refusals in a non-diag world: thrust/heading/draw are diag_only (cancel
-- with no plan is a no-op since M2.3a); the
-- tick proceeds and no stream counter moves.
pure func checkTickRefusals() -> bool {
  let t = tick(newWorld(1, false, defaultParams()), {dtau: 0.5, intents: [IThrust(1.0), IHeading({x: 1.0, y: 0.0, z: 0.0}), ICancel, IDraw(SNews)]});
  t.world.tick == 1 && refusalsAre(t.refused, ["0:diag_only", "1:diag_only", "3:diag_only"]) && t.world.ship.motion.tau == 0.5 && isIdle(t.world.journey) &&
  t.world.rng.news == 0 && drawnText(t.events) == []
}
-- Draw (diag, M2.4): each draw reports (stream, counter, top 53 bits of the
-- value at that counter) in order and advances only its own stream; the
-- counters persist across ticks, so the next draw continues the sequence.
pure func drawnText(es: [Event]) -> [string] =
  match es { [] => [], e :: rest => (match e.drew { Some(d) => join(":", [e.kind, d.stream, intToStr(d.n), intToStr(d.value)]), None => e.kind }) :: drawnText(rest) }
pure func drawnWant(s: Stream, name: string, n: int) -> string = join(":", ["draw", name, intToStr(n), intToStr(top53(value(7, s, n)))])
pure func checkDrawIntent() -> bool {
  let t1 = tick(diagWorld(), {dtau: 0.0, intents: [IDraw(SNews), IDraw(SNews), IDraw(SJourney)]});
  let t2 = tick(t1.world, {dtau: 0.0, intents: [IDraw(SNews), IDraw(SAi)]});
  let r = t2.world.rng;
  join(",", drawnText(t1.events)) == join(",", [drawnWant(SNews, "news", 0), drawnWant(SNews, "news", 1), drawnWant(SJourney, "journey", 0)]) &&
  join(",", drawnText(t2.events)) == join(",", [drawnWant(SNews, "news", 2), drawnWant(SAi, "ai", 0)]) &&
  drawnWant(SNews, "news", 0) == "draw:news:0:5208588083530661" &&
  r.news == 3 && r.journey == 1 && r.ai == 1 && r.crew == 0 && r.events == 0 && r.galaxy == 0 &&
  refusalsAre(t1.refused, []) && refusalsAre(t2.refused, []) && t2.world.tick == 2
}
pure func refusalsAre(rs: [Refusal], want: [string]) -> bool =
  join(",", refusalText(rs)) == join(",", want)
pure func refusalText(rs: [Refusal]) -> [string] = match rs { [] => [], r :: rest => join(":", [intToStr(r.i), r.reason]) :: refusalText(rest) }

-- ------------------------------------------------------------ M2.3a planner, readouts, commit rule
-- Check rows: design m2-journey-core §M2.0 (trip rows 1-9, readout table),
-- canon higgs-bubble HB-16...29, HB-35...63 (pre-planning finding 1).
pure func isIdle(j: Journey) -> bool = match j { Idle => true, _ => false }
pure func plCommitted(j: Journey) -> bool = match j { Committed(_) => true, _ => false }
pure func plOf(w: World) -> Option[Plan] = match w.journey { Planned(p) => Some(p), _ => None }
pure func plId(w: World) -> int = match w.journey { Planned(p) => p.id, Committed(c) => c.plan.id, Arrived(c) => c.plan.id, Idle => 0 }
pure func plAcen() -> Target = {index: 1, id: "Gl 559", pos: {x: 0.0, y: 0.0, z: -4.37}}
pure func plAt(d: float) -> Target = {index: 9, id: "probe", pos: {x: d, y: 0.0, z: 0.0}}
-- M1.7: alpha Cen A as data/starmap/stars.json carries it (CNS5:3627, the CNS5 system parallax, D-19).
pure func plAcenA() -> Target = {index: 2, id: "CNS5:3627", pos: {x: 3.094521, y: -3.015404, z: -0.051608}}
pure func plCruise(t: Target, phi: float) -> Intent = IPlan({target: t, cruisePhi: phi, flipG: None})
pure func plFlip(t: Target, g: float) -> Intent = IPlan({target: t, cruisePhi: 2.0, flipG: Some(g)})
pure func plDo(w: World, xs: [Intent]) -> Ticked = tick(w, {dtau: 0.0, intents: xs})
pure func plWorld(diag: bool, p: Params) -> World = newWorld(3, diag, p)
pure func phi09() -> float = 1.4722194895832204
pure func phi099() -> float = 2.6466524123622457
pure func plPhiCap() -> float = rapidityOfOneMinusBeta(0.000001)
pure func tol9() -> float = 0.000000001

-- A plan's trip equals (ship-yr, Earth-yr) to 1e-9 relative.
pure func plTrip(w: World, ship: float, earth: float) -> bool =
  match plOf(w) { Some(p) => rel(p.trip.trip.shipTime, ship, tol9()) && rel(p.trip.trip.galaxyTime, earth, tol9()), None => false }
pure func plField(w: World, g: Plan -> bool) -> bool = match plOf(w) { Some(p) => g(p), None => false }

-- Rows 1-3: alpha Cen (4.37 ly) burn-coast-burn at the scenario's boost_g (7.5e5 g).
pure func checkPlanCruise09() -> bool {
  let w = plDo(plWorld(false, defaultParams()), [plCruise(plAcen(), phi09())]).world;
  phi09() == rapidityOfBeta(0.9) && plTrip(w, 2.116489782091437, 4.8555571747021204) &&
  plField(w, \p. p.trip.phiPeak == phi09() && !p.trip.fellBack && p.trip.trip.distance == 4.37 && !p.flip && p.id == 1 &&
    rel(p.trip.a, 750000.0 * standardGravity(), 0.000000000000001))
}
pure func checkPlanCruise099() -> bool {
  let w = plDo(plWorld(false, defaultParams()), [plCruise(plAcen(), phi099())]).world;
  plTrip(w, 0.6226958707592057, 4.414143655383168) && plField(w, \p. p.trip.phiPeak == phi099() && !p.trip.fellBack)
}
pure func checkPlanCruiseCap() -> bool {
  let w = plDo(plWorld(false, defaultParams()), [plCruise(plAcen(), plPhiCap())]).world;
  plPhiCap() == 7.254328619262047 && plTrip(w, 0.006196277986522204, 4.370006949593909) &&
  plField(w, \p. rel(p.trip.trip.peakGamma, 707.106957963309, tol9()) && !p.trip.fellBack)
}
-- Rows 6-7 (diag flip_g, the 1 g flip-and-burn check profile, HB-27...29).
pure func checkPlanAlphaCen() -> bool {
  let w = plDo(plWorld(true, defaultParams()), [plFlip(plAcen(), 1.0)]).world;
  plTrip(w, 3.5823937227478337, 6.00250277725247) &&
  plField(w, \p. p.flip && rel(p.trip.trip.peakBeta, 0.9516558449006334, tol9()) && rel(p.trip.trip.peakGamma, 3.2555651770846072, tol9()) && p.trip.tauCoast == 0.0)
}
-- Catalogue doubles (stars.json CNS5:3627, M1.7): d is a float64 scalar, bit for bit
-- (float32-rounded positions would move d by 2.3e-8 ly). Expected values: the 1 g flip-and-burn
-- closed form tau = 2 c/g acosh(1 + g d / 2c^2), t = 2 c/g sinh(...), beta = tanh(...).
pure func checkPlanAcenA() -> bool {
  let w = plDo(plWorld(true, defaultParams()), [plFlip(plAcenA(), 1.0)]).world;
  plTrip(w, 3.566522686148632, 5.951034407059531) &&
  plField(w, \p. p.trip.trip.distance == 4.32103979249451 && rel(p.trip.trip.peakBeta, 0.9508768841337906, tol9()) && p.target.id == "CNS5:3627")
}
-- Row 8: 100 ly, boost_g 1 g, cruise 0.99c.
pure func checkPlanCoast100() -> bool {
  let w = plDo(plWorld(false, {defaultParams() | boostG: 1.0}), [plCruise(plAt(100.0), phi099())]).world;
  plTrip(w, 17.696001151818983, 102.69103232505418) && plField(w, \p. rel(p.trip.trip.peakGamma, 7.088812050083355, tol9()) && !p.trip.fellBack)
}
-- Rows 9 and 4: the cruise is unreachable, the plan falls back to flip-and-burn.
pure func checkPlanFallback() -> bool {
  let far = plDo(plWorld(false, {defaultParams() | boostG: 1.0}), [plCruise(plAt(1000.0), plPhiCap())]).world;
  let close = plDo(plWorld(false, defaultParams()), [plCruise(plAt(0.001), plPhiCap())]).world;
  plTrip(far, 13.448622327743177, 1001.9355569687548) && plField(far, \p. p.trip.fellBack && rel(p.trip.trip.peakGamma, 517.147637776798, tol9())) &&
  plTrip(close, 0.000017190007186656455, 0.001002579912238613) && plField(close, \p. p.trip.fellBack && rel(p.trip.phiPeak, 6.654436202069182, tol9()))
}

-- Readouts (design readout table; n = 1e5 m^-3, R = 100 m, m_eff 1 kg, eps 1e-10 (D-29 follow-up, 2026-10-03), f_in 1/2; the glow is 1/10 of the design table's eps 1e-9 values).
pure func plView(w: World) -> Option[PlanView] = (journeyView(w)).plan
pure func plViewOk(w: World, g: PlanView -> bool) -> bool = match plView(w) { Some(v) => g(v), None => false }
pure func plNear(a: float, b: float, absTol: float) -> bool = absf(a - b) <= absTol
pure func plRow(v: PlanView, boost: float, drag: float, total: float, kg: float, load: float, glow: float, force: float, hold: float, tf: float) -> bool =
  rel(v.energy.boostJ, boost, tol9()) && rel(v.energy.brakeJ, boost, tol9()) && rel(v.energy.dragJ, drag, tol9()) && rel(v.energy.totalJ, total, tol9()) &&
  plNear(v.energy.totalKg, kg, 0.0005 * kg) && rel(v.ism.loadWM2, load, tol9()) && rel(v.ism.glowWM2, glow, tol9()) &&
  rel(v.ism.dragN, force, tol9()) && rel(v.ism.holdW, hold, tol9()) && rel(v.cmbForwardK, tf, tol9())
pure func plPanel(phi: float) -> World = plDo(plWorld(false, defaultParams()), [plCruise(plAcen(), phi)]).world
pure func checkPlanReadouts() -> bool {
  let r09 = plViewOk(plPanel(phi09()), \v. plRow(v, 132316489050019360.0, 40314432176987310.0, 304947410277026050.0, 3.393, 19212.82874513549, 0.00000015052987296077217, 2.0133555741551197, 603588816.4039646, 11.877999621148337) &&
    plNear(v.boostMinutes, 1.00, 0.005) && rel(v.cruiseBeta, 0.9, tol9()));
  let r099 = plViewOk(plPanel(phi099()), \v. plRow(v, 237869256192685950.0, 137025773945911980.0, 612764286331283800.0, 6.818, 221961.27278927868, 0.0000024071942179266308, 23.25982143207345, 6973119039.76238, 38.44085554458952) &&
    plNear(v.boostMinutes, 1.80, 0.005) && rel(v.shipYears, 0.6226958707592057, tol9()) && rel(v.earthYears, 4.414143655383168, tol9()) &&
    rel(v.cruiseBeta, 0.99, tol9()) && rel(v.cruiseOneMinusBeta, 0.01, tol9()) && v.profile == "burn_coast_burn" && !v.fellBack && v.distance == 4.37);
  let rcap = plViewOk(plPanel(plPhiCap()), \v. plRow(v, 651986541482047200.0, 13800617973906030000.0, 15104591056870126000.0, 168.06, 2253353077.7286806, 0.02812710757763286, 236133.9415328578, 70791174749363.73, 3853.730994033574) &&
    plNear(v.boostMinutes, 4.93, 0.005) && rel(v.cruiseOneMinusBeta, 0.000001, tol9()) && rel(v.cruiseGamma, 707.106957963309, tol9()));
  r09 && r099 && rcap && checkPlanDerived() && checkPlanMEff() && checkOneMinusBetaReadout() && checkCommittedView()
}
-- Derived fields after a non-zero rest period (1.5 yr at rest; the clock
-- never pauses, D-12): arrive_year = year + Earth-yr, age_on_arrival = age +
-- ship-yr, years_left = 100 - (age - start_age) - ship-yr, boost_minutes = tauBurn * 525960.
pure func checkPlanDerived() -> bool {
  let p = {defaultParams() | epoch: 2100.0, startAge: 41.0};
  let rested = tick(plWorld(false, p), {dtau: 1.5, intents: []}).world;
  let w = plDo(rested, [plCruise(plAcen(), phi099())]).world;
  let t = rested.ship.motion.t;
  rested.ship.motion.tau == 1.5 && t == 1.5 &&
  plViewOk(w, \v. rel(v.arriveYear, 2100.0 + t + 4.414143655383168, tol9()) && rel(v.ageOnArrival, 41.0 + 1.5 + 0.6226958707592057, tol9()) &&
    rel(v.yearsLeft, 100.0 - 1.5 - 0.6226958707592057, tol9()) && minutesPerYear() == 525960.0 &&
    plField(w, \pl. v.boostMinutes == pl.trip.tauBurn * 525960.0 && v.earthYears == pl.trip.trip.galaxyTime))
}
-- The energy readouts use the scenario's m_eff (M2.2 follow-up): 0.5 kg
-- halves boost and brake; drag and the ISM readouts do not change.
pure func checkPlanMEff() -> bool {
  let half = plDo(plWorld(false, {defaultParams() | mEffKg: 0.5}), [plCruise(plAcen(), phi099())]).world;
  plViewOk(half, \v. rel(v.energy.boostJ, 0.5 * 237869256192685950.0, tol9()) && rel(v.energy.dragJ, 137025773945911980.0, tol9()) &&
    rel(v.energy.totalJ, 237869256192685950.0 + 137025773945911980.0, tol9()) && rel(v.ism.dragN, 23.25982143207345, tol9()))
}
-- cruise_one_minus_beta comes from the rapidity (oneMinusBeta), never 1 - beta:
-- with the cap moved to 1e-17, 1 - beta rounds to 0, the readout does not.
pure func checkOneMinusBetaReadout() -> bool {
  let p = {defaultParams() | capOneMinusBeta: 0.00000000000000001};
  let phi = rapidityOfOneMinusBeta(0.00000000000000001);
  let w = plDo(plWorld(false, p), [plCruise(plAt(10000.0), phi)]).world;
  plViewOk(w, \v. v.cruiseOneMinusBeta > 0.0 && rel(v.cruiseOneMinusBeta, 0.00000000000000001, tol9()) && v.cruiseOneMinusBeta == oneMinusBeta(phi) && v.cruiseBeta == 1.0)
}
-- A committed journey's readout is frozen at the commit (tau0, t0): flying
-- does not move the arrival year, nor does arriving.
pure func checkCommittedView() -> bool {
  let w = plDo(plWorld(false, defaultParams()), [plCruise(plAcen(), phi099())]).world;
  let c = plDo(w, [ICommit(1)]).world;
  let later = tick(c, {dtau: 0.3, intents: []}).world;
  let landed = tick(later, {dtau: 2.0, intents: []}).world;
  let a = journeyView(c);
  let b = journeyView(later);
  let d = journeyView(landed);
  a.state == "committed" && b.state == "committed" && d.state == "arrived" && a.planId == 1 && d.planId == 1 &&
  match a.plan { Some(x) => match b.plan { Some(y) => match d.plan { Some(z) => x.arriveYear == y.arriveYear && x.yearsLeft == y.yearsLeft && z.arriveYear == x.arriveYear &&
    rel(x.arriveYear, 4.414143655383168, tol9()), None => false }, None => false }, None => false }
}

-- Cruise range [rapidityOfBeta(cruise_min_beta), rapidityOfOneMinusBeta(cap)], both ends inclusive.
pure func plRefused(t: Ticked, why: string) -> bool = refusalsAre(t.refused, [join(":", ["0", why])])
pure func plAccepted(t: Ticked) -> bool = refusalsAre(t.refused, []) && plId(t.world) > 0
pure func checkCruiseRange() -> bool {
  let w = plWorld(false, defaultParams());
  let lo = rapidityOfBeta(0.9);
  let cap = plPhiCap();
  let above = cap + cap * 0.0000000000000002220446049250313;
  let below = lo - lo * 0.0000000000000002220446049250313;
  let custom = plWorld(false, {defaultParams() | cruiseMinBeta: 0.5, capOneMinusBeta: 0.01});
  let refusedFirst = plDo(w, [plCruise(plAcen(), above)]).world;
  plAccepted(plDo(w, [plCruise(plAcen(), lo)])) && plRefused(plDo(w, [plCruise(plAcen(), below)]), "out_of_range") &&
  plAccepted(plDo(w, [plCruise(plAcen(), cap)])) && plRefused(plDo(w, [plCruise(plAcen(), above)]), "out_of_range") &&
  above > cap && below < lo &&
  plRefused(plDo(w, [plCruise(plAcen(), 0.5)]), "out_of_range") && plRefused(plDo(w, [plCruise(plAcen(), 50.0)]), "out_of_range") &&
  plAccepted(plDo(custom, [plCruise(plAcen(), rapidityOfBeta(0.5))])) && plAccepted(plDo(custom, [plCruise(plAcen(), phi099())])) &&
  plRefused(plDo(custom, [plCruise(plAcen(), rapidityOfBeta(0.4))]), "out_of_range") && plRefused(plDo(custom, [plCruise(plAcen(), 3.0)]), "out_of_range") &&
  isIdle(refusedFirst.journey) && plId(plDo(refusedFirst, [plCruise(plAcen(), cap)]).world) == 1 &&
  plRefused(plDo(w, [plCruise(plAt(0.0), phi099())]), "out_of_range") && plRefused(plDo(plWorld(true, defaultParams()), [plFlip(plAt(0.0), 1.0)]), "out_of_range") &&
  plRefused(plDo(plWorld(true, defaultParams()), [plFlip(plAcen(), 0.0)]), "out_of_range")
}
-- flip_g, thrust and heading are diag-only (D-12); in diag they are accepted.
pure func checkDiagOnly() -> bool {
  let play = plWorld(false, defaultParams());
  let diag = plWorld(true, defaultParams());
  let t = plDo(play, [plFlip(plAcen(), 1.0), IThrust(1.0), IHeading({x: 1.0, y: 0.0, z: 0.0}), plCruise(plAcen(), phi099())]);
  let d = plDo(diag, [plFlip(plAcen(), 1.0), IHeading({x: 1.0, y: 0.0, z: 0.0}), IThrust(0.5)]);
  refusalsAre(t.refused, ["0:diag_only", "1:diag_only", "2:diag_only"]) && plId(t.world) == 1 && plField(t.world, \p. !p.flip) &&
  refusalsAre(d.refused, []) && plField(d.world, \p. p.flip)
}
-- A committed world: 4.37 ly along +x at 0.99c, committed at rest in a diag
-- session (so every diag intent would otherwise be accepted).
pure func plCommittedWorld() -> World = plDo(plDo(plWorld(true, defaultParams()), [plCruise(plAt(4.37), phi099())]).world, [ICommit(1)]).world
-- One of every Intent constructor (IPlan twice: cruise and diag flip).
pure func plEveryIntent() -> [Intent] = [plCruise(plAcen(), phi09()), plFlip(plAcen(), 1.0), ICommit(1), ICommit(2), ICancel, IThrust(1.0),
  IHeading({x: 0.0, y: 1.0, z: 0.0}), IRecord({source: "ai", req: "r", kind: "line", sha256: "00", body: "x"}), IDraw(SNews),
  IEcho({target: plAcen(), cruisePhi: 1.0, flipG: None})]
pure func plSameCommit(a: World, b: World) -> bool =
  match a.journey { Committed(x) => (match b.journey { Committed(y) => x.plan.id == y.plan.id && x.tau0 == y.tau0 && x.t0 == y.t0 && x.plan.trip.tauTotal == y.plan.trip.tauTotal, _ => false }), _ => false }
-- Since M2.3b the committed ship flies: a refused intent leaves the world
-- exactly as the autopilot alone leaves it (same ship, el, ledger).
pure func plSameFlight(a: World, b: World) -> bool {
  let m = a.ship.motion;
  let n = b.ship.motion;
  plSameCommit(a, b) && m.phi == n.phi && m.tau == n.tau && m.t == n.t && m.x == n.x && a.ship.phase == b.ship.phase &&
  a.ledger.boostJ == b.ledger.boostJ && a.ledger.dragJ == b.ledger.dragJ && a.lastPlanId == b.lastPlanId &&
  (match a.journey { Committed(x) => (match b.journey { Committed(y) => x.el == y.el, _ => false }), _ => false })
}
pure func plAllRefused(c: World, xs: [Intent]) -> bool = match xs {
  [] => true,
  x :: more => {
    let t = tick(c, {dtau: 0.25, intents: [x]});
    plRefused(t, "committed") && plSameCommit(c, t.world) && plSameFlight(t.world, tick(c, {dtau: 0.25, intents: []}).world) && plAllRefused(c, more)
  }
}
pure func checkCommittedRefusesAll() -> bool {
  -- D-20 (2026-10-02): every journey intent is refused `committed`; the AI
  -- intents are accepted and leave the flight exactly as the autopilot alone
  -- does. Index 7 is a record for a request never opened: ai_unknown_req (AI.3).
  -- (head and rest matched separately: `a :: b :: _` is evaluator-only on the strict VM, ailang#1505)
  let c = plCommittedWorld();
  let aiOpen = IAiOpen({kind: "text", purpose: "line", entityId: "medic", emotion: None, ageStage: None, lineReq: None, emotions: None, context: []});
  let aiIntents = [aiOpen, IAiCancel({req: "1", reason: "offline"})];
  let journeyIntents = [plCruise(plAcen(), phi09()), plFlip(plAcen(), 1.0), ICommit(1), ICommit(2), ICancel, IThrust(1.0),
    IHeading({x: 0.0, y: 1.0, z: 0.0}), IDraw(SNews), IEcho({target: plAcen(), cruisePhi: 1.0, flipG: None})];
  let all = tick(c, {dtau: 0.25, intents: plEveryIntent() ++ aiIntents});
  let alone = tick(c, {dtau: 0.25, intents: []}).world;
  let opened = tick(c, {dtau: 0.25, intents: [aiOpen]});
  plCommitted(c.journey) && plAllRefused(c, journeyIntents) &&
  refusalsAre(all.refused, ["0:committed", "1:committed", "2:committed", "3:committed", "4:committed", "5:committed", "6:committed", "7:ai_unknown_req", "8:committed", "9:committed"]) &&
  (match all.events { a :: rest => a.kind == "ai_request" && (match rest { b :: _ => b.kind == "ai_fallback", _ => false }), _ => false }) && all.world.ai.lastReq == 1 && all.world.rng.ai == 1 &&
  refusalsAre(opened.refused, []) && opened.world.ai.lastReq == 1 && plSameCommit(c, opened.world) && plSameFlight(opened.world, alone) &&
  plSameCommit(c, all.world) && plSameFlight(all.world, alone) && all.world.ship.phase == Cruising && all.world.tick == c.tick + 1 &&
  all.world.rng.news == 0 && all.world.rng.journey == 0
}
-- Commit: the at-rest turn to the plan heading, a committed event, tau0/t0
-- at the commit (a dtau 0 tick: the autopilot has not flown yet).
pure func checkCommitTurns() -> bool {
  let w = plDo(plWorld(false, defaultParams()), [plCruise(plAt(4.37), phi099())]).world;
  let t = tick(w, {dtau: 0.0, intents: [ICommit(1)]});
  let c = t.world;
  let h = c.ship.heading;
  plCommitted(c.journey) && refusalsAre(t.refused, []) && h.x == 1.0 && h.y == 0.0 && h.z == 0.0 &&
  (match t.events { [e] => e.kind == "committed", _ => false }) &&
  (match c.journey { Committed(x) => x.tau0 == 0.0 && x.t0 == 0.0 && x.plan.id == 1 && x.el == 0.0, _ => false }) &&
  c.ship.motion.phi == 0.0 && c.ship.phase == AtRest && position(c.ship).x == 0.0 && c.ship.x0 == c.ship.motion.x && checkCommitDropsThrust()
}
-- A diag thrust earlier in the commit's tick does not reach the drive: from
-- the commit on the autopilot owns it (the tick equals a commit-only tick).
pure func checkCommitDropsThrust() -> bool {
  let w = plDo(plWorld(true, defaultParams()), [plCruise(plAt(4.37), phi099())]).world;
  let t = tick(w, {dtau: 0.5, intents: [IThrust(1.0), ICommit(1)]});
  let plain = tick(w, {dtau: 0.5, intents: [ICommit(1)]}).world;
  refusalsAre(t.refused, []) && plCommitted(t.world.journey) && plSameFlight(t.world, plain) && t.world.ship.phase == Cruising
}
-- Commit while moving is refused `moving`, also when already heading at the
-- target; the plan stays.
pure func checkCommitMoving() -> bool {
  let moving = go(plWorld(true, defaultParams()), 1.0, 0.1);
  let t = plDo(moving, [plCruise(plAcen(), phi099()), ICommit(1)]);
  let along = plDo(moving, [plCruise({index: 2, id: "ahead", pos: {x: 0.0, y: 0.0, z: -9.0}}, phi099()), ICommit(1)]);
  refusalsAre(t.refused, ["1:moving"]) && plId(t.world) == 1 && !plCommitted(t.world.journey) &&
  refusalsAre(along.refused, ["1:moving"]) && !plCommitted(along.world.journey)
}
-- A plan_id that is not the current plan is refused `stale_plan`: no plan,
-- a replaced plan, a cancelled plan, or a plan made from another position.
pure func checkStalePlan() -> bool {
  let w = plWorld(true, defaultParams());
  let nothing = plDo(w, [ICommit(1)]);
  let replanned = plDo(w, [plCruise(plAcen(), phi099()), plCruise(plAcen(), phi09()), ICommit(1)]);
  let cancelled = plDo(w, [plCruise(plAcen(), phi099()), ICancel, ICommit(1)]);
  let wrong = plDo(w, [plCruise(plAcen(), phi099()), ICommit(7)]);
  let planned = plDo(w, [plCruise(plAcen(), phi099())]).world;
  let moved = go(go(planned, 1.0, 0.1), -1.0, 0.1);
  let elsewhere = plDo(moved, [ICommit(1)]);
  let ok = plDo(planned, [ICommit(1)]);
  refusalsAre(nothing.refused, ["0:stale_plan"]) && isIdle(nothing.world.journey) &&
  refusalsAre(replanned.refused, ["2:stale_plan"]) && plId(replanned.world) == 2 && !plCommitted(replanned.world.journey) &&
  refusalsAre(cancelled.refused, ["2:stale_plan"]) && isIdle(cancelled.world.journey) &&
  refusalsAre(wrong.refused, ["1:stale_plan"]) && !plCommitted(wrong.world.journey) &&
  absf(moved.ship.motion.phi) < restTolerance() && position(moved.ship).z < 0.0 && refusalsAre(elsewhere.refused, ["0:stale_plan"]) && !plCommitted(elsewhere.world.journey) &&
  refusalsAre(ok.refused, []) && plCommitted(ok.world.journey)
}
-- Plan ids increase monotonically from 1; a replan replaces the plan; cancel
-- clears it (a no-op with no plan); refused plans take no id.
pure func checkPlanIds() -> bool {
  let w = plWorld(false, defaultParams());
  let a = plDo(w, [plCruise(plAcen(), phi099())]).world;
  let b = plDo(a, [plCruise(plAt(10.0), phi09())]).world;
  let c = plDo(b, [ICancel]).world;
  let c2 = plDo(c, [ICancel]);
  let d = plDo(c, [plCruise(plAcen(), 0.1), plCruise(plAcen(), phi099())]).world;
  w.lastPlanId == 0 && isIdle(w.journey) && plId(a) == 1 && plId(b) == 2 && plField(b, \p. p.trip.trip.distance == 10.0 && p.trip.phiPeak == phi09()) &&
  isIdle(c.journey) && c.lastPlanId == 2 && refusalsAre(c2.refused, []) && isIdle(c2.world.journey) && plId(d) == 3 && d.lastPlanId == 3
}
-- The stored plan is the package's: equal to a direct planBurnCoastBurn /
-- planFlipAndBurn call bit for bit.
pure func checkPlanIsPackage() -> bool {
  let a = 750000.0 * standardGravity();
  let w = plDo(plWorld(true, defaultParams()), [plCruise(plAcen(), phi099())]).world;
  let f = plDo(plWorld(true, defaultParams()), [plFlip(plAcenA(), 1.0)]).world;
  let want = planBurnCoastBurn(4.37, a, phi099());
  let wantF = planFlipAndBurn(4.32103979249451, standardGravity());
  plField(w, \p. p.trip.tauTotal == want.tauTotal && p.trip.trip.galaxyTime == want.trip.galaxyTime && p.trip.dCoast == want.dCoast) &&
  plField(f, \p. p.trip.tauTotal == wantF.tauTotal && p.trip.trip.galaxyTime == wantF.trip.galaxyTime)
}


-- ------------------------------------------------------------ M2.3b autopilot, boundaries, arrival, ledger
-- A committed play world: plan to `t` at cruise phi with params p, commit.
pure func apCommitted(p: Params, t: Target, phi: float) -> World = plDo(plDo(plWorld(false, p), [plCruise(t, phi)]).world, [ICommit(1)]).world
pure func apCommit(w: World) -> Commitment = match w.journey { Committed(c) => c, Arrived(c) => c, _ => {plan: {id: 0, target: plAt(1.0), from: {x: 0.0, y: 0.0, z: 0.0}, heading: {x: 1.0, y: 0.0, z: 0.0}, flip: false, trip: planFlipAndBurn(1.0, 1.0), nav: None}, tau0: -1.0, t0: -1.0, el: -1.0} }
pure func isArrived(j: Journey) -> bool = match j { Arrived(_) => true, _ => false }
pure func wait(w: World, dtau: float) -> Ticked = tick(w, {dtau: dtau, intents: []})
-- |a - b| <= 1e-9 max(1, |b|)
pure func near9(a: float, b: float) -> bool = absf(a - b) <= tol9() * (if absf(b) > 1.0 then absf(b) else 1.0)
-- The stepped ship equals the package's motionAt at el: phi, and t and x
-- measured from the commit (x along the line from the rebase at the commit).
pure func apMatches(w: World) -> bool {
  let c = apCommit(w);
  let m = motionAt(c.plan.trip, c.el);
  let s = w.ship.motion;
  -- after arrival the leftover of the tick is spent at rest (t and tau advance together)
  if isArrived(w.journey) then s.phi == 0.0 && c.el == c.plan.trip.tauTotal && near9((s.t - c.t0) - ((s.tau - c.tau0) - c.el), m.t)
  else near9(s.phi, m.phi) && near9(s.t - c.t0, m.t) && near9(s.x - w.ship.x0, m.x) && near9(s.tau - c.tau0, c.el)
}
-- Fly 0.01-yr ticks to arrival, checking every tick end against motionAt;
-- returns the arrival tick (or -1 on a mismatch or no arrival in n ticks).
type Voyage = { w: World, ok: bool, events: [Event], ticks: int }
pure func voyage(v: Voyage, dtau: float, n: int) -> Voyage =
  if n <= 0 || isArrived(v.w.journey) || !v.ok then v
  else {
    let t = wait(v.w, dtau);
    voyage({w: t.world, ok: v.ok && apMatches(t.world), events: v.events ++ t.events, ticks: v.ticks + 1}, dtau, n - 1)
  }
pure func phaseEvents(es: [Event]) -> [Crossing] = match es { [] => [], e :: r => match e.phase { Some(c) => c :: phaseEvents(r), None => phaseEvents(r) } }
pure func arrivedEvents(es: [Event]) -> [Residuals] = match es { [] => [], e :: r => match e.arrived { Some(x) => x :: arrivedEvents(r), None => arrivedEvents(r) } }
pure func crossingNames(cs: [Crossing]) -> string = join(",", mapNames(cs))
pure func mapNames(cs: [Crossing]) -> [string] = match cs { [] => [], c :: r => join(">", [c.from, c.to]) :: mapNames(r) }
-- Each crossing's tau is the boundary's, tau0 + (0, tauBurn, tauBurn + tauCoast, tauTotal), to an ulp of the tick sum.
pure func crossingTaus(cs: [Crossing], want: [float]) -> bool =
  match cs { [] => (match want { [] => true, _ => false }), c :: r => match want { [] => false, x :: wr => absf(c.tau - x) <= 0.000000000001 && crossingTaus(r, wr) } }

pure func bcbNames() -> string = "at_rest>boosting,boosting>cruising,cruising>braking,braking>at_rest"
pure func checkVoyageAt(phi: float) -> bool {
  let c0 = apCommitted(defaultParams(), plAcen(), phi);
  let c = apCommit(c0);
  let tp = c.plan.trip;
  let v = voyage({w: c0, ok: true, events: [], ticks: 0}, 0.01, 1000);
  let cs = phaseEvents(v.events);
  v.ok && isArrived(v.w.journey) && crossingNames(cs) == bcbNames() &&
  crossingTaus(cs, [c.tau0, c.tau0 + tp.tauBurn, c.tau0 + tp.tauBurn + tp.tauCoast, c.tau0 + tp.tauTotal]) &&
  v.ticks == floatToInt(tp.tauTotal / 0.01) + 1 && checkBoundaryTicks(c0)
}
-- Ticks that end exactly on each boundary: the state there is motionAt's
-- boundary state (dBurn, phiPeak; d - dBurn; arrival) to 1e-9.
pure func checkBoundaryTicks(c0: World) -> bool {
  let tp = (apCommit(c0)).plan.trip;
  let b1 = wait(c0, tp.tauBurn).world;
  let b2 = wait(b1, tp.tauCoast).world;
  let b3 = wait(b2, tp.tauBurn).world;
  let done = if isArrived(b3.journey) then b3 else wait(b3, 0.000000000001).world;
  near9(b1.ship.motion.x - b1.ship.x0, tp.dBurn) && near9(b1.ship.motion.phi, tp.phiPeak) && b1.ship.phase == Cruising && (apCommit(b1)).el == tp.tauBurn &&
  near9(b2.ship.motion.x - b2.ship.x0, tp.trip.distance - tp.dBurn) && near9(b2.ship.motion.phi, tp.phiPeak) && b2.ship.phase == Braking && (apCommit(b2)).el == tp.tauBurn + tp.tauCoast &&
  apMatches(b1) && apMatches(b2) && isArrived(done.journey) && (apCommit(done)).el == tp.tauTotal && near9(done.ship.motion.t - (apCommit(done)).t0, tp.trip.galaxyTime)
}
pure func checkVoyageBoundaries() -> bool = checkVoyageAt(phi099()) && checkVoyageAt(plPhiCap()) && checkFlipVoyage()
-- The diag 1 g flip-and-burn check profile: boost straight into brake (tauCoast = 0).
pure func checkFlipVoyage() -> bool {
  let c0 = plDo(plDo(plWorld(true, defaultParams()), [plFlip(plAcenA(), 1.0)]).world, [ICommit(1)]).world;
  let c = apCommit(c0);
  let tp = c.plan.trip;
  let v = voyage({w: c0, ok: true, events: [], ticks: 0}, 0.01, 1000);
  let cs = phaseEvents(v.events);
  v.ok && isArrived(v.w.journey) && crossingNames(cs) == "at_rest>boosting,boosting>braking,braking>at_rest" &&
  crossingTaus(cs, [c.tau0, c.tau0 + tp.tauBurn, c.tau0 + tp.tauTotal]) && checkResidualsOf(v, tp.trip.distance) &&
  veqExact(position(v.w.ship), plAcenA().pos)
}

pure func veqExact(a: Vec3, b: Vec3) -> bool = a.x == b.x && a.y == b.y && a.z == b.z
pure func checkResidualsOf(v: Voyage, d: float) -> bool =
  match arrivedEvents(v.events) {
    [r] => {
      let tol = tol9() * (if d > 1.0 then d else 1.0);
      r.x < tol && r.t < tol && r.phi < tol && r.x == r.x && r.t == r.t && r.phi == r.phi
    },
    _ => false
  }
-- Arrival: one `arrived` event with residuals < 1e-9 max(1, d), phi snapped
-- to 0 and the position to target.pos bit for bit; leftover dtau at rest.
pure func checkArrivalResidual() -> bool {
  let c0 = apCommitted(defaultParams(), plAcen(), phi099());
  let c = apCommit(c0);
  let v = voyage({w: c0, ok: true, events: [], ticks: 0}, 0.01, 1000);
  let s = v.w.ship;
  let after = wait(v.w, 0.5).world;
  let cap = voyage({w: apCommitted(defaultParams(), plAcenA(), plPhiCap()), ok: true, events: [], ticks: 0}, 0.01, 1000);
  checkResidualsOf(v, 4.37) && checkResidualsOf(cap, 4.32103979249451) && veqExact(position(cap.w.ship), plAcenA().pos) &&
  s.motion.phi == 0.0 && s.phase == AtRest && veqExact(position(s), plAcen().pos) &&
  absf(s.motion.tau - (c.tau0 + 0.01 * intToFloat(v.ticks))) <= 0.000000000001 &&
  near9(s.motion.t, c.t0 + c.plan.trip.trip.galaxyTime + (0.01 * intToFloat(v.ticks) - c.plan.trip.tauTotal)) &&
  isArrived(after.journey) && veqExact(position(after.ship), plAcen().pos) && after.ship.phase == AtRest && after.ship.motion.t == s.motion.t + 0.5 &&
  checkResidualsReported()
}
-- The residuals are measured, not assumed: a state 1e-6 off reports 1e-6.
pure func checkResidualsReported() -> bool {
  let c = apCommit(apCommitted(defaultParams(), plAcen(), phi099()));
  let tp = c.plan.trip;
  let r = arrivalResiduals({phi: 0.000001, tau: tp.tauTotal, t: c.t0 + tp.trip.galaxyTime + 0.000002, x: 10.0 + 4.37 - 0.000003}, 10.0, c);
  rel(r.phi, 0.000001, 0.000001) && rel(r.t, 0.000002, 0.000001) && rel(r.x, 0.000003, 0.000001) && checkResidualsMeasured()
}
-- The `arrived` event carries the stepped state's residuals from before the
-- snap: a flight whose start is offset (x0 by 1e-6 ly, t0 by 2e-6 yr, or a
-- drift of phi = 1e-7 at the commit) reports that offset, not zero.
pure func flyEvents(w: World, n: int, acc: [Event]) -> [Event] =
  if n <= 0 || isArrived(w.journey) then acc else { let t = wait(w, 0.01); flyEvents(t.world, n - 1, acc ++ t.events) }
pure func apArrivedResiduals(w: World) -> [Residuals] = arrivedEvents(flyEvents(w, 1000, []))
pure func checkResidualsMeasured() -> bool {
  let c0 = apCommitted(defaultParams(), plAcen(), phi099());
  let c = apCommit(c0);
  let s = c0.ship;
  let offset = {c0 | ship: {s | x0: s.x0 - 0.000001}, journey: Committed({c | t0: c.t0 - 0.000002})};
  let drift = {c0 | ship: {s | motion: {s.motion | phi: 0.0000001}}};
  (match apArrivedResiduals(offset) { [r] => rel(r.x, 0.000001, 0.00001) && rel(r.t, 0.000002, 0.00001) && r.phi < tol9(), _ => false }) &&
  (match apArrivedResiduals(drift) { [r] => rel(r.phi, 0.0000001, 0.001), _ => false })
}
-- One tick that holds the whole boost: two phase events, at tau0 and at tau0 + tauBurn exactly.
pure func checkWholeBoostTick() -> bool {
  let w = plDo(plWorld(false, defaultParams()), [plCruise(plAcen(), phi099())]).world;
  let rested = wait(w, 0.25).world;
  let t = tick(plDo(rested, []).world, {dtau: 0.01, intents: [ICommit(1)]});
  let c = apCommit(t.world);
  let cs = phaseEvents(t.events);
  (match t.events { e :: _ => e.kind == "committed", [] => false }) &&
  crossingNames(cs) == "at_rest>boosting,boosting>cruising" && c.tau0 == rested.ship.motion.tau &&
  (match cs { [a, b] => a.tau == c.tau0 && b.tau == c.tau0 + c.plan.trip.tauBurn, _ => false }) &&
  t.world.ship.phase == Cruising && plCommitted(t.world.journey)
}
-- A commit in a dtau 0 tick flies nothing and emits no phase event; the
-- first piece of the next tick emits at_rest > boosting once.
pure func checkStartEventOnce() -> bool {
  let c0 = apCommitted(defaultParams(), plAcen(), phi099());
  let z = wait(c0, 0.0);
  let one = wait(z.world, 0.000001);
  let two = wait(one.world, 0.000001);
  crossingNames(phaseEvents(z.events)) == "" && z.world.ship.phase == AtRest && crossingNames(phaseEvents(one.events)) == "at_rest>boosting" &&
  one.world.ship.phase == Boosting && crossingNames(phaseEvents(two.events)) == ""
}
-- Committed -> Arrived only through the sim (the autopilot reaching
-- tauTotal); then the journey is free: a plan from the arrival point
-- measures d from there (the M2.3a follow-up), and a second journey flies home.
pure func checkArrivedThenReplan() -> bool {
  let c0 = apCommitted(defaultParams(), plAcen(), phi099());
  let early = wait(c0, 0.6).world;
  let landed = wait(early, 0.1);
  let home = {index: 0, id: "Sol", pos: {x: 0.0, y: 0.0, z: 0.0}};
  let re = plDo(landed.world, [plCruise(home, phi09())]);
  let back = plDo(re.world, [ICommit(2)]).world;
  let v = voyage({w: back, ok: true, events: [], ticks: 0}, 0.01, 1000);
  plCommitted(early.journey) && isArrived(landed.world.journey) && plRefused(plDo(early, [ICancel]), "committed") &&
  refusalsAre(re.refused, []) && plId(re.world) == 2 &&
  plField(re.world, \p. p.trip.trip.distance == 4.37 && p.heading.z == 1.0 && p.from.z == -4.37) &&
  v.ok && isArrived(v.w.journey) && veqExact(position(v.w.ship), home.pos) && checkResidualsOf(v, 4.37)
}
-- The ledger at arrival equals tripEnergy(plan, m_eff, n, R).total to 1e-9
-- relative, at a non-default m_eff (3 kg), at 0.99c and at the cap; boost
-- and drag close separately (drag accumulated during a boost would not).
pure func checkLedgerAt(p: Params, t: Target, phi: float) -> bool {
  let v = voyage({w: apCommitted(p, t, phi), ok: true, events: [], ticks: 0}, 0.01, 1000);
  let tp = (apCommit(v.w)).plan.trip;
  let e = tripEnergy(tp, p.mEffKg, p.ismNCm3 * 1000000.0, p.bubbleRadiusM);
  let l = v.w.ledger;
  isArrived(v.w.journey) && l.mEffKg == p.mEffKg && rel(l.boostJ + l.dragJ, e.total, tol9()) && rel(l.boostJ, e.boost + e.brake, tol9()) && rel(l.dragJ, e.drag, tol9()) &&
  l.availableKg == 20000.0
}
pure func checkLedgerAtArrival() -> bool {
  let p = {defaultParams() | mEffKg: 3.0};
  let tp = planBurnCoastBurn(4.37, 750000.0 * standardGravity(), phi099());
  let landed = voyage({w: apCommitted(p, plAcen(), phi099()), ok: true, events: [], ticks: 0}, 0.01, 1000).w;
  let rested = wait(landed, 1.0).world;
  checkLedgerAt(p, plAcen(), phi099()) && checkLedgerAt(p, plAcenA(), plPhiCap()) && checkLedgerAt({defaultParams() | mEffKg: 0.5, ismNCm3: 1.0}, plAt(10.0), phi09()) &&
  rel(landed.ledger.boostJ, photonDriveEnergy(3.0, 2.0 * tp.phiPeak), tol9()) &&
  rested.ledger.boostJ == landed.ledger.boostJ && rested.ledger.dragJ == landed.ledger.dragJ
}
-- Commit's `moving` guard is |phi| >= 1e-9: 1e-9 is refused, just below is accepted.
pure func checkCommitMovingBoundary() -> bool {
  let w = plWorld(true, defaultParams());
  let s = w.ship;
  let at = {w | ship: {s | motion: {phi: 0.000000001, tau: 0.0, t: 0.0, x: 0.0}}};
  let below = {w | ship: {s | motion: {phi: 0.0000000009999999, tau: 0.0, t: 0.0, x: 0.0}}};
  let neg = {w | ship: {s | motion: {phi: -0.000000001, tau: 0.0, t: 0.0, x: 0.0}}};
  refusalsAre(plDo(at, [plCruise(plAcen(), phi099()), ICommit(1)]).refused, ["1:moving"]) &&
  refusalsAre(plDo(neg, [plCruise(plAcen(), phi099()), ICommit(1)]).refused, ["1:moving"]) &&
  plCommitted(plDo(below, [plCruise(plAcen(), phi099()), ICommit(1)]).world.journey)
}
-- A plan from a moved ship measures d from the ship (M2.3a follow-up):
-- after a diag boost and brake along -z the ship rests at z < 0.
pure func checkPlanFromMovedShip() -> bool {
  let moved = go(go(plWorld(true, defaultParams()), 1.0, 0.1), -1.0, 0.1);
  let z = position(moved.ship).z;
  let w = plDo(moved, [plCruise(plAcen(), phi099())]).world;
  let side = plDo(moved, [plCruise(plAt(3.0), phi099())]).world;
  let v = voyage({w: plDo(w, [ICommit(1)]).world, ok: true, events: [], ticks: 0}, 0.01, 1000);
  z < -0.01 && plField(w, \p. p.trip.trip.distance == 4.37 + z && p.heading.z == -1.0 && p.from.z == z) &&
  plField(side, \p. p.trip.trip.distance == sqrt(9.0 + z * z)) &&
  -- committed along the heading it already had (no turn): the commit still
  -- rebases, so the flight measures from here and lands on the target
  v.ok && isArrived(v.w.journey) && checkResidualsOf(v, 4.37 + z) && veqExact(position(v.w.ship), plAcen().pos)
}
-- A NaN cruise_phi is refused out_of_range by the core itself.
pure func nan() -> float = 1.0e308 * 10.0 - 1.0e308 * 10.0
pure func checkNaNCruise() -> bool {
  let x = nan();
  !(x == x) && plRefused(plDo(plWorld(false, defaultParams()), [plCruise(plAcen(), x)]), "out_of_range")
}

export pure func voyageVm(n: int) -> string =
  if checkVoyageBoundaries() && checkArrivalResidual() && checkWholeBoostTick() && checkStartEventOnce() && checkArrivedThenReplan() && checkLedgerAtArrival() &&
    checkCommitMovingBoundary() && checkPlanFromMovedShip() && checkNaNCruise()
  then "voyage-ok" else "voyage-BAD"

export pure func planVm(n: int) -> string =
  if checkPlanCruise09() && checkPlanCruise099() && checkPlanCruiseCap() && checkPlanAlphaCen() && checkPlanAcenA() && checkPlanCoast100() && checkPlanFallback() &&
    checkPlanReadouts() && checkCruiseRange() && checkDiagOnly() && checkCommittedRefusesAll() && checkCommitTurns() && checkCommitMoving() && checkStalePlan() && checkPlanIds() && checkPlanIsPackage()
  then "plan-ok" else "plan-BAD"

export pure func worldVm(n: int) -> string =
  if checkMassClosed() && checkPhaseDerivedDiag() && checkRestToleranceEdge() && checkWorldPhases() && checkLedgerDiag() && checkScenarioMEff() && checkRngZero() && checkTickRefusals() && checkDrawIntent()
  then "world-ok" else "world-BAD"

test "turn at rest snaps rapidity" { checkTurnAtRest() }
test "moving turn rejected" { checkMovingTurnRejected() }
test "position after turn retains origin" { checkPositionAfterTurn() }
test "strict off axis voyage" { checkScriptedOffAxis() }
test "mass budget closed: available_kg 20000 after any ticks" { checkMassClosed() }
test "phase derived for diag flight, rest tolerance 1e-9" { checkPhaseDerivedDiag() }
test "rest tolerance edge: turn at phi 0.9e-9 accepted, 1.1e-9 refused moving" { checkRestToleranceEdge() }
test "world phases follow diag thrust" { checkWorldPhases() }
test "ledger accumulates boost and cruise drag from the package" { checkLedgerDiag() }
test "scenario refuses m_eff below the brake threshold" { checkScenarioMEff() }
test "rng counters start at zero" { checkRngZero() }
test "tick refusals proceed" { checkTickRefusals() }
test "M2.4 draw intent: events, counters per stream, persists across ticks" { checkDrawIntent() }
test "AC2 plan alpha Cen cruise 0.9c (row 1)" { checkPlanCruise09() }
test "AC2 plan alpha Cen cruise 0.99c (row 2: 0.6227 ship-yr, 4.414 Earth-yr)" { checkPlanCruise099() }
test "AC2 plan alpha Cen cruise at the cap (row 3)" { checkPlanCruiseCap() }
test "AC2 plan alpha Cen 1 g flip, diag (row 6)" { checkPlanAlphaCen() }
test "AC2 plan alpha Cen A catalogue doubles (CNS5:3627), 1 g flip (row 7)" { checkPlanAcenA() }
test "AC2 plan 100 ly cruise 0.99c at 1 g (row 8)" { checkPlanCoast100() }
test "AC2 plan falls back to flip-and-burn (rows 9, 4)" { checkPlanFallback() }
test "AC3 plan readouts equal the readout table and derived fields" { checkPlanReadouts() }
test "AC4 cruise range refused out_of_range, both ends inclusive" { checkCruiseRange() }
test "AC4 flip_g, thrust, heading are diag only" { checkDiagOnly() }
test "AC7 committed world refuses every journey intent" { checkCommittedRefusesAll() }
test "commit turns to the plan heading and holds position" { checkCommitTurns() }
test "commit while moving refused moving" { checkCommitMoving() }
test "stale plan id refused stale_plan" { checkStalePlan() }
test "plan ids monotonic from 1, replan replaces, cancel clears" { checkPlanIds() }
test "stored plan is the package's TripPlan bit for bit" { checkPlanIsPackage() }
test "AC5 stepped voyage matches motionAt at every boundary (0.99c, cap, 1 g flip)" { checkVoyageBoundaries() }
test "AC5 arrival residuals < 1e-9 max(1, d), snap to target, leftover at rest" { checkArrivalResidual() }
test "AC6 ledger at arrival equals tripEnergy total (m_eff 3 kg, 0.99c and cap)" { checkLedgerAtArrival() }
test "a tick holding the whole boost emits two phase events at exact tau" { checkWholeBoostTick() }
test "at_rest > boosting emitted once, on the first piece flown" { checkStartEventOnce() }
test "Committed -> Arrived only via the sim; replan from the arrival point" { checkArrivedThenReplan() }
test "commit moving guard boundary |phi| = 1e-9" { checkCommitMovingBoundary() }
test "plan from a moved ship measures d from the ship" { checkPlanFromMovedShip() }
test "NaN cruise_phi refused out_of_range" { checkNaNCruise() }
