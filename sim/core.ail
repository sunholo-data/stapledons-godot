module stapledons/sim/core

-- Pure simulation core. No effects: everything here must run on the bytecode
-- VM under --strict-bytecode (checked by `make strict`). I/O lives in ship.ail.
-- Physics comes from the published sunholo/relativity package.

import std/option (Option, Some, None)
import std/result (Ok, Err)
import std/math (intToFloat)
import pkg/sunholo/relativity/kinematics (Motion, rest, accelerate, standardGravity, betaOf, gammaOf, oneMinusBeta, rapidityOfBeta, rapidityOfOneMinusBeta)
import pkg/sunholo/relativity/optics (Vec3, norm, normalize, cmbForwardTemperature)
import pkg/sunholo/relativity/hyper (absf)
import pkg/sunholo/relativity/journey (TripPlan, planBurnCoastBurn, planFlipAndBurn)
import pkg/sunholo/relativity/medium (accelSI, julianYearS, cSI, photonDriveEnergy, mirrorDragForce, mirrorDragPower, loadScale, glowInwardFlux, tripEnergy, brakeHoldsAgainstDrag)
import ./tripphase (tripPhaseIndex)
import ./consequence (Cq, News, ArchiveRow, emptyCq, entry, append, standoffLy, standoffFor, homeId, clocks, newsTier, templateId, unlock, ismAt, IsmNow, newsRequested, newsAccepted, newsFellBack)
import ./rng (Rng, Stream, SNews, zeroRng, draw, streamName, top53)
import ./celestial (defaultEpochJd, solSystem)
import ./navigation (BodyReq, NavPlan, Leg, planBody, staleAt)
import ./ai (AiState, AiOpen, AiCancel, AiRecord, AiEvent, ERequest, EAcceptedText, EAcceptedMedia, EFallback, AiStep, AiParams, aiEventName, emptyAi, defaultAiMaxOpen, defaultAiTtlTicks, openRequest, cancelRequest, recordResult, expire)

-- ShipPhase is TripPhase in canon words (design §M2.2).
export type ShipPhase = AtRest | Boosting | Cruising | Braking deriving (Eq)
export type Ship = { motion: Motion, heading: Vec3, origin: Vec3, x0: float, phase: ShipPhase }
export type TurnResult = { accepted: bool, ship: Ship }

export pure func initShip() -> Ship = { motion: rest(), heading: {x: 0.0, y: 0.0, z: -1.0}, origin: {x: 0.0, y: 0.0, z: 0.0}, x0: 0.0, phase: AtRest }

-- |phi| (or |beta|) below this is at rest: turns snap, the phase is AtRest.
export pure func restTolerance() -> float = 0.000000001

export pure func position(s: Ship) -> Vec3 {
  let d = s.motion.x - s.x0;
  { x: s.origin.x + s.heading.x * d, y: s.origin.y + s.heading.y * d, z: s.origin.z + s.heading.z * d }
}

export pure func turn(s: Ship, h: Vec3) -> TurnResult {
  let changed = absf(h.x - s.heading.x) > 0.000000001 || absf(h.y - s.heading.y) > 0.000000001 || absf(h.z - s.heading.z) > 0.000000001;
  if !changed then {accepted: true, ship: s}
  else if absf(betaOf(s.motion.phi)) >= restTolerance() then {accepted: false, ship: s}
  else {
    let p = position(s);
    let m = s.motion;
    { accepted: true, ship: { motion: { phi: 0.0, tau: m.tau, t: m.t, x: m.x }, heading: normalize(h), origin: p, x0: m.x, phase: AtRest } }
  }
}

-- Advance one tick: dtau ship-years under thrust x 1 g (thrust in [-1, 1]).
export pure func step(s: Ship, thrust: float, dtau: float) -> Ship
  requires { dtau >= 0.0 }
{
  { motion: accelerate(s.motion, thrust * standardGravity(), dtau), heading: s.heading, origin: s.origin, x0: s.x0, phase: s.phase }
}

export pure func beta(s: Ship) -> float = betaOf(s.motion.phi)
export pure func gamma(s: Ship) -> float = gammaOf(s.motion.phi)

pure func burn(s: Ship, thrust: float, dtau: float, n: int) -> Ship =
  if n <= 0 then s else burn(step(s, thrust, dtau), thrust, dtau, n - 1)

-- Scripted voyage for the strict-bytecode check: accelerate for `ticks`
-- ticks, decelerate for as many, return total galaxy years. `make strict`
-- compares it with the closed-form flip-and-burn galaxy time (python
-- reference) for T = ticks * 0.01 ship-years per half.
export pure func scripted(ticks: int) -> float {
  let out = burn(burn(initShip(), 1.0, 0.01, ticks), -1.0, 0.01, ticks);
  out.motion.t
}

export pure func scriptedOffAxis(ticks: int) -> float {
  let first = burn(burn(turn(initShip(), {x: 1.0, y: 0.0, z: 0.0}).ship, 1.0, 0.01, ticks), -1.0, 0.01, ticks);
  let second = burn(burn(turn(first, {x: 0.0, y: 1.0, z: 0.0}).ship, 1.0, 0.01, ticks), -1.0, 0.01, ticks);
  norm(position(second))
}

-- ------------------------------------------------------------ world (M2.2)
-- Intents are domain commands; protocol.ail owns their wire codec.
export type Target = { index: int, id: string, pos: Vec3 }
export type PlanReq = { target: Target, cruisePhi: float, flipG: Option[float] }
-- IEcho: diag-only test hook (M2.1b, AC9). It carries a plan payload and the
-- sim echoes it back in an `echo` event, so the Godot bridge can check the
-- float64 round trip of `target.pos` and `cruise_phi` before M2.3a's planner.
export type Intent =
  IPlan(PlanReq) | IPlanBody(BodyReq)
  | ICommit(int) | ICancel | IThrust(float) | IHeading(Vec3)
  | IRecord(AiRecord)
  | IDraw(Stream) | IEcho(PlanReq)
  | IAiOpen(AiOpen) | IAiCancel(AiCancel)
  | IWarp(float)
export type Refusal = { i: int, reason: string }
-- A `phase` event carries the crossing (from/to are phaseName strings, tau
-- the ship's proper time at the boundary); an `arrived` event carries the
-- residuals of the stepped flight against the closed form, taken before the
-- snap (design §M2.3). A `draw` event (diag, M2.4) carries the stream's
-- wire name, the counter drawn at and the value's top 53 bits. The AI
-- events (ai_request, ai_accepted, ai_fallback; AI.2) carry `ai`.
export type Crossing = { from: string, to: string, tau: float }
export type Residuals = { x: float, t: float, phi: float }
export type Drawn = { stream: string, n: int, value: int }
export type Event = { kind: string, echo: Option[PlanReq], phase: Option[Crossing], arrived: Option[Residuals], drew: Option[Drawn], ai: Option[AiEvent] }
export pure func event(k: string) -> Event = { kind: k, echo: None, phase: None, arrived: None, drew: None, ai: None }

-- standoffAu: the arrival stand-off (M4.1, D-14); 0 plans to the star itself (M2),
-- the M4 client sets 1000. Sol (star index 0) never has one.
-- aiMaxOpen, aiTtlTicks: AI request limits (design ai-service-foundation
-- (a1)); echoed as the last two params keys since protocol 2.1 (AI.3).
-- epochJd: the scenario epoch as a Julian Date (M5.1b, D-12); system.jd = epochJd + t
-- (sim/celestial.ail). Like standoffAu it is set by `epoch_jd` and not in the params echo.
export type Params = { epoch: float, startAge: float, boostG: float, mEffKg: float, ismNCm3: float, bubbleRadiusM: float, glowEps: float, glowFIn: float, cruiseMinBeta: float, capOneMinusBeta: float, aiMaxOpen: int, aiTtlTicks: int, standoffAu: float, epochJd: float }
-- Scenario "sol" (design §M2.1, D-12, D-15).
export pure func defaultParams() -> Params = { epoch: 0.0, startAge: 30.0, boostG: 750000.0, mEffKg: 1.0, ismNCm3: 0.1, bubbleRadiusM: 100.0, glowEps: 0.0000000001, glowFIn: 0.5, cruiseMinBeta: 0.9, capOneMinusBeta: 0.000001,
  aiMaxOpen: defaultAiMaxOpen(), aiTtlTicks: defaultAiTtlTicks(), standoffAu: 0.0, epochJd: defaultEpochJd() }

-- Radiated energy = boostJ + dragJ. The mass budget is closed (higgs-bubble
-- §8): availableKg is carried unchanged; nothing is deducted or enforced.
export type Ledger = { mEffKg: float, availableKg: float, boostJ: float, dragJ: float }
export pure func availableKgStart() -> float = 20000.0
-- rng: one counter per named PRNG stream (sim/rng.ail, M2.4).
-- lastPlanId: the id of the most recent accepted plan (0 before any); plan
-- ids increase monotonically from 1 and are never reused.
-- ai: open AI requests and their ids (sim/ai.ail, AI.2).
-- cq: the consequence state (sim/consequence.ail, M4.1): news, legacy log, archive.
export type World = { tick: int, seed: int, params: Params, ship: Ship, journey: Journey, lastPlanId: int, ledger: Ledger, rng: Rng, diag: bool, ai: AiState, cq: Cq }
export type TickInput = { dtau: float, intents: [Intent] }
export type Ticked = { world: World, refused: [Refusal], events: [Event] }
-- Journey state machine (design §M2.3; the commit rule is Pillar 1):
--   Idle/Arrived --plan--> Planned --plan--> Planned (replan, new id)
--   Planned --cancel--> Idle
--   Planned --commit(id, at rest, same position)--> Committed
--   Committed --(sim only: the autopilot reaches el = tauTotal)--> Arrived
--   Committed --every journey intent--> Committed, refused "committed"
--   (AI intents ai_open, ai_cancel, record are accepted while committed and
--   never touch ship, journey, ledger or a non-ai stream: D-20, 2026-10-02)
-- Nothing maps a Committed journey back to Planned or Idle (AC7).
-- A plan keeps the package's TripPlan as is; `from` is the ship's position
-- when it was made (a commit from anywhere else is stale). `nav` is the body
-- planner's part (M5.5a, sim/navigation.ail); None for a star. `el` is the
-- proper time flown since the commit, kept exactly so that a boundary is
-- reached at el = tauBurn, tauBurn + tauCoast, tauTotal bit for bit (the
-- ship's own tau is tau0 + the pieces, which can be an ulp off).
export type Plan = { id: int, target: Target, from: Vec3, heading: Vec3, flip: bool, trip: TripPlan, nav: Option[NavPlan] }
export type Commitment = { plan: Plan, tau0: float, t0: float, el: float }
export type Journey = Idle | Planned(Plan) | Committed(Commitment) | Arrived(Commitment)

export pure func newWorld(seed: int, diag: bool, p: Params) -> World =
  { tick: 0, seed: seed, params: p, ship: initShip(), journey: Idle, lastPlanId: 0,
    ledger: { mEffKg: p.mEffKg, availableKg: availableKgStart(), boostJ: 0.0, dragJ: 0.0 },
    rng: zeroRng(), diag: diag, ai: emptyAi(), cq: emptyCq() }

-- ISM density: scenario cm^-3 to the package's m^-3.
pure func ismPerM3(p: Params) -> float = p.ismNCm3 * 1000000.0

-- Scenario validation beyond the per-field ranges: the brake's photon thrust
-- at boost_g must hold against the drag at the cap.
export pure func scenarioError(p: Params) -> Option[string] =
  if brakeHoldsAgainstDrag(p.mEffKg, accelSI(p.boostG * standardGravity()), ismPerM3(p), rapidityOfOneMinusBeta(p.capOneMinusBeta), p.bubbleRadiusM)
  then None else Some("m_eff_too_small")

-- Phase for manual (diag) flight, from the rapidity after the tick and the
-- thrust applied: thrust along the motion boosts, against it brakes.
export pure func derivePhase(phi: float, thrust: float) -> ShipPhase =
  if absf(phi) < restTolerance() then AtRest
  else if thrust == 0.0 then Cruising
  else if (thrust > 0.0) == (phi > 0.0) then Boosting
  else Braking

export pure func phaseName(p: ShipPhase) -> string =
  match p { AtRest => "at_rest", Boosting => "boosting", Cruising => "cruising", Braking => "braking" }

-- Per tick piece: thrust (boost or brake, including the piece that ends at
-- rest) adds m_eff c^2 |dphi|; cruise adds the
-- drag-holding power over dtau (seconds). Boost/brake drag terms cancel over
-- the pair (package tripEnergy), so they are omitted.
pure func ledgerAfter(l: Ledger, p: Params, before: Motion, after: Motion, thrust: float, dtau: float) -> Ledger =
  if thrust != 0.0 then {l | boostJ: l.boostJ + photonDriveEnergy(l.mEffKg, absf(after.phi - before.phi))}
  else if absf(after.phi) < restTolerance() then l
  else {l | dragJ: l.dragJ + mirrorDragPower(ismPerM3(p), absf(after.phi), p.bubbleRadiusM) * dtau * julianYearS()}

-- at: the number of the tick being computed (AI request open/expiry ticks).
type Pending = { ship: Ship, thrust: float, journey: Journey, lastPlanId: int, seed: int, rng: Rng, ai: AiState, at: int, refused: [Refusal], events: [Event], i: int }
pure func refuseIntent(a: Pending, why: string) -> Pending = {a | refused: {i: a.i, reason: why} :: a.refused}
pure func noteEvent(a: Pending, k: string) -> Pending = {a | events: event(k) :: a.events}

-- The commit rule (Pillar 1, AC7, narrowed by D-20 on 2026-10-02): a
-- committed journey refuses every journey intent and nothing else changes;
-- the three AI intents delegate to sim/ai.ail, which cannot reach the ship,
-- the journey or the ledger. One arm per Intent constructor and no
-- wildcard, so a new intent kind needs its own line here.
pure func refuseWhileCommitted(diag: bool, p: Params, a: Pending, it: Intent) -> Pending =
  match it {
    IPlan(_) => refuseIntent(a, "committed"),
    IPlanBody(_) => refuseIntent(a, "committed"),
    ICommit(_) => refuseIntent(a, "committed"),
    ICancel => refuseIntent(a, "committed"),
    IThrust(_) => refuseIntent(a, "committed"),
    IHeading(_) => refuseIntent(a, "committed"),
    IDraw(_) => refuseIntent(a, "committed"),
    IEcho(_) => refuseIntent(a, "committed"),
    IRecord(r) => aiStep(a, recordResult(a.rng, a.ai, r)),
    IAiOpen(o) => aiOpenIntent(diag, p, a, o),
    IAiCancel(c) => aiStep(a, cancelRequest(a.rng, a.ai, c)),
    IWarp(_) => a
  }

-- AI intents (sim/ai.ail): the step's ai state, its `ai` stream counter,
-- its refusal and events; nothing else in Pending changes.
pure func aiStep(a: Pending, s: AiStep) -> Pending {
  let b = {a | ai: s.ai, rng: s.rng, events: aiEvents(s.events, a.events)};
  match s.refusal { Some(why) => refuseIntent(b, why), None => b }
}
pure func aiEvents(xs: [AiEvent], acc: [Event]) -> [Event] = match xs { [] => acc, x :: more => aiEvents(more, aiEvent(x) :: acc) }
pure func aiEvent(x: AiEvent) -> Event = {event(aiEventName(x)) | ai: Some(x)}
pure func aiOpenIntent(diag: bool, p: Params, a: Pending, o: AiOpen) -> Pending =
  aiStep(a, openRequest(diag, {maxOpen: p.aiMaxOpen, ttlTicks: p.aiTtlTicks}, a.at, a.seed, a.rng, a.ai, o))

-- Plan (design §M2.3): d = |target.pos - position(ship)| in float64 scalars;
-- the trip is the package's planBurnCoastBurn at boost_g, or in diag with
-- flip_g its planFlipAndBurn check profile. The cruise rapidity must lie in
-- [rapidityOfBeta(cruise_min_beta), rapidityOfOneMinusBeta(cap)], both ends
-- included; a target at the ship's own position (no heading) or a flip_g
-- that is not a positive finite number is out of range too.
pure func planIntent(diag: bool, p: Params, a: Pending, rq: PlanReq) -> Pending {
  let here = position(a.ship);
  let dv = { x: rq.target.pos.x - here.x, y: rq.target.pos.y - here.y, z: rq.target.pos.z - here.z };
  let d = norm(dv);
  -- M4.1: plan to the stand-off point, 1,000 AU short on the same heading (0 for Sol and by default).
  let dist = d - standoffFor(p.standoffAu, rq.target.id);
  let reachable = d > 0.0 && d - d == 0.0 && dist > 0.0;
  match rq.flipG {
    Some(g) =>
      if !diag then refuseIntent(a, "diag_only")
      else if !reachable || !(g > 0.0 && g - g == 0.0) then refuseIntent(a, "out_of_range")
      else storePlan(a, rq.target, here, normalize(dv), true, planFlipAndBurn(dist, g * standardGravity()), None),
    None =>
      -- `phi == phi` first: a NaN fails every comparison, so it is refused here
      -- on both runtimes (ailang#1419) rather than reaching the package's `requires`.
      if !reachable || !(rq.cruisePhi == rq.cruisePhi) || rq.cruisePhi < cruisePhiMin(p) || rq.cruisePhi > cruisePhiMax(p) then refuseIntent(a, "out_of_range")
      else storePlan(a, rq.target, here, normalize(dv), false, planBurnCoastBurn(dist, p.boostG * standardGravity(), rq.cruisePhi), None)
  }
}
-- M5.5a: a body target. sim/navigation.ail computes the arrival point (the client
-- sends only the id), the intercept and the refusals; the target's index is the
-- body's place in system.bodies and its pos the arrival point.
pure func planBodyIntent(p: Params, a: Pending, rq: BodyReq) -> Pending {
  let here = position(a.ship);
  match planBody({ sys: solSystem(), epochJd: p.epochJd, t0: a.ship.motion.t, hereLy: here, accel: p.boostG * standardGravity(), bubbleKm: p.bubbleRadiusM / 1000.0 }, rq) {
    Ok(l) => storePlan(a, { index: l.nav.index, id: rq.id, pos: l.arrivalLy }, here, l.heading, false, l.trip, Some(l.nav)),
    Err(why) => refuseIntent(a, why)
  }
}
-- The cruise-rapidity range a plan accepts (both ends included) and the
-- D-14 default, 0.99c clamped into it. The params echo carries all three so
-- the UI slider does no rapidity maths (M2.6b).
export pure func cruisePhiMin(p: Params) -> float = rapidityOfBeta(p.cruiseMinBeta)
export pure func cruisePhiMax(p: Params) -> float = rapidityOfOneMinusBeta(p.capOneMinusBeta)
export pure func cruiseDefaultBeta() -> float = 0.99
export pure func cruisePhiDefault(p: Params) -> float {
  let d = rapidityOfBeta(cruiseDefaultBeta());
  if d < cruisePhiMin(p) then cruisePhiMin(p) else if d > cruisePhiMax(p) then cruisePhiMax(p) else d
}
-- A new plan replaces any uncommitted one and takes the next id.
pure func storePlan(a: Pending, t: Target, here: Vec3, h: Vec3, flip: bool, tp: TripPlan, nav: Option[NavPlan]) -> Pending {
  let id = a.lastPlanId + 1;
  {a | journey: Planned({ id: id, target: t, from: here, heading: h, flip: flip, trip: tp, nav: nav }), lastPlanId: id}
}

-- Commit: the ship must be at rest (else `moving`) and the id must name the
-- current plan, made from where the ship is now (else `stale_plan`). It
-- performs the at-rest turn to the plan heading ("up" is the direction of
-- travel, D-14), rebases the line of motion at the ship (origin = here,
-- x0 = x, so x - x0 is the distance flown) and records tau0/t0. The
-- autopilot owns the drive from here.
pure func commitIntent(a: Pending, id: int) -> Pending =
  if absf(a.ship.motion.phi) >= restTolerance() then refuseIntent(a, "moving")
  else match a.journey {
    Planned(pl) => {
      let here = position(a.ship);
      if pl.id != id || here.x != pl.from.x || here.y != pl.from.y || here.z != pl.from.z || staleAt(pl.nav, a.ship.motion.t) then refuseIntent(a, "stale_plan")
      else {
        let t = turn(a.ship, pl.heading).ship;
        let turned = {t | origin: position(t), x0: t.motion.x};
        noteEvent({a | ship: turned, thrust: 0.0, journey: Committed({ plan: pl, tau0: turned.motion.tau, t0: turned.motion.t, el: 0.0 })}, "committed")
      }
    },
    _ => refuseIntent(a, "stale_plan")
  }

-- Cancel clears an uncommitted plan; with no plan it is a no-op. Only
-- reached when the journey is not committed (applyIntent).
-- (`_ => j`, not `other => other`: a variable pattern is evaluator-only on
-- the strict VM, ailang#1473.)
pure func cancelPlan(j: Journey) -> Journey = match j { Planned(_) => Idle, _ => j }

pure func applyFree(diag: bool, p: Params, a: Pending, it: Intent) -> Pending =
  match it {
    IPlan(rq) => planIntent(diag, p, a, rq),
    IPlanBody(rq) => planBodyIntent(p, a, rq),
    ICommit(id) => commitIntent(a, id),
    ICancel => {a | journey: cancelPlan(a.journey)},
    IThrust(t) => if diag then {a | thrust: t} else refuseIntent(a, "diag_only"),
    IHeading(h) => if !diag then refuseIntent(a, "diag_only") else {
      let turned = turn(a.ship, h);
      if turned.accepted then {a | ship: turned.ship} else refuseIntent(a, "moving")
    },
    IEcho(q) => if diag then {a | events: {event("echo") | echo: Some(q)} :: a.events} else refuseIntent(a, "diag_only"),
    IDraw(st) => if diag then drawIntent(a, st) else refuseIntent(a, "diag_only"),
    IRecord(r) => aiStep(a, recordResult(a.rng, a.ai, r)),
    IAiOpen(o) => aiOpenIntent(diag, p, a, o),
    IAiCancel(c) => aiStep(a, cancelRequest(a.rng, a.ai, c)),
    IWarp(_) => refuseIntent(a, "not_committed")
  }
-- Draw (diag, M2.4): the stream's next value; its counter advances and
-- the value is reported in a `draw` event.
pure func drawIntent(a: Pending, st: Stream) -> Pending {
  let d = draw(a.seed, a.rng, st);
  {a | rng: d.rng, events: {event("draw") | drew: Some({ stream: streamName(st), n: d.n, value: top53(d.value) })} :: a.events}
}
pure func applyIntent(diag: bool, p: Params, a: Pending, it: Intent) -> Pending {
  let r = match a.journey {
    Committed(_) => refuseWhileCommitted(diag, p, a, it),
    _ => applyFree(diag, p, a, it)
  };
  {r | i: a.i + 1}
}
pure func applyIntents(diag: bool, p: Params, a: Pending, xs: [Intent]) -> Pending = match xs { [] => a, x :: more => applyIntents(diag, p, applyIntent(diag, p, a, x), more) }
pure func reversed(xs: [a], acc: [a]) -> [a] = match xs { [] => acc, x :: more => reversed(more, x :: acc) }

-- ------------------------------------------------------------ autopilot (M2.3b)
-- With el the proper time since the commit, a tick's dtau is cut at every
-- phase boundary it holds (tauBurn, tauBurn + tauCoast, tauTotal; the phase
-- is the package's phaseAt) and each piece is flown with the package's exact
-- `accelerate` at +a, 0 or -a. Each crossing is a `phase` event at the
-- boundary's tau (the first piece flown also emits at_rest -> boosting). The
-- piece that ends at tauTotal reports the residuals, then snaps phi to 0 and
-- the position to the target; leftover dtau is spent at rest. Drag does not
-- alter the kinematics (the drive cancels it); it appears only in the
-- ledger: boost and brake add m_eff c^2 |dphi| (the brake's last |dphi| is
-- to the snapped 0, so the pair sums to 2 phiPeak), cruise adds the holding
-- power at the cruise rapidity times the piece in seconds. At arrival the
-- ledger is tripEnergy(...).total.
type Flight = { ship: Ship, c: Commitment, ledger: Ledger, events: [Event], arrived: bool }

pure func phaseOfIndex(i: int) -> ShipPhase = if i == 0 then Boosting else if i == 1 then Cruising else if i == 2 then Braking else AtRest
pure func phaseEnd(tp: TripPlan, i: int) -> float = if i == 0 then tp.tauBurn else if i == 1 then tp.tauBurn + tp.tauCoast else tp.tauTotal
pure func phaseAccel(tp: TripPlan, i: int) -> float = if i == 0 then tp.a else if i == 1 then 0.0 else 0.0 - tp.a
pure func crossing(from: ShipPhase, to: ShipPhase, tau: float) -> Event = {event("phase") | phase: Some({ from: phaseName(from), to: phaseName(to), tau: tau })}

-- Residuals at arrival, before the snap: |x_stepped - d|, |t_stepped -
-- (t0 + galaxyTime)| and |phi_stepped| (x_stepped = x - x0, the distance
-- flown since the commit's rebase).
export pure func arrivalResiduals(m: Motion, x0: float, c: Commitment) -> Residuals =
  { x: absf((m.x - x0) - c.plan.trip.trip.distance), t: absf(m.t - (c.t0 + c.plan.trip.trip.galaxyTime)), phi: absf(m.phi) }

pure func pieceLedger(l: Ledger, p: Params, tp: TripPlan, i: int, before: Motion, after: Motion, piece: float) -> Ledger =
  if i == 1 then {l | dragJ: l.dragJ + mirrorDragPower(ismPerM3(p), tp.phiPeak, p.bubbleRadiusM) * piece * julianYearS()}
  else {l | boostJ: l.boostJ + photonDriveEnergy(l.mEffKg, absf(after.phi - before.phi))}

-- Where the autopilot lands: the target itself (a body plan's target is its arrival point),
-- or (stand-off) the planned distance along the heading.
pure func arrivalPoint(p: Params, pl: Plan) -> Vec3 =
  if (match pl.nav { Some(_) => true, None => false }) || standoffFor(p.standoffAu, pl.target.id) == 0.0 then pl.target.pos
  else { let d = pl.trip.trip.distance; { x: pl.from.x + pl.heading.x * d, y: pl.from.y + pl.heading.y * d, z: pl.from.z + pl.heading.z * d } }

pure func atRest(s: Ship, dtau: float) -> Ship = {step(s, 0.0, dtau) | phase: AtRest}

pure func fly(p: Params, f: Flight, rem: float) -> Flight {
  let tp = f.c.plan.trip;
  let el = f.c.el;
  let i = tripPhaseIndex(tp, el);
  if i == 3 then {f | ship: atRest(f.ship, rem)}
  else if rem <= 0.0 then f
  else {
    let started = if el == 0.0 then crossing(AtRest, Boosting, f.ship.motion.tau) :: f.events else f.events;
    let b = phaseEnd(tp, i);
    let whole = el + rem < b;
    let piece = if whole then rem else b - el;
    let before = f.ship.motion;
    let after = accelerate(before, phaseAccel(tp, i), piece);
    if whole then
      {f | ship: {f.ship | motion: after, phase: phaseOfIndex(i)}, c: {f.c | el: el + rem}, ledger: pieceLedger(f.ledger, p, tp, i, before, after, piece), events: started}
    else {
      let j = tripPhaseIndex(tp, b);
      let crossed = crossing(phaseOfIndex(i), phaseOfIndex(j), after.tau) :: started;
      let left = if rem - piece > 0.0 then rem - piece else 0.0;
      if j == 3 then {
        let snapped = {after | phi: 0.0};
        let res = arrivalResiduals(after, f.ship.x0, f.c);
        let landed = { motion: snapped, heading: f.ship.heading, origin: arrivalPoint(p, f.c.plan), x0: snapped.x, phase: AtRest };
        fly(p, {ship: landed, c: {f.c | el: b}, ledger: pieceLedger(f.ledger, p, tp, i, before, snapped, piece),
          events: {event("arrived") | arrived: Some(res)} :: crossed, arrived: true}, left)
      } else
        fly(p, {f | ship: {f.ship | motion: after, phase: phaseOfIndex(j)}, c: {f.c | el: b}, ledger: pieceLedger(f.ledger, p, tp, i, before, after, piece), events: crossed}, left)
    }
  }
}

-- One tick: apply the intents in order (refusals listed, the tick proceeds),
-- expire AI requests whose expires_tick is this tick or earlier, then
-- advance the ship by dtau: under the autopilot while committed,
-- otherwise by the diag thrust with the phase derived from it; the ledger
-- follows either way.
pure func tickBase(w: World, input: TickInput) -> Ticked
  requires { input.dtau >= 0.0 }
  ensures { result.world.tick == w.tick + 1 }
{
  let applied = applyIntents(w.diag, w.params, {ship: w.ship, thrust: 0.0, journey: w.journey, lastPlanId: w.lastPlanId, seed: w.seed, rng: w.rng, ai: w.ai, at: w.tick + 1, refused: [], events: [], i: 0}, input.intents);
  let ex = expire(w.tick + 1, applied.ai);
  let a = {applied | ai: ex.ai, events: aiEvents(ex.events, applied.events)};
  match a.journey {
    Committed(c) => {
      let f = fly(w.params, {ship: a.ship, c: c, ledger: w.ledger, events: a.events, arrived: false}, input.dtau);
      { world: {w | tick: w.tick + 1, ship: f.ship, journey: if f.arrived then Arrived(f.c) else Committed(f.c), lastPlanId: a.lastPlanId, ledger: f.ledger, rng: a.rng, ai: a.ai},
        refused: reversed(a.refused, []), events: reversed(f.events, []) }
    },
    _ => {
      let moved = step(a.ship, a.thrust, input.dtau);
      let next = {moved | phase: derivePhase(moved.motion.phi, a.thrust)};
      { world: {w | tick: w.tick + 1, ship: next, journey: a.journey, lastPlanId: a.lastPlanId, ledger: ledgerAfter(w.ledger, w.params, a.ship.motion, next.motion, a.thrust, input.dtau), rng: a.rng, ai: a.ai},
        refused: reversed(a.refused, []), events: reversed(a.events, []) }
    }
  }
}

-- ------------------------------------------------------------ consequence (M4.1)
-- The M2 tick is unchanged; observe() then reads its events and the new world
-- and updates the consequence state: the legacy log, the news item (tier and
-- template from the `news` stream at arrival), its AI provenance and the archive
-- unlocks. Nothing here touches the ship, the journey or the ledger.
type Obs = { cq: Cq, rng: Rng }

pure func starOf(j: Journey) -> string =
  match j { Planned(p) => p.target.id, Committed(c) => c.plan.target.id, Arrived(c) => c.plan.target.id, Idle => "" }
pure func logAt(c: Cq, w: World, kind: string, star: string) -> Cq = append(c, entry(w.tick, kind, star, w.ship.motion.tau, w.ship.motion.t))
pure func logKinds(c: Cq, w: World, ks: [string], star: string) -> Cq = match ks { [] => c, k :: more => logKinds(logAt(c, w, k, star), w, more, star) }
pure func phaseKinds(to: string) -> [string] = if to == "boosting" then ["departure", "boost"] else if to == "cruising" then ["cruise"] else if to == "braking" then ["brake"] else []

pure func linkNews(c: Cq, x: AiEvent) -> Cq =
  match c.news {
    None => c,
    Some(n) => match x {
      ERequest(r) => if r.purpose == "news" then {c | news: Some(newsRequested(n, r.req))} else c,
      EAcceptedText(a) => {c | news: Some(newsAccepted(n, a.req))},
      EAcceptedMedia(_) => c,
      EFallback(f) => {c | news: Some(newsFellBack(n, f.req, f.reason))}
    }
  }

-- Arrival: the news item at the arrival point (epoch t - |p|, tier by the Earth-years since departure), then the log.
pure func arrive(w: World, o: Obs) -> Obs =
  match w.journey {
    Arrived(c) => {
      let tgt = c.plan.target;
      let cl = clocks(w.ship.motion.t, w.ship.motion.tau, position(w.ship));
      let dep = match o.cq.depT { Some(d) => d, None => c.t0 };
      let elapsed = cl.newsEpoch - dep;
      let tier = newsTier(elapsed);
      let d = draw(w.seed, o.rng, SNews);
      let n = { tier: tier, templateId: templateId(tier, top53(d.value)), starId: tgt.id, elapsedYears: elapsed, newsEpoch: cl.newsEpoch, newsAgeYears: cl.newsAgeYears,
        aiRequestId: None, bodySource: "template", fallbackReason: None };
      let c1 = logKinds({o.cq | news: Some(n)}, w, ["arrival", "news"], tgt.id);
      { cq: if tgt.id == homeId() then logAt(c1, w, "return", tgt.id) else c1, rng: d.rng }
    },
    _ => o
  }

pure func observeEvent(before: World, w: World, o: Obs, e: Event) -> Obs =
  if e.kind == "committed" then
    { cq: {logAt(o.cq, w, "commit", starOf(w.journey)) | depT: match o.cq.depT { None => Some(before.ship.motion.t), Some(_) => o.cq.depT }, dragJ0: before.ledger.dragJ}, rng: o.rng }
  else if e.kind == "arrived" then arrive(w, o)
  else match e.phase {
    Some(c) => { cq: logKinds(o.cq, w, phaseKinds(c.to), starOf(w.journey)), rng: o.rng },
    None => match e.ai { Some(x) => { cq: linkNews(o.cq, x), rng: o.rng }, None => o }
  }
pure func observeAll(before: World, w: World, o: Obs, es: [Event]) -> Obs =
  match es { [] => o, e :: more => observeAll(before, w, observeEvent(before, w, o, e), more) }

pure func observe(before: World, after: World, es: [Event]) -> World = if !before.cq.on then after else observeOn(before, after, es)
pure func observeOn(before: World, after: World, es: [Event]) -> World {
  let o = observeAll(before, after, { cq: after.cq, rng: after.rng }, es);
  let m = after.ship.motion;
  { after | cq: unlock(o.cq, after.tick, m.tau, m.t, after.ship.phase == Cruising, beta(after.ship), gamma(after.ship)), rng: o.rng }
}

export pure func tick(w: World, input: TickInput) -> Ticked
  requires { input.dtau >= 0.0 }
  ensures { result.world.tick == w.tick + 1 }
{
  let r = tickBase(w, input);
  { world: observe(w, r.world, r.events), refused: r.refused, events: r.events }
}

-- ------------------------------------------------------------ consequence readouts (M4.1)
-- The live ISM at the ship's current rapidity (package calls; zero at rest).
export pure func ismNow(w: World) -> IsmNow = ismAt(ismPerM3(w.params), w.ship.motion.phi, w.params.bubbleRadiusM, w.params.glowEps, w.params.glowFIn)
-- The ledger's drag_j since the latest commit (M2 semantics F*c); 0 before the first commit.
export pure func isWarpLevel(x: float) -> bool = x == 0.002 || x == 0.01 || x == 0.05
export pure func dragEnergyJ(w: World) -> float = match w.cq.depT { None => 0.0, Some(_) => w.ledger.dragJ - w.cq.dragJ0 }

-- Every displayed number is a field: Godot never subtracts two of them.
-- M4.3a transit readouts (the HUD formats them, never derives them): distance and Earth years left,
-- ship years to the end of the current phase (the client's dtau never overshoots a phase), the load in
-- suns (solarConstantWM2) and the drag energy as mass. All 0 outside a committed flight.
export type CqView = { gapYears: float, newsEpoch: float, newsAgeYears: float, progress: float, standoffLy: float,
  distanceRemaining: float, earthYearsRemaining: float, phaseRemainingYr: float, loadSuns: float, dragEnergyKg: float, cq: Cq }
export pure func solarConstantWM2() -> float = 1361.0
pure func nonNeg(x: float) -> float = if x > 0.0 then x else 0.0
pure func remainingOf(w: World) -> {distance: float, earth: float, phase: float} =
  match w.journey {
    Committed(c) => {
      let tp = c.plan.trip;
      let i = tripPhaseIndex(tp, c.el);
      { distance: nonNeg(tp.trip.distance - (w.ship.motion.x - w.ship.x0)), earth: nonNeg(c.t0 + tp.trip.galaxyTime - w.ship.motion.t),
        phase: if i == 3 then 0.0 else nonNeg(phaseEnd(tp, i) - c.el) }
    },
    _ => { distance: 0.0, earth: 0.0, phase: 0.0 }
  }
pure func progressOf(w: World) -> float =
  match w.journey {
    Committed(c) => {
      let f = (w.ship.motion.x - w.ship.x0) / c.plan.trip.trip.distance;
      if f < 0.0 then 0.0 else if f > 1.0 then 1.0 else f
    },
    Arrived(_) => 1.0,
    _ => 0.0
  }
export pure func cqView(w: World) -> CqView {
  let cl = clocks(w.ship.motion.t, w.ship.motion.tau, position(w.ship));
  let rem = remainingOf(w);
  { gapYears: cl.gapYears, newsEpoch: cl.newsEpoch, newsAgeYears: cl.newsAgeYears, progress: progressOf(w), standoffLy: standoffLy(w.params.standoffAu),
    distanceRemaining: rem.distance, earthYearsRemaining: rem.earth, phaseRemainingYr: rem.phase,
    loadSuns: (ismNow(w)).loadWM2 / solarConstantWM2(), dragEnergyKg: dragEnergyJ(w) / (cSI() * cSI()), cq: w.cq }
}

-- Scripted alpha Cen journey for `make strict` (AC10): plan 4.37 ly at
-- 0.99c in a play world, commit, fly `ticks` ticks of 0.01 yr; returns the
-- galaxy time, or -1 if the journey has not arrived. Past arrival the ship
-- rests, so the closed form is galaxyTime + (ticks * 0.01 - tauTotal).
pure func flyTicks(w: World, n: int) -> World = if n <= 0 then w else flyTicks(tick(w, {dtau: 0.01, intents: []}).world, n - 1)
export pure func journeyVm(ticks: int) -> float {
  let rq = { target: { index: 1, id: "alpha Cen", pos: { x: 0.0, y: 0.0, z: -4.37 } }, cruisePhi: 2.6466524123622457, flipG: None };
  let planned = tick(newWorld(0, false, defaultParams()), {dtau: 0.0, intents: [IPlan(rq)]}).world;
  let committed = tick(planned, {dtau: 0.0, intents: [ICommit(1)]}).world;
  let out = flyTicks(committed, ticks);
  match out.journey { Arrived(_) => out.ship.motion.t, _ => 0.0 - 1.0 }
}

-- ------------------------------------------------------------ readouts (M2.3a)
-- Every number on the plan panel is a package output or arithmetic on one
-- (design §M2.3); Godot only formats them.
export type Energy = { boostJ: float, brakeJ: float, dragJ: float, totalJ: float, totalKg: float }
export type Ism = { dragN: float, holdW: float, loadWM2: float, glowWM2: float }
export type PlanView = { target: Target, distance: float, profile: string, fellBack: bool,
  cruisePhi: float, cruiseBeta: float, cruiseOneMinusBeta: float, cruiseGamma: float,
  boostMinutes: float, shipYears: float, earthYears: float, arriveYear: float, ageOnArrival: float, yearsLeft: float,
  energy: Energy, ism: Ism, cmbForwardK: float }
export type JourneyView = { state: string, planId: int, plan: Option[PlanView] }

-- Exact plan-time position, retained after the ship's arrival rebase. Display
-- clients must not reconstruct it from rounded headings or target distances.
export pure func departureOf(w: World) -> Option[Vec3] =
  match w.journey {
    Planned(p) => Some(p.from), Committed(c) => Some(c.plan.from),
    Arrived(c) => Some(c.plan.from), Idle => None
  }
export pure func journeyHeadingOf(w: World) -> Option[Vec3] =
  match w.journey {
    Planned(p) => Some(p.heading), Committed(c) => Some(c.plan.heading),
    Arrived(c) => Some(c.plan.heading), Idle => None
  }

-- Minutes per Julian year (525,960, exact).
export pure func minutesPerYear() -> float = julianYearS() / 60.0
-- The crew's span for "years left" (design §M2.3; placeholder for the crew model).
export pure func crewSpanYears() -> float = 100.0

-- The panel for a plan seen from ship time tau and galaxy time t: "now"
-- while planned, the commit instant (tau0, t0) once committed. Cruise
-- beta, 1 - beta and gamma come from the peak rapidity (oneMinusBeta, never
-- 1 - beta); energy is tripEnergy at the scenario m_eff; ISM and the forward
-- CMB are evaluated at the peak rapidity.
export pure func planView(p: Params, pl: Plan, tau: float, t: float) -> PlanView {
  let tp = pl.trip;
  let phi = tp.phiPeak;
  let n = ismPerM3(p);
  let e = tripEnergy(tp, p.mEffKg, n, p.bubbleRadiusM);
  { target: pl.target, distance: tp.trip.distance, profile: if pl.flip then "flip_and_burn" else "burn_coast_burn", fellBack: tp.fellBack,
    cruisePhi: phi, cruiseBeta: betaOf(phi), cruiseOneMinusBeta: oneMinusBeta(phi), cruiseGamma: gammaOf(phi),
    boostMinutes: tp.tauBurn * minutesPerYear(), shipYears: tp.trip.shipTime, earthYears: tp.trip.galaxyTime,
    arriveYear: p.epoch + t + tp.trip.galaxyTime, ageOnArrival: p.startAge + tau + tp.trip.shipTime,
    yearsLeft: crewSpanYears() - tau - tp.trip.shipTime,
    energy: { boostJ: e.boost, brakeJ: e.brake, dragJ: e.drag, totalJ: e.total, totalKg: e.total / (cSI() * cSI()) },
    ism: { dragN: mirrorDragForce(n, phi, p.bubbleRadiusM), holdW: mirrorDragPower(n, phi, p.bubbleRadiusM),
           loadWM2: loadScale(n, phi), glowWM2: glowInwardFlux(n, phi, p.glowEps, p.glowFIn) },
    cmbForwardK: cmbForwardTemperature(phi) }
}

-- The body planner's part of the current plan (M5.5a; None for a star plan or no plan).
export pure func navOf(w: World) -> Option[NavPlan] =
  match w.journey { Planned(p) => p.nav, Committed(c) => c.plan.nav, Arrived(c) => c.plan.nav, Idle => None }

export pure func journeyView(w: World) -> JourneyView =
  match w.journey {
    Idle => { state: "idle", planId: 0, plan: None },
    Planned(pl) => { state: "planned", planId: pl.id, plan: Some(planView(w.params, pl, w.ship.motion.tau, w.ship.motion.t)) },
    Committed(c) => { state: "committed", planId: c.plan.id, plan: Some(planView(w.params, c.plan, c.tau0, c.t0)) },
    Arrived(c) => { state: "arrived", planId: c.plan.id, plan: Some(planView(w.params, c.plan, c.tau0, c.t0)) }
  }

-- new_game's codex table: set, then the rows whose hint already holds (`always`) unlock at tick 0.
export pure func withArchive(w: World, rows: [ArchiveRow]) -> World {
  let m = w.ship.motion;
  {w | cq: unlock({w.cq | archive: rows}, 0, m.tau, m.t, false, 0.0, 1.0)}
}

-- ------------------------------------------------------------ scripted round trip (M4.1, AC1)
-- A leg flown exactly to arrival with zero dwell: plan, commit, one tick of
-- tauTotal, then 1e-12 ticks while a last-ulp shortfall leaves it Committed.
pure func tauTotalOf(w: World) -> float =
  match w.journey { Planned(p) => p.trip.tauTotal, Committed(c) => c.plan.trip.tauTotal, Arrived(c) => c.plan.trip.tauTotal, Idle => 0.0 }
pure func settle(w: World) -> World =
  match w.journey { Committed(_) => settle(tick(w, {dtau: 0.000000000001, intents: []}).world), _ => w }
export pure func scriptedLeg(w: World, t: Target, phi: float) -> World {
  let planned = tick(w, {dtau: 0.0, intents: [IPlan({target: t, cruisePhi: phi, flipG: None})]}).world;
  let c = tick(planned, {dtau: 0.0, intents: [ICommit(planned.lastPlanId)]}).world;
  settle(tick(c, {dtau: tauTotalOf(c), intents: []}).world)
}
-- Sol -> alpha Cen -> Sol at 0.99c, 1,000 AU stand-off, zero dwell (make strict compares each value with a
-- closed form). which: 0 Earth years, 1 ship years, 2 news epoch at alpha Cen, 3 gap at the end, 4 news tier
-- at alpha Cen, 5 news tier at the return, 6 the stand-off in ly.
export pure func scriptedRoundTrip(which: int) -> float {
  let acen = { index: 1, id: "alpha Cen", pos: { x: 0.0, y: 0.0, z: -4.37 } };
  let sol = { index: 0, id: "Sol", pos: { x: 0.0, y: 0.0, z: 0.0 } };
  let out = scriptedLeg(newWorld(0, false, {defaultParams() | standoffAu: 1000.0}), acen, 2.6466524123622457);
  let back = scriptedLeg(out, sol, 2.6466524123622457);
  let tierOf = \w. match w.cq.news { Some(n) => intToFloat(n.tier), None => 0.0 - 1.0 };
  if which == 0 then back.ship.motion.t else if which == 1 then back.ship.motion.tau
  else if which == 2 then (cqView(out)).newsEpoch else if which == 3 then (cqView(back)).gapYears
  else if which == 4 then tierOf(out) else if which == 5 then tierOf(back) else standoffLy(1000.0)
}
