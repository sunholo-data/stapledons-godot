module stapledons/sim/solar_departure

-- Bounded explicitly selected demonstration. Only initialize changes the
-- position, and only for a NEW session: subsequent stops/turns use core.tick.
-- Earth is the published Earth-Moon barycentre approximation (celestial0.1.0).
-- No orbit-following force, ephemeris substitution or close-planet teleport.
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import pkg/sunholo/celestial/kepler (Vec3, sub, scale, norm)
import pkg/sunholo/relativity/kinematics (rapidityOfBeta)
import ./celestial (solSystem, bodyAt, lyKm)
import ./navigation (BodyReq, safetyMinKm, targetFacts)
import ./data/sol (sun)
import pkg/sunholo/celestial/ephemeris (auKm)
import ./core (World, Params, Target, Intent, IPlanBody, IPlan, cruisePhiDefault)

export type TourLeg = { id: string, name: string, kind: string, cruisePhi: float, standoffKm: Option[float] }
export pure func approximation() -> string = "Earth position is the Earth-Moon barycentre approximation; inertial geometric-clearance demo, not gravity-bound orbits. Gravity and thermal hazards are not simulated."
pure func radiusKm(id: string) -> float = match targetFacts(solSystem(), id) { Ok(f) => f.radiusKm, Err(_) => 0.0 }
export pure func earthStandoffKm() -> float = 2.0 * radiusKm("earth")
export pure func sunStandoffKm() -> float = 3.0 * (sun()).radiusKm
export pure func jupiterStandoffKm() -> float = 2.0 * radiusKm("jupiter")
export pure func saturnStandoffKm() -> float = match targetFacts(solSystem(), "saturn") { Ok(f) => 1.5 * f.ringKm, Err(_) => 0.0 }
export pure func callistoStandoffKm() -> float = 10.0 * radiusKm("callisto")
-- The observer starts on the dayside two equatorial radii from the centre.
-- Epoch is the scenario's exact epoch_jd; the normal sol scenario is untouched.
export pure func initialize(w: World) -> Result[World, string] =
  initializeAtStandoff(w, earthStandoffKm())
-- Authoring configuration only: still requires a new untouched simulation;
-- all clearance uses the existing package-composed navigation minimum.
export pure func initializeAtStandoff(w: World, distanceKm: float) -> Result[World, string] =
  if w.tick != 0 || w.ship.motion.tau != 0.0 || w.ship.motion.t != 0.0 then Err("solar_start_requires_new_session")
  else if !(distanceKm >= safetyMinKm(radiusKm("earth"), w.params.bubbleRadiusM / 1000.0)) || !(distanceKm < lyKm()) then Err("unsafe_solar_start")
  else match bodyAt(solSystem(), "earth", w.params.epochJd) {
    None => Err("earth_ephemeris_unavailable"),
    Some(earth) => {
      let here = sub(earth.pos, scale(distanceKm / norm(earth.pos), earth.pos));
      Ok({w | ship: {w.ship | origin: scale(1.0 / lyKm(), here), heading: scale(1.0 / norm(earth.pos), earth.pos)}})
    }
  }

-- Low system cruise speed, inside (not on) the accepted minimum boundary,
-- with genuine stop intercepts and
-- explicit standoffs checked by the unchanged collision/ring/intercept math.
export pure func legs(p: Params) -> [TourLeg] = [
  {id: "sun", name: "Sun", kind: "body", cruisePhi: rapidityOfBeta(0.002), standoffKm: Some(sunStandoffKm())},
  {id: "jupiter", name: "Jupiter", kind: "body", cruisePhi: rapidityOfBeta(0.002), standoffKm: Some(jupiterStandoffKm())},
  {id: "callisto", name: "Callisto clearance", kind: "body", cruisePhi: rapidityOfBeta(0.002), standoffKm: Some(callistoStandoffKm())},
  {id: "saturn", name: "Saturn", kind: "body", cruisePhi: rapidityOfBeta(0.002), standoffKm: Some(saturnStandoffKm())},
  {id: "CNS5:3627", name: "Alpha Centauri system", kind: "star", cruisePhi: cruisePhiDefault(p), standoffKm: None},
  {id: "acen-a", name: "Alpha Centauri A — 1 AU", kind: "body", cruisePhi: rapidityOfBeta(0.002), standoffKm: Some(auKm())}
]
pure func legAt(xs: [TourLeg], n: int) -> Option[TourLeg] =
  if n < 0 then None else match xs { [] => None, x :: rest => if n == 0 then Some(x) else legAt(rest, n - 1) }
export pure func intentForLeg(w: World, n: int, outbound: Target) -> Option[Intent] =
  match legAt(legs(w.params), n) {
    None => None,
    Some(leg) => if leg.kind == "body" then Some(IPlanBody({id: leg.id, cruisePhi: leg.cruisePhi, mode: "stop", standoffKm: leg.standoffKm, bKm: 0.0, clockDeg: 0.0, runOutKm: None}))
      else if outbound.id == leg.id then Some(IPlan({target: outbound, cruisePhi: leg.cruisePhi, flipG: None})) else None
  }
