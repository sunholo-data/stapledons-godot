module stapledons/sim/solar_departure

-- Bounded explicitly selected demonstration. Only initialize changes the
-- position, and only for a NEW session: subsequent stops/turns use core.tick.
-- Earth is the published Earth-Moon barycentre approximation (celestial0.1.0).
-- No orbit-following force, ephemeris substitution or close-planet teleport.
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import pkg/sunholo/celestial/kepler (Vec3, sub, scale, norm)
import pkg/sunholo/relativity/kinematics (rapidityOfOneMinusBeta)
import ./celestial (solSystem, bodyAt, lyKm)
import ./navigation (BodyReq, Timing, safetyMinKm, targetFacts, bodyPhiMax)
import ./data/sol (sun)
import ./destination_stars (habitableZoneKm, destinationStopKm)
import ./alpha_centauri (stellarValue as alphaStellarValue)
import pkg/sunholo/celestial/ephemeris (auKm)
import ./core (World, Params, Target, Intent, IPlanBody, IPlan)

export type TourLeg = { id: string, name: string, kind: string, cruisePhi: float, standoffKm: Option[float], timing: Option[Timing] }
-- D-46 (Mark, attended 2026-10-06): every in-system leg has the same rhythm:
-- 30 s of boost, about 60 s of cruise, then a 25 s final approach that begins
-- where the body is 4 degrees across. The sim solves each leg's thrust and speed.
export pure func tourTiming() -> Timing = { boostS: 30.0, cruiseS: 60.0, approachS: 25.0, approachDeg: 4.0 }
-- A giant gets a longer approach (Mark, 2026-10-07): 90 s from where it is 25 degrees
-- across, so Aldebaran grows smoothly (0.8 -> 7 -> 18 -> 40 degrees apparent) instead of
-- appearing in the last 6 s; the 4 degree point is 6 AU out, too far for a gentle 25 s.
export pure func giantTiming() -> Timing = { boostS: 30.0, cruiseS: 60.0, approachS: 90.0, approachDeg: 25.0 }
export pure func approximation() -> string = "Earth position is the Earth-Moon barycentre approximation; inertial geometric-clearance demo, not gravity-bound orbits. Gravity and thermal hazards are not simulated."
pure func radiusKm(id: string) -> float = match targetFacts(solSystem(), id) { Ok(f) => f.radiusKm, Err(_) => 0.0 }
export pure func earthStandoffKm() -> float = 2.0 * radiusKm("earth")
export pure func sunStandoffKm() -> float = 3.0 * (sun()).radiusKm
export pure func jupiterStandoffKm() -> float = 2.0 * radiusKm("jupiter")
export pure func saturnStandoffKm() -> float = match targetFacts(solSystem(), "saturn") { Ok(f) => 1.5 * f.ringKm, Err(_) => 0.0 }
export pure func callistoStandoffKm() -> float = 10.0 * radiusKm("callisto")
-- The observer starts on the dayside two equatorial radii from the centre.
-- Epoch is the scenario's exact epoch_jd; the normal sol scenario is untouched.
export pure func initialize(w: World) -> Result[World, string] =
  initializeAtStandoff(w, earthStandoffKm())
-- Authoring configuration only: still requires a new untouched simulation;
-- all clearance uses the existing package-composed navigation minimum.
export pure func initializeAtStandoff(w: World, distanceKm: float) -> Result[World, string] =
  if w.tick != 0 || w.ship.motion.tau != 0.0 || w.ship.motion.t != 0.0 then Err("solar_start_requires_new_session")
  else if !(distanceKm >= safetyMinKm(radiusKm("earth"), w.params.bubbleRadiusM / 1000.0)) || !(distanceKm < lyKm()) then Err("unsafe_solar_start")
  else match bodyAt(solSystem(), "earth", w.params.epochJd) {
    None => Err("earth_ephemeris_unavailable"),
    Some(earth) => {
      let here = sub(earth.pos, scale(distanceKm / norm(earth.pos), earth.pos));
      Ok({w | ship: {w.ship | origin: scale(1.0 / lyKm(), here), heading: scale(1.0 / norm(earth.pos), earth.pos)}})
    }
  }

-- Real-time voyage cruise speeds (Mark, attended 2026-10-06: D-39, D-40, D-41),
-- held as exact 1 - beta so nothing computes 1 - beta near c. The guided drive
-- (3,000,000 g, cap 1 - beta = 5e-7, m_eff 10 kg) is a host scenario parameter
-- (demos/solar_departure.gd GUIDED_DRIVE) checked by the unchanged scenarioError.
-- In-system legs (Sol bodies, the alpha Cen A hop) cruise at the navigation cap,
-- 0.99c exactly as navigation.bodyPhiMax states it (bit-identical, so never refused).
export pure func solCruisePhi() -> float = bodyPhiMax()
export pure func acenOneMinusBeta() -> float = 0.001      -- 0.999c: Saturn -> alpha Cen
export pure func trappistOneMinusBeta() -> float = 0.0001 -- 0.9999c: alpha Cen -> TRAPPIST-1
export pure func aldebaranOneMinusBeta() -> float = 0.000001 -- 0.999999c: TRAPPIST-1 -> Aldebaran
-- Genuine stop intercepts with explicit standoffs checked by the unchanged
-- collision/ring/intercept math; star legs arrive at the catalogue stand-off.
export pure func legs(p: Params) -> [TourLeg] = [
  {id: "sun", name: "Sun", kind: "body", cruisePhi: solCruisePhi(), standoffKm: Some(sunStandoffKm()), timing: Some(tourTiming())},
  {id: "jupiter", name: "Jupiter", kind: "body", cruisePhi: solCruisePhi(), standoffKm: Some(jupiterStandoffKm()), timing: Some(tourTiming())},
  {id: "callisto", name: "Callisto clearance", kind: "body", cruisePhi: solCruisePhi(), standoffKm: Some(callistoStandoffKm()), timing: Some(tourTiming())},
  {id: "saturn", name: "Saturn", kind: "body", cruisePhi: solCruisePhi(), standoffKm: Some(saturnStandoffKm()), timing: Some(tourTiming())},
  {id: "CNS5:3627", name: "Alpha Centauri system", kind: "star", cruisePhi: rapidityOfOneMinusBeta(acenOneMinusBeta()), standoffKm: None, timing: None},
  {id: "acen-a", name: "Alpha Centauri A", kind: "body", cruisePhi: solCruisePhi(), standoffKm: Some(habitableZoneKm(alphaStellarValue("acen-a", "luminosity_sun"))), timing: Some(tourTiming())},
  {id: "Gaia DR3 2635476908753563008", name: "TRAPPIST-1 system", kind: "star", cruisePhi: rapidityOfOneMinusBeta(trappistOneMinusBeta()), standoffKm: None, timing: None},
  {id: "trappist-1", name: "TRAPPIST-1", kind: "body", cruisePhi: solCruisePhi(), standoffKm: Some(destinationStopKm("trappist-1")), timing: Some(tourTiming())},
  {id: "CNS5:1142", name: "Aldebaran system", kind: "star", cruisePhi: rapidityOfOneMinusBeta(aldebaranOneMinusBeta()), standoffKm: None, timing: None},
  {id: "aldebaran", name: "Aldebaran", kind: "body", cruisePhi: solCruisePhi(), standoffKm: Some(destinationStopKm("aldebaran")), timing: Some(giantTiming())}
]
export pure func legCount() -> int = 10
pure func legAt(xs: [TourLeg], n: int) -> Option[TourLeg] =
  if n < 0 then None else match xs { [] => None, x :: rest => if n == 0 then Some(x) else legAt(rest, n - 1) }
export pure func intentForLeg(w: World, n: int, outbound: Target) -> Option[Intent] =
  match legAt(legs(w.params), n) {
    None => None,
    Some(leg) => if leg.kind == "body" then Some(IPlanBody({id: leg.id, cruisePhi: leg.cruisePhi, mode: "stop", standoffKm: leg.standoffKm, bKm: 0.0, clockDeg: 0.0, runOutKm: None, timing: leg.timing}))
      else if outbound.id == leg.id then Some(IPlan({target: outbound, cruisePhi: leg.cruisePhi, flipG: None})) else None
  }
