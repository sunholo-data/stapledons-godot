type Texts = {c5: string, h2: string, hm: string, gc: string}
pure func joinLines(ls: [string]) -> string = concat([join("\n", ls), "\n"])
pure func inline() -> Texts = {c5: joinLines(cns5Lines()), h2: joinLines(hip2Lines()), hm: joinLines(hipMainLines()), gc: joinLines(gcnsLines())}
pure func brightRows(t: Texts) -> [Row] = match bright(parseHip2(t.h2), parseHipMain(t.hm), parseCnsHip(t.c5), gcnsIndex("")) {
  Ok(b) => b.rows, Err(_) => [] }
pure func world(t: Texts) -> [Star] =
  candidates(cnsStars(t.c5), gcnsStars(t.gc), hipStars(brightRows(t), parseHip2(t.h2), hipErrors(t.h2), parseHipMain(t.hm)))
pure func links(t: Texts) -> [Link] = systems(world(t))
pure func rootOf(t: Texts, id: string) -> string = match linkOf(links(t), id) { Some(l) => l.root, None => "-" }
-- Sirius B (Gaia, 374.51 mas) takes Sirius A's Hipparcos parallax (CNS5 1676, 379.21 mas, 8.601 ly).
pure func checkSiriusB(t: Texts) -> bool = match linkOf(links(t), "2947050466531873024") {
  Some(l) => l.root == "CNS5:1676" && l.parent == "CNS5:1676" && l.plx == 379.2099914550781 && l.ownPlx == 374.5105905289588 &&
    l.sep > 5.0 && l.sep < 12.0 && l.au < 50.0,
  None => false
}
-- alpha Cen B (HIP 71681, a bright row) takes CNS5 3627's parallax at its own HIP2 direction moved to
-- 3627's epoch (J1991.25): exactly the bytes the retired rule (c) wrote (data/starmap/stars.json, M1.7).
pure func checkAlphaCenB(t: Texts) -> bool = match linkOf(links(t), "HIP 71681") {
  Some(l) => l.root == "CNS5:3627" && l.epoch == 1991.25 && l.plx == 754.8099975585938 &&
    (match filter(\r. r.id == "HIP 71681", applyHip(brightRows(t), parseHip2(t.h2), linkIndex(links(t)))) {
      [b] => b.x == 3.094279167661899 && b.y == 0.0 - 3.015648140050498 && b.z == 0.0 - 0.05181368755211183, _ => false }),
  None => false
}
-- Luyten 726-8 B (UV Cet) -> A (BL Cet), 2.3 arcsec; Wolf 424 B -> A, 1.1 arcsec. Both parallaxes
-- disagree by 6-10 sigma (Gaia's errors on close pairs are too small), and agree within 5%.
pure func checkLuytenWolf(t: Texts) -> bool =
  rootOf(t, "5140693571158946048") == "5140693571158739840" && rootOf(t, "3902874650601954816") == "3902874650602495232" &&
  rootOf(t, "5140693571158739840") == "-" && rootOf(t, "3902874650602495232") == "-"
-- False pairs: the GCNS star 43 arcsec from GJ 604 (634 AU projected) is at 307 ly against 48 ly
-- (parallaxes 84% apart): no link. GJ 13207 / 13208: 102 arcsec, 87% apart: no link. GJ 604's GCNS
-- row is its CNS5 row (one candidate, so no self-pair).
pure func checkFalsePairs(t: Texts) -> bool =
  rootOf(t, "5994771079533026688") == "-" && rootOf(t, "5994771148252505216") == "-" &&
  rootOf(t, "1958030617647715328") == "-" && rootOf(t, "1958031442283263616") == "-" &&
  size(filter(\s. s.id == "5994771148252505216", world(t))) == 1
-- Exactly the four companions, the same whatever the input order.
pure func checkOrderFree(t: Texts) -> bool =
  map(\l. l.id, links(t)) == ["2947050466531873024", "3902874650601954816", "5140693571158946048", "HIP 71681"] &&
  map(linkLine, systems(reverse(world(t)))) == map(linkLine, links(t))
-- The pinned outcomes pass on these lines and fail when one is missing or re-rooted.
pure func isErr(r: Result[(), string]) -> bool = match r { Err(_) => true, Ok(_) => false }
pure func checkPinnedGuard(t: Texts) -> bool {
  let ls = links(t);
  !isErr(checkPinned(linkIndex(ls))) && isErr(checkPinned(linkIndex(filter(\l. l.id != "HIP 71681", ls)))) &&
  isErr(checkPinned(linkIndex(map(\l. if l.id == "2947050466531873024" then {id: l.id, parent: l.parent, root: "CNS5:1675",
    plx: l.plx, epoch: l.epoch, ownPlx: l.ownPlx, sep: l.sep, au: l.au} else l, ls))))
}
-- companions.csv round trip (bit-exact floats), and the refusals: header, order, duplicates, fields.
pure func checkTableRoundTrip(t: Texts) -> bool {
  let ls = links(t);
  let txt = linksText(["rule", "inputs"], ls);
  startsWith(txt, "# rule\n# inputs\nid,root,") &&
  (match parseLinks(txt) { Ok(back) => map(linkLine, back) == map(linkLine, ls) && map(\l. l.plx, back) == map(\l. l.plx, ls), Err(_) => false }) &&
  isErrL(parseLinks(replace(txt, "id,root,", "id,ROOT,"))) && isErrL(parseLinks(linksText([], reverse(ls)))) &&
  isErrL(parseLinks(linksText([], flatMap(\l. [l, l], ls)))) && isErrL(parseLinks(concat([txt, "x,y\n"])))
}
pure func isErrL(r: Result[[Link], string]) -> bool = match r { Err(_) => true, Ok(_) => false }
-- applyRows moves a linked row along its own direction to the root's distance and leaves every
-- other row exactly as it was.
pure func lenOf(r: Row) -> float = sqrt(r.x * r.x + r.y * r.y + r.z * r.z)
pure func checkApplyRows(t: Texts) -> bool {
  let ix = linkIndex(links(t));
  let b = {id: "2947050466531873024", x: -5.842239, y: -6.316659, z: -1.346276, teff: 9000.0, v: 8.5, flags: 0};
  let o = {id: "other", x: 1.0, y: 2.0, z: 3.0, teff: 3000.0, v: 12.0, flags: 4};
  match applyRows([o, b], ix) {
    [o2, b2] => o2.id == o.id && o2.x == o.x && o2.y == o.y && o2.z == o.z && o2.teff == o.teff && o2.v == o.v && o2.flags == o.flags && b2.teff == b.teff && b2.v == b.v && b2.flags == b.flags &&
      lenOf(b2) - 8.60094374 < 0.0000001 && 8.60094374 - lenOf(b2) < 0.0000001 &&
      b2.x / b.x - b2.z / b.z < 0.000000000001 && b2.z / b.z - b2.x / b.x < 0.000000000001 && movedIn([o, b], ix) == 1,
    _ => false
  }
}

pure func synthetic() -> [(string, bool)] = [("Angle", checkAngle()), ("ProjectedAu", checkProjectedAu()), ("FracCap", checkFracCap()),
  ("CloseOrSigma", checkCloseOrSigma()), ("ProperMotion", checkProperMotion()), ("Rank", checkRank()), ("RootChain", checkRootChain()),
  ("BrightestParent", checkBrightestParent()), ("Band", checkBand())]
pure func real(t: Texts) -> [(string, bool)] = [("SiriusB", checkSiriusB(t)), ("AlphaCenB", checkAlphaCenB(t)), ("LuytenWolf", checkLuytenWolf(t)),
  ("FalsePairs", checkFalsePairs(t)), ("OrderFree", checkOrderFree(t)), ("PinnedGuard", checkPinnedGuard(t)),
  ("TableRoundTrip", checkTableRoundTrip(t)), ("ApplyRows", checkApplyRows(t))]

test "companions checkAngle" { checkAngle() }
test "companions checkProjectedAu" { checkProjectedAu() }
test "companions checkFracCap" { checkFracCap() }
test "companions checkCloseOrSigma" { checkCloseOrSigma() }
test "companions checkProperMotion" { checkProperMotion() }
test "companions checkRank" { checkRank() }
test "companions checkRootChain" { checkRootChain() }
test "companions checkBrightestParent" { checkBrightestParent() }
test "companions checkBand" { checkBand() }
test "companions checkSiriusB" { checkSiriusB(inline()) }
test "companions checkAlphaCenB" { checkAlphaCenB(inline()) }
test "companions checkLuytenWolf" { checkLuytenWolf(inline()) }
test "companions checkFalsePairs" { checkFalsePairs(inline()) }
test "companions checkOrderFree" { checkOrderFree(inline()) }
test "companions checkPinnedGuard" { checkPinnedGuard(inline()) }
test "companions checkTableRoundTrip" { checkTableRoundTrip(inline()) }
test "companions checkApplyRows" { checkApplyRows(inline()) }

export func companionsVm(_: int) -> string = verdictOf("companions", failedChecks(flatMap(\x. x, [synthetic(), real(inline())])))
pure func pick(text: string, keep: string -> bool) -> string = joinLines(filter(keep, filter(\l. l != "", split(text, "\n"))))
export func companionsFixtures(dir: string) -> string ! {FS} {
  let c5 = concat([pick(readFile(concat([dir, "/cns5_bright.dat"])), \l. startsWith(l, "1675 ") || startsWith(l, "1676 ") || startsWith(l, "3627 ")),
    readFile(concat([dir, "/cns5_companions.dat"]))]);
  let h2 = pick(readFile(concat([dir, "/hip2_bright.dat"])), \l. startsWith(l, " 71681 ") || startsWith(l, " 71683 "));
  let hm = pick(readFile(concat([dir, "/hip_main_bright.dat"])), \l. startsWith(l, "H|       71681|") || startsWith(l, "H|       71683|"));
  let t = {c5: c5, h2: h2, hm: hm, gc: readFile(concat([dir, "/table1c_companions.dat"]))};
  let same = [("cns5 bytes", t.c5 == inline().c5), ("hip2 bytes", t.h2 == inline().h2), ("hip_main bytes", t.hm == inline().hm),
    ("gcns bytes", t.gc == inline().gc)];
  verdictOf("companions-fixtures", failedChecks(flatMap(\x. x, [same, real(t)])))
}
