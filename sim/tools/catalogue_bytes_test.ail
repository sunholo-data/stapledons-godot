module stapledons/sim/tools/catalogue_bytes_test
import ./catalogue (Row)
import ./catalogue_bytes (encodeRows)
import std/result (Ok, Err)
import std/bytes (toInts)
import std/list (map, flatMap)
import std/math (floatToInt)

pure func inspect(rows: [Row]) -> [int] = match encodeRows(rows) { Ok(b) => toInts(b), Err(_) => [-1] }
pure func input(values: [float]) -> Row = match values {
  [x,y,z,t,v,f] => {id:"oracle",x:x,y:y,z:z,teff:t,v:v,flags:floatToInt(f)},
  _ => {id:"invalid",x:1e39,y:0.0,z:0.0,teff:0.0,v:0.0,flags:0}
}
export pure func oracle(cases: [[[float]]]) -> [[int]] = map(\rows. inspect(map(input,rows)),cases)
pure func badRows(v: float) -> [[Row]] = [
  [{id:"x",x:v,y:2.0,z:3.0,teff:4.0,v:5.0,flags:0}],
  [{id:"y",x:1.0,y:v,z:3.0,teff:4.0,v:5.0,flags:0}],
  [{id:"z",x:1.0,y:2.0,z:v,teff:4.0,v:5.0,flags:0}],
  [{id:"teff",x:1.0,y:2.0,z:3.0,teff:v,v:5.0,flags:0}],
  [{id:"v",x:1.0,y:2.0,z:3.0,teff:4.0,v:v,flags:0}]]
export pure func nonfinite(n: int) -> [[int]] = map(inspect,flatMap(badRows,[0.0/0.0,1.0/0.0,-1.0/0.0]))
