module stapledons/sim/tools/bright_main
-- M1.2d shells (FS) for sim/tools/bright.ail, on catalogue_main's validated, atomic writer, with the
-- companion rule (sim/tools/companions.ail) in every tier:
--   companionsMain  the rule over CNS5 + GCNS + the bright rows -> data/starmap/companions/companions.csv (make
--              companions). It reads the uncompressed GCNS table1c.dat (std/gzip stops at 100 MB; the
--              Makefile gunzips the pinned .gz into the scratch dir) and records both digests.
--   mainFill   the quick tier with rule (b), the HIP photometry fill: catalogue_main.main's inputs
--              plus hip_main.dat (I/239); the CNS5 HIP column and Gaia G come from the raw cns5.dat.
--   gcnsMain   the medium and large tiers (GCNS): catalogue_main.main plus the companion table.
--   brightMain the bright tier, rule (a).
--   mapMain    M1.7: the galaxy map catalogue data/starmap/stars.json (sim/tools/starmap.ail) from
--              the quick rows (with the fill) and the bright rows, within 25 pc.
-- Every tier entry reads companions.csv, refuses it unless the pinned companions (Sirius B, alpha
-- Cen B, Luyten 726-8 B, Wolf 424 B) have their roots, applies it, and records its digest.
-- A separate module so catalogue_main (`--entry main`, the fixture writer) does not load extract.ail,
-- whose own `main` the v0.51.0 VM picked instead (reported upstream).
--   ailang run --quiet --bytecode --caps IO,FS --package-dir sim --entry brightMain --args-json \
--     '{"hip2":"data/raw/hip2.dat.gz","hipMain":"data/raw/hip_main.dat","cns5":"data/raw/cns5.dat","gcns":"data/raw/gcns.csv",
--       "companions":"data/starmap/companions/companions.csv","lock":"sim/ailang.lock","out":"data/starmap","ailang":"v0.52.0"}' \
--     sim/tools/bright_main.ail
import ./catalogue (Fill)
import ./catalogue_bytes (encodeRows)
import ./catalogue (Row, selectTier, transform)
import ./catalogue_main (Pkg, Plan, sidecarWith, planAdjusted, applyFill, lockPackage, outputName, fail, writeFail, rawDigest, commit)
import ./starmap (mapRows, mapJson, mapRadiusLy)
import ./truth (Truth, Pos, Index, ruleVersion, ruleText, parseCnsAst, parseGcnsAst, parsePos, parseSame, byKey, truthRows, csvText, countWhere, countLine, uncertain, parseTruth, index, applyById, applyGcns, dropped, placedCount)
import ./extract (fmt6)
import ./bright (Astro, Phot, Cns, Bright, parseHip2, parseHipMain, parseCnsHip, gcnsIndex, fill, bright)
import ./companions (Link, Same, cnsStars, gcnsStars, hipStars, hipErrors, candidates, systems, linkIndex, applyRows, applyGcnsRows, applyHip, movedIn, rootsIn, checkTier, checkPinned, linksText, parseLinks)
import std/result (Result, Ok, Err)
import std/option (Some, None)
import std/string (concat, join, intToStr, floatToStr, contains)
import std/list (map, nth, filter, flatMap, length as size, concat as append)
import std/crypto (sha256Hex, sha256Bytes)
import std/bytes (fromBase64, toString as utf8)
import std/json (Json, encode, kv, js, jint, jo, ja, asString)
import std/gzip (decompressFile)
import std/fs (readFileResult, writeFileResult, renameFileResult)
import std/io (println)

export pure func companionRule() -> string =
  "companion rule (Mark, attended 2026-10-03; design_docs/planned/r1/m1-companion-parallax.md): within 60 arcsec and 2000 AU of a brighter star, parallaxes within 20% and (5% or 3 sigma), proper motions within the orbital bound or 20%: the system root's parallax"
-- The bright tier inputs (rule a): HIP2, hip_main, CNS5 (dat), GCNS (csv).
export type BrightIn = {hip2: string, hipMain: string, cns5: string, gcns: string}
export type Tier = {b: Bright, hips: [Astro], phot: Array[Phot], cns: [Cns]}
export pure func brightTier(i: BrightIn) -> Result[Tier, string] {
  let phot = parseHipMain(i.hipMain);
  let cns = parseCnsHip(i.cns5);
  let hips = parseHip2(i.hip2);
  match bright(hips, phot, cns, gcnsIndex(i.gcns)) { Err(e) => Err(e), Ok(b) => Ok({b: b, hips: hips, phot: phot, cns: cns}) }
}
-- The rule over every candidate (gcnsDat: the uncompressed GCNS table1c.dat text), and the
-- cross-identifications dropped before pairing.
export pure func companionTable(i: BrightIn, gcnsDat: string) -> Result[{links: [Link], same: [Same]}, string] = match brightTier(i) {
  Err(e) => Err(e),
  Ok(t) => {
    let c = candidates(cnsStars(i.cns5), gcnsStars(gcnsDat), hipStars(t.b.rows, t.hips, hipErrors(i.hip2), t.phot));
    let ls = systems(c.stars);
    match checkPinned(linkIndex(ls)) { Err(e) => Err(e), Ok(_) => Ok({links: ls, same: c.same}) }
  }
}
-- A committed table, checked.
export pure func readLinks(text: string) -> Result[Array[Link], string] = match parseLinks(text) {
  Err(e) => Err(e),
  Ok(ls) => { let ix = linkIndex(ls); match checkPinned(ix) { Err(e) => Err(e), Ok(_) => Ok(ix) } }
}
pure func ruleKeys(n: int) -> [{key: string, value: Json}] = [kv("companions", jint(n)), kv("companion_rule", js(companionRule()))]
pure func brightSource() -> string =
  "HIP2 VizieR I/311 hip2.dat.gz x I/239 hip_main.dat: V < 7, Plx > 0, unmatched to CNS5 (HIP id) and GCNS (1 arcsec at J2016.0, |G-V| < 2); companions at their system's distance"
-- M1.2d rule (a) and the companion rule: the bright tier; count_excluded = V < 7 stars without B-V (no teff).
export pure func brightPlan(t: Tier, links: Array[Link], shas: [{key: string, value: Json}], ailang: string, pkg: Pkg) -> Result[Plan,string] {
  let moved = applyHip(t.b.rows, t.hips, links);
  match checkTier(moved, links) { Err(e) => Err(e), Ok(rows) => match selectTier(rows,"large") {
    Err(e) => Err(e),
    Ok(_) => match encodeRows(rows) {
      Err(e) => Err(e),
      Ok(bin) => Ok({bin: bin, count: size(rows), excluded: size(t.b.noColour),
        sidecar: sidecarWith("bright",brightSource(),size(rows),size(t.b.noColour),
          append([kv("ids",ja(map(\r. js(r.id),rows))), kv("matched_cns5",jint(t.b.cns5)), kv("matched_gcns",jint(t.b.gcns))], ruleKeys(movedIn(rows,links))),
          shas,sha256Bytes(bin),ailang,pkg)})
    }
  } }
}
func readText(path: string) -> Result[string,string] ! {FS} = match readFileResult(path) {
  Err(e) => Err(concat(["cannot read ",path,": ",e])), Ok(t) => Ok(t)
}
func readGz(path: string) -> Result[string,string] ! {FS} = match decompressFile(path) {
  Err(e) => Err(concat(["cannot gunzip ",path,": ",e])),
  Ok(b64) => match fromBase64(b64) { Some(b) => Ok(utf8(b)), None => Err(concat([path," did not decode"])) }
}
func installed(p: Plan, out: string, tier: string, msg: string) -> () ! {FS, IO} = match commit(p,out,tier) {
  Err(e) => writeFail(e),
  Ok(warn) => println(concat(["catalogue ",tier,": ",intToStr(p.count)," rows, ",intToStr(p.excluded)," excluded",msg,
    " -> ",outputName(out,tier,"bin")," (",intToStr(p.count*24)," B)",warn]))
}
func readTable(path: string) -> Result[{links: Array[Link], sha: string},string] ! {FS} = match readText(path) {
  Err(e) => Err(e),
  Ok(t) => match readLinks(t) { Err(e) => Err(concat([path, ": ", e])), Ok(ix) => Ok({links: ix, sha: sha256Hex(t)}) }
}
-- The star-truth table (sim/tools/truth.ail): parsed, indexed, with its digest.
func readTruth(path: string) -> Result[{ix: Index, sha: string}, string] ! {FS} = match readText(path) {
  Err(e) => Err(e),
  Ok(t) => match parseTruth(t) { Err(e) => Err(concat([path, ": ", e])), Ok(rows) => Ok({ix: index(rows), sha: sha256Hex(t)}) }
}
pure func truthKeys(rows: [Row], ix: Index) -> [{key: string, value: Json}] = [kv("truth_rule", js(ruleVersion())), kv("truth_rows", jint(placedCount(rows, ix)))]
-- The quick tier with the M1.2d rule (b) fill and the companion table.
export func mainFill(a: {tier: string, csv: string, raw: string, lock: string, out: string, ailang: string, hip: string, companions: string, truth: string}) -> () ! {FS, IO} =
  match readText(a.csv) { Err(e) => fail(e), Ok(csv) => match readText(a.raw) { Err(e) => fail(e), Ok(rawText) =>
  match readText(a.hip) { Err(e) => fail(e), Ok(hipText) => match rawDigest(a.raw) { Err(e) => fail(e), Ok(rawSha) =>
  match rawDigest(a.hip) { Err(e) => fail(e), Ok(hipSha) => match readText(a.lock) { Err(e) => fail(e), Ok(lock) =>
  match readTable(a.companions) { Err(e) => fail(e), Ok(tab) => match readTruth(a.truth) { Err(e) => fail(e), Ok(tr) =>
  match lockPackage(lock,"sunholo/relativity") { Err(e) => fail(e), Ok(pkg) => {
    let f = fill(parseCnsHip(rawText),parseHipMain(hipText));
    match planAdjusted({tier: a.tier, csv: csv, rawSha: rawSha, ailang: a.ailang, pkg: pkg},f.rows,hipSha,
        \rs. checkTier(applyRows(applyById(rs,tr.ix),tab.links),tab.links), \rs. append(ruleKeys(movedIn(rs,tab.links)), truthKeys(rs,tr.ix)),
        [kv("companions",js(tab.sha)), kv("truth",js(tr.sha))]) {
      Err(e) => fail(e),
      Ok(p) => installed(p,a.out,a.tier,concat(["; HIP photometry filled ",intToStr(size(f.rows)),", left missing: ",
        intToStr(size(f.ambiguous))," sharing a HIP id (",join(" ",f.ambiguous),"), ",intToStr(size(f.noPhot))," without HIP V and B-V (",join(" ",f.noPhot),")"]))
    }
  } } } } } } } } } }
-- The medium and large tiers (GCNS: csv gcns.csv, raw table1c.dat.gz) with the companion table.
-- The star-truth table first (position, relabel, drop), then the companion rule (truth.applyGcns).
export func gcnsMain(a: {tier: string, csv: string, raw: string, lock: string, out: string, ailang: string, companions: string, truth: string}) -> () ! {FS, IO} =
  match readText(a.csv) { Err(e) => fail(e), Ok(csv) => match rawDigest(a.raw) { Err(e) => fail(e), Ok(rawSha) =>
  match readText(a.lock) { Err(e) => fail(e), Ok(lock) => match lockPackage(lock,"sunholo/relativity") { Err(e) => fail(e), Ok(pkg) =>
  match readTable(a.companions) { Err(e) => fail(e), Ok(tab) => match readTruth(a.truth) { Err(e) => fail(e), Ok(tr) =>
    match planAdjusted({tier: a.tier, csv: csv, rawSha: rawSha, ailang: a.ailang, pkg: pkg},[],"",
        \rs. checkTier(applyGcns(rs,tr.ix,tab.links),tab.links), \rs. flatten([ruleKeys(movedIn(rs,tab.links)), [kv("companion_roots",jint(rootsIn(rs,tab.links)))], truthKeys(rs,tr.ix)]),
        [kv("companions",js(tab.sha)), kv("truth",js(tr.sha))]) {
      Err(e) => fail(e),
      Ok(p) => installed(p,a.out,a.tier,"")
    } } } } } } }
func brightInputs(hip2: string, hipMain: string, cns5: string, gcns: string) -> Result[{i: BrightIn, shas: [{key: string, value: Json}]},string] ! {FS} =
  match readGz(hip2) { Err(e) => Err(e), Ok(h2) => match readText(hipMain) { Err(e) => Err(e), Ok(hm) =>
  match readText(cns5) { Err(e) => Err(e), Ok(c5) => match readText(gcns) { Err(e) => Err(e), Ok(gc) =>
  match rawDigest(hip2) { Err(e) => Err(e), Ok(s2) => match rawDigest(cns5) { Err(e) => Err(e), Ok(s5) =>
    Ok({i: {hip2: h2, hipMain: hm, cns5: c5, gcns: gc},
      shas: [kv("hip2",js(s2)), kv("hip_main",js(sha256Hex(hm))), kv("cns5",js(s5)), kv("gcns",js(sha256Hex(gc)))]})
  } } } } } }
-- The bright tier (rule a and the companion table). hip2 is the pinned .gz, read directly.
export func brightMain(a: {hip2: string, hipMain: string, cns5: string, gcns: string, companions: string, lock: string, out: string, ailang: string}) -> () ! {FS, IO} =
  match brightInputs(a.hip2, a.hipMain, a.cns5, a.gcns) { Err(e) => fail(e), Ok(bi) =>
  match readText(a.lock) { Err(e) => fail(e), Ok(lock) => match lockPackage(lock,"sunholo/relativity") { Err(e) => fail(e), Ok(pkg) =>
  match readTable(a.companions) { Err(e) => fail(e), Ok(tab) =>
  match brightTier(bi.i) { Err(e) => fail(e), Ok(t) =>
  match brightPlan(t, tab.links, append(bi.shas, [kv("companions",js(tab.sha))]), a.ailang, pkg) {
    Err(e) => fail(e),
    Ok(p) => installed(p,a.out,"bright",concat([" (no B-V: ",join(" ",t.b.noColour),"); matched CNS5 ",intToStr(t.b.cns5),
      ", GCNS ",intToStr(t.b.gcns)]))
  } } } } } }

-- M1.7: the map rows are exactly the tiers' rows (quick with rule b, bright with rule a, both with the
-- companion table), before the float32 encoding; Ok carries the file text and the row count.
export pure func mapPlan(csv: string, t: Tier, links: Array[Link], ix: Index, shas: [{key: string, value: Json}], ailang: string, pkg: Pkg) -> Result[{text: string, count: int}, string] =
  match transform(csv) {
    Err(e) => Err(e),
    Ok(s) => match selectTier(applyRows(applyById(applyFill(s.rows, fill(t.cns, t.phot).rows), ix), links), "quick") {
      Err(e) => Err(e),
      Ok(q) => {
        let b = applyHip(t.b.rows, t.hips, links);
        match mapRows(q.rows, b, mapRadiusLy()) {
          Err(e) => Err(e),
          Ok(rows0) => match checkTier(rows0, links) { Err(e) => Err(e), Ok(rows) => Ok({count: size(rows), text: mapJson(rows, size(q.rows), size(b), [
            kv("ailang", js(ailang)),
            kv("package", jo([kv("name", js(pkg.name)), kv("version", js(pkg.version)), kv("content_hash", js(pkg.hash))])),
            kv("producer", js("stapledons/sim/tools/bright_main mapMain (sim/tools/starmap.ail)")),
            kv("companions", jint(movedIn(rows, links))), kv("companion_rule", js(companionRule())),
            kv("truth_rule", js(ruleVersion())), kv("truth_rows", jint(placedCount(rows0, ix))),
            kv("sha256", jo(shas))])}) }
        }
      }
    }
  }
-- Temp file beside the target, then a rename: a refusal or a failed write leaves the old file.
func install(out: string, text: string, msg: string) -> () ! {FS, IO} = {
  let tmp = concat([out, ".tmp"]);
  match writeFileResult(tmp, text) {
    Err(e) => writeFail(concat(["cannot write ", tmp, ": ", e, "; nothing changed"])),
    Ok(_) => match renameFileResult(tmp, out) {
      Err(e) => writeFail(concat(["cannot install ", out, ": ", e, "; ", tmp, " left for inspection, ", out, " unchanged"])),
      Ok(_) => println(concat([msg, " -> ", out, " (sha256 ", sha256Hex(text), ")"]))
    }
  }
}
export func mapMain(a: {csv: string, cns5: string, hip2: string, hipMain: string, gcns: string, companions: string, truth: string, lock: string, out: string, ailang: string}) -> () ! {FS, IO} =
  match readText(a.csv) { Err(e) => fail(e), Ok(csv) => match brightInputs(a.hip2, a.hipMain, a.cns5, a.gcns) { Err(e) => fail(e), Ok(bi) =>
  match readText(a.lock) { Err(e) => fail(e), Ok(lock) => match lockPackage(lock,"sunholo/relativity") { Err(e) => fail(e), Ok(pkg) =>
  match readTable(a.companions) { Err(e) => fail(e), Ok(tab) => match readTruth(a.truth) { Err(e) => fail(e), Ok(tr) =>
  match brightTier(bi.i) { Err(e) => fail(e), Ok(t) =>
  match mapPlan(csv, t, tab.links, tr.ix, flatten([[kv("cns5_csv",js(sha256Hex(csv)))], reorder(bi.shas), [kv("companions",js(tab.sha)), kv("truth",js(tr.sha))]]), a.ailang, pkg) {
    Err(e) => fail(e),
    Ok(m) => install(a.out, m.text, concat(["starmap: ", intToStr(m.count), " stars within 25 pc"]))
  } } } } } } } }
-- the M1.7 header order: cns5, hip_main, hip2, gcns
pure func reorder(shas: [{key: string, value: Json}]) -> [{key: string, value: Json}] = match shas {
  [h2, hm, c5, gc] => [c5, hm, h2, gc], _ => shas }
pure func flatten[a](xs: [[a]]) -> [a] = match xs { [] => [], x :: r => append(x, flatten(r)) }
-- The companion table: the rule over CNS5 + GCNS (gcnsDat, the uncompressed table1c.dat; gcnsRaw, the
-- pinned .gz, for its digest) + the bright rows, sorted by id.
export func companionsMain(a: {cns5: string, hip2: string, hipMain: string, gcns: string, gcnsRaw: string, gcnsDat: string, out: string}) -> () ! {FS, IO} =
  match brightInputs(a.hip2, a.hipMain, a.cns5, a.gcns) { Err(e) => fail(e), Ok(bi) =>
  match readText(a.gcnsDat) { Err(e) => fail(e), Ok(gd) => match rawDigest(a.gcnsRaw) { Err(e) => fail(e), Ok(sg) =>
  match companionTable(bi.i, gd) {
    Err(e) => fail(e),
    Ok(t) => install(a.out, linksText(append([companionRule(),
      concat(["inputs sha256: cns5.dat ", shaOf(bi.shas, 2), ", table1c.dat.gz ", sg, ", table1c.dat ", sha256Hex(gd),
        ", hip2.dat.gz ", shaOf(bi.shas, 0), ", hip_main.dat ", shaOf(bi.shas, 1), ", gcns.csv ", shaOf(bi.shas, 3)]),
      concat(["same star, GCNS record dropped before pairing (", intToStr(size(t.same)), "): name = Gaia id, separation arcsec"])],
      map(\x. concat(["same: ", x.id, " = ", x.gaia, ", ", floatToStr(x.sep)]), t.same)), t.links),
      concat(["companions: ", intToStr(size(t.links)), " companions, ", intToStr(size(t.same)), " cross-identifications"]))
  } } } }
pure func shaOf(shas: [{key: string, value: Json}], i: int) -> string = match nth(shas, i) {
  Some(e) => match asString(e.value) { Some(t) => t, None => "" }, None => "" }

-- The star-truth table (sim/tools/truth.ail, design_docs/planned/r1/starmap-single-truth.md):
-- CNS5 (dat + csv) x GCNS (table1c.dat uncompressed, gcnsDat; the pinned .gz, gcnsRaw, for its digest;
-- gcns.csv) x the companion table's cross-identifications, with the bright rows (after the companion
-- rule) for the HIP cross-ids. Writes <out>/positions.csv and <out>/positions.json.
pure func posOf(r: Row) -> Pos = {id: r.id, x: fmt6(r.x), y: fmt6(r.y), z: fmt6(r.z)}
export pure func truthPlan(cnsDat: string, cnsCsv: string, gcnsDat: string, gcnsCsv: string, companions: string, t: Tier, links: Array[Link]) -> Result[[Truth], string] {
  let cns = parseCnsAst(cnsDat);
  let same = parseSame(companions);
  let keep = byKey(\s. s, append(map(\a. a.id, cns), map(\s. s.gaia, same)));
  truthRows(cns, parseGcnsAst(keep, gcnsDat), parsePos(byKey(\s. s, []), cnsCsv), parsePos(keep, gcnsCsv), same,
    map(posOf, applyHip(t.b.rows, t.hips, links)))
}
export pure func truthSidecar(rows: [Truth], csvSha: string, shas: [{key: string, value: Json}], ailang: string) -> string =
  concat([encode(jo([kv("rule", js(ruleVersion())), kv("rule_text", js(ruleText())), kv("rows", jint(size(rows))),
    kv("position", jint(countWhere(rows, \x. x.action == "position"))), kv("relabel", jint(countWhere(rows, \x. x.action == "relabel"))),
    kv("drop", jint(countWhere(rows, \x. x.action == "drop"))), kv("disagreements", jint(countWhere(rows, \x. x.disagree))),
    kv("resolved", jint(countWhere(rows, \x. x.disagree && x.resolution != ""))), kv("uncertain", jint(size(uncertain(rows)))),
    kv("ailang", js(ailang)), kv("producer", js("stapledons/sim/tools/bright_main truthMain (sim/tools/truth.ail)")),
    kv("sha256", jo(append(shas, [kv("positions_csv", js(csvSha))])))])), "\n"])
export func truthMain(a: {cns5: string, cns5Csv: string, gcnsRaw: string, gcnsDat: string, gcns: string, hip2: string, hipMain: string, companions: string, out: string, ailang: string}) -> () ! {FS, IO} =
  match brightInputs(a.hip2, a.hipMain, a.cns5, a.gcns) { Err(e) => fail(e), Ok(bi) =>
  match readText(a.cns5Csv) { Err(e) => fail(e), Ok(cc) => match readText(a.gcnsDat) { Err(e) => fail(e), Ok(gd) =>
  match rawDigest(a.gcnsRaw) { Err(e) => fail(e), Ok(sg) => match readText(a.companions) { Err(e) => fail(e), Ok(ct) =>
  match readLinks(ct) { Err(e) => fail(e), Ok(links) => match brightTier(bi.i) { Err(e) => fail(e), Ok(t) =>
  match truthPlan(bi.i.cns5, cc, gd, bi.i.gcns, ct, t, links) {
    Err(e) => fail(e),
    Ok(rows) => {
      let shas = [kv("cns5", js(shaOf(bi.shas, 2))), kv("cns5_csv", js(sha256Hex(cc))), kv("table1c", js(sg)), kv("gcns", js(shaOf(bi.shas, 3))),
        kv("hip2", js(shaOf(bi.shas, 0))), kv("hip_main", js(shaOf(bi.shas, 1))), kv("companions", js(sha256Hex(ct)))];
      let text = csvText([ruleText(), concat(["inputs sha256: ", join(", ", map(\s. concat([s.key, " ", match asString(s.value) { Some(v) => v, None => "" }]), shas))]),
        "x, y, z: galactic light-years, the adopted source CSV's own digits; dist_ly = |x, y, z|; sigma_ly = dist_ly * e_plx / plx (adopted)",
        "action: position = GCNS row takes this position; relabel = GCNS row becomes this CNS5 identity here; drop = the bright tier renders it"], rows);
      install(concat([a.out, "/positions.csv"]), text, concat(["star truth: ", countLine(rows)]));
      install(concat([a.out, "/positions.json"]), truthSidecar(rows, sha256Hex(text), shas, a.ailang), "star truth sidecar")
    }
  } } } } } } } }

-- AC4 audit (make starmap-truth-audit): every row the truth table marks (a disagreement over max(3 sigma,
-- 1%), or any resolution) has a resolution, and its Gaia id appears in the committed audit document.
export pure func auditLines(rows: [Truth], doc: string) -> {lines: [string], bad: [string]} {
  let marked = disagreementsOf(rows);
  {lines: map(\t. concat([t.id, " (", t.source, "; ", t.action, "): ", if t.resolution == "" then "UNRESOLVED" else t.resolution]), marked),
   bad: flatMap(\t. if t.resolution == "" then [concat([t.id, ": no resolution"])] else if !contains(doc, t.gaia) then [concat([t.id, ": not in the audit document"])] else [], marked)}
}
pure func disagreementsOf(rows: [Truth]) -> [Truth] = filter(\t. t.disagree || t.resolution != "", rows)
export func auditMain(a: {truth: string, doc: string}) -> () ! {FS, IO} =
  match readText(a.truth) { Err(e) => fail(e), Ok(text) => match readText(a.doc) { Err(e) => fail(e), Ok(doc) =>
  match parseTruth(text) { Err(e) => fail(e), Ok(rows) => {
    let r = auditLines(rows, doc);
    println(concat(["starmap-truth-audit: ", countLine(rows)]));
    println(join("\n", map(\l. concat(["  ", l]), r.lines)));
    match r.bad {
      [] => println(concat(["starmap-truth-audit: PASS (", intToStr(size(r.lines)), " marked rows, all resolved and in ", a.doc, ")"])),
      bad => fail(concat(["star truth audit: ", join("; ", bad)]))
    }
  } } } }
