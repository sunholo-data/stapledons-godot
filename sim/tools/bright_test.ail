type Texts = {h2: string, hm: string, c5: string}
pure func joinLines(ls: [string]) -> string = concat([join("\n", ls), "\n"])
pure func inline() -> Texts = {h2: joinLines(hip2Lines()), hm: joinLines(hipMainLines()), c5: joinLines(cns5Lines())}
-- the same world without one CNS5 row (by its designation, bytes 1-4)
pure func withoutCns(t: Texts, desig: string) -> Texts =
  {h2: t.h2, hm: t.hm, c5: joinLines(filter(\l. !startsWith(l, concat([desig, " "])), split(t.c5, "\n")))}
-- Arcturus as a GCNS row at its J2016.0 position (x 1000 ly), from an independent Python
-- propagation (spherical linear, not bright.ail's vector form); G = V - 0.45.
pure func arcturusGcns() -> string = "id,x,y,z,G,BPRP,wd\narcturus,344.362932,92.411369,934.277427,-0.500000,1.500000,0\n"
pure func world(t: Texts, gcns: string) -> Result[Bright, string] =
  bright(parseHip2(t.h2), parseHipMain(t.hm), parseCnsHip(t.c5), gcnsIndex(gcns))
-- the same world with one field of Rigel's lines rewritten (the cut tests)
pure func rigel(t: Texts, hm: string, h2: string) -> Texts =
  {h2: replace(t.h2, "    3.78 ", h2), hm: replace(t.hm, "| 0.18|", hm), c5: t.c5}
pure func ids(t: Texts, gcns: string) -> [string] = match world(t, gcns) { Ok(b) => map(\r. r.id, b.rows), Err(e) => [e] }
pure func rowOf(t: Texts, id: string) -> [Row] = match world(t, "") { Ok(b) => filter(\r. r.id == id, b.rows), Err(_) => [] }
pure func astro(t: Texts, h: int) -> [Astro] = filter(\a. a.hip == h, parseHip2(t.h2))
pure func cnsRow(t: Texts, id: string) -> [Cns] = filter(\c. c.id == id, parseCnsHip(t.c5))
pure func filled(t: Texts, id: string) -> [{id: string, teff: float, v: float, flags: int}] =
  filter(\f. f.id == id, fill(parseCnsHip(t.c5), parseHipMain(t.hm)).rows)
pure func dist(r: Row) -> float = sqrt(r.x * r.x + r.y * r.y + r.z * r.z)

-- Vega (CNS5 4607, HIP 91262) is matched by CNS5's HIP column and is not in the bright tier; without
-- its CNS5 row it would be (the negative control). The tier is Rigel plus alpha Cen B, in HIP order.
pure func checkVegaExcluded(t: Texts) -> bool =
  ids(t, "") == ["HIP 24436", "HIP 71681"] && ids(withoutCns(t, "4607"), "") == ["HIP 24436", "HIP 71681", "HIP 91262"] &&
  (match world(t, "") { Ok(b) => b.cns5 == 6 && b.gcns == 0 && b.noColour == [], Err(_) => false })
-- Arcturus moves 2.3 arcsec/yr: its J1991.25 position is 56 arcsec from the J2016.0 GCNS row, so it
-- matches only after propagation; |G - V| >= 2 refuses the match; without its CNS5 row the GCNS row
-- alone keeps it out of the bright tier.
pure func checkArcturusPmMatch(t: Texts) -> bool = match astro(t, 69673) {
  [a] => { let idx = gcnsIndex(arcturusGcns());
    gcnsMatch(idx, a, 0.0 - 0.05, 2016.0) && !gcnsMatch(idx, a, 0.0 - 0.05, 1991.25) && !gcnsMatch(idx, a, 1.6, 2016.0) &&
    ids(withoutCns(t, "3517"), arcturusGcns()) == ["HIP 24436", "HIP 71681"] &&
    ids(withoutCns(t, "3517"), "") == ["HIP 24436", "HIP 69673", "HIP 71681"] &&
    (match world(withoutCns(t, "3517"), arcturusGcns()) { Ok(b) => b.gcns == 1 && b.cns5 == 5, Err(_) => false }) },
  _ => false
}
-- Rigel (HIP 24436): in no CNS5 or GCNS row; v = hip_main V verbatim, flag 8, teff from B-V,
-- at its HIP2 distance (3.78 mas, ~863 ly).
pure func checkRigelIncluded(t: Texts) -> bool = match rowOf(t, "HIP 24436") {
  [r] => r.v == 0.18 && r.flags == flagHip() && r.flags == 8 && r.teff == teffFromBV(0.0 - 0.03) &&
    within(dist(r), 1000.0 / 3.78 * 3.261563777, 0.000001),
  _ => false
}
-- Groombridge 1830 (HIP 57939, CNS5 2914, a Gaia J2016.0 position, 7 arcsec/yr): HIP2 propagated to
-- the CNS5 row's own epoch lands within 1 arcsec of it; unpropagated it is 175 arcsec off.
pure func arcsec2() -> float = (PI() / 648000.0) * (PI() / 648000.0)
pure func checkCns5EpochMatch(t: Texts) -> bool = match astro(t, 57939) {
  [a] => match cnsRow(t, "4034171629042489088") {
    [c] => match icrsToGalactic(c.ra, c.dec) { (x, y, z) =>
      c.epoch == 2016.0 && chord2(directionAt(a, c.epoch), x, y, z) < arcsec2() &&
      chord2(directionAt(a, 1991.25), x, y, z) > 10000.0 * arcsec2() },
    _ => false
  },
  _ => false
}
-- Sirius A (CNS5 1676, no Gaia photometry, HIP 32349) gets hip_main V -1.44 and teff from B-V 0.009
-- in place, flag 8; Sirius B (1675, Gaia-measured, no HIP id) is untouched; HIP 32349 is not a
-- bright row (no duplicate); Groombridge 1830 (Gaia-measured, HIP 57939) keeps its Gaia photometry.
-- Five fixture rows are filled (Aldebaran A, Sirius A, Arcturus, alpha Cen AB, Vega). applyFill
-- puts a fill into the tier row by id.
pure func checkSiriusFilled(t: Texts) -> bool = match filled(t, "CNS5:1676") {
  [f] => f.v == 0.0 - 1.44 && f.flags == 8 && f.teff == teffFromBV(0.009) && size(filled(t, "2947050466531873024")) == 0 &&
    size(filled(t, "4034171629042489088")) == 0 && size(fill(parseCnsHip(t.c5), parseHipMain(t.hm)).rows) == 5 &&
    !hasId(ids(t, ""), "HIP 32349") &&
    (match applyFill([{id: "CNS5:1676", x: 1.0, y: 2.0, z: 3.0, teff: 0.0, v: 99.0, flags: 2}], fill(parseCnsHip(t.c5), parseHipMain(t.hm)).rows) {
      [r] => r.v == 0.0 - 1.44 && r.flags == 8 && r.x == 1.0 && r.z == 3.0, _ => false }),
  _ => false
}
pure func hasId(xs: [string], id: string) -> bool = size(filter(\x. x == id, xs)) > 0
-- Shared HIP ids: Aldebaran A (1142, missing) shares HIP 21421 with B (1143, G 11.9 vs V 0.87), so
-- A is the HIP star and is filled; were B's G within 2 mag of V, A would be left missing.
pure func checkSharedHipGuard(t: Texts) -> bool {
  let ph = indexBy(\p. p.hip, [{hip: 21421, v: 0.87, bv: Some(1.538)}]);
  let a = {id: "a", hip: 21421, epoch: 1991.25, ra: 0.0, dec: 0.0, plx: 50.0, g: 99.0, missing: true};
  let b = {id: "b", hip: 21421, epoch: 2016.0, ra: 0.0, dec: 0.0, plx: 50.0, g: 1.5, missing: false};
  size(filled(t, "CNS5:1142")) == 1 && size(fill([a, b], ph).rows) == 0 && fill([a, b], ph).ambiguous == ["a"] &&
    size(fill([a, {id: "b", hip: 21421, epoch: 2016.0, ra: 0.0, dec: 0.0, plx: 50.0, g: 3.0, missing: false}], ph).rows) == 1
}
-- alpha Cen: A is CNS5 3627 (filled, V -0.01); B (HIP 71681) is a bright row (rule a) at its own HIP2
-- parallax (4.09 ly) until the companion rule moves it to the CNS5 system distance (754.81 mas,
-- 4.321 ly), 19 arcsec from A on the sky (~4e-4 ly, ~25 AU). Rule (c) did this by hand before.
pure func companionRows(t: Texts) -> [Row] = match world(t, "") {
  Ok(b) => applyHip(b.rows, parseHip2(t.h2), linkIndex(systems(candidates(cnsStars(t.c5), [],
    hipStars(b.rows, parseHip2(t.h2), hipErrors(t.h2), parseHipMain(t.hm))).stars))),
  Err(_) => [] }
pure func checkAlphaCenBRaw(t: Texts) -> bool = match rowOf(t, "HIP 71681") {
  [b] => within(dist(b), 1000.0 / 796.92 * 3.261563777, 0.000001), _ => false }
pure func checkAlphaCenComponents(t: Texts) -> bool = match filter(\r. r.id == "HIP 71681", companionRows(t)) {
  [b] => match filter(\r. r.id == "CNS5:3627", X.parseCns5(t.c5).rows) {
    [a] => { let sys = match distanceLy(Some(754.8099975585938)) { Some(d) => d, None => 0.0 };
      size(filled(t, "CNS5:3627")) == 1 && within(dist(b), sys, 0.0000001) && within(sys, 4.3211, 0.0001) &&
      len3(b.x - a.x, b.y - a.y, b.z - a.z) > 0.0003 && len3(b.x - a.x, b.y - a.y, b.z - a.z) < 0.0005 &&
      dist(b) - 4.09 > 0.2 && b.v == 1.35 && b.flags == 8 },
    _ => false
  },
  _ => false
}
-- V < 7 and Plx > 0: Rigel at V 7.00 or with a negative parallax is cut; at V 6.99 it stays.
pure func checkCuts(t: Texts) -> bool =
  ids(rigel(t, "| 7.00|", "    3.78 "), "") == ["HIP 71681"] && ids(rigel(t, "| 6.99|", "    3.78 "), "") == ["HIP 24436", "HIP 71681"] &&
  ids(rigel(t, "| 0.18|", "   -3.78 "), "") == ["HIP 71681"]

-- The fill is a quick-tier step: planFill refuses it on medium, and the quick sidecar records the
-- fill count and the hip_main digest; a plan without a fill keeps the M1.2c sidecar (no new keys).
pure func shaB() -> string = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
pure func sidecarOf(tier: string, fs: [{id: string, teff: float, v: float, flags: int}], hipSha: string) -> string =
  match planFill({tier: tier, csv: "id,x,y,z,G,BPRP,wd\nCNS5:1676,1,2,3,,,0\n", rawSha: shaB(), ailang: "v0.51.0",
      pkg: {name: "sunholo/relativity", version: "0.5.1", hash: "sha256:00"}}, fs, hipSha) {
    Ok(p) => p.sidecar, Err(e) => concat(["ERR ", e]) }
pure func checkFillQuickOnly() -> bool {
  let f = [{id: "CNS5:1676", teff: 9597.0, v: 0.0 - 1.44, flags: 8}];
  startsWith(sidecarOf("medium", f, shaB()), "ERR") && startsWith(sidecarOf("quick", f, "short"), "ERR") &&
  contains(sidecarOf("quick", f, shaB()), "\"hip_filled\":1,") && contains(sidecarOf("quick", f, shaB()), "\"hip_main\":\"bbbb") &&
  !contains(sidecarOf("quick", [], ""), "hip_")
}

-- M1.2d eval gaps: fixtures that kill the surviving mutants of the round-1 mutation audit.
-- (1) Two MISSING_PHOT rows sharing one HIP id: each is the other's rival, so neither is filled and
-- both are listed ambiguous (dropping the `missing` term would fill both, their G being 99).
pure func cnsAt(id: string, g: float, missing: bool) -> Cns =
  {id: id, hip: 21421, epoch: 1991.25, ra: 0.0, dec: 0.0, plx: 50.0, g: g, missing: missing}
pure func phot21421() -> Array[Phot] = indexBy(\p. p.hip, [{hip: 21421, v: 0.87, bv: Some(1.538)}])
pure func checkTwoMissingShareHip() -> bool {
  let r = fill([cnsAt("a", 99.0, true), cnsAt("b", 99.0, true)], phot21421());
  size(r.rows) == 0 && r.ambiguous == ["a", "b"] && r.noPhot == [] &&
    size(fill([cnsAt("a", 99.0, true)], phot21421()).rows) == 1
}
-- (2) The |G - V| < 2 window on both sides (V 0.87): a rival at G = V + 2.1 or V - 2.1 is outside it
-- and A is filled; at V + 1.9 or V - 1.9 it is inside and A is left ambiguous. Each one-sided
-- mutant of the window is refused by one of the four cases.
pure func filledWith(g: float) -> int = size(fill([cnsAt("a", 99.0, true), cnsAt("b", g, false)], phot21421()).rows)
pure func checkWindowBothSides() -> bool =
  filledWith(0.87 + 2.1) == 1 && filledWith(0.87 - 2.1) == 1 && filledWith(0.87 + 1.9) == 0 && filledWith(0.87 - 1.9) == 0
-- (3) The 1 arcsec GCNS match radius, at J2016.0 with |G - V| < 2: a GCNS row 0.9 arcsec from
-- Rigel's propagated position matches, one 1.1 arcsec away does not (radius 0.5 or 2 arcsec fails).
-- The offset is a great-circle step toward the north galactic pole.
pure func gcnsAtOffset(u: (float, float, float), arcsec: float) -> Array[Gcns] = match u { (ux, uy, uz) => {
  let tn = sqrt(1.0 - uz * uz);
  let d = arcsec * PI() / 648000.0;
  let tx = (0.0 - uz * ux) / tn; let ty = (0.0 - uz * uy) / tn; let tz = tn;
  toArray([{ux: ux * cos(d) + tx * sin(d), uy: uy * cos(d) + ty * sin(d), uz: uz * cos(d) + tz * sin(d), g: 0.0}]) } }
pure func checkGcnsRadius(t: Texts) -> bool = match astro(t, 24436) {
  [a] => { let u = directionAt(a, 2016.0);
    gcnsMatch(gcnsAtOffset(u, 0.0), a, 0.18, 2016.0) && gcnsMatch(gcnsAtOffset(u, 0.9), a, 0.18, 2016.0) &&
    !gcnsMatch(gcnsAtOffset(u, 1.1), a, 0.18, 2016.0) && !gcnsMatch(gcnsAtOffset(u, 3.0), a, 0.18, 2016.0) },
  _ => false
}
-- (4) A kept row sits at its J2016.0 position. Groombridge 1830 (HIP 57939; CNS5 row dropped so it is
-- a bright row) moves 7 arcsec/yr, so J1991.25 would be 0.02 ly off. Expected value hand-propagated
-- (independent Python, spherical linear: RA += pmRA*/cos(dec)*dt, Dec += pmDE*dt, dt = 24.75 yr)
-- from RA 3.1107451467, Dec 0.6585617448 rad, pm 4003.98 / -5813.62 mas/yr, plx 109.99 mas
-- (29.6533 ly), through the IAU galactic matrix: (-8.104964, 1.639034, 28.477006) ly. The two forms
-- agree to ~2e-5 ly; the tolerance is 5e-4 ly.
pure func checkKeptRowAt2016(t: Texts) -> bool = match rowOf(withoutCns(t, "2914"), "HIP 57939") {
  [r] => within(r.x, 0.0 - 8.104964, 0.0005) && within(r.y, 1.639034, 0.0005) && within(r.z, 28.477006, 0.0005) &&
    within(dist(r), 29.6533, 0.0001),
  _ => false
}
-- (5) A V < 7 star with no B-V is excluded and counted (bright_main writes size(noColour) as
-- count_excluded); the same star with a B-V is kept.
pure func rigelWith(bv: Option[float]) -> Result[Bright, string] =
  bright(astro(inline(), 24436), indexBy(\p. p.hip, [{hip: 24436, v: 0.18, bv: bv}]), [], gcnsIndex(""))
pure func checkNoBvExcluded() -> bool =
  (match rigelWith(None) { Ok(b) => size(b.rows) == 0 && b.noColour == ["HIP 24436"], Err(_) => false }) &&
  (match rigelWith(Some(0.0 - 0.03)) { Ok(b) => size(b.rows) == 1 && b.noColour == [], Err(_) => false })
-- (6) Flag 16 for a B-V outside the teffFromBV table (-0.33..2.17): both ends, in a bright row and in
-- a fill; inside the table it stays 8.
pure func checkFlagOutOfTable() -> bool {
  let u = (1.0, 0.0, 0.0);
  let f = \bv. size(filter(\x. x.flags == 24, fill([cnsAt("a", 99.0, true)], indexBy(\p. p.hip, [{hip: 21421, v: 0.87, bv: Some(bv)}])).rows));
  hipRow("h", u, 10.0, 1.0, 2.5).flags == 24 && hipRow("h", u, 10.0, 1.0, 0.0 - 0.5).flags == 24 &&
    hipRow("h", u, 10.0, 1.0, 1.0).flags == 8 && f(2.5) == 1 && f(0.0 - 0.5) == 1 && f(1.0) == 0
}
-- (7) Plx > 0, not >= 0: a HIP2 row with Plx 0.00 is skipped, as a negative one is (>= would reach the
-- distance step and refuse the whole build).
pure func checkPlxZeroSkipped(t: Texts) -> bool =
  ids(rigel(t, "| 0.18|", "    0.00 "), "") == ["HIP 71681"]
-- (8) The CNS5 parallax gate: a row with Plx 0 or below is not read (the row 1143 plx rewritten).
pure func cns5With(t: Texts, plx: string) -> Texts =
  {h2: t.h2, hm: t.hm, c5: replace(t.c5, "47.27153969330315", plx)}
pure func checkCnsPlxGate(t: Texts) -> bool =
  size(parseCnsHip(t.c5)) == 8 && size(parseCnsHip(cns5With(t, "0.000000000000000").c5)) == 7 &&
  size(parseCnsHip(cns5With(t, "-4.72715396933031").c5)) == 7 && size(parseCnsHip(cns5With(t, "0.000000000000001").c5)) == 8

pure func checks(t: Texts) -> [(string, bool)] = [
  ("VegaExcluded", checkVegaExcluded(t)), ("ArcturusPmMatch", checkArcturusPmMatch(t)),
  ("RigelIncluded", checkRigelIncluded(t)), ("Cns5EpochMatch", checkCns5EpochMatch(t)),
  ("SiriusFilled", checkSiriusFilled(t)), ("SharedHipGuard", checkSharedHipGuard(t)),
  ("AlphaCenComponents", checkAlphaCenComponents(t)), ("AlphaCenBRaw", checkAlphaCenBRaw(t)), ("Cuts", checkCuts(t)), ("FillQuickOnly", checkFillQuickOnly()),
  ("TwoMissingShareHip", checkTwoMissingShareHip()), ("WindowBothSides", checkWindowBothSides()), ("GcnsRadius", checkGcnsRadius(t)),
  ("KeptRowAt2016", checkKeptRowAt2016(t)), ("NoBvExcluded", checkNoBvExcluded()), ("FlagOutOfTable", checkFlagOutOfTable()),
  ("PlxZeroSkipped", checkPlxZeroSkipped(t)), ("CnsPlxGate", checkCnsPlxGate(t))]

test "M1.2d checkVegaExcluded" { checkVegaExcluded(inline()) }
test "M1.2d checkArcturusPmMatch" { checkArcturusPmMatch(inline()) }
test "M1.2d checkRigelIncluded" { checkRigelIncluded(inline()) }
test "M1.2d checkCns5EpochMatch" { checkCns5EpochMatch(inline()) }
test "M1.2d checkSiriusFilled" { checkSiriusFilled(inline()) }
test "M1.2d checkSharedHipGuard" { checkSharedHipGuard(inline()) }
test "M1.2d checkAlphaCenComponents" { checkAlphaCenComponents(inline()) }
test "M1.2d checkAlphaCenBRaw" { checkAlphaCenBRaw(inline()) }
test "M1.2d checkCuts" { checkCuts(inline()) }
test "M1.2d checkFillQuickOnly" { checkFillQuickOnly() }

test "M1.2d gap checkTwoMissingShareHip" { checkTwoMissingShareHip() }
test "M1.2d gap checkWindowBothSides" { checkWindowBothSides() }
test "M1.2d gap checkGcnsRadius" { checkGcnsRadius(inline()) }
test "M1.2d gap checkKeptRowAt2016" { checkKeptRowAt2016(inline()) }
test "M1.2d gap checkNoBvExcluded" { checkNoBvExcluded() }
test "M1.2d gap checkFlagOutOfTable" { checkFlagOutOfTable() }
test "M1.2d gap checkPlxZeroSkipped" { checkPlxZeroSkipped(inline()) }
test "M1.2d gap checkCnsPlxGate" { checkCnsPlxGate(inline()) }

export func brightVm(_: int) -> string = verdictOf("bright-vm", failedChecks(checks(inline())))
export func brightFixtures(dir: string) -> string ! {FS} {
  let t = {h2: readFile(concat([dir, "/hip2_bright.dat"])), hm: readFile(concat([dir, "/hip_main_bright.dat"])),
    c5: readFile(concat([dir, "/cns5_bright.dat"]))};
  let same = [("hip2 bytes", t.h2 == inline().h2), ("hip_main bytes", t.hm == inline().hm), ("cns5 bytes", t.c5 == inline().c5)];
  verdictOf("bright-fixtures", failedChecks(concat_(same, checks(t))))
}
