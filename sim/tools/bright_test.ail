module stapledons/sim/tools/bright_test
-- M1.2d bright tier and CNS5 fill (sim/tools/bright.ail) on real Hipparcos and CNS5 bytes.
-- The fixtures are real lines cut from the downloads (tools/fixtures/README.md); they are inlined
-- below so the named checks run under `ailang test` and on the strict VM, and `brightFixtures`
-- (FS) checks the inline copies equal tools/fixtures/*_bright.dat byte for byte and reruns every
-- check on the file text. `make bright-test`: strict VM = interpreter, then fixtures VM = interpreter.
import ./bright (Astro, Cns, Phot, Gcns, Bright, hipRow, indexBy, parseHip2, parseHipMain, parseCnsHip, gcnsIndex, fill, bright, gcnsMatch, directionAt, chord2, flagHip)
import ./catalogue (Row)
import ./catalogue_main (applyFill, planFill)
import ./companions (cnsStars, hipStars, hipErrors, candidates, systems, linkIndex, applyHip)
import ./extract (icrsToGalactic, distanceLy)
import ./extract as X
import std/string (concat, join, split, startsWith, replace, contains)
import std/list (map, filter, head, length as size, concat as concat_)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/math (sqrt, sin, cos, PI)
import std/array (fromList as toArray)
import std/fs (readFile)
import pkg/sunholo/relativity/photometry (teffFromBV)

pure func failedChecks(checks: [(string, bool)]) -> [string] =
  map(\c. match c { (n, _) => n }, filter(\c. match c { (_, ok) => !ok }, checks))
pure func verdictOf(tag: string, bad: [string]) -> string =
  match bad { [] => concat([tag, "-ok"]), _ => concat([tag, "-BAD: ", join(",", bad)]) }
pure func within(a: float, b: float, tol: float) -> bool = a - b <= tol && b - a <= tol
pure func len3(x: float, y: float, z: float) -> float = sqrt(x * x + y * y + z * z)

