module stapledons/sim/tools/session_audit_test
-- Fixtures are mirrored as literal bytes for strict VM tests because FS is
-- evaluator-only in v0.52.0. auditTests verifies every mirror against its file.
import ./session_audit (timeReport, codexReport)
import ./session_refusals (refusalReport)
import std/fs (readFile)
import std/string (contains, concat)
import std/list (foldl)
-- By hand: 2*1200*.05 + 2*1.5 + 200*60/200 + 2*20 = 223 s.
-- Each leg = 60 s. Includes two 1.5 s commit holds.
pure func fixture(name: string) -> string =
  if name == "proxy" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":1200}\n{\"type\":\"click\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"map\"}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":1200}\n{\"type\":\"key\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"relay\"}\n"
  else if name == "over_limit" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":1200}\n{\"type\":\"click\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"map\"}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":1200}\n{\"type\":\"key\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"relay\"}\n{\"type\":\"text_shown\",\"words\":1000}\n"
  else if name == "bad_leg" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":600}\n{\"type\":\"click\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"map\"}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":600}\n{\"type\":\"key\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"relay\"}\n"
  else if name == "codex" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\"]}}}}\n"
  else if name == "swapped" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\",\"archive.starbow\",\"archive.ism-glow\"]}}}}\n"
  else if name == "missing" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\",\"archive.ism-glow\"]}}}}\n"
  else if name == "early" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\"]}}}}\n"
  else if name == "shrink" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\"]}}}}\n"
  else if name == "wrong_hint" then "{\"v\":2,\"type\":\"new_game\",\"seed\":0,\"scenario\":\"sol\",\"diag\":false,\"archive\":[{\"id\":\"archive.two-clocks\",\"unlock\":\"first_boost\"}]}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\"]}}}}\n"
  else if name == "right_hint" then "{\"v\":2,\"type\":\"new_game\",\"seed\":0,\"scenario\":\"sol\",\"diag\":false,\"archive\":[{\"id\":\"archive.two-clocks\",\"unlock\":\"first_commit\"}]}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\"]}}}}\n"
  else ""
pure func expected() -> string = "{\n  \"comment\": \"M4.7 AC16 input: the Archive entries the minimum path unlocks, in the order the sim fires them (sprint R1-M4-JOURNEY M4.7; the design repo owns the list, lore/archive/README.md). Scenario: Sol to alpha Cen A at the 0.99c default (gamma 7.0888), commit, boost, cruise, brake, arrive. cmb-forward needs gamma >= 275 and tides and shadow-ring need a black hole, so none of them unlock.\",\n  \"scenario\": \"alpha_cen_0.99c\",\n  \"unlocks\": [\n    {\"id\": \"archive.bubble\", \"hint\": \"always\"},\n    {\"id\": \"archive.one-g\", \"hint\": \"always\"},\n    {\"id\": \"archive.nothing-crosses\", \"hint\": \"always\"},\n    {\"id\": \"archive.two-clocks\", \"hint\": \"first_commit\"},\n    {\"id\": \"archive.photon-drive\", \"hint\": \"first_boost\"},\n    {\"id\": \"archive.ism-glow\", \"hint\": \"cruise_above_0.9c\"},\n    {\"id\": \"archive.starbow\", \"hint\": \"cruise_above_0.9c\"}\n  ],\n  \"not_unlocked\": [\"archive.cmb-forward\", \"archive.tides\", \"archive.shadow-ring\"]\n}\n"
pure func checkProxy() -> bool = contains(timeReport(fixture("proxy")), "total_seconds=223\n") && contains(timeReport(fixture("proxy")), "playthrough-time=PASS")
pure func checkLimit() -> bool = contains(timeReport(fixture("over_limit")), "limit_360=FAIL") && contains(timeReport(fixture("over_limit")), "playthrough-time=FAIL")
pure func checkBand() -> bool = contains(timeReport(fixture("bad_leg")), "legs_45_120=FAIL") && contains(timeReport(fixture("bad_leg")), "playthrough-time=FAIL")
pure func checkCodex(name: string, want: string) -> bool = contains(codexReport(fixture(name), expected()), concat(["codex-unlocks=", want]))
test "proxy hand total includes two commit holds" { checkProxy() }
test "over 360 seconds fails" { checkLimit() }
test "leg outside 45-120 fails" { checkBand() }
test "codex swapped entries fail" { checkCodex("swapped", "FAIL") }
test "codex missing entry fails" { checkCodex("missing", "FAIL") }
test "codex valid ordered stream passes" { checkCodex("codex", "PASS") }
test "codex entry unlocked before its trigger fails (hint check)" { checkCodex("early", "FAIL") }
test "codex unlocked list that shrinks fails (prefix check)" { checkCodex("shrink", "FAIL") }
test "codex archive table with a wrong unlock hint fails (table check)" { checkCodex("wrong_hint", "FAIL") }
test "codex archive table with the right unlock hint passes" { checkCodex("right_hint", "PASS") }
export pure func auditPure(_: int) -> string = if checkProxy() && checkLimit() && checkBand() && checkCodex("swapped", "FAIL") && checkCodex("missing", "FAIL") && checkCodex("codex", "PASS") && checkCodex("early", "FAIL") && checkCodex("shrink", "FAIL") && checkCodex("wrong_hint", "FAIL") && checkCodex("right_hint", "PASS") then "session-audit-ok" else "session-audit-FAIL"
export func auditTests(_: int) -> string ! {FS} {
  let same = foldl(\ok n. ok && readFile(concat(["tests/fixtures/session_audit/", n, ".ndjson"])) == fixture(n), true, ["proxy", "over_limit", "bad_leg", "codex", "swapped", "missing", "early", "shrink", "wrong_hint", "right_hint"]);
  if same && readFile("tests/expected_unlocks.json") == expected() then auditPure(0) else "session-audit-fixture-FAIL"
}
pure func adversarialText() -> string = "{\"v\":2,\"type\":\"hello\",\"want\":{\"major\":2,\"minor\":2}}\n{\"v\":2,\"type\":\"new_game\",\"seed\":0,\"scenario\":\"sol\",\"diag\":false}\n{\"v\":2,\"type\":\"input\",\"tick\":1,\"dtau\":0,\"intents\":[{\"k\":\"plan\",\"target\":{\"index\":1,\"id\":\"alpha Cen\",\"pos\":{\"x\":0,\"y\":0,\"z\":-4.37}},\"cruise_phi\":2.6466524123622457}]}\n{\"v\":2,\"type\":\"input\",\"tick\":2,\"dtau\":0,\"intents\":[{\"k\":\"commit\",\"plan_id\":1}]}\n{\"v\":2,\"type\":\"input\",\"tick\":3,\"dtau\":0.000001,\"intents\":[]}\n{\"v\":2,\"type\":\"input\",\"tick\":4,\"dtau\":0,\"intents\":[{\"k\":\"plan\",\"target\":{\"index\":1,\"id\":\"alpha Cen\",\"pos\":{\"x\":0,\"y\":0,\"z\":-4.37}},\"cruise_phi\":2.6466524123622457}]}\n{\"v\":2,\"type\":\"input\",\"tick\":5,\"dtau\":0,\"intents\":[{\"k\":\"cancel\"}]}\n{\"v\":2,\"type\":\"input\",\"tick\":6,\"dtau\":0,\"intents\":[{\"k\":\"commit\",\"plan_id\":1}]}\n"
test "moving committed re-plan cancel commit refuse with unchanged state" { contains(refusalReport(adversarialText(), 1), "state-unchanged=PASS") }
