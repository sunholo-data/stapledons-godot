module stapledons/sim/tools/session_audit_test
-- Fixtures are mirrored as literal bytes for strict VM tests because FS is
-- evaluator-only in v0.52.0. auditTests verifies every mirror against its file.
import ./session_audit (timeReport, codexReport)
import ./session_refusals (refusalReport)
import std/fs (readFile)
import std/string (contains, concat)
import std/list (foldl)
-- By hand: 2*1200*.05 + 2*1.5 + 200*60/200 + 0 = 183 s (visits are bounds, not charges).
-- Each leg = 60 s. Includes two 1.5 s commit holds.
pure func fixture(name: string) -> string =
  if name == "simultaneous" then "{\"type\":\"new_game\",\"archive\":[{\"id\":\"archive.bubble\",\"unlock\":\"always\"},{\"id\":\"archive.one-g\",\"unlock\":\"always\"},{\"id\":\"archive.nothing-crosses\",\"unlock\":\"always\"},{\"id\":\"archive.two-clocks\",\"unlock\":\"first_commit\"},{\"id\":\"archive.earths-voice\",\"unlock\":\"first_commit\"},{\"id\":\"archive.photon-drive\",\"unlock\":\"first_boost\"},{\"id\":\"archive.ism-glow\",\"unlock\":\"cruise_above_0.9c\"},{\"id\":\"archive.starbow\",\"unlock\":\"cruise_above_0.9c\"},{\"id\":\"archive.weather-between-the-stars\",\"unlock\":\"cruise_above_0.9c\"},{\"id\":\"archive.following-light\",\"unlock\":\"cruise_above_0.9c\"}]}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}},\"ship\":{\"phase\":\"boosting\",\"beta\":0.2}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else if name == "late_hint" then "{\"type\":\"new_game\",\"archive\":[{\"id\":\"archive.bubble\",\"unlock\":\"always\"},{\"id\":\"archive.one-g\",\"unlock\":\"always\"},{\"id\":\"archive.nothing-crosses\",\"unlock\":\"always\"},{\"id\":\"archive.two-clocks\",\"unlock\":\"first_commit\"},{\"id\":\"archive.earths-voice\",\"unlock\":\"first_commit\"},{\"id\":\"archive.photon-drive\",\"unlock\":\"first_boost\"},{\"id\":\"archive.ism-glow\",\"unlock\":\"cruise_above_0.9c\"},{\"id\":\"archive.starbow\",\"unlock\":\"cruise_above_0.9c\"},{\"id\":\"archive.weather-between-the-stars\",\"unlock\":\"cruise_above_0.9c\"},{\"id\":\"archive.following-light\",\"unlock\":\"cruise_above_0.9c\"}]}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}},\"ship\":{\"phase\":\"boosting\",\"beta\":0.2}}}\n{\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else if name == "walk_valid" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":1200}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":1200}\n{\"type\":\"walk\",\"to\":\"archive\",\"path_m\":35}\n{\"type\":\"use\",\"action\":\"commit\"}\n{\"type\":\"read\",\"words\":100}\n{\"type\":\"interactable_visit\"}\n"
  else if name == "walk_ceiling" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":1200}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":1200}\n{\"type\":\"walk\",\"to\":\"archive\",\"path_m\":35}\n{\"type\":\"use\",\"action\":\"commit\"}\n{\"type\":\"read\",\"words\":100}\n{\"type\":\"interactable_visit\"}\n{\"type\":\"walk\",\"path_m\":40.01}\n"
  else if name == "walk_over_limit" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":1200}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":1200}\n{\"type\":\"walk\",\"to\":\"archive\",\"path_m\":35}\n{\"type\":\"use\",\"action\":\"commit\"}\n{\"type\":\"read\",\"words\":100}\n{\"type\":\"interactable_visit\"}\n{\"type\":\"text_shown\",\"words\":1000}\n"
  else if name == "proxy" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":1200}\n{\"type\":\"click\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"map\"}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":1200}\n{\"type\":\"key\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"relay\"}\n"
  else if name == "over_limit" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":1200}\n{\"type\":\"click\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"map\"}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":1200}\n{\"type\":\"key\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"relay\"}\n{\"type\":\"text_shown\",\"words\":1000}\n"
  else if name == "bad_leg" then "{\"type\":\"sim_ticks\",\"leg\":1,\"ticks\":600}\n{\"type\":\"click\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"map\"}\n{\"type\":\"sim_ticks\",\"leg\":2,\"ticks\":600}\n{\"type\":\"key\",\"action\":\"commit_hold\"}\n{\"type\":\"text_shown\",\"words\":100}\n{\"type\":\"interactable_visit\",\"id\":\"relay\"}\n"
  else if name == "codex" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else if name == "swapped" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.starbow\",\"archive.ism-glow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else if name == "missing" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else if name == "early" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else if name == "shrink" then "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else if name == "wrong_hint" then "{\"v\":2,\"type\":\"new_game\",\"seed\":0,\"scenario\":\"sol\",\"diag\":false,\"archive\":[{\"id\":\"archive.two-clocks\",\"unlock\":\"first_boost\"}]}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else if name == "right_hint" then "{\"v\":2,\"type\":\"new_game\",\"seed\":0,\"scenario\":\"sol\",\"diag\":false,\"archive\":[{\"id\":\"archive.two-clocks\",\"unlock\":\"first_commit\"}]}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"boosting\",\"beta\":0.2},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\"]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"ship\":{\"phase\":\"cruising\",\"beta\":0.99},\"consequence\":{\"archive\":{\"unlocked\":[\"archive.bubble\",\"archive.one-g\",\"archive.nothing-crosses\",\"archive.two-clocks\",\"archive.earths-voice\",\"archive.photon-drive\",\"archive.ism-glow\",\"archive.starbow\",\"archive.weather-between-the-stars\",\"archive.following-light\"]}}}}\n"
  else ""
pure func expected() -> string = "{\n  \"comment\": \"M4.7 AC16 input: the Archive entries the minimum path unlocks, in the order the sim fires them (sprint R1-M4-JOURNEY M4.7; the design repo owns the list, lore/archive/README.md). Scenario: Sol to alpha Cen A at the 0.99c default (gamma 7.0888), commit, boost, cruise, brake, arrive. cmb-forward needs gamma >= 275 and tides and shadow-ring need a black hole, so none of them unlock.\",\n  \"scenario\": \"alpha_cen_0.99c\",\n  \"unlocks\": [\n    {\n      \"id\": \"archive.bubble\",\n      \"hint\": \"always\"\n    },\n    {\n      \"id\": \"archive.one-g\",\n      \"hint\": \"always\"\n    },\n    {\n      \"id\": \"archive.nothing-crosses\",\n      \"hint\": \"always\"\n    },\n    {\n      \"id\": \"archive.two-clocks\",\n      \"hint\": \"first_commit\"\n    },\n    {\n      \"id\": \"archive.earths-voice\",\n      \"hint\": \"first_commit\"\n    },\n    {\n      \"id\": \"archive.photon-drive\",\n      \"hint\": \"first_boost\"\n    },\n    {\n      \"id\": \"archive.ism-glow\",\n      \"hint\": \"cruise_above_0.9c\"\n    },\n    {\n      \"id\": \"archive.starbow\",\n      \"hint\": \"cruise_above_0.9c\"\n    },\n    {\n      \"id\": \"archive.weather-between-the-stars\",\n      \"hint\": \"cruise_above_0.9c\"\n    },\n    {\n      \"id\": \"archive.following-light\",\n      \"hint\": \"cruise_above_0.9c\"\n    }\n  ],\n  \"not_unlocked\": [\n    \"archive.cmb-forward\",\n    \"archive.tides\",\n    \"archive.shadow-ring\"\n  ]\n}\n"
pure func checkWalk() -> bool = contains(timeReport(fixture("walk_valid")), "total_seconds=162.1\n") && contains(timeReport(fixture("walk_valid")), "playthrough-time=PASS") && contains(timeReport(fixture("walk_ceiling")), "playthrough-time=FAIL") && contains(timeReport(fixture("walk_over_limit")), "limit_360=FAIL")
test "walk distance charged; ceiling and total controls fail" { checkWalk() }
pure func checkProxy() -> bool = contains(timeReport(fixture("proxy")), "total_seconds=183\n") && contains(timeReport(fixture("proxy")), "playthrough-time=PASS")
pure func checkLimit() -> bool = contains(timeReport(fixture("over_limit")), "limit_360=FAIL") && contains(timeReport(fixture("over_limit")), "playthrough-time=FAIL")
pure func checkBand() -> bool = contains(timeReport(fixture("bad_leg")), "legs_45_120=FAIL") && contains(timeReport(fixture("bad_leg")), "playthrough-time=FAIL")
pure func checkCodex(name: string, want: string) -> bool = contains(codexReport(fixture(name), expected()), concat(["codex-unlocks=", want]))
-- An unlock with no inferable trigger (fired = "") and an expected row with no hint: only the holds clause rejects it.
pure func hintlessStream() -> string = "{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"journey\":{\"state\":\"committed\"},\"consequence\":{\"archive\":{\"unlocked\":[]}}}}\n{\"v\":2,\"type\":\"state\",\"status\":\"ok\",\"changes\":{\"consequence\":{\"archive\":{\"unlocked\":[\"archive.late\"]}}}}\n"
pure func hintlessExpected() -> string = "{\"unlocks\":[{\"id\":\"archive.late\"}]}"
pure func checkHintless() -> bool = contains(codexReport(hintlessStream(), hintlessExpected()), "codex-unlocks=FAIL")
test "proxy hand total includes two commit holds" { checkProxy() }
test "over 360 seconds fails" { checkLimit() }
test "leg outside 45-120 fails" { checkBand() }
test "codex swapped entries fail" { checkCodex("swapped", "FAIL") }
test "codex missing entry fails" { checkCodex("missing", "FAIL") }
test "codex valid ordered stream passes" { checkCodex("codex", "PASS") }
test "codex entry unlocked before its trigger fails (hint check)" { checkCodex("early", "FAIL") }
test "codex unlocked list that shrinks fails (prefix check)" { checkCodex("shrink", "FAIL") }
test "codex archive table with a wrong unlock hint fails (table check)" { checkCodex("wrong_hint", "FAIL") }
test "codex archive table with the right unlock hint passes" { checkCodex("right_hint", "PASS") }
test "codex unlock with no inferable trigger fails even when the expectation has no hint (holds check)" { checkHintless() }
export pure func auditPure(_: int) -> string = if checkCodex("simultaneous", "PASS") && checkCodex("late_hint", "FAIL") && checkWalk() && checkProxy() && checkLimit() && checkBand() && checkCodex("swapped", "FAIL") && checkCodex("missing", "FAIL") && checkCodex("codex", "PASS") && checkCodex("early", "FAIL") && checkCodex("shrink", "FAIL") && checkCodex("wrong_hint", "FAIL") && checkCodex("right_hint", "PASS") && checkHintless() then "session-audit-ok" else "session-audit-FAIL"
export func auditTests(_: int) -> string ! {FS} {
  let same = foldl(\ok n. ok && readFile(concat(["tests/fixtures/session_audit/", n, ".ndjson"])) == fixture(n), true, ["simultaneous", "late_hint", "walk_valid", "walk_ceiling", "walk_over_limit", "proxy", "over_limit", "bad_leg", "codex", "swapped", "missing", "early", "shrink", "wrong_hint", "right_hint"]);
  if same && readFile("tests/expected_unlocks.json") == expected() then auditPure(0) else "session-audit-fixture-FAIL"
}
pure func adversarialText() -> string = "{\"v\":2,\"type\":\"hello\",\"want\":{\"major\":2,\"minor\":2}}\n{\"v\":2,\"type\":\"new_game\",\"seed\":0,\"scenario\":\"sol\",\"diag\":false}\n{\"v\":2,\"type\":\"input\",\"tick\":1,\"dtau\":0,\"intents\":[{\"k\":\"plan\",\"target\":{\"index\":1,\"id\":\"alpha Cen\",\"pos\":{\"x\":0,\"y\":0,\"z\":-4.37}},\"cruise_phi\":2.6466524123622457}]}\n{\"v\":2,\"type\":\"input\",\"tick\":2,\"dtau\":0,\"intents\":[{\"k\":\"commit\",\"plan_id\":1}]}\n{\"v\":2,\"type\":\"input\",\"tick\":3,\"dtau\":0.000001,\"intents\":[]}\n{\"v\":2,\"type\":\"input\",\"tick\":4,\"dtau\":0,\"intents\":[{\"k\":\"plan\",\"target\":{\"index\":1,\"id\":\"alpha Cen\",\"pos\":{\"x\":0,\"y\":0,\"z\":-4.37}},\"cruise_phi\":2.6466524123622457}]}\n{\"v\":2,\"type\":\"input\",\"tick\":5,\"dtau\":0,\"intents\":[{\"k\":\"cancel\"}]}\n{\"v\":2,\"type\":\"input\",\"tick\":6,\"dtau\":0,\"intents\":[{\"k\":\"commit\",\"plan_id\":1}]}\n"
test "moving committed re-plan cancel commit refuse with unchanged state" { contains(refusalReport(adversarialText(), 1), "state-unchanged=PASS") }

test "same-response commit and boost use the imported hints" { checkCodex("simultaneous", "PASS") }
test "imported hint cannot excuse a late unlock" { checkCodex("late_hint", "FAIL") }
