module stapledons/sim/tools/world_hosts_main
-- W2.0 auxiliary source table: the measured host subset of the navigation
-- registry, retaining every digit of identity, position, photometry and flags.
import stapledons/sim/worlds_registry (CatalogueRow, catalogueRows)
import std/json (decode, encode, js, getArray, getString, getBool)
import std/option (Some, None, getOrElse)
import std/result (Ok, Err)
import std/list (map, filter, any, length)
import std/string (join)
import std/fs (readFile, writeFile)
import std/crypto (sha256Hex)
import std/io (println, exit)
pure func source(r:CatalogueRow) -> string = "{id:${encode(js(r.id))},pos:{x:${show(r.pos.x)},y:${show(r.pos.y)},z:${show(r.pos.z)}},v:${show(r.v)},teff:${show(r.teff)},flags:${show(r.flags)}}"
export func main(a:{registry:string,planets:string,output:string}) -> () ! {FS,IO} {
 let reg=readFile(a.registry);let raw=readFile(a.planets);
 let ids=match decode(raw) {Err(_)=>[],Ok(j)=>match getArray(j,"planets") {None=>[],Some(ps)=>map(\p. getOrElse(getString(p,"hostId"),""),filter(\p. getOrElse(getBool(p,"inRegistry"),false),ps))}};
 let rows=filter(\r. any(\id. id==r.id,ids),catalogueRows(reg));
 if length(rows)==0 then {println("world-hosts: FAILED empty measured host subset");exit(1)} else {
 writeFile(a.output,"module stapledons/sim/data/world_hosts\n-- Generated by tools/world_hosts_main.ail. Catalogue facts only.\n-- registry sha256 ${sha256Hex(reg)}; planets sha256 ${sha256Hex(raw)}\nimport stapledons/sim/worlds_registry (CatalogueRow)\nexport pure func knownHostRows() -> [CatalogueRow] = [\n${join(",\n",map(source,rows))}\n]\n");
 println("world-hosts: ${length(rows)} measured hosts; exact navigation positions/photometry/flags")}
}
