module stapledons/sim/tools/crew_pack
-- R2-CREW C0 (design crew-integration.md §CI-1): the crew scenario pack as data in the pure core.
-- `make crew-sync` copies the lab pack's files into data/crew/ (tools/crew_sync.sh) and runs
-- `generate`, which embeds each file's text verbatim in sim/data/crew_pack.ail: the core does no
-- I/O, as with the star data (sim/data/*.ail). The round trip is crew_pack_check.ail.
-- Bytecode VM with evaluator fallback for std/fs (readFile is evaluator-only on the strict VM in v0.54.6), FS caps.
import std/string (concat, join, replaceMany)
import std/list (map)
import std/fs (readFile, writeFile)
import std/io (println)

export type PackFile = { name: string, entry: string, file: string }

-- The pack's files: the function name in crew_pack.ail and the file under data/crew/.
export pure func files() -> [PackFile] = [
  { name: "scenario", entry: "scenarioJson", file: "scenario.json" },
  { name: "policy", entry: "policyJson", file: "policy.json" },
  { name: "escalation", entry: "escalationJson", file: "escalation.json" },
  { name: "hands_on", entry: "handsOnJson", file: "hands_on.json" }
]

-- An AILANG string literal holding s exactly: \ " $ (interpolation) and control characters escaped.
export pure func literal(s: string) -> string =
  concat(["\"", replaceMany(s, [("\\", "\\\\"), ("\"", "\\\""), ("$", "\\$"), ("\n", "\\n"), ("\r", "\\r"), ("\t", "\\t")]), "\""])

pure func entryText(e: string, text: string) -> string =
  concat(["export pure func ", e, "() -> string =\n  ", literal(text), "\n"])

export pure func moduleText(sync: string, texts: [(PackFile, string)]) -> string =
  concat([
    "module stapledons/sim/data/crew_pack\n",
    "-- GENERATED by `make crew-sync` (sim/tools/crew_pack.ail); do not edit. The crew scenario pack\n",
    "-- synced from the crew lab (ailang-packages examples/crew-lab/scenarios/stapledon), verbatim.\n",
    "-- Source and hashes: data/crew/SYNC. `make crew-sync-check` proves the round trip.\n",
    "export pure func syncManifest() -> string =\n  ", literal(sync), "\n",
    "export pure func packFiles() -> [(string, string)] = [",
    join(", ", map(\t. match t { (f, _) => concat(["(\"", f.file, "\", ", f.entry, "())"]) }, texts)),
    "]\n",
    join("", map(\t. match t { (f, x) => entryText(f.entry, x) }, texts))
  ])

export func generate(a: {dir: string, out: string}) -> () ! {IO, FS} {
  let texts = map(\f. (f, readFile(concat([a.dir, "/", f.file]))), files());
  writeFile(a.out, moduleText(readFile(concat([a.dir, "/SYNC"])), texts));
  println(concat(["crew-pack: wrote ", a.out]))
}
