module stapledons/sim/tools/lab_probe

-- R3-UNIVERSE-LAB UL0a (design r3/universe-lab.md, "What it costs in run time"; sprint row UL0a):
-- the speed probes that need no detector. Each entry is PURE and returns one line of text that
-- depends only on its argument, so the same call gives the same bytes on every run and the
-- harness (tools/lab_probe.py, `make lab-probe`) can time it from outside: there is no clock in
-- the sim (gate 6). The harness runs each entry at a small size and at a full size and reports
-- the difference, so process start and compilation are not counted as work.
--
-- THESE ARE STAND-INS, written before the modules they stand for:
--   draws      the new-game draw loop of sim/universe.ail (UL3b) and the acceptance test of
--              sunholo/worlds `selection` (UL2a). Here: four keyed uniforms per draw through the
--              pinned priors' own `quantileOf`, then three closed-form counts from the package
--              (`aliveWithin`, `traceCappedMean`, and a late share min(1, G/L)) tested against
--              a band. The real test's constants (R, G, phi, the bands) are outputs of the lab;
--              the ones below only make the arithmetic the same size.
--   quadrature the fixed two-dimensional quadrature of `selection` (UL2a2): the CDF of a sum of
--              two uniforms integrated over a unit square by the midpoint rule. That integral is
--              the CDF of a sum of FOUR uniforms, which has a closed form, so the probe's value
--              is checked, not just timed.
--   intervals  sim/lab_stats.ail (UL3c): sort 1,024 rows and find the exact order-statistic
--              ranks for the 10th percentile, the median and the 90th percentile.
--   filter     the per-seed candidate table (UL6b): 5 x 10^5 rows held as an Array, counted
--              under a predicate in whole passes.
-- When the real modules land, `make lab-budget` (UL3b) measures the real loop against the
-- ceiling this probe set. Nothing here is imported by the game.
import stapledons/sim/rng (keyed, unit53, top53)
import pkg/sunholo/worlds/baseline (Factor, Prior, Fixed, baseline, quantileOf)
import pkg/sunholo/worlds/dial (Params)
import pkg/sunholo/worlds/disc (Disc, aliveWithin)
import pkg/sunholo/worlds/epoch_statistics (traceCappedMean)
import std/array as A
import std/list (foldl, map, range, sortBy, nth, length)
import std/math (intToFloat, exp, log, floor)
import std/option (Option, Some, None)

-- The probe's own keyed-RNG domain ("labprobe" as bytes). Not the `universe` domain, which
-- UL3b adds to sim/rng.ail; nothing the game draws can collide with a probe.
pure func probeDomain() -> int = 0x6c616270726f6265
pure func probeSeed() -> int = 20261112

-- ------------------------------------------------------------ draws
type Priors = { life: Prior, minds: Prior, tech: Prior, lifetime: Prior, windowYr: float, remnantLoYr: float, remnantHiYr: float, disc: Disc }

pure func priorOf(fs: [Factor], key: string) -> Prior =
  match fs { [] => Fixed(0.0 / 0.0), f :: rest => if f.key == key then f.prior else priorOf(rest, key) }
pure func fixedOf(fs: [Factor], key: string) -> float = quantileOf(priorOf(fs, key), 0.5)
pure func priors() -> Priors {
  let b = baseline();
  { life: priorOf(b, "life"), minds: priorOf(b, "minds"), tech: priorOf(b, "tech"), lifetime: priorOf(b, "lifetime"),
    windowYr: fixedOf(b, "window"), remnantLoYr: fixedOf(b, "remnantLo"), remnantHiYr: fixedOf(b, "remnantHi"),
    disc: { rho0Pc3: fixedOf(b, "rho0Pc3"), scaleHeightPc: fixedOf(b, "scaleHeightPc") } }
}

-- Draw i of the run: uniform f is keyed by (seed, domain, i, f), as the design specifies.
pure func drawParams(pr: Priors, i: int) -> Params {
  let u = \f. unit53(keyed(probeSeed(), probeDomain(), i, f));
  let minds = quantileOf(pr.minds, u(1));
  { fLife: quantileOf(pr.life, u(0)), fComplex: minds, fMinds: minds, fTech: quantileOf(pr.tech, u(2)),
    lifetimeYr: quantileOf(pr.lifetime, u(3)), windowYr: pr.windowYr, remnantLoYr: pr.remnantLoYr, remnantHiYr: pr.remnantHiYr }
}

pure func minf(a: float, b: float) -> float = if a < b then a else b

-- Three closed-form counts inside 3,000 ly and a band on each: the shape of the acceptance test.
pure func accepts(pr: Priors, p: Params) -> bool {
  let perStar = 0.1 * p.fLife * p.fMinds * p.fTech;
  let found = aliveWithin(pr.disc, 3000.0, perStar, p) * minf(1.0, 100.0 / p.lifetimeYr);
  let ended = found * traceCappedMean(pr.remnantLoYr, pr.remnantHiYr, 1.0e5) / p.lifetimeYr;
  let late = found * minf(1.0, 3000.0 / p.lifetimeYr);
  found >= 0.02 && found <= 50.0 && ended >= 0.0 && late <= 10.0
}

type DrawAcc = { accepted: int, first: int, mix: int }
pure func drawStep(pr: Priors, acc: DrawAcc, i: int) -> DrawAcc {
  let p = drawParams(pr, i);
  let ok = accepts(pr, p);
  { accepted: if ok then acc.accepted + 1 else acc.accepted,
    first: if ok && acc.first == 0 then i else acc.first,
    mix: acc.mix ^ top53(keyed(probeSeed(), probeDomain(), i, 3)) }
}
-- n draws (1..n), every one tested: accepted count, the first accepted draw, a checksum.
export pure func draws(n: int) -> string {
  let pr = priors();
  let r = foldl(\acc i. drawStep(pr, acc, i), { accepted: 0, first: 0, mix: 0 }, range(1, n + 1));
  "draws n=${show(n)} accepted=${show(r.accepted)} first=${show(r.first)} mix=${show(r.mix)}"
}

-- ------------------------------------------------------------ quadrature
-- CDF of the sum of two uniforms on [0, 1).
pure func sum2Cdf(s: float) -> float =
  if s <= 0.0 then 0.0 else if s <= 1.0 then 0.5 * s * s else if s < 2.0 then 1.0 - 0.5 * (2.0 - s) * (2.0 - s) else 1.0
pure func pow4(x: float) -> float = x * x * x * x
-- CDF of the sum of four uniforms (Irwin-Hall), 0 <= c <= 2.
pure func sum4Cdf(c: float) -> float =
  (pow4(c) - (if c > 1.0 then 4.0 * pow4(c - 1.0) else 0.0)) / 24.0
pure func quadCut() -> float = 1.3
pure func quadRow(n: int, x: float) -> float =
  foldl(\acc j. acc + sum2Cdf(quadCut() - x - (intToFloat(j) + 0.5) / intToFloat(n)), 0.0, range(0, n))
-- The n x n midpoint rule, the closed form it approximates, and the difference.
export pure func quadrature(n: int) -> string =
  if n < 1 then "quadrature n=${show(n)} refused" else {
    let total = foldl(\acc i. acc + quadRow(n, (intToFloat(i) + 0.5) / intToFloat(n)), 0.0, range(0, n));
    let p = total / (intToFloat(n) * intToFloat(n));
    "quadrature n=${show(n)} p=${show(p)} exact=${show(sum4Cdf(quadCut()))} err=${show(p - sum4Cdf(quadCut()))}"
  }

-- ------------------------------------------------------------ intervals
pure func cmpFloat(a: float, b: float) -> int = if a < b then 0 - 1 else if a > b then 1 else 0
-- The rank arithmetic of an exact order-statistic interval: the binomial pmf by its log
-- recurrence, summed from each end. ranks = (l, u), 1-based, each tail at most 0.025.
pure func lowerRank(n: int, q: float, k: int, logPmf: float, cum: float) -> int {
  let next = cum + exp(logPmf);
  if k >= n then n else if next > 0.025 then k
  else lowerRank(n, q, k + 1, logPmf + log(intToFloat(n - k) / intToFloat(k + 1)) + log(q / (1.0 - q)), next)
}
pure func upperRank(n: int, q: float, k: int, logPmf: float, cum: float) -> int {
  let next = cum + exp(logPmf);
  if k <= 0 then 1 else if next > 0.025 then k + 1
  else upperRank(n, q, k - 1, logPmf + log(intToFloat(k) / intToFloat(n - k + 1)) + log((1.0 - q) / q), next)
}
pure func at(xs: [float], rank: int) -> float = match nth(xs, rank - 1) { Some(x) => x, None => 0.0 / 0.0 }
pure func intervalSum(sorted: [float], q: float) -> float {
  let n = length(sorted);
  let l = lowerRank(n, q, 0, intToFloat(n) * log(1.0 - q), 0.0);
  let u = upperRank(n, q, n, intToFloat(n) * log(q), 0.0);
  at(sorted, if l < 1 then 1 else l) + at(sorted, u) + intToFloat(l) + intToFloat(u)
}
pure func sampleOf(rep: int) -> [float] =
  map(\i. floor(40.0 * unit53(keyed(probeSeed(), probeDomain() + 1, rep, i))), range(0, 1024))
pure func intervalsOnce(rep: int) -> float {
  let sorted = sortBy(cmpFloat, sampleOf(rep));
  intervalSum(sorted, 0.1) + intervalSum(sorted, 0.5) + intervalSum(sorted, 0.9)
}
-- `reps` samples of 1,024 rows (counts 0..39, so with ties), three intervals each.
export pure func intervals(reps: int) -> string =
  "intervals rows=1024 reps=${show(reps)} sum=${show(foldl(\acc r. acc + intervalsOnce(r), 0.0, range(0, reps)))}"

-- ------------------------------------------------------------ filter
type Row = { distLy: float, kind: int, ageYr: float }
pure func rowOf(i: int) -> Row = {
  distLy: 3000.0 * unit53(keyed(probeSeed(), probeDomain() + 2, i, 0)),
  kind: top53(keyed(probeSeed(), probeDomain() + 2, i, 1)) % 8,
  ageYr: 5.0e9 * unit53(keyed(probeSeed(), probeDomain() + 2, i, 2)) }
pure func countPass(rows: Array[Row], n: int, i: int, maxLy: float, kind: int, acc: int) -> int =
  if i >= n then acc else {
    let r = A.get(rows, i);
    countPass(rows, n, i + 1, maxLy, kind, if r.distLy <= maxLy && r.kind == kind && r.ageYr > 1.0e9 then acc + 1 else acc)
  }
pure func filterOf(n: int, passes: int) -> string {
  let rows = A.fromList(map(rowOf, range(0, n)));
  let total = foldl(\acc p. acc + countPass(rows, n, 0, 300.0 * intToFloat(p + 1), p % 8, 0), 0, range(0, passes));
  "filter rows=${show(A.length(rows))} passes=${show(passes)} matched=${show(total)}"
}
-- Build 500,000 rows once, then `passes` whole-table filters with different cuts.
export pure func filter(passes: int) -> string = filterOf(500000, passes)
-- The same code on 2,000 rows, for the VM = interpreter check (the interpreter is slow on 500,000).
export pure func filterSmall(passes: int) -> string = filterOf(2000, passes)
