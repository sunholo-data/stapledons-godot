module stapledons/sim/tools/evidence_probe
-- R3-REASONS RT2a diagnostic, never on the wire: the funnel from truth to
-- record. For every planet the worlds model populates in the registry
-- (synthesised ones included), from one ship position at one galaxy year, it
-- counts what is true at the emitted time, what that truth shows, and at
-- which gate of the stop look each world is lost. Every gate is read from
-- evidence.stagesOf, the same functions the records use; the "record:" rows
-- count the records themselves (evidence.observeTarget) as a cross-check.
--
-- WHAT-IFS are labelled and live only here; data/detect.ail's shipSuite() is
-- not changed. apertureM other than 10 swaps the telescope's aperture and
-- nothing else. The "what-if transit spectrum" row counts living worlds with
-- oxygen whose transit is seen and whose direct-imaging continuum SNR would
-- reach 5 if the inner working angle and the noise floor were ignored: a crude upper bound, not a
-- transit-spectroscopy budget.
--
--   ailang run --quiet --bytecode --caps IO,FS --package-dir sim --entry funnel --args-json \
--     '{"registry":"data/starmap/stars.json","planets":"data/planets/exoplanets.json","firstSeed":0,"seeds":5,"x":0,"y":0,"z":0,"year":0,"apertureM":10,"shellLy":60}' \
--     sim/tools/evidence_probe.ail
import stapledons/sim/evidence (Target, Observation, Emission, Stages, Quantity, QPlanet, QOxygen, QOxygenMethane, QRedEdge, QLeakage,
 Method, DirectImaging, Transit, targetOf, emissionAt, stagesOf, observeTarget)
import stapledons/sim/data/detect (Suite, shipSuite)
import stapledons/sim/data/presets (Preset, allPresets)
import stapledons/sim/exoplanets_snapshot (snapshotFromJson)
import stapledons/sim/worlds_catalogue (rowsFromJsonWith)
import stapledons/sim/worlds_model (StarRow, NotHabitable, systemFrom, historyUniforms)
import stapledons/sim/census (observedIndex, observedFor)
import pkg/sunholo/worlds/baseline (baseline)
import pkg/sunholo/worlds/dial (Params, applyDial, zeroDial)
import pkg/sunholo/worlds/history (History, PlanetState, Sterile, Microbial, Complex, PreTech, Technological, Remnant, Transcended, Ecocide, historyOf)
import pkg/sunholo/observe/lightcone (seenAt)
import pkg/sunholo/observe/constants (snrHint, snrStrong)
import pkg/sunholo/celestial/kepler (Vec3)
import std/list (map, flatMap, filter, foldl, length, any, zipWith)
import std/string (join, formatFixed)
import std/math (intToFloat)
import std/option (Option, Some, None)
import std/fs (readFile)
import std/io (println, exit)

-- One planet: its target (physical facts and keyed draws), what its history
-- draw needs, and the gates of the stop look, none of which depend on the preset.
type Item = {t:Target,habitable:bool,slot:string,g:Stages}
pure func one(b:bool) -> int = if b then 1 else 0
pure func rowNames() -> [string] = [
 "planets populated (outside the ship's own system)",
 "planets habitable or debated",
 "truth: living (Microbial or better)",
 "truth: Complex or better",
 "truth: PreTech",
 "truth: Technological",
 "truth: Remnant",
 "truth: Ecocide or Transcended",
 "living, shows oxygen (O2, with or without CH4)",
 "living, shows O2 + CH4",
 "living, shows the red edge",
 "living + oxygen: star and planet sizes known",
 "living + oxygen: outside the inner working angle",
 "living + oxygen: outside it and above the noise floor",
 "living + oxygen: imaged at SNR >= 5 (an oxygen record)",
 "living + oxygen: imaged at SNR >= 10",
 "living + oxygen: orbit transits as seen from here",
 "living + oxygen: transit seen (census record only)",
 "WHAT-IF transit spectrum: living + oxygen, transit seen, continuum SNR >= 5 with the working angle and noise floor ignored",
 "living (any): outside the inner working angle",
 "living (any): imaged at SNR >= 5",
 "Technological: radar class (beam crosses the ship)",
 "Technological, radar class, inside the dish's hint reach",
 "Technological, inside the dish's TV-carrier hint reach",
 "record: planets imaged",
 "record: planets seen in transit",
 "record: oxygen detections, all worlds",
 "record: oxygen detections on sterile worlds (false positives)",
 "record: red-edge detections, all worlds",
 "record: red-edge detections on sterile worlds (false positives)",
 "record: leakage detections",
 "record: worlds with a biosignature or leakage detection"]
pure func seen(rs:[Observation],q:Quantity) -> bool = any(\o. o.detected && o.quantity==q,rs)
pure func flags(e:Emission,g:Stages,habitable:bool,rs:[Observation]) -> [int] {
 let s=e.state;
 let living=s==Microbial || s==Complex || s==PreTech || s==Technological || s==Remnant;
 let lo=living && e.oxygen;
 let hint=snrHint();
 let tech=s==Technological;
 let oxygen=seen(rs,QOxygen) || seen(rs,QOxygenMethane);
 map(one,[true,habitable,living,s==Complex || s==PreTech || s==Technological || s==Remnant,s==PreTech,tech,s==Remnant,s==Ecocide || s==Transcended,
  lo,lo && e.methane,living && e.redEdge,
  lo && g.inputs,lo && g.inputs && g.iwa,lo && g.inputs && g.iwa && g.floor,lo && g.directSnr>=hint,lo && g.directSnr>=snrStrong(),
  lo && g.transitGeometry,lo && g.transitSnr>=hint,lo && g.transitSnr>=hint && g.continuumSnr>=hint,
  living && g.inputs && g.iwa,living && g.directSnr>=hint,
  tech && e.radar,tech && e.radar && g.radarSnr>=hint,tech && g.tvSnr>=hint,
  any(\o. o.quantity==QPlanet && o.method==DirectImaging,rs),any(\o. o.quantity==QPlanet && o.method==Transit,rs),
  oxygen,oxygen && s==Sterile,seen(rs,QRedEdge),seen(rs,QRedEdge) && s==Sterile,seen(rs,QLeakage),oxygen || seen(rs,QRedEdge) || seen(rs,QLeakage)])
}
pure func zeros() -> [int] = map(\n. 0,rowNames())
pure func addInts(a:[int],b:[int]) -> [int] = zipWith(\x y. x+y,a,b)
pure func minf(a:float,b:float) -> float = if a<b then a else b
-- inner: the counts within shellLy; whole: within the registry. nearest*: light-years (1e99: none).
type Tally = {inner:[int],whole:[int],nearestLiving:float,nearestOxygen:float,nearestTech:float,inSystem:int}
pure func tallyOne(suite:Suite,p:Params,seed:int,obs:Vec3,year:float,shellLy:float,acc:Tally,i:Item) -> Tally =
 if i.g.inSystem then {acc | inSystem:acc.inSystem+1} else {
  let t={i.t | history:if i.habitable then historyOf(p,true,historyUniforms(seed,i.t.host,i.slot)) else i.t.history};
  let e=emissionAt(t,seenAt(year,obs,t.pos));
  let f=flags(e,i.g,i.habitable,observeTarget(suite,suite.stopLookS,t,obs,year));
  let s=e.state;
  let living=s==Microbial || s==Complex || s==PreTech || s==Technological || s==Remnant;
  {inner:if i.g.dist<=shellLy then addInts(acc.inner,f) else acc.inner,whole:addInts(acc.whole,f),
   nearestLiving:if living then minf(acc.nearestLiving,i.g.dist) else acc.nearestLiving,
   nearestOxygen:if living && e.oxygen then minf(acc.nearestOxygen,i.g.dist) else acc.nearestOxygen,
   nearestTech:if s==Technological then minf(acc.nearestTech,i.g.dist) else acc.nearestTech,inSystem:acc.inSystem}
 }
pure func tally(suite:Suite,preset:Preset,seed:int,obs:Vec3,year:float,shellLy:float,items:[Item]) -> Tally {
 let p=applyDial(baseline(),preset.dial);
 foldl(\acc i. tallyOne(suite,p,seed,obs,year,shellLy,acc,i),{inner:zeros(),whole:zeros(),nearestLiving:1e99,nearestOxygen:1e99,nearestTech:1e99,inSystem:0},items)
}
pure func ints(lo:int,hi:int) -> [int] = if lo>=hi then [] else lo::ints(lo+1,hi)
pure func sumOf(xs:[int]) -> int = foldl(\a x. a+x,0,xs)
pure func minOf(xs:[int]) -> int = match xs {[]=>0,x::rest=>foldl(\a y. if y<a then y else a,x,rest)}
pure func maxOf(xs:[int]) -> int = match xs {[]=>0,x::rest=>foldl(\a y. if y>a then y else a,x,rest)}
pure func pick[a](xs:[a],n:int) -> [a] = match xs {[]=>[],x::rest=>if n<=0 then [x] else pick(rest,n-1)}
-- "mean (min-max)" over the seeds, for row n.
pure func cell(vectors:[[int]],n:int) -> string {
 let xs=flatMap(\v. pick(v,n),vectors);
 "${formatFixed(intToFloat(sumOf(xs))/intToFloat(length(xs)),1)} (${show(minOf(xs))}-${show(maxOf(xs))})"
}
pure func ly(x:float) -> string = if x>1e98 then "none" else formatFixed(x,1)
pure func table(title:string,presets:[Preset],perPreset:[[[int]]]) -> string =
 join("\n",["**${title}**","","| stage | ${join(" | ",map(\p. p.id,presets))} |","|---|${join("",map(\p. "---|",presets))}"]
  ++zipWith(\n name. "| ${name} | ${join(" | ",map(\vs. cell(vs,n),perPreset))} |",ints(0,length(rowNames())),rowNames()))
func run(a:{registry:string,planets:string,firstSeed:int,seeds:int,x:float,y:float,z:float,year:float,apertureM:float,shellLy:float},presets:[Preset]) -> () ! {FS,IO} =
 match snapshotFromJson(readFile(a.planets)) {
  None=>{println("evidence-probe: FAIL malformed measured-planet JSON");exit(1)},
  Some(snapshot)=>{
   let known=snapshot.planets;
   let rows=rowsFromJsonWith(readFile(a.registry),known);
   let idx=observedIndex(known);
   let base=shipSuite();
   let whatIf=a.apertureM!=base.telescope.optics.apertureM;
   let suite=if whatIf then {base | telescope:{base.telescope | id:"WHAT-IF-coronagraph-${show(a.apertureM)}m",optics:{base.telescope.optics | apertureM:a.apertureM}}} else base;
   let obs={x:a.x,y:a.y,z:a.z};
   let seeds=ints(a.firstSeed,a.firstSeed+a.seeds);
   -- per seed: the physical population once, then one tally per preset
   let runs=map(\seed. {
    let items=flatMap(\row. map(\p. {
      let t=targetOf(seed,row,p);
      {t:t,habitable:p.hab!=NotHabitable,slot:p.slot,g:stagesOf(suite,suite.stopLookS,t,obs)}
     },(systemFrom(seed,zeroDial(),row,observedFor(idx,row.id))).planets),rows);
    map(\preset. tally(suite,preset,seed,obs,a.year,a.shellLy,items),presets)
   },seeds);
   let tallies=map(\k. flatMap(\run. pick(run,k),runs),ints(0,length(presets)));
   println("evidence-probe: ${if whatIf then "WHAT-IF " else ""}telescope ${suite.telescope.id} (${show(suite.telescope.optics.apertureM)} m), receiver ${suite.receiver.id}, look ${show(suite.stopLookS/86400.0)} days; from (${show(a.x)}, ${show(a.y)}, ${show(a.z)}) ly at year ${show(a.year)}; ${show(length(rows))} registry systems; seeds ${show(a.firstSeed)}..${show(a.firstSeed+a.seeds-1)}; cells are mean (min-max) over seeds");
   println("");
   println(table("Within ${show(a.shellLy)} ly of the ship",presets,map(\ts. map(\t. t.inner,ts),tallies)));
   println("");
   println(table("Whole registry (25 pc, 81.5 ly, around Sol)",presets,map(\ts. map(\t. t.whole,ts),tallies)));
   println("");
   println("**Nearest, light-years from the ship, per seed**");
   println("");
   println("| preset | nearest living world | nearest living world showing oxygen | nearest Technological world | planets in the ship's own system (not observed remotely) |");
   println("|---|---|---|---|---|");
   println(join("\n",zipWith(\p ts. "| ${p.id} | ${join(", ",map(\t. ly(t.nearestLiving),ts))} | ${join(", ",map(\t. ly(t.nearestOxygen),ts))} | ${join(", ",map(\t. ly(t.nearestTech),ts))} | ${join(", ",map(\t. show(t.inSystem),ts))} |",presets,tallies)))
  }
 }
export func funnel(a:{registry:string,planets:string,firstSeed:int,seeds:int,x:float,y:float,z:float,year:float,apertureM:float,shellLy:float}) -> () ! {FS,IO} = run(a,allPresets())
-- The same funnel at candidate dials (offsets in orders of magnitude), for the preset calibration proposal.
export func funnelAt(a:{registry:string,planets:string,firstSeed:int,seeds:int,x:float,y:float,z:float,year:float,apertureM:float,shellLy:float,
 dials:[{id:string,life:float,minds:float,tech:float,lifetime:float}]}) -> () ! {FS,IO} =
 run({registry:a.registry,planets:a.planets,firstSeed:a.firstSeed,seeds:a.seeds,x:a.x,y:a.y,z:a.z,year:a.year,apertureM:a.apertureM,shellLy:a.shellLy},
  map(\d. {id:d.id,name:d.id,dial:{life:d.life,minds:d.minds,tech:d.tech,lifetime:d.lifetime},calibrated:false},a.dials))
