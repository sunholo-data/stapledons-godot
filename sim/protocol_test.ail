module stapledons/sim/protocol_test

-- Protocol v2 codec round trips, reason codes (every v1.1 reason case has a
-- v2 counterpart here since M2.1b removed v1.1), scenario-parameter bounds,
-- rejection model, handshake, the diag echo hook (AC8, AC9 sim side) and the
-- M2.2 world over the wire (params, m_eff_too_small, clock, phase) and the
-- M2.3a journey and ledger sections, and the M2.4 draw intent and rng section,
-- and the 2.1 AI codecs (AI.2: ai_open, ai_cancel, the AI events, the `ai`
-- change-set section) with no wire change for a 2.0 session.
-- `protocolVm` runs the checks on the strict VM (`make strict`, AC10).
import ./core (initShip, step, turn, position, Intent, IPlan, ICommit, ICancel, IThrust, IHeading, IRecord, IDraw, IEcho, IAiOpen, IAiCancel, PlanReq, Params, Refusal, Event, Crossing, Residuals, Drawn, event, defaultParams,
  Target, PlanView, JourneyView, Energy, Ism, World, newWorld, tick, journeyView, cruisePhiMin, cruisePhiMax, cruisePhiDefault)
import ./protocol (Input, GHello, GNewGame, GInput, GQuit, StateMsg, Clock, ShipView, LedgerView, HelloMsg, Session, Served, decodeInput, encodeInput, decodeState, encodeState, encodeHello, decodeHello, helloMsg, newSession, serve, num)
import ./rng (Rng, Stream, SJourney, SNews, value, top53)
import ./ai (AiOpen, AiEvent, ERequest, EAcceptedText, EAcceptedMedia, EFallback, AiRequest, AiSeg, CacheKey, Constraints, CtxVal, CStr, CList, CtxField, AiView, OpenView, cancelReasons)
import std/json (Json, JObject, JNumber, JString, JArray, JBool, JNull, kv)
import pkg/sunholo/relativity/medium (photonDriveEnergy)
import pkg/sunholo/relativity/optics (Vec3)
import std/json (decode, getString, getNumber)
import std/result (Ok, Err)
import std/option (Option, Some, None)
import std/string (join, contains, startsWith)
import std/list (map, foldl)
import ./protocol (systemMinor, helloFor, encodeSystem, decodeSystem)
import ./celestial (SystemView, BodyView, solSystem, systemAt, defaultEpochJd)

pure func status(line: string) -> string =
  match decode(line) { Ok(j) => match getString(j, "status") { Some(x) => x, None => "missing" }, Err(_) => "decode_error" }

-- ------------------------------------------------- bit-exact equality
-- `==` treats -0.0 and 0.0 as equal; the sign is compared through 1/x.
pure func feq(a: float, b: float) -> bool = a == b && (a != 0.0 || (1.0 / a < 0.0) == (1.0 / b < 0.0))
pure func veq(a: Vec3, b: Vec3) -> bool = feq(a.x, b.x) && feq(a.y, b.y) && feq(a.z, b.z)
pure func oeq(a: Option[float], b: Option[float]) -> bool =
  match a { Some(x) => match b { Some(y) => feq(x, y), None => false }, None => b == None }
pure func allEq(f: (a, a) -> bool, xs: [a], ys: [a]) -> bool =
  match xs { [] => (match ys { [] => true, _ => false }), x :: xr => match ys { [] => false, y :: yr => f(x, y) && allEq(f, xr, yr) } }

pure func planEq(p: PlanReq, q: PlanReq) -> bool =
  p.target.index == q.target.index && p.target.id == q.target.id && veq(p.target.pos, q.target.pos) && feq(p.cruisePhi, q.cruisePhi) && oeq(p.flipG, q.flipG)
pure func intentEq(a: Intent, b: Intent) -> bool =
  match a {
    IPlan(p) => match b { IPlan(q) => planEq(p, q), _ => false },
    ICommit(n) => match b { ICommit(m) => n == m, _ => false },
    ICancel => match b { ICancel => true, _ => false },
    IThrust(x) => match b { IThrust(y) => feq(x, y), _ => false },
    IHeading(h) => match b { IHeading(g) => veq(h, g), _ => false },
    IRecord(r) => match b { IRecord(q) => r.source == q.source && r.req == q.req && r.kind == q.kind && r.sha256 == q.sha256 && r.body == q.body, _ => false },
    IDraw(s) => match b { IDraw(t) => s == t, _ => false },
    IEcho(p) => match b { IEcho(q) => planEq(p, q), _ => false },
    IAiOpen(o) => match b { IAiOpen(q) => aiOpenEq(o, q), _ => false },
    IAiCancel(c) => match b { IAiCancel(d) => c.req == d.req && c.reason == d.reason, _ => false }
  }
pure func strsEq(a: [string], b: [string]) -> bool = allEq(\x y. x == y, a, b)
pure func ctxEq(a: CtxField, b: CtxField) -> bool =
  a.name == b.name && (match a.value { CStr(x) => (match b.value { CStr(y) => x == y, _ => false }), CList(xs) => (match b.value { CList(ys) => strsEq(xs, ys), _ => false }) })
pure func aiOpenEq(o: AiOpen, q: AiOpen) -> bool =
  o.kind == q.kind && o.purpose == q.purpose && o.entityId == q.entityId && o.emotion == q.emotion && oeq(o.ageStage, q.ageStage) && o.lineReq == q.lineReq &&
  someEq(strsEq, o.emotions, q.emotions) && allEq(ctxEq, o.context, q.context)
pure func keyEq(a: CacheKey, b: CacheKey) -> bool = a.kind == b.kind && a.entityId == b.entityId && a.emotion == b.emotion && a.ageStage == b.ageStage && a.variant == b.variant
pure func segEq(a: AiSeg, b: AiSeg) -> bool = a.emotion == b.emotion && a.text == b.text
pure func aiRequestEq(a: AiRequest, b: AiRequest) -> bool =
  a.req == b.req && a.kind == b.kind && a.purpose == b.purpose && a.lineReq == b.lineReq && keyEq(a.key, b.key) && a.seed == b.seed &&
  a.constraints.maxChars == b.constraints.maxChars && a.constraints.noNumerals == b.constraints.noNumerals && strsEq(a.constraints.emotions, b.constraints.emotions) &&
  allEq(ctxEq, a.context, b.context) && a.expiresTick == b.expiresTick
pure func aiEventEq(a: AiEvent, b: AiEvent) -> bool =
  match a {
    ERequest(x) => (match b { ERequest(y) => aiRequestEq(x, y), _ => false }),
    EAcceptedText(x) => (match b { EAcceptedText(y) => x.req == y.req && x.kind == y.kind && x.sha256 == y.sha256 && x.text == y.text && allEq(segEq, x.segments, y.segments), _ => false }),
    EAcceptedMedia(x) => (match b { EAcceptedMedia(y) => x.req == y.req && x.kind == y.kind && x.sha256 == y.sha256 && x.descriptor == y.descriptor, _ => false }),
    EFallback(x) => (match b { EFallback(y) => x.req == y.req && x.reason == y.reason, _ => false })
  }
pure func openViewEq(a: OpenView, b: OpenView) -> bool = a.req == b.req && a.kind == b.kind && a.expiresTick == b.expiresTick
pure func aiViewEq(a: AiView, b: AiView) -> bool = a.lastReq == b.lastReq && allEq(openViewEq, a.open, b.open) && a.core == b.core
pure func overrideEq(a: {name: string, value: float}, b: {name: string, value: float}) -> bool = a.name == b.name && feq(a.value, b.value)
pure func inputEq(a: Input, b: Input) -> bool =
  match a {
    GHello(h) => match b { GHello(g) => h.major == g.major && h.minor == g.minor, _ => false },
    GNewGame(n) => match b { GNewGame(m) => n.seed == m.seed && n.scenario == m.scenario && n.diag == m.diag && allEq(overrideEq, n.params, m.params) && n.aiCore == m.aiCore, _ => false },
    GInput(i) => match b { GInput(j) => i.tick == j.tick && feq(i.dtau, j.dtau) && allEq(intentEq, i.intents, j.intents), _ => false },
    GQuit => match b { GQuit => true, _ => false }
  }
pure func paramsEq(a: Params, b: Params) -> bool =
  feq(a.epoch, b.epoch) && feq(a.startAge, b.startAge) && feq(a.boostG, b.boostG) && feq(a.mEffKg, b.mEffKg) && feq(a.ismNCm3, b.ismNCm3) && feq(a.bubbleRadiusM, b.bubbleRadiusM) && feq(a.glowEps, b.glowEps) && feq(a.glowFIn, b.glowFIn) && feq(a.cruiseMinBeta, b.cruiseMinBeta) && feq(a.capOneMinusBeta, b.capOneMinusBeta) &&
  a.aiMaxOpen == b.aiMaxOpen && a.aiTtlTicks == b.aiTtlTicks
pure func clockEq(a: Clock, b: Clock) -> bool = feq(a.tau, b.tau) && feq(a.t, b.t) && feq(a.year, b.year) && feq(a.age, b.age)
pure func shipEq(a: ShipView, b: ShipView) -> bool = a.phase == b.phase && feq(a.beta, b.beta) && feq(a.oneMinusBeta, b.oneMinusBeta) && feq(a.gamma, b.gamma) && veq(a.heading, b.heading) && veq(a.pos, b.pos) && feq(a.x, b.x) && feq(a.flown, b.flown)
pure func none(o: Option[a]) -> bool = match o { None => true, Some(_) => false }
pure func someEq(f: (a, a) -> bool, x: Option[a], y: Option[a]) -> bool =
  match x { Some(p) => match y { Some(q) => f(p, q), None => false }, None => match y { None => true, Some(_) => false } }
pure func refusalEq(a: Refusal, b: Refusal) -> bool = a.i == b.i && a.reason == b.reason
pure func crossingEq(a: Crossing, b: Crossing) -> bool = a.from == b.from && a.to == b.to && feq(a.tau, b.tau)
pure func residualsEq(a: Residuals, b: Residuals) -> bool = feq(a.x, b.x) && feq(a.t, b.t) && feq(a.phi, b.phi)
pure func drawnEq(a: Drawn, b: Drawn) -> bool = a.stream == b.stream && a.n == b.n && a.value == b.value
pure func eventEq(a: Event, b: Event) -> bool = a.kind == b.kind && someEq(planEq, a.echo, b.echo) && someEq(crossingEq, a.phase, b.phase) && someEq(residualsEq, a.arrived, b.arrived) && someEq(drawnEq, a.drew, b.drew) && someEq(aiEventEq, a.ai, b.ai)
pure func rngEq(a: Rng, b: Rng) -> bool = a.journey == b.journey && a.crew == b.crew && a.events == b.events && a.galaxy == b.galaxy && a.ai == b.ai && a.news == b.news
pure func targetEq(a: Target, b: Target) -> bool = a.index == b.index && a.id == b.id && veq(a.pos, b.pos)
pure func planViewEq(a: PlanView, b: PlanView) -> bool =
  targetEq(a.target, b.target) && feq(a.distance, b.distance) && a.profile == b.profile && a.fellBack == b.fellBack &&
  feq(a.cruisePhi, b.cruisePhi) && feq(a.cruiseBeta, b.cruiseBeta) && feq(a.cruiseOneMinusBeta, b.cruiseOneMinusBeta) && feq(a.cruiseGamma, b.cruiseGamma) &&
  feq(a.boostMinutes, b.boostMinutes) && feq(a.shipYears, b.shipYears) && feq(a.earthYears, b.earthYears) && feq(a.arriveYear, b.arriveYear) &&
  feq(a.ageOnArrival, b.ageOnArrival) && feq(a.yearsLeft, b.yearsLeft) &&
  feq(a.energy.boostJ, b.energy.boostJ) && feq(a.energy.brakeJ, b.energy.brakeJ) && feq(a.energy.dragJ, b.energy.dragJ) && feq(a.energy.totalJ, b.energy.totalJ) && feq(a.energy.totalKg, b.energy.totalKg) &&
  feq(a.ism.dragN, b.ism.dragN) && feq(a.ism.holdW, b.ism.holdW) && feq(a.ism.loadWM2, b.ism.loadWM2) && feq(a.ism.glowWM2, b.ism.glowWM2) && feq(a.cmbForwardK, b.cmbForwardK)
pure func journeyEq(a: JourneyView, b: JourneyView) -> bool = a.state == b.state && a.planId == b.planId && someEq(planViewEq, a.plan, b.plan)
pure func ledgerEq(a: LedgerView, b: LedgerView) -> bool =
  feq(a.mEffKg, b.mEffKg) && feq(a.availableKg, b.availableKg) && feq(a.radiatedJ, b.radiatedJ) && feq(a.boostJ, b.boostJ) && feq(a.dragJ, b.dragJ)
pure func stateEq(a: StateMsg, b: StateMsg) -> bool =
  a.tick == b.tick && a.status == b.status && someEq(clockEq, a.clock, b.clock) && someEq(shipEq, a.ship, b.ship) &&
  someEq(journeyEq, a.journey, b.journey) && someEq(ledgerEq, a.ledger, b.ledger) && someEq(rngEq, a.rng, b.rng) && someEq(paramsEq, a.params, b.params) && someEq(aiViewEq, a.ai, b.ai) &&
  allEq(eventEq, a.events, b.events) && allEq(refusalEq, a.refused, b.refused) && a.full == b.full

-- ------------------------------------------------------------ fixtures
pure func maxInt() -> int = 9007199254740991
pure func almostOne() -> float = 1.0 - 0.0000000000000002220446049250313
pure func tiny() -> float = 4.9406564584124654e-324
pure func negZero() -> float = -1.0 * 0.0
pure func phiCap() -> float = 7.254328619262047

pure func edgeVec() -> Vec3 = {x: 1.0e308, y: negZero(), z: almostOne()}
pure func edgePlan() -> PlanReq = {target: {index: maxInt(), id: "Gl 559", pos: edgeVec()}, cruisePhi: phiCap(), flipG: None}
pure func allIntents() -> [Intent] = [
  IPlan({target: {index: maxInt(), id: "Gl 559", pos: edgeVec()}, cruisePhi: phiCap(), flipG: Some(1.0)}),
  IPlan({target: {index: 0, id: "Sol \"quoted\" \\ star", pos: {x: 0.1, y: tiny(), z: -4.09}}, cruisePhi: 0.1, flipG: None}),
  ICommit(maxInt()), ICancel, IThrust(negZero()), IThrust(-1.0),
  IHeading({x: 0.6, y: 0.8, z: negZero()}),
  IRecord({source: "ai", req: "r-1", kind: "line", sha256: "e3b0c442", body: "{\"text\":\"hi\"}"}),
  IDraw(SNews),
  IEcho({target: {index: 3, id: "echo", pos: edgeVec()}, cruisePhi: negZero(), flipG: Some(tiny())})
]
pure func inputFixtures() -> [Input] = [
  GHello({major: 2, minor: 0}),
  GNewGame({seed: maxInt(), scenario: "sol", diag: true, params: [{name: "glow_eps", value: tiny()}, {name: "epoch", value: negZero()}, {name: "glow_f_in", value: almostOne()}, {name: "start_age", value: 0.1}], aiCore: None}),
  GNewGame({seed: 0, scenario: "sol", diag: false, params: [], aiCore: None}),
  GInput({tick: maxInt(), dtau: 0.1, intents: allIntents()}),
  GInput({tick: 1, dtau: tiny(), intents: []}),
  GInput({tick: 2, dtau: almostOne(), intents: [IThrust(1.0)]}),
  GInput({tick: 3, dtau: negZero(), intents: []}),
  GQuit
]
pure func edgeView() -> PlanView = { target: {index: maxInt(), id: "Gl \"559\"", pos: edgeVec()}, distance: 4.35667304258651, profile: "burn_coast_burn", fellBack: true,
  cruisePhi: phiCap(), cruiseBeta: almostOne(), cruiseOneMinusBeta: tiny(), cruiseGamma: 1.0e308, boostMinutes: 1.7976931348623157e308, shipYears: 0.1,
  earthYears: negZero(), arriveYear: -1.0e308, ageOnArrival: 0.30000000000000004, yearsLeft: -0.00000000015,
  energy: {boostJ: 1.0e21, brakeJ: 237869256192685950.0, dragJ: 0.0, totalJ: 15104591056870126000.0, totalKg: 6.818},
  ism: {dragN: tiny(), holdW: 70791174749363.73, loadWM2: 2253353077.7286806, glowWM2: 0.000024071942179266308}, cmbForwardK: 3853.730994033574 }
pure func stateFixtures() -> [StateMsg] = [
  { tick: 0, status: "ok", clock: Some({tau: 0.1, t: almostOne(), year: tiny(), age: negZero()}),
    ship: Some({phase: "rest", beta: negZero(), oneMinusBeta: 1.0, gamma: 1.0e308, heading: {x: 0.0, y: 0.0, z: -1.0}, pos: {x: phiCap(), y: 0.1, z: tiny()}, x: 1.0e308, flown: negZero()}),
    journey: Some({state: "planned", planId: maxInt(), plan: Some(edgeView())}),
    ledger: Some({mEffKg: 0.5, availableKg: 20000.0, radiatedJ: 1.0e308, boostJ: tiny(), dragJ: negZero()}),
    rng: Some({journey: 0, crew: 1, events: 2, galaxy: 3, ai: maxInt(), news: 9007199254740991}),
    params: Some(defaultParams()), ai: None, events: [{event("phase") | phase: Some({from: "boosting", to: "cruising", tau: 0.0000034232612397})}, {event("echo") | echo: Some(edgePlan())}, event("committed"),
      {event("phase") | phase: Some({from: "braking", to: "at_rest", tau: negZero()})}, {event("arrived") | arrived: Some({x: tiny(), t: 1.0e308, phi: negZero()})},
      {event("draw") | drew: Some({stream: "news", n: 0, value: 9007199254740991})}, {event("draw") | drew: Some({stream: "journey", n: maxInt(), value: 0})}], refused: [{i: 0, reason: "unsupported"}, {i: maxInt(), reason: "diag_only"}], full: true },
  { tick: maxInt(), status: "bad_tick", clock: None, ship: None, journey: None, ledger: None, rng: None, params: None, ai: None, events: [], refused: [], full: false },
  { tick: 7, status: "ok", clock: Some({tau: 1.0e308, t: -1.0e308, year: 0.0, age: 30.0}), ship: None, journey: Some({state: "idle", planId: 0, plan: None}), ledger: None, rng: None, params: None, ai: None, events: [], refused: [], full: false }
]

pure func roundTripInput(x: Input) -> bool = match decodeInput(encodeInput(x)) { Ok(y) => inputEq(x, y), Err(_) => false }
pure func roundTripState(x: StateMsg) -> bool = match decodeState(encodeState(x)) { Ok(y) => stateEq(x, y), Err(_) => false }
pure func allTrue(xs: [bool]) -> bool = foldl(\acc x. acc && x, true, xs)

pure func checkFloatText() -> bool =
  num(0.1) == "0.1" && num(almostOne()) == "0.9999999999999998" && num(tiny()) == "5e-324" && num(1.0e308) == "1e308" &&
  num(negZero()) == "-0.0" && num(0.0) == "0" && num(phiCap()) == "7.254328619262047" && num(-1.0e308) == "-1e308" &&
  num(1.7976931348623157e308) == "1.7976931348623157e308" && num(1.0e21) == "1e21" && num(0.000001) == "0.000001" &&
  num(0.0000001) == "1e-7" && num(-0.00000000015) == "-1.5e-10" && num(0.1 + 0.2) == "0.30000000000000004" && num(9007199254740991.0) == "9007199254740991"
pure func checkInputRoundTrip() -> bool = allTrue(map(roundTripInput, inputFixtures()))
pure func checkStateRoundTrip() -> bool = allTrue(map(roundTripState, stateFixtures()))
pure func checkHelloRoundTrip() -> bool {
  let h = helloMsg();
  match decodeHello(encodeHello(h)) { Ok(g) => g.major == 2 && g.minor == 1 && g.sim == h.sim && g.relativity == h.relativity && g.rng == "splitmix64-1", Err(_) => false }
}

-- ------------------------------------------------- reason codes (decode)
pure func code(line: string) -> string = match decodeInput(line) { Ok(_) => "ok", Err(c) => c }
pure func inp(body: string) -> string = join("", ["{\"v\":2,\"type\":\"input\",\"tick\":1,", body, "}"])
pure func newGame(body: string) -> string = join("", ["{\"v\":2,\"type\":\"new_game\",", body, "}"])
pure func intent(body: string) -> string = inp(join("", ["\"dtau\":0.1,\"intents\":[", body, "]"]))
-- 1e400 is out of float64 range: std/json refuses the whole line since v0.52.0 (bad_json;
-- v0.51.0 decoded it to a non-finite value, refused per field).
pure func checkDecodeCodes() -> bool =
  code("{broken") == "bad_json" && code(inp("\"dtau\":NaN,\"intents\":[]")) == "bad_json" &&
  code("{\"type\":\"hello\"}") == "bad_v" && code("{\"v\":3,\"type\":\"hello\"}") == "bad_v" && code("{\"v\":\"2\",\"type\":\"hello\"}") == "bad_v" && code("{\"v\":2.5,\"type\":\"hello\"}") == "bad_v" &&
  code("{\"v\":2,\"type\":\"warp\"}") == "bad_cmd" && code("{\"v\":2}") == "bad_cmd" &&
  code("{\"v\":2,\"type\":\"input\",\"tick\":1.5,\"dtau\":0,\"intents\":[]}") == "bad_tick" && code("{\"v\":2,\"type\":\"input\",\"tick\":-1,\"dtau\":0,\"intents\":[]}") == "bad_tick" &&
  code("{\"v\":2,\"type\":\"input\",\"tick\":9007199254740992,\"dtau\":0,\"intents\":[]}") == "bad_tick" && code("{\"v\":2,\"type\":\"input\",\"dtau\":0,\"intents\":[]}") == "bad_tick" &&
  code(inp("\"dtau\":-1,\"intents\":[]")) == "bad_step" && code(inp("\"dtau\":1.0000000000000002,\"intents\":[]")) == "bad_step" && code(inp("\"dtau\":1e400,\"intents\":[]")) == "bad_json" && code(inp("\"intents\":[]")) == "bad_step" &&
  code(inp("\"dtau\":0")) == "bad_intent" && code(inp("\"dtau\":0,\"intents\":{}")) == "bad_intent" && code(intent("{\"k\":\"warp\"}")) == "bad_intent" && code(intent("{}")) == "bad_intent" &&
  code(intent("{\"k\":\"plan\",\"cruise_phi\":1}")) == "bad_intent" && code(intent("{\"k\":\"commit\",\"plan_id\":1.5}")) == "bad_intent" && code(intent("{\"k\":\"draw\"}")) == "bad_intent" &&
  code(intent("{\"k\":\"plan\",\"target\":{\"index\":0,\"id\":\"x\",\"pos\":{\"x\":1e400,\"y\":0,\"z\":0}},\"cruise_phi\":1}")) == "bad_json" &&
  code(intent("{\"k\":\"thrust\",\"thrust\":2}")) == "bad_step" && code(intent("{\"k\":\"thrust\"}")) == "bad_step" &&
  code(intent("{\"k\":\"heading\",\"heading\":{\"x\":1,\"y\":0}}")) == "bad_heading" && code(intent("{\"k\":\"heading\",\"heading\":{\"x\":1.00000001,\"y\":0,\"z\":0}}")) == "bad_heading" &&
  code(intent("{\"k\":\"heading\",\"heading\":{\"x\":1e400,\"y\":0,\"z\":0}}")) == "bad_json" && code(intent("{\"k\":\"echo\",\"cruise_phi\":1}")) == "bad_intent" &&
  code(newGame("\"seed\":-1,\"scenario\":\"sol\",\"diag\":true")) == "bad_game" && code(newGame("\"seed\":9007199254740992,\"scenario\":\"sol\",\"diag\":true")) == "bad_game" &&
  code(newGame("\"seed\":1.5,\"scenario\":\"sol\",\"diag\":true")) == "bad_game" && code(newGame("\"seed\":1,\"scenario\":\"andromeda\",\"diag\":true")) == "bad_game" && code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":\"yes\"")) == "bad_game" &&
  code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"warp\":1}")) == "bad_params" && code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"glow_eps\":2}")) == "bad_params" &&
  code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"cruise_min_beta\":1}")) == "bad_params" && code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"m_eff_kg\":0}")) == "bad_params" &&
  code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"params\":[]")) == "bad_params" && code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"cap_one_minus_beta\":-1e-6}")) == "bad_params"

-- -------------------------------------------------- session (serve)
pure func feed(s: Session, lines: [string]) -> Served =
  foldl(\acc line. serve(acc.session, line), {session: s, reply: ""}, lines)
pure func stateOf(reply: string) -> StateMsg =
  match decodeState(reply) { Ok(m) => m, Err(e) => {tick: -1, status: e, clock: None, ship: None, journey: None, ledger: None, rng: None, params: None, ai: None, events: [], refused: [], full: false} }
pure func hello() -> string = "{\"v\":2,\"type\":\"hello\",\"want\":{\"major\":2,\"minor\":0}}"
pure func diagGame() -> string = newGame("\"seed\":7,\"scenario\":\"sol\",\"diag\":true")
pure func playGame() -> string = newGame("\"seed\":7,\"scenario\":\"sol\",\"diag\":false")
pure func tickLine(t: int, dtau: string, intents: string) -> string = join("", ["{\"v\":2,\"type\":\"input\",\"tick\":", show(t), ",\"dtau\":", dtau, ",\"intents\":[", intents, "]}"])
pure func shipX(m: StateMsg) -> float = match m.ship { Some(v) => v.x, None => -1.0 }

pure func checkHandshake() -> bool {
  let pre = serve(newSession(), diagGame());
  let pre2 = serve(newSession(), tickLine(1, "0", ""));
  let h = serve(newSession(), hello());
  let noGame = serve(h.session, tickLine(1, "0", ""));
  let first = match decodeHello(h.reply) { Ok(g) => g.major == 2 && g.minor == 1 && g.rng == "splitmix64-1", Err(_) => false };
  let full = stateOf(serve(h.session, diagGame()).reply);
  stateOf(pre.reply).status == "no_hello" && none(stateOf(pre.reply).ship) && stateOf(pre2.reply).status == "no_hello" &&
  first && stateOf(noGame.reply).status == "no_game" && full.full && full.tick == 0 && full.status == "ok" &&
  someEq(paramsEq, full.params, Some(defaultParams())) && !none(full.clock) && !none(full.ship) &&
  someEq(journeyEq, full.journey, Some({state: "idle", planId: 0, plan: None})) && !none(full.ledger)
}
pure func checkParamsEcho() -> bool {
  let s = feed(newSession(), [hello(), newGame("\"seed\":7,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"m_eff_kg\":0.5,\"epoch\":-0.0}")]);
  let d = defaultParams();
  someEq(paramsEq, stateOf(s.reply).params, Some({d | mEffKg: 0.5, epoch: negZero()}))
}
-- A malformed line changes nothing; the next good tick is still world + 1.
pure func checkMalformedKeepsTick() -> bool {
  let s = feed(newSession(), [hello(), diagGame(), tickLine(1, "0.1", "{\"k\":\"thrust\",\"thrust\":1}")]);
  let bad = [tickLine(1, "0.1", ""), tickLine(3, "0.1", ""), tickLine(0, "0.1", ""), tickLine(2, "-1", ""), tickLine(2, "0.1", "{\"k\":\"warp\"}"), "{broken", "{\"cmd\":\"step\"}", tickLine(2, "0.1", "{\"k\":\"thrust\",\"thrust\":2}")];
  let codes = map(\l. stateOf(serve(s.session, l).reply), bad);
  let next = stateOf(serve(s.session, tickLine(2, "0.1", "")).reply);
  let same = allTrue(map(\l. stateEq(stateOf(serve(serve(s.session, l).session, tickLine(2, "0.1", "")).reply), next), bad));
  allEq(\a b. a == b, map(\m. m.status, codes), ["bad_tick", "bad_tick", "bad_tick", "bad_step", "bad_intent", "bad_json", "bad_v", "bad_step"]) &&
  allTrue(map(\m. m.tick == 1 && none(m.clock) && none(m.ship), codes)) && same && next.status == "ok" && next.tick == 2
}
-- A well-formed intent the rules refuse is listed and the tick proceeds.
-- (Diag game, ship moving: the plan is accepted, commit refused `moving`,
-- cancel clears the plan, so the journey section nets to no change.)
pure func checkRefusedProceeds() -> bool {
  let play = feed(newSession(), [hello(), playGame(), tickLine(1, "0.5", "{\"k\":\"thrust\",\"thrust\":1},{\"k\":\"heading\",\"heading\":{\"x\":1,\"y\":0,\"z\":0}}")]);
  let p = stateOf(play.reply);
  let all = "{\"k\":\"plan\",\"target\":{\"index\":0,\"id\":\"Gl 559\",\"pos\":{\"x\":1.5,\"y\":-4.09,\"z\":-0.05}},\"cruise_phi\":2.6},{\"k\":\"commit\",\"plan_id\":1},{\"k\":\"cancel\"},{\"k\":\"record\",\"source\":\"ai\",\"req\":\"r\",\"kind\":\"line\",\"sha256\":\"00\",\"body\":\"x\"},{\"k\":\"draw\",\"stream\":\"news\"}";
  let diag = feed(newSession(), [hello(), diagGame(), tickLine(1, "0.5", "{\"k\":\"thrust\",\"thrust\":1}"), tickLine(2, "0.5", join("", [all, ",{\"k\":\"heading\",\"heading\":{\"x\":1,\"y\":0,\"z\":0}}"]))]);
  let d = stateOf(diag.reply);
  p.status == "ok" && p.tick == 1 && allEq(refusalEq, p.refused, [{i: 0, reason: "diag_only"}, {i: 1, reason: "diag_only"}]) && shipX(p) == -1.0 &&
  d.status == "ok" && d.tick == 2 && allEq(refusalEq, d.refused, [{i: 1, reason: "moving"}, {i: 3, reason: "ai_unknown_req"}, {i: 5, reason: "moving"}]) &&
  none(d.journey)
}
-- The diag adapter reproduces core.turn/step exactly (what v1.1 served).
pure func checkDiagKinematics() -> bool {
  let s = feed(newSession(), [hello(), diagGame(), tickLine(1, "0", "{\"k\":\"heading\",\"heading\":{\"x\":1,\"y\":0,\"z\":0}}"), tickLine(2, "1", "{\"k\":\"thrust\",\"thrust\":1}"), tickLine(3, "1", "{\"k\":\"thrust\",\"thrust\":-1}")]);
  let want = step(step(step(turn(initShip(), {x: 1.0, y: 0.0, z: 0.0}).ship, 0.0, 0.0), 1.0, 1.0), -1.0, 1.0);
  let m = stateOf(s.reply);
  let p = position(want);
  m.tick == 3 && match m.ship { Some(v) => feq(v.x, want.motion.x) && veq(v.pos, p) && veq(v.heading, {x: 1.0, y: 0.0, z: 0.0}), None => false } &&
  match m.clock { Some(c) => feq(c.tau, want.motion.tau) && feq(c.t, want.motion.t) && feq(c.age, 30.0 + want.motion.tau) && feq(c.year, want.motion.t), None => false }
}
-- Change-sets: a section appears only when a field in it changed.
pure func checkChangeSets() -> bool {
  let s = feed(newSession(), [hello(), diagGame()]);
  let idle = stateOf(serve(s.session, tickLine(1, "0", "")).reply);
  -- ailang#1467: a `let tick` would be shadowed by the imported core.tick, hence `later`.
  let later = stateOf(serve(s.session, tickLine(1, "0.5", "")).reply);
  idle.tick == 1 && none(idle.clock) && none(idle.ship) && none(idle.journey) && none(idle.ledger) && none(idle.rng) && none(idle.params) && !idle.full &&
  !none(later.clock) && none(later.ship) && none(later.journey) && none(later.ledger)
}
-- Every scenario-parameter bound (inRange): accepted exactly at the bound,
-- refused just past it. Executor-chosen ranges, pending Mark's ratification.
pure func param(name: string, v: string) -> string = code(newGame(join("", ["\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"", name, "\":", v, "}"])))
pure func accepts(name: string, vs: [string]) -> bool = allTrue(map(\v. param(name, v) == "ok", vs))
pure func refuses(name: string, vs: [string]) -> bool = allTrue(map(\v. param(name, v) == "bad_params", vs))
pure func checkParamBounds() -> bool =
  accepts("epoch", ["1000000", "-1000000", "-0.0"]) && refuses("epoch", ["1000000.0000001", "-1000000.0000001"]) &&
  accepts("start_age", ["0", "1000"]) && refuses("start_age", ["-1e-9", "1000.0000000001"]) &&
  accepts("boost_g", ["5e-324", "1000000000"]) && refuses("boost_g", ["0", "-1", "1000000000.0000001"]) &&
  accepts("m_eff_kg", ["5e-324", "1e30"]) && refuses("m_eff_kg", ["0", "1.0000000000000001e30", "2e30"]) &&
  accepts("ism_n_cm3", ["0", "1000000"]) && refuses("ism_n_cm3", ["-1e-9", "1000000.0000001"]) &&
  accepts("bubble_radius_m", ["5e-324", "1000000"]) && refuses("bubble_radius_m", ["0", "1000000.0000001"]) &&
  accepts("glow_eps", ["0", "1"]) && refuses("glow_eps", ["-1e-9", "1.0000000000000002"]) &&
  accepts("glow_f_in", ["0", "1"]) && refuses("glow_f_in", ["-1e-9", "1.0000000000000002"]) &&
  accepts("cruise_min_beta", ["5e-324", "0.9999999999999999"]) && refuses("cruise_min_beta", ["0", "1"]) &&
  accepts("cap_one_minus_beta", ["5e-324", "0.9999999999999999"]) && refuses("cap_one_minus_beta", ["0", "1"]) &&
  refuses("warp", ["0"]) && refuses("epoch", ["\"1\"", "true", "null"])
-- The diag echo hook returns the decoded plan payload bit for bit, in order;
-- outside diag it is refused diag_only and the tick proceeds.
pure func echoLine(t: int, pos: string, phi: string) -> string =
  tickLine(t, "0", join("", ["{\"k\":\"echo\",\"target\":{\"index\":9007199254740991,\"id\":\"Gl 559\",\"pos\":", pos, "},\"cruise_phi\":", phi, "}"]))
pure func checkEcho() -> bool {
  let d = feed(newSession(), [hello(), diagGame(), echoLine(1, "{\"x\":1e308,\"y\":-0.0,\"z\":0.9999999999999998}", "7.254328619262047")]);
  let m = stateOf(d.reply);
  let p = feed(newSession(), [hello(), playGame(), echoLine(1, "{\"x\":0.1,\"y\":5e-324,\"z\":-4.09}", "0.1")]);
  let pm = stateOf(p.reply);
  m.status == "ok" && m.tick == 1 && allEq(eventEq, m.events, [{event("echo") | echo: Some(edgePlan())}]) && allEq(refusalEq, m.refused, []) &&
  pm.status == "ok" && pm.tick == 1 && allEq(eventEq, pm.events, []) && allEq(refusalEq, pm.refused, [{i: 0, reason: "diag_only"}])
}

-- ------------------------------------------------- M2.2 world over the wire
pure func gameWith(params: string) -> string = newGame(join("", ["\"seed\":7,\"scenario\":\"sol\",\"diag\":true,\"params\":{", params, "}"]))
-- Each parameter just outside its range is a schema error that changes
-- nothing: a running game keeps its tick and params.
pure func badParams() -> [string] = ["\"epoch\":1000001", "\"start_age\":-1", "\"boost_g\":0", "\"m_eff_kg\":-1", "\"ism_n_cm3\":-0.1",
  "\"bubble_radius_m\":0", "\"glow_eps\":1.5", "\"glow_f_in\":-0.5", "\"cruise_min_beta\":0", "\"cap_one_minus_beta\":1"]
pure func checkParamRange() -> bool {
  let s = feed(newSession(), [hello(), diagGame(), tickLine(1, "0.1", "{\"k\":\"thrust\",\"thrust\":1}")]);
  let next = stateOf(serve(s.session, tickLine(2, "0.1", "")).reply);
  let codes = map(\b. stateOf(serve(s.session, gameWith(b)).reply), badParams());
  let same = allTrue(map(\b. stateEq(stateOf(serve(serve(s.session, gameWith(b)).session, tickLine(2, "0.1", "")).reply), next), badParams()));
  allTrue(map(\m. m.status == "bad_params" && m.tick == 1 && none(m.params) && !m.full, codes)) && same && next.tick == 2
}
-- V12: the brake holds against the drag at the cap only above 0.0321 kg.
pure func checkMEffTooSmall() -> bool {
  let refused = stateOf(feed(newSession(), [hello(), gameWith("\"m_eff_kg\":0.03")]).reply);
  let accepted = stateOf(feed(newSession(), [hello(), gameWith("\"m_eff_kg\":0.033")]).reply);
  let after = feed(newSession(), [hello(), gameWith("\"m_eff_kg\":0.03"), tickLine(1, "0", "")]);
  let d = defaultParams();
  refused.status == "m_eff_too_small" && none(refused.params) && !refused.full &&
  accepted.status == "ok" && accepted.full && someEq(paramsEq, accepted.params, Some({d | mEffKg: 0.033})) &&
  stateOf(after.reply).status == "no_game"
}
-- year = epoch + t, age = start_age + tau, from the effective params.
pure func checkClockFields() -> bool {
  let s = feed(newSession(), [hello(), gameWith("\"epoch\":2100.5,\"start_age\":41"), tickLine(1, "0.5", "{\"k\":\"thrust\",\"thrust\":1}")]);
  let first = stateOf(feed(newSession(), [hello(), gameWith("\"epoch\":2100.5,\"start_age\":41")]).reply);
  let m = stateOf(s.reply);
  match m.clock { Some(c) => c.tau == 0.5 && c.t > 0.5 && feq(c.year, 2100.5 + c.t) && feq(c.age, 41.0 + c.tau), None => false } &&
  match first.clock { Some(c) => c.tau == 0.0 && c.t == 0.0 && c.year == 2100.5 && c.age == 41.0, None => false }
}
-- The ship section carries the phase core derives (diag flight).
pure func phaseOf(m: StateMsg) -> string = match m.ship { Some(v) => v.phase, None => "none" }
pure func checkPhaseOnWire() -> bool {
  let g = feed(newSession(), [hello(), diagGame()]);
  let b = feed(g.session, [tickLine(1, "0.1", "{\"k\":\"thrust\",\"thrust\":1}")]);
  let c = feed(b.session, [tickLine(2, "0.1", "")]);
  let r = feed(c.session, [tickLine(3, "0.1", "{\"k\":\"thrust\",\"thrust\":-1}")]);
  phaseOf(stateOf(g.reply)) == "at_rest" && phaseOf(stateOf(b.reply)) == "boosting" && phaseOf(stateOf(c.reply)) == "cruising" && phaseOf(stateOf(r.reply)) == "at_rest" &&
  helloMsg().relativity == "0.4.0"
}

-- ------------------------------------------------- M2.3a journey and ledger over the wire
pure func viewOf(m: StateMsg) -> Option[PlanView] = match m.journey { Some(j) => j.plan, None => None }
pure func jstate(m: StateMsg) -> string = match m.journey { Some(j) => join(":", [j.state, show(j.planId)]), None => "none" }
pure func gl559Plan(phi: string) -> string = join("", ["{\"k\":\"plan\",\"target\":{\"index\":1,\"id\":\"Gl 559\",\"pos\":{\"x\":1.5,\"y\":-4.09,\"z\":-0.05}},\"cruise_phi\":", phi, "}"])
pure func acenPlan(phi: string) -> string = join("", ["{\"k\":\"plan\",\"target\":{\"index\":1,\"id\":\"Gl 559\",\"pos\":{\"x\":0,\"y\":0,\"z\":-4.37}},\"cruise_phi\":", phi, "}"])
pure func relW(a: float, b: float, tol: float) -> bool = (if a > b then a - b else b - a) <= tol * (if b < 0.0 then 0.0 - b else b)
-- The journey section: idle in the full state; planned with the panel
-- (bit for bit core.journeyView, through the codec); live while planned
-- (the clock runs); committed with a `committed` event, then frozen and
-- absent from the change-sets; cancel refused `committed`.
pure func checkJourneyOnWire() -> bool {
  let g = feed(newSession(), [hello(), playGame()]);
  let p = feed(g.session, [tickLine(1, "0", gl559Plan("2.6466524123622457"))]);
  let w = tick(newWorld(7, false, defaultParams()), {dtau: 0.0, intents: [IPlan({target: {index: 1, id: "Gl 559", pos: {x: 1.5, y: -4.09, z: -0.05}}, cruisePhi: 2.6466524123622457, flipG: None})]}).world;
  let wait = feed(p.session, [tickLine(2, "0.5", "")]);
  let c = feed(wait.session, [tickLine(3, "0", "{\"k\":\"commit\",\"plan_id\":1}")]);
  let after = feed(c.session, [tickLine(4, "0.5", "{\"k\":\"cancel\"}")]);
  let pm = stateOf(p.reply);
  let cm = stateOf(c.reply);
  let am = stateOf(after.reply);
  jstate(stateOf(g.reply)) == "idle:0" && none(viewOf(stateOf(g.reply))) &&
  jstate(pm) == "planned:1" && someEq(planViewEq, viewOf(pm), (journeyView(w)).plan) &&
  jstate(stateOf(wait.reply)) == "planned:1" &&
  (match viewOf(stateOf(wait.reply)) { Some(v) => match viewOf(pm) { Some(u) => v.arriveYear == u.arriveYear + 0.5 && v.yearsLeft == 100.0 - 0.5 - v.shipYears, None => false }, None => false }) &&
  jstate(cm) == "committed:1" && allEq(eventEq, cm.events, [event("committed")]) && allEq(refusalEq, cm.refused, []) &&
  none(am.journey) && allEq(refusalEq, am.refused, [{i: 0, reason: "committed"}]) && am.tick == 4
}
-- The alpha Cen 0.99c panel as the wire carries it (design AC2/AC3 headline:
-- 0.6227 ship-yr, 4.414 Earth-yr, 1.80 boost-min, 6.818 kg total).
pure func checkAlphaCenPanel() -> bool {
  let m = stateOf(feed(newSession(), [hello(), playGame(), tickLine(1, "0", acenPlan("2.6466524123622457"))]).reply);
  match viewOf(m) {
    Some(v) => relW(v.shipYears, 0.6226958707592057, 0.000000001) && relW(v.earthYears, 4.414143655383168, 0.000000001) &&
      num(v.boostMinutes) == num(v.boostMinutes) && relW(v.boostMinutes, 1.80, 0.003) && relW(v.energy.totalKg, 6.818, 0.0001) &&
      relW(v.energy.totalJ, 612764286331283800.0, 0.000000001) && relW(v.cmbForwardK, 38.44085554458952, 0.000000001) && v.profile == "burn_coast_burn",
    None => false
  }
}
-- The ledger section with a non-default m_eff (M2.2 follow-up): echoed in
-- the full state, then sent whenever it changes; radiated = boost + drag;
-- equal to core's ledger bit for bit. The plan energy uses the same m_eff.
pure func ledgerOfMsg(m: StateMsg) -> Option[LedgerView] = m.ledger
pure func checkLedgerOnWire() -> bool {
  let g = feed(newSession(), [hello(), newGame("\"seed\":7,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"m_eff_kg\":0.5}")]);
  let b = feed(g.session, [tickLine(1, "0.25", "{\"k\":\"thrust\",\"thrust\":1}")]);
  let c = feed(b.session, [tickLine(2, "0.5", "")]);
  let r = feed(c.session, [tickLine(3, "0.25", "{\"k\":\"thrust\",\"thrust\":-1}")]);
  let still = feed(r.session, [tickLine(4, "0.5", "")]);
  let wb = tick(newWorld(7, true, {defaultParams() | mEffKg: 0.5}), {dtau: 0.25, intents: [IThrust(1.0)]}).world;
  let wc = tick(wb, {dtau: 0.5, intents: []}).world;
  let pe = feed(newSession(), [hello(), newGame("\"seed\":7,\"scenario\":\"sol\",\"diag\":false,\"params\":{\"m_eff_kg\":0.5}"), tickLine(1, "0", acenPlan("2.6466524123622457"))]);
  someEq(ledgerEq, ledgerOfMsg(stateOf(g.reply)), Some({mEffKg: 0.5, availableKg: 20000.0, radiatedJ: 0.0, boostJ: 0.0, dragJ: 0.0})) &&
  someEq(ledgerEq, ledgerOfMsg(stateOf(b.reply)), Some({mEffKg: 0.5, availableKg: 20000.0, radiatedJ: wb.ledger.boostJ, boostJ: wb.ledger.boostJ, dragJ: 0.0})) &&
  wb.ledger.boostJ == photonDriveEnergy(0.5, wb.ship.motion.phi) &&
  someEq(ledgerEq, ledgerOfMsg(stateOf(c.reply)), Some({mEffKg: 0.5, availableKg: 20000.0, radiatedJ: wc.ledger.boostJ + wc.ledger.dragJ, boostJ: wc.ledger.boostJ, dragJ: wc.ledger.dragJ})) &&
  wc.ledger.dragJ > 0.0 && !none(ledgerOfMsg(stateOf(r.reply))) && none(ledgerOfMsg(stateOf(still.reply))) &&
  match viewOf(stateOf(pe.reply)) { Some(v) => v.energy.boostJ == photonDriveEnergy(0.5, 2.6466524123622457) && v.energy.totalJ == 2.0 * v.energy.boostJ + v.energy.dragJ, None => false }
}

-- ------------------------------------------------- M2.3b autopilot over the wire
-- A committed alpha Cen journey flown in one 1-yr tick: four `phase` events
-- (from, to, tau) and one `arrived` event (residuals), bit for bit core's;
-- the journey section turns `arrived`, the ship rests at the target.
pure func eventKinds(es: [Event]) -> string = join(",", map(\e. e.kind, es))
pure func checkArrivalOnWire() -> bool {
  let g = feed(newSession(), [hello(), playGame(), tickLine(1, "0", acenPlan("2.6466524123622457")), tickLine(2, "0", "{\"k\":\"commit\",\"plan_id\":1}")]);
  let a = feed(g.session, [tickLine(3, "1", "")]);
  let m = stateOf(a.reply);
  let rq = {target: {index: 1, id: "Gl 559", pos: {x: 0.0, y: 0.0, z: -4.37}}, cruisePhi: 2.6466524123622457, flipG: None};
  let w = tick(tick(newWorld(7, false, defaultParams()), {dtau: 0.0, intents: [IPlan(rq)]}).world, {dtau: 0.0, intents: [ICommit(1)]}).world;
  let t = tick(w, {dtau: 1.0, intents: []});
  m.status == "ok" && jstate(m) == "arrived:1" && allEq(eventEq, m.events, t.events) &&
  eventKinds(m.events) == "phase,phase,phase,phase,arrived" &&
  (match m.ship { Some(s) => s.phase == "at_rest" && veq(s.pos, {x: 0.0, y: 0.0, z: -4.37}) && feq(s.beta, 0.0), None => false }) &&
  (match m.ledger { Some(l) => feq(l.boostJ, t.world.ledger.boostJ) && feq(l.dragJ, t.world.ledger.dragJ) && l.dragJ > 0.0, None => false })
}

-- M2.4: diag draws come back as `draw` events {stream, n, value = top 53
-- bits} with an `rng` change-set naming the counters; the full state
-- carries the zero counters; no draw, no rng section; outside diag a draw is
-- refused diag_only; an unknown stream name is a malformed intent.
pure func drawWire(st: Stream, name: string, n: int) -> string =
  join("", ["{\"k\":\"draw\",\"stream\":\"", name, "\",\"n\":", show(n), ",\"value\":", show(top53(value(7, st, n))), "}"])
pure func rngIs(o: Option[Rng], want: Rng) -> bool = match o { Some(r) => rngEq(r, want), None => false }
pure func checkDrawOnWire() -> bool {
  let g = feed(newSession(), [hello(), diagGame()]);
  let full = stateOf(g.reply);
  let draws = "{\"k\":\"draw\",\"stream\":\"news\"},{\"k\":\"draw\",\"stream\":\"news\"},{\"k\":\"draw\",\"stream\":\"journey\"}";
  let d = feed(g.session, [tickLine(1, "0", draws)]);
  let dm = stateOf(d.reply);
  let quiet = stateOf(feed(d.session, [tickLine(2, "0", "")]).reply);
  let more = stateOf(feed(d.session, [tickLine(2, "0", "{\"k\":\"draw\",\"stream\":\"news\"}")]).reply);
  let play = stateOf(feed(newSession(), [hello(), playGame(), tickLine(1, "0", "{\"k\":\"draw\",\"stream\":\"news\"}")]).reply);
  let zero = {journey: 0, crew: 0, events: 0, galaxy: 0, ai: 0, news: 0};
  rngIs(full.rng, zero) &&
  dm.status == "ok" && rngIs(dm.rng, {zero | news: 2, journey: 1}) && allEq(refusalEq, dm.refused, []) &&
  contains(d.reply, join("", ["\"events\":[", drawWire(SNews, "news", 0), ",", drawWire(SNews, "news", 1), ",", drawWire(SJourney, "journey", 0), "]"])) &&
  contains(d.reply, "{\"k\":\"draw\",\"stream\":\"news\",\"n\":0,\"value\":5208588083530661}") &&
  contains(d.reply, "\"rng\":{\"journey\":1,\"crew\":0,\"events\":0,\"galaxy\":0,\"ai\":0,\"news\":2}") &&
  quiet.status == "ok" && none(quiet.rng) && allEq(eventEq, quiet.events, []) &&
  rngIs(more.rng, {zero | news: 3, journey: 1}) && contains(encodeState(more), drawWire(SNews, "news", 2)) &&
  play.status == "ok" && none(play.rng) && allEq(refusalEq, play.refused, [{i: 0, reason: "diag_only"}]) && allEq(eventEq, play.events, []) &&
  code(intent("{\"k\":\"draw\",\"stream\":\"bogus\"}")) == "bad_intent" && code(intent("{\"k\":\"draw\",\"stream\":1}")) == "bad_intent" &&
  code(intent("{\"k\":\"draw\",\"stream\":\"ai\"}")) == "ok"
}
-- ------------------------------------------------- M2.6b UI inputs
-- The params echo carries the planner's cruise-rapidity bounds and the D-14
-- default bit for bit (phi09 = rapidityOfBeta 0.9, the cap, phi099), so the
-- slider does no rapidity maths; they also follow a cruise_min_beta override.
pure func echoes(reply: string, k: string, v: float) -> bool = contains(reply, join("", ["\"", k, "\":", num(v), ","])) || contains(reply, join("", ["\"", k, "\":", num(v), "}"]))
pure func checkPhiBoundsEcho() -> bool {
  let r = feed(newSession(), [hello(), playGame()]).reply;
  let d = defaultParams();
  let o = feed(newSession(), [hello(), newGame("\"seed\":7,\"scenario\":\"sol\",\"diag\":false,\"params\":{\"cruise_min_beta\":0.995}")]).reply;
  let od = {d | cruiseMinBeta: 0.995};
  cruisePhiMin(d) == 1.4722194895832204 && cruisePhiDefault(d) == 2.6466524123622457 && cruisePhiMax(d) == 7.254328619262047 &&
  echoes(r, "cruise_phi_min", 1.4722194895832204) && echoes(r, "cruise_phi_max", 7.254328619262047) && echoes(r, "cruise_phi_default", 2.6466524123622457) &&
  cruisePhiDefault(od) == cruisePhiMin(od) && cruisePhiMin(od) > 2.6466524123622457 && echoes(o, "cruise_phi_default", cruisePhiMin(od)) && echoes(o, "cruise_phi_min", cruisePhiMin(od))
}
-- ship.flown is x - x0: 0 at the commit, the distance flown since it
-- mid-cruise (bit for bit core's), 0 again after arrival (the line is
-- rebased at the target, so the UI must not read progress from ship.x there).
pure func shipFlown(m: StateMsg) -> float = match m.ship { Some(v) => v.flown, None => 0.0 - 1.0 }
pure func checkFlownOnWire() -> bool {
  let g = feed(newSession(), [hello(), playGame(), tickLine(1, "0", acenPlan("2.6466524123622457")), tickLine(2, "0", "{\"k\":\"commit\",\"plan_id\":1}")]);
  let mid = feed(g.session, [tickLine(3, "0.3", "")]);
  let end = feed(mid.session, [tickLine(4, "1", "")]);
  let rq = {target: {index: 1, id: "Gl 559", pos: {x: 0.0, y: 0.0, z: -4.37}}, cruisePhi: 2.6466524123622457, flipG: None};
  let w = tick(tick(newWorld(7, false, defaultParams()), {dtau: 0.0, intents: [IPlan(rq)]}).world, {dtau: 0.0, intents: [ICommit(1)]}).world;
  let wm = tick(w, {dtau: 0.3, intents: []}).world;
  let fm = shipFlown(stateOf(mid.reply));
  none(stateOf(mid.reply).journey) && feq(fm, wm.ship.motion.x - wm.ship.x0) && fm > 2.0 && fm < 4.37 &&
  jstate(stateOf(end.reply)) == "arrived:1" && feq(shipFlown(stateOf(end.reply)), 0.0)
}

-- ------------------------------------------------- 2.1 AI codecs (AI.2)
pure func hexA() -> string = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
pure func fullOpen() -> AiOpen = { kind: "portrait", purpose: "archive", entityId: "medic_2", emotion: Some("grieving"), ageStage: Some(50.0),
  lineReq: Some("9007199254740991"), emotions: Some(["neutral", "loving", "grieving"]),
  context: [{name: "topic", value: CStr("first night aboard \"Ä\" \\ ✓")}, {name: "canon", value: CList(["archive.two-clocks", "archive.ψ"])}, {name: "empty", value: CList([])}] }
pure func aiIntents() -> [Intent] =
  [IAiOpen(fullOpen()), IAiOpen({ kind: "x", purpose: "", entityId: "Not An Id", emotion: None, ageStage: Some(negZero()), lineReq: None, emotions: Some([]), context: [] }),
   IAiOpen({ kind: "text", purpose: "line", entityId: "medic", emotion: None, ageStage: None, lineReq: None, emotions: None, context: [] })] ++
  map(\r. IAiCancel({req: "7", reason: r}), cancelReasons()) ++ [IAiCancel({req: "never-opened", reason: "budget"})]
pure func aiInputs() -> [Input] =
  [GInput({tick: 5, dtau: 0.0, intents: aiIntents()}), GNewGame({seed: 1, scenario: "sol", diag: false, params: [{name: "ai_max_open", value: 64.0}, {name: "ai_ttl_ticks", value: 1.0}], aiCore: Some(hexA())})]
-- The design's ai_request example, byte for byte.
pure func exampleRequest() -> AiRequest = { req: "7", kind: "text", purpose: "line", lineReq: None,
  key: { kind: "text", entityId: "medic", emotion: "-", ageStage: 0, variant: "-" }, seed: 123456789012345,
  constraints: { maxChars: 280, noNumerals: true, emotions: ["neutral", "loving", "grieving"] },
  context: [{name: "topic", value: CStr("first_night_aboard")}, {name: "canon", value: CList(["archive.two-clocks"])}], expiresTick: 3607 }
pure func exampleWire() -> string =
  "{\"k\":\"ai_request\",\"req\":\"7\",\"kind\":\"text\",\"purpose\":\"line\",\"key\":{\"kind\":\"text\",\"entity_id\":\"medic\",\"emotion\":\"-\",\"age_stage\":0,\"variant\":\"-\"},\"seed\":123456789012345,\"constraints\":{\"max_chars\":280,\"no_numerals\":true,\"emotions\":[\"neutral\",\"loving\",\"grieving\"]},\"context\":{\"topic\":\"first_night_aboard\",\"canon\":[\"archive.two-clocks\"]},\"expires_tick\":3607}"
pure func aiEv(e: AiEvent, k: string) -> Event = {event(k) | ai: Some(e)}
pure func descriptor() -> Json = JObject([kv("key", JObject([kv("kind", JString("voice"))])), kv("duration_ms", JNumber(5300.0)), kv("segments_ms", JArray([JNumber(0.0), JNumber(2100.0)])), kv("ok", JBool(true)), kv("none", JNull)])
pure func aiStates() -> [StateMsg] = [
  { tick: 9, status: "ok", clock: None, ship: None, journey: None, ledger: None, rng: Some({journey: 0, crew: 0, events: 0, galaxy: 0, ai: 3, news: 0}), params: None,
    ai: Some({lastReq: maxInt(), open: [{req: "1", kind: "text", expiresTick: 3601}, {req: "9007199254740991", kind: "portrait", expiresTick: maxInt()}], core: hexA()}),
    events: [aiEv(ERequest(exampleRequest()), "ai_request"),
      aiEv(ERequest({exampleRequest() | req: "8", kind: "voice", purpose: "line", lineReq: Some("7"), seed: maxInt(), context: [], constraints: {maxChars: 0, noNumerals: false, emotions: []}}), "ai_request"),
      aiEv(EAcceptedText({req: "7", kind: "text", sha256: hexA(), text: "Hello. I am the Medic, Ä ✓", segments: [{emotion: "neutral", text: "Hello."}, {emotion: "loving", text: "I am the Medic, Ä ✓"}]}), "ai_accepted"),
      aiEv(EAcceptedText({req: "10", kind: "text", sha256: hexA(), text: "", segments: []}), "ai_accepted"),
      aiEv(EAcceptedMedia({req: "8", kind: "voice", sha256: hexA(), descriptor: descriptor()}), "ai_accepted"),
      aiEv(EFallback({req: "7", reason: "expired"}), "ai_fallback"), aiEv(EFallback({req: "9", reason: "ai_hash"}), "ai_fallback")],
    refused: [{i: 0, reason: "ai_too_many"}], full: false },
  { tick: 1, status: "ok", clock: None, ship: None, journey: None, ledger: None, rng: None, params: None, ai: Some({lastReq: 0, open: [], core: ""}), events: [], refused: [], full: false }
]
pure func aiOpenLine(body: string) -> string = intent(join("", ["{\"k\":\"ai_open\",", body, "}"]))
pure func okOpen() -> string = "\"kind\":\"text\",\"purpose\":\"line\",\"entity_id\":\"medic\""
-- age_stage 1e400: bad_json since v0.52.0 (std/json refuses out-of-range numbers), see checkDecodeCodes.
pure func checkAiCodecs() -> bool =
  allTrue(map(roundTripInput, aiInputs())) && allTrue(map(roundTripState, aiStates())) &&
  contains(encodeState({tick: 1, status: "ok", clock: None, ship: None, journey: None, ledger: None, rng: None, params: None, ai: None, events: [aiEv(ERequest(exampleRequest()), "ai_request")], refused: [], full: false}),
    join("", ["\"events\":[", exampleWire(), "]"])) &&
  -- well-formed, whatever the values: value checks are refusals (sim/ai.ail), not decode errors
  code(aiOpenLine(okOpen())) == "ok" && code(aiOpenLine("\"kind\":\"warp\",\"purpose\":\"x\",\"entity_id\":\"BAD id\",\"age_stage\":1.5,\"emotions\":[]")) == "ok" &&
  code(aiOpenLine(join("", [okOpen(), ",\"context\":{\"a\":\"1\",\"b\":[],\"c\":\"3\",\"d\":\"4\",\"e\":\"5\",\"f\":\"6\",\"g\":\"7\",\"h\":[\"8\"]}"]))) == "ok" &&
  -- malformed fields stay bad_intent
  code(aiOpenLine("\"purpose\":\"line\",\"entity_id\":\"medic\"")) == "bad_intent" && code(aiOpenLine("\"kind\":\"text\",\"entity_id\":\"medic\"")) == "bad_intent" &&
  code(aiOpenLine("\"kind\":\"text\",\"purpose\":\"line\"")) == "bad_intent" && code(aiOpenLine("\"kind\":1,\"purpose\":\"line\",\"entity_id\":\"medic\"")) == "bad_intent" &&
  code(aiOpenLine(join("", [okOpen(), ",\"emotion\":null"]))) == "bad_intent" && code(aiOpenLine(join("", [okOpen(), ",\"age_stage\":\"0\""]))) == "bad_intent" &&
  code(aiOpenLine(join("", [okOpen(), ",\"age_stage\":1e400"]))) == "bad_json" && code(aiOpenLine(join("", [okOpen(), ",\"line_req\":7"]))) == "bad_intent" &&
  code(aiOpenLine(join("", [okOpen(), ",\"emotions\":\"neutral\""]))) == "bad_intent" && code(aiOpenLine(join("", [okOpen(), ",\"emotions\":[\"neutral\",1]"]))) == "bad_intent" &&
  code(aiOpenLine(join("", [okOpen(), ",\"context\":[]"]))) == "bad_intent" && code(aiOpenLine(join("", [okOpen(), ",\"context\":{\"a\":1}"]))) == "bad_intent" &&
  code(aiOpenLine(join("", [okOpen(), ",\"context\":{\"a\":{\"b\":\"c\"}}"]))) == "bad_intent" && code(aiOpenLine(join("", [okOpen(), ",\"context\":{\"a\":[\"x\",null]}"]))) == "bad_intent" &&
  code(aiOpenLine(join("", [okOpen(), ",\"context\":{\"a\":\"1\",\"b\":\"2\",\"c\":\"3\",\"d\":\"4\",\"e\":\"5\",\"f\":\"6\",\"g\":\"7\",\"h\":\"8\",\"i\":\"9\"}"]))) == "bad_intent" &&
  allTrue(map(\r. code(intent(join("", ["{\"k\":\"ai_cancel\",\"req\":\"1\",\"reason\":\"", r, "\"}"]))) == "ok", cancelReasons())) &&
  code(intent("{\"k\":\"ai_cancel\",\"req\":\"1\",\"reason\":\"expired\"}")) == "bad_intent" && code(intent("{\"k\":\"ai_cancel\",\"req\":\"1\",\"reason\":\"OFFLINE\"}")) == "bad_intent" &&
  code(intent("{\"k\":\"ai_cancel\",\"reason\":\"offline\"}")) == "bad_intent" && code(intent("{\"k\":\"ai_cancel\",\"req\":1,\"reason\":\"offline\"}")) == "bad_intent" &&
  code(intent("{\"k\":\"record\",\"source\":\"ai\",\"req\":1,\"kind\":\"text\",\"sha256\":\"00\",\"body\":\"x\"}")) == "bad_intent" &&
  -- new_game: ai_core is a sha256 (64 lowercase hex), else bad_game; the AI params are validated like M2's
  code(newGame(join("", ["\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"ai_core\":\"", hexA(), "\""]))) == "ok" &&
  code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"ai_core\":\"E3B0\"")) == "bad_game" &&
  code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"ai_core\":\"E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855\"")) == "bad_game" &&
  code(newGame("\"seed\":1,\"scenario\":\"sol\",\"diag\":true,\"ai_core\":7")) == "bad_game" &&
  accepts("ai_max_open", ["1", "64"]) && refuses("ai_max_open", ["0", "65", "1.5", "-1"]) &&
  accepts("ai_ttl_ticks", ["1", "1000000"]) && refuses("ai_ttl_ticks", ["0", "1000001", "2.5"])
-- AI.3, protocol 2.1 on the wire (AC1): the hello answers minor 1; every
-- full state echoes ai_max_open and ai_ttl_ticks as the last keys of params
-- and the ai section as the last section; ticks without AI intents still
-- carry no ai section and no AI key.
pure func checkHello21() -> bool {
  let r = feed(newSession(), [hello(), diagGame()]).reply;
  let hl = serve(newSession(), hello()).reply;
  let c = feed(newSession(), [hello(), newGame(join("", ["\"seed\":7,\"scenario\":\"sol\",\"diag\":true,\"params\":{\"ai_ttl_ticks\":9,\"ai_max_open\":3},\"ai_core\":\"", hexA(), "\""]))]);
  let quiet = feed(c.session, [tickLine(1, "0.5", "{\"k\":\"thrust\",\"thrust\":1}")]).reply;
  helloMsg().major == 2 && helloMsg().minor == 1 && startsWith(hl, "{\"v\":2,\"type\":\"hello\",\"proto\":{\"major\":2,\"minor\":1},") &&
  contains(r, "\"ai_max_open\":8,\"ai_ttl_ticks\":3600},\"ai\":{\"last_req\":0,\"open\":[],\"core\":\"\"}},\"events\":[],\"refused\":[],\"full\":true}") &&
  contains(c.reply, join("", ["\"ai_max_open\":3,\"ai_ttl_ticks\":9},\"ai\":{\"last_req\":0,\"open\":[],\"core\":\"", hexA(), "\"}},\"events\":[]"])) &&
  (match decodeState(c.reply) { Ok(m) => (match m.params { Some(p) => p.aiMaxOpen == 3 && p.aiTtlTicks == 9, None => false }) && (match m.ai { Some(a) => a.core == hexA() && a.lastReq == 0, None => false }), Err(_) => false }) &&
  !contains(quiet, "\"ai\":{") && !contains(quiet, "ai_")
}

pure func encodedFixtures() -> [string] = map(encodeInput, inputFixtures() ++ aiInputs()) ++ map(encodeState, stateFixtures() ++ aiStates()) ++ [encodeHello(helloMsg())]
export pure func protocolVm(n: int) -> string =
  if checkFloatText() && checkInputRoundTrip() && checkStateRoundTrip() && checkHelloRoundTrip() && checkDecodeCodes() && checkHandshake() && checkParamsEcho() && checkMalformedKeepsTick() && checkRefusedProceeds() && checkDiagKinematics() && checkChangeSets() && checkParamBounds() && checkEcho() &&
    checkParamRange() && checkMEffTooSmall() && checkClockFields() && checkPhaseOnWire() && checkJourneyOnWire() && checkAlphaCenPanel() && checkLedgerOnWire() && checkArrivalOnWire() && checkDrawOnWire() && checkPhiBoundsEcho() && checkFlownOnWire() &&
    checkAiCodecs() && checkHello21() && checkHello23() && checkSystemOnWire() && checkEpochJd() && checkSystemRoundTrip()
  then join("\n", encodedFixtures() ++ ["protocol-ok"]) else "protocol-BAD"

test "v2 float text is shortest round-trip incl -0.0 and 1e308" { checkFloatText() }
test "v2 decodeInput(encodeInput(x)) == x" { checkInputRoundTrip() }
test "v2 decodeState(encodeState(s)) == s" { checkStateRoundTrip() }
test "v2 hello round trip" { checkHelloRoundTrip() }
test "v2 reason codes stable" { checkDecodeCodes() }
test "v2 hello first, no state before hello" { checkHandshake() }
test "v2 params echoed in full state" { checkParamsEcho() }
test "v2 malformed line keeps tick" { checkMalformedKeepsTick() }
test "v2 refused intent proceeds" { checkRefusedProceeds() }
test "v2 diag adapter equals core" { checkDiagKinematics() }
test "v2 change-sets" { checkChangeSets() }
test "v2 every scenario-parameter bound" { checkParamBounds() }
test "v2 diag echo hook round trip" { checkEcho() }
test "M2.2 each param out of range is bad_params, game unchanged" { checkParamRange() }
test "M2.2 m_eff 0.03 refused m_eff_too_small, 0.033 accepted" { checkMEffTooSmall() }
test "M2.2 clock year = epoch + t, age = start_age + tau" { checkClockFields() }
test "M2.2 ship phase on the wire" { checkPhaseOnWire() }
test "M2.3a journey section: idle, planned panel, committed, frozen" { checkJourneyOnWire() }
test "M2.3a alpha Cen 0.99c panel on the wire" { checkAlphaCenPanel() }
test "M2.3a ledger section with m_eff 0.5" { checkLedgerOnWire() }
test "M2.4 draw events, rng change-set, diag only, unknown stream malformed" { checkDrawOnWire() }
test "M2.6b params echo carries the cruise-rapidity bounds and default" { checkPhiBoundsEcho() }
test "M2.6b ship.flown: distance since the commit, 0 after arrival" { checkFlownOnWire() }
test "AC2 2.1 AI codecs round-trip; malformed fields stay bad_intent" { checkAiCodecs() }
test "AC1 protocol 2.1: hello minor 1, AI params last in params, ai section last in full states" { checkHello21() }

-- ------------------------------------------------- M5.1b, protocol 2.3: the system section
-- The minor is read from systemMinor(), never written as a literal (sprint F4:
-- whichever of M4 and M5 merges second takes the next minor).
pure func helloWant(m: int) -> string = join("", ["{\"v\":2,\"type\":\"hello\",\"want\":{\"major\":2,\"minor\":", show(m), "}}"])
pure func sysGame(params: string) -> string = newGame(join("", ["\"seed\":7,\"scenario\":\"sol\",\"diag\":true", params]))
pure func helloMinor(want: int) -> int = match decodeHello(serve(newSession(), helloWant(want)).reply) { Ok(g) => g.minor, Err(_) => -1 }
export pure func checkHello23() -> bool =
  helloMinor(systemMinor()) == systemMinor() && helloMinor(systemMinor() + 7) >= systemMinor() && helloMinor(systemMinor() + 7) <= systemMinor() + 7 && helloMinor(2) == 2 && helloMinor(1) == 1 && helloMinor(0) == 1
  && helloFor(systemMinor()).minor == systemMinor() && systemMinor() >= 3
test "2.3 hello: want >= systemMinor() is answered at least systemMinor() (2.4 takes the next); 2, 1 and 0 as before" { checkHello23() }

-- Below the system minor the stream never carries `system`; at it, the full state
-- and every tick that moved the clock or the ship do; a tick that moved nothing does not.
pure func sysReplies(want: int, params: string) -> [string] {
  let a = serve(newSession(), helloWant(want));
  let g = serve(a.session, sysGame(params));
  let t1 = serve(g.session, tickLine(1, "0", ""));
  let t2 = serve(t1.session, tickLine(2, "0.25", ""));
  let t3 = serve(t2.session, tickLine(3, "0", "{\"k\":\"thrust\",\"thrust\":0}"));
  [g.reply, t1.reply, t2.reply, t3.reply]
}
pure func hasSystem(r: string) -> bool = contains(r, "\"system\":{")
export pure func checkSystemOnWire() -> bool {
  let r3 = sysReplies(systemMinor(), "");
  let r2 = sysReplies(2, "");
  map(hasSystem, r3) == [true, false, true, false] && map(hasSystem, r2) == [false, false, false, false]
  && map(\r. status(r), r3) == ["ok", "ok", "ok", "ok"]
  && (match r3 { g :: _ => contains(g, "\"system\":{\"jd\":2451545,\"ephemeris\":\"jpl-approx\",\"frame\":\"galactic\",\"bodies\":[{\"id\":\"sun\"")
      && !contains(g, "epoch_jd"), [] => false })
  && (match r3 { _ :: _ :: t2 :: _ => contains(t2, "\"system\":{\"jd\":2451636.3125,"), _ => false })
}
test "2.3 system section: in the full state and on ticks that move the clock; never below the system minor" { checkSystemOnWire() }

-- epoch_jd is a scenario parameter (D-12): it sets system.jd, stays out of the params echo, and is range-checked.
export pure func checkEpochJd() -> bool {
  let ok = sysReplies(systemMinor(), ",\"params\":{\"epoch_jd\":2460251.5}");
  let bad = serve(serve(newSession(), helloWant(systemMinor())).session, sysGame(",\"params\":{\"epoch_jd\":1.5e9}"));
  (match ok { g :: _ => contains(g, "\"system\":{\"jd\":2460251.5,") && !contains(g, "epoch_jd"), [] => false })
  && status(bad.reply) == "bad_params" && defaultParams().epochJd == defaultEpochJd()
}
test "2.3 epoch_jd sets system.jd, is not echoed, and 1.5e9 is bad_params" { checkEpochJd() }

-- decodeSystem(encodeSystem(v)) re-encodes to the same bytes (every field, -0.0 and exponents kept by num).
pure func sysText(v: SystemView) -> string = encodeSystem(v)
export pure func checkSystemRoundTrip() -> bool {
  let views = [systemAt(solSystem(), defaultEpochJd(), {x: 0.0, y: 0.0, z: 0.0}), systemAt(solSystem(), 2460251.5, {x: 0.00001, y: 0.0 - 0.000002, z: 4.2}),
    systemAt(solSystem(), 2451545.0 + 365.25 * 5000.0, {x: 0.0, y: 0.0, z: 0.0})];
  foldl(\acc v. acc && (match decodeSystem(sysText(v)) { Ok(w) => sysText(w) == sysText(v) && w.ephemeris == v.ephemeris, Err(_) => false }), true, views)
  && (match decodeSystem("{\"jd\":1,\"ephemeris\":\"jpl-approx\",\"frame\":\"galactic\",\"bodies\":[{\"id\":\"x\"}]}") { Err(c) => c == "bad_state", Ok(_) => false })
}
test "2.3 decodeSystem(encodeSystem(v)) re-encodes byte for byte; a body missing fields is bad_state" { checkSystemRoundTrip() }
