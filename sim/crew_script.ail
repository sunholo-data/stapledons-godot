module stapledons/sim/crew_script

-- R2-CREW C1: scripted crew sessions for `make strict` (AC4) and `make crew-parity` (AC3).
-- A script is what a captain does: crew_core command lines (an `ask` is answered at once by the
-- authored policy, drawing on the crew stream) and ship-days passing. Running one through
-- sim/crew.ail yields the lines the sim fed crew_core and its journal records.
--   consent  offer, ask (authored answer), start, the scheduled ship event, a check-in
--   orders   start without consent, a check-in
--   shipevent C3: a run-time arrival event (signal +1) and a news burst of loss after a switch to
--            orders, both as crew_core ship_event lines
--   argument the analyst (from tick 1) and the medic (from tick 2) hold signal when
--            `earth_recedes` (tick 3) takes 2 and only 1 is free
import std/string (concat, join, intToStr)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/crypto (sha256Hex)
import ./crew (CrewState, CrewStepped, CrewHold, CrewCmd, initCrewWith, crewStep, crewCommand, consoleCmds, daysPerYear, crewTurn, shipEventLine, startTaskLine)
import pkg/sunholo/crew_core/conversations (Issue, suggestions)
import pkg/sunholo/crew_core/session (moot)
import std/json (encode, jo, kv, js, jint)
import ./crew_events (noMoments, shipEvents)
import ./crew_auto (setPreset, autoStep)
import ./cruise_digest (nextStop, stopYears)
import ./core (World, Params, Intent, ICrew, IPlan, ICommit, Event, newWorld, defaultParams, tick)
import ./protocol_interlude (cruiseStop, encodeDigest)
import ./rng (Rng, SCrew, zeroRng, counter)
import std/math (intToFloat)

-- R2-CREW-CONSOLE-V2 V1: STick is one tick's console intents (sim/crew.ail consoleCmds: an offer
-- with `start`, a start `as` orders); SReply answers a member's open concern with crew_core's first
-- suggested approach, at the crew's current tick and revision, as the console does.
export type Step = SCmd(string, Option[string]) | SDays(int) | STick([CrewCmd]) | SReply(string)
export type Script = { name: string, captaincy: string, steps: [Step] }
export type Ran = { start: string, lines: [string], traces: [string], turn: int, crewDraws: int, refused: Option[string] }

pure func offer(worker: string, id: string) -> Step =
  SCmd(concat(["{\"command\":\"offer\",\"worker\":\"", worker, "\",\"recipe\":\"work_", worker, "\",\"id\":\"", id, "\"}"]), None)
pure func ask(actor: string, task: string, id: string) -> Step =
  SCmd(concat(["{\"command\":\"ask\",\"actor\":\"", actor, "\",\"task\":\"", task, "\",\"id\":\"", id, "\"}"]), Some(id))
pure func begin(task: string) -> Step = SCmd(concat(["{\"command\":\"start_task\",\"task\":\"", task, "\"}"]), None)
pure func shipEvent(m: {arrive: bool, news: bool}, tick: int) -> [Step] =
  map(\e. SCmd(shipEventLine(e), None), shipEvents({ noMoments(tick) | arrivedPlan: if m.arrive then Some(1) else None, newsTemplate: if m.news then Some(8) else None }))
pure func policy(p: string) -> Step = SCmd(concat(["{\"command\":\"policy\",\"policy\":\"", p, "\"}"]), None)

pure func cmd(kind: string, line: string, ask: Option[string], asMode: string, startMode: string) -> CrewCmd = { kind: kind, line: line, askId: ask, asMode: asMode, startMode: startMode }
pure func offerC(worker: string, id: string, start: string) -> CrewCmd =
  cmd("crew_offer", concat(["{\"command\":\"offer\",\"worker\":\"", worker, "\",\"recipe\":\"work_", worker, "\",\"id\":\"", id, "\"}"]), None, "", start)
pure func askC(actor: string, task: string, id: string) -> CrewCmd =
  cmd("crew_ask", concat(["{\"command\":\"ask\",\"actor\":\"", actor, "\",\"task\":\"", task, "\",\"id\":\"", id, "\"}"]), Some(id), "", "")
pure func startAsC(task: string, mode: string) -> CrewCmd = cmd("crew_start", startTaskLine(task), None, mode, "")
-- The captain's reply to `worker`'s open concern (the first suggestion), or a line crew_core refuses.
pure func replyLine(c: CrewState, worker: string) -> string = match keep(\i. i.worker == worker && i.status == "open" && !moot(c.session, i), c.session.chat.issues) {
  i :: _ => match suggestions(i, 1) {
    o :: _ => encode(jo([kv("command", js("captain_reply")), kv("id", js(concat(["say-", i.task]))), kv("issue", js(i.id)), kv("text", js(o.text)), kv("approach", js(o.approach)),
      kv("tick", jint(c.session.state.tick)), kv("revision", jint(c.session.state.revision))])),
    [] => "{\"command\":\"captain_reply\"}"
  },
  [] => "{\"command\":\"captain_reply\"}"
}
pure func offerAll() -> [CrewCmd] = flat(map(\w. [offerC(w, concat(["t-", w]), "on_accept"), askC(w, concat(["t-", w]), concat(["r-", w]))], ["medic", "engineer", "analyst", "pilot", "counselor"]))
pure func flat(xss: [[a]]) -> [a] = match xss { [] => [], xs :: r => xs ++ flat(r) }

export pure func scripts() -> [Script] = [
  { name: "consent", captaincy: "consent", steps: [offer("medic", "t1"), ask("medic", "t1", "r1"), begin("t1"), SDays(1), ask("medic", "t1", "c1"), SDays(5)] },
  { name: "orders", captaincy: "orders", steps: [offer("engineer", "t1"), begin("t1"), SDays(2), ask("engineer", "t1", "c1"), SDays(5)] },
  { name: "shipevent", captaincy: "consent", steps: [offer("pilot", "t1"), ask("pilot", "t1", "r1"), SDays(1), policy("orders")] ++ shipEvent({arrive: true, news: false}, 2)
      ++ [SDays(1)] ++ shipEvent({arrive: false, news: true}, 3) ++ [SDays(2)] },
  { name: "argument", captaincy: "orders", steps: [SDays(1), offer("analyst", "t1"), begin("t1"), SDays(1), offer("medic", "t2"), begin("t2"), SDays(3)] },
  consoleV2()
]
-- R2-CREW-CONSOLE-V2 V1 (AC5): the console's session under consent. The pilot and the medic are
-- offered with start on_accept in one tick (at the fixture seed the medic agrees and starts, the
-- pilot raises a concern); the captain answers the concern, then orders the pilot's work over it
-- (start as orders: refused_order, the ship default stays consent); the engineer is offered with
-- start now (an order whatever they say); then two days pass.
export pure func consoleV2() -> Script = { name: "console_v2", captaincy: "consent", steps: [
  STick(offerAll()),
  SReply("pilot"),
  SDays(4),
  STick([startAsC("t-pilot", "orders")]),
  STick([offerC("engineer", "t-engineer-2", "now"), askC("engineer", "t-engineer-2", "r-engineer-2")]),
  SDays(2)] }

-- A ship-day count as ship-years, a hair over so floor() lands on the whole day.
pure func years(days: int) -> float = intToFloat(days) / daysPerYear() + 0.0000001

pure func run(c: CrewState, seed: int, rng: Rng, steps: [Step], lines: [string], traces: [string]) -> {crew: CrewState, rng: Rng, lines: [string], traces: [string], refused: Option[string]} =
  match steps {
    [] => { crew: c, rng: rng, lines: lines, traces: traces, refused: None },
    st :: rest => {
      let r = match st { SCmd(line, askId) => crewCommand(c, seed, rng, line, askId), SDays(n) => crewStep(c, seed, rng, years(n)),
        STick(cmds) => consoleCmds(c, seed, rng, cmds), SReply(worker) => crewCommand(c, seed, rng, replyLine(c, worker), None) };
      match r.refused {
        Some(e) => { crew: r.crew, rng: r.rng, lines: lines ++ r.lines, traces: traces ++ r.traces, refused: Some(e) },
        None => run(r.crew, seed, r.rng, rest, lines ++ r.lines, traces ++ r.traces)
      }
    }
  }

-- Run a script on a traced crew (crew_core keeps its journal records).
export pure func runScript(s: Script, seed: int) -> Result[Ran, string] = match initCrewWith(s.captaincy, true) {
  Err(e) => Err(e),
  Ok((c, t0)) => {
    let r = run(c, seed, zeroRng(), s.steps, [], []);
    Ok({ start: t0, lines: r.lines, traces: r.traces, turn: crewTurn(r.crew), crewDraws: counter(r.rng, SCrew), refused: r.refused })
  }
}

-- The journal as crew_core.session.recording prints it: the start record, then one per line.
export pure func journal(r: Ran) -> string = join("\n", r.start :: r.traces)

-- `make strict` entry: every script on the strict VM; one digest line each.
export pure func crewScripted(seed: int) -> string = join(" | ", map(\s. match runScript(s, seed) {
  Err(e) => concat([s.name, " error ", e]),
  Ok(r) => concat([s.name, " turn ", intToStr(r.turn), " lines ", intToStr(length(r.lines)), " draws ", intToStr(r.crewDraws),
    match r.refused { Some(e) => concat([" refused ", e]), None => "" }, " sha ", sha256Hex(journal(r))])
}, scripts()))

pure func map(f: a -> b, xs: [a]) -> [b] = match xs { [] => [], x :: r => f(x) :: map(f, r) }
pure func length(xs: [a]) -> int = match xs { [] => 0, _ :: r => 1 + length(r) }

-- R2-CREW C8, AC11 (`make crew-perf`): a long skip under auto-run (critical_only, monthly check-ins
-- on a committed leg, D-76), untraced, in one sim tick of `years` ship-years. Prints the crew days
-- run, the holds raised and the auto turns.
export pure func crewSkip(years: int) -> string = match initCrewWith("orders", false) {
  Err(e) => e,
  Ok((c, _)) => {
    let on = setPreset(c, 3, zeroRng(), "critical_only");
    let r = autoStep(on.crew, 3, on.rng, intToFloat(years) + 0.0000001, false);
    concat(["days ", intToStr(r.stepped.crew.turn), " holds ", intToStr(length(r.holds)),
      match r.stepped.refused { Some(e) => concat([" refused ", e]), None => "" }])
  }
}
-- The worst case for AC11: auto-run with no escalation rules, so it never stops for a hold.
export pure func crewSkipUnheld(years: int) -> string = match initCrewWith("orders", false) {
  Err(e) => e,
  Ok((c, _)) => {
    let on = { c | auto: Some({ preset: "unheld", rules: [], st: { seed: 77, agreed: [], raised: [], calls: 0 } }) };
    let r = autoStep(on, 3, zeroRng(), intToFloat(years) + 0.0000001, false);
    concat(["days ", intToStr(r.stepped.crew.turn), " holds ", intToStr(length(r.holds)),
      match r.stepped.refused { Some(e) => concat([" refused ", e]), None => "" }])
  }
}

-- R2-INTERLUDE I1, AC6 (`make crew-perf`, sim/tools/crew_perf.ail crewSkipChunked): a crossing stepped
-- as the host steps it, one chunk per sim tick to the next stop (sim/cruise_digest.ail nextStop),
-- `endDay` crew days in all. `resume`: the captain resumes each hold at once (the next chunk is the
-- next check-in); otherwise an open hold leaves only cap-sized plain chunks.
export type Chunked = { crew: CrewState, rng: Rng, holds: [CrewHold], kind: string }
export pure func chunkStep(c: CrewState, rng: Rng, endDay: int, resume: bool) -> Chunked {
  let s = nextStop(Some(c), stopYears(c.dayRem, endDay - c.turn));
  let r = autoStep(c, 3, rng, s.years, false);
  { crew: if resume then { r.stepped.crew | holds: [] } else r.stepped.crew, rng: r.stepped.rng, holds: r.holds, kind: s.kind }
}
-- The perf cases' crews: "busy" is crewSkipUnheld's (orders, auto-run with no escalation rules:
-- the crew busy for the whole decade); "critical_only" is the game's default (consent captaincy,
-- the lab's rules, D-70 OQ5 and ruling 4).
export pure func chunkCrew(which: string) -> Result[CrewState, string] =
  if which == "busy" then (match initCrewWith("orders", false) {
    Err(e) => Err(e),
    Ok((c, _)) => Ok({ c | auto: Some({ preset: "unheld", rules: [], st: { seed: 77, agreed: [], raised: [], calls: 0 } }) })
  }) else match initCrewWith("consent", false) {
    Err(e) => Err(e),
    Ok((c, _)) => Ok((setPreset(c, 3, zeroRng(), which)).crew)
  }

-- R2-INTERLUDE I2 (AC1-AC4): a scripted crossing for the digest. A year crossed at 0.99c on a 70 ly
-- leg through the measured medium (lism-1), with the game's consent captaincy: auto-run is hands_on
-- from the commit until its first hold, which the captain resumes at once, turning auto-run to
-- critical_only (the game's default) for the rest. The host steps each next stop
-- (sim/protocol_interlude.ail cruiseStop) and resumes every hold the tick it is raised. `digests`
-- is the encoded digest after each chunk (the crossing_hold recording, make crew-parity).
pure func farLeg() -> Intent = IPlan({ target: { index: 2, id: "far", pos: { x: 0.0, y: 0.0, z: 0.0 - 70.0 } }, cruisePhi: 2.6466524123622457, flipG: None, star: None })
pure func ordersI(preset: string) -> Intent = ICrew({ kind: "crew_orders", line: "{\"command\":\"orders\",\"preset\":\"${preset}\"}", askId: None, asMode: "", startMode: "" })
pure func resumeI(id: string) -> Intent = ICrew({ kind: "crew_resume", line: "{\"command\":\"resume\",\"hold\":\"${id}\"}", askId: None, asMode: "", startMode: "" })
pure func holdIds(es: [Event]) -> [string] = map(\e. match e.crewHold { Some(h) => h.id, None => "" }, keep(\e. e.kind == "crew_hold", es))
pure func keep(p: a -> bool, xs: [a]) -> [a] = match xs { [] => [], x :: r => if p(x) then x :: keep(p, r) else keep(p, r) }
pure func turnIn(w: World) -> int = match w.crew { Some(c) => c.turn, None => 0 - 1 }
pure func digestText(w: World) -> string = match w.cruiseDigest { Some(d) => encodeDigest(d), None => "null" }
pure func resumeAll(w: World, hs: [string], after: string) -> World = match hs { [] => w, h :: r => resumeAll((tick(w, { dtau: 0.0, intents: [resumeI(h), ordersI(after)] })).world, r, after) }
export type Crossed = { world: World, holds: [string], digests: [string] }
-- Step to the next stop until crew day `endDay` (with `untilHold`, until the first hold).
pure func cross(x: Crossed, endDay: int, untilHold: bool, after: string, left: int) -> Crossed =
  if left <= 0 || turnIn(x.world) >= endDay then x else match cruiseStop(x.world) {
    None => x,
    Some(s) => {
      let r = tick(x.world, { dtau: s.years, intents: [] });
      let hs = holdIds(r.events);
      let w2 = resumeAll(r.world, hs, after);
      let y = { world: w2, holds: x.holds ++ hs, digests: x.digests ++ [digestText(w2)] };
      if untilHold && length(hs) > 0 then y else cross(y, endDay, untilHold, after, left - 1)
    }
  }
pure func lism() -> Params = { defaultParams() | ismModel: 1.0 }
-- The crew comes aboard without core.withCrew's generated names (members are named by role id):
-- the names table (sim/data/crew_names.ail nameRegions) is evaluator-only on the strict VM, whose
-- register allocator takes at most 256 in one literal (ailang#1736), and this runs under
-- --strict-bytecode. Nothing else differs (withCrew's pack lint is proven by the crew tests).
export pure func scriptedCrossing(seed: int) -> Crossed = match initCrewWith("consent", false) {
  Err(e) => { world: newWorld(seed, false, lism()), holds: [], digests: [concat(["error ", e])] },
  Ok((cr, _)) => {
    let w0 = { newWorld(seed, false, lism()) | crew: Some(cr) };
    let p = tick(w0, { dtau: 0.0, intents: [farLeg()] });
    let c = tick(p.world, { dtau: 0.0, intents: [ICommit(1), ordersI("hands_on")] });
    let a = cross({ world: c.world, holds: [], digests: [digestText(c.world)] }, 365, true, "critical_only", 400);
    cross(a, 365, false, "critical_only", 400)
  }
}
-- `make strict` entry (AC2): the scripted crossing on the strict VM; one line: chunks, holds, the
-- final digest's sha256.
export pure func digestScripted(seed: int) -> string = {
  let x = scriptedCrossing(seed);
  concat(["crossing chunks ", intToStr(length(x.digests)), " holds ", intToStr(length(x.holds)), " turn ", intToStr(turnIn(x.world)), " digest ", sha256Hex(digestText(x.world))])
}

-- `make strict` entry (R2-CREW-CONSOLE-V2 V1, AC5): the console session (consoleV2: offers that
-- start on agreement, a concern answered, an order over it, an offer that starts now) on the strict
-- VM; one line: turn, lines, crew draws, any refusal, the journal's sha256.
export pure func consoleScripted(seed: int) -> string = match runScript(consoleV2(), seed) {
  Err(e) => concat(["console_v2 error ", e]),
  Ok(r) => concat(["console_v2 turn ", intToStr(r.turn), " lines ", intToStr(length(r.lines)), " draws ", intToStr(r.crewDraws),
    match r.refused { Some(e) => concat([" refused ", e]), None => "" }, " sha ", sha256Hex(journal(r))])
}
