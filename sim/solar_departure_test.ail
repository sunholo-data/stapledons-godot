module stapledons/sim/solar_departure_test

import std/result (Ok, Err)
import std/option (Some, None)
import pkg/sunholo/celestial/kepler (sub, scale, norm, absf, dot)
import ./celestial (solSystem, bodyAt, lyKm)
import ./core (World, Target, Intent, ICommit, Planned, Arrived, newWorld, defaultParams, position, tick)
import ./solar_departure (initialize, earthStandoffKm, intentForLeg)

pure func fixtureTarget() -> Target = { index: 0, id: "CNS5:3627", pos: {x: 3.094521, y: 0.0 - 3.015404, z: 0.0 - 0.051608} }
pure func base() -> World = newWorld(42, false, defaultParams())
pure func started() -> World = match initialize(base()) { Ok(w) => w, Err(_) => base() }
export pure func checkInitial() -> bool =
  match bodyAt(solSystem(), "earth", (base()).params.epochJd) {
    None => false,
    Some(earth) => {
      let w = started();
      absf(norm(sub(scale(lyKm(), position(w.ship)), earth.pos)) - earthStandoffKm()) < 0.000001
      && w.ship.motion.phi == 0.0 && w.ship.motion.tau == 0.0 && w.ship.motion.t == 0.0 && w.tick == 0
      && dot(w.ship.heading, scale(1.0 / norm(earth.pos), earth.pos)) > 0.999999999
    }
  }
test "new demo starts exactly ten Earth radii away at rest, zero clocks" { checkInitial() }
export pure func checkUnsafe() -> bool {
  let w = base();
  match initialize({w | params: {w.params | bubbleRadiusM: 1000000000.0}}) { Err(e) => e == "unsafe_solar_start", Ok(_) => false }
}
test "an unsafe giant bubble is rejected rather than intersecting Earth" { checkUnsafe() }
export pure func checkNoReinitialize() -> bool {
  let existing = (tick(started(), {dtau: 0.000000001, intents: []})).world;
  match initialize(existing) { Err(e) => e == "solar_start_requires_new_session", Ok(_) => false }
}
test "initialization cannot reposition an existing simulation" { checkNoReinitialize() }
export pure func finishLeg(w: World, n: int) -> World =
  match intentForLeg(w, n, fixtureTarget()) {
    None => w,
    Some(intent) => {
      let planned = (tick(w, {dtau: 0.0, intents: [intent]})).world;
      match planned.journey {
        Planned(p) => {
          let committed = (tick(planned, {dtau: 0.0, intents: [ICommit(p.id)]})).world;
          (tick(committed, {dtau: p.trip.tauTotal, intents: []})).world
        },
        _ => planned
      }
    }
  }
pure func chain(w: World, n: int) -> bool =
  if n >= 3 then true else {
    let before = position(w.ship);
    let landed = finishLeg(w, n);
    match landed.journey {
      Arrived(c) => c.plan.from.x == before.x && c.plan.from.y == before.y && c.plan.from.z == before.z
        && position(landed.ship).x == c.plan.target.pos.x && position(landed.ship).y == c.plan.target.pos.y && position(landed.ship).z == c.plan.target.pos.z
        && landed.ship.motion.phi == 0.0 && landed.ship.motion.tau > w.ship.motion.tau && landed.ship.motion.t > w.ship.motion.t
        && landed.tick == w.tick + 3 && chain(landed, n + 1),
      _ => false
    }
  }
export pure func checkSequence() -> bool = chain(started(), 0)
test "Earth Jupiter Saturn outbound are true successive commits without resetting clocks or endpoints" { checkSequence() }
export pure func checkBounds() -> bool {
  let target = fixtureTarget();
  (match intentForLeg(started(), -1, fixtureTarget()) { None => true, _ => false })
  && (match intentForLeg(started(), 3, fixtureTarget()) { None => true, _ => false })
  && (match intentForLeg(started(), 2, {target | id: "wrong ID"}) { None => true, _ => false })
}
test "itinerary bounds and exact outbound identity are fail closed" { checkBounds() }
export pure func solarDepartureVm(n: int) -> string =
  if checkInitial() && checkUnsafe() && checkNoReinitialize() && checkSequence() && checkBounds() then "solar-departure-pure: OK" else "solar-departure-pure: FAIL"
