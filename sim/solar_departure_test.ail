module stapledons/sim/solar_departure_test

import std/result (Ok, Err)
import std/option (Option, Some, None)
import pkg/sunholo/celestial/kepler (sub, scale, norm, absf, dot)
import ./celestial (solSystem, bodyAt, lyKm)
import ./core (World, Target, Intent, ICommit, IPlanBody, Planned, Arrived, Plan, newWorld, defaultParams, position, tick, scenarioError, phaseName)
import pkg/sunholo/relativity/kinematics (rapidityOfBeta, rapidityOfOneMinusBeta)
import std/string (concat)
import ./solar_departure (TourLeg, initialize, initializeAtStandoff, earthStandoffKm, intentForLeg, legs, legCount, solCruisePhi, acenOneMinusBeta, trappistOneMinusBeta, aldebaranOneMinusBeta)
import ./navigation (safetyMinKm, bodyPhiMax)
import ./destination_stars (destinationStopKm, habitableZoneKm, destinationRadiusKm, destinationValue, destinationLy)
import ./protocol (finiteSystemOf)
import ./celestial (BodyView)
import pkg/sunholo/relativity/photometry (illuminanceFromV)
import ./data/sol (sun)

pure func fixtureTarget() -> Target = { index: 0, id: "CNS5:3627", pos: {x: 3.094521, y: 0.0 - 3.015404, z: 0.0 - 0.051608} }
-- Catalogue rows (data/starmap/stars.json, ly, galactic frame) for the outbound star legs.
pure func trappistTarget() -> Target = { index: 1, id: "Gaia DR3 2635476908753563008", pos: {x: 7.742, y: 20.946483, z: 0.0 - 33.930598} }
pure func aldebaranTarget() -> Target = { index: 2, id: "CNS5:1142", pos: {x: 0.0 - 62.516711, y: 0.0 - 1.060038, z: 0.0 - 23.064639} }
pure func targetFor(n: int) -> Target = if n == 6 then trappistTarget() else if n == 8 then aldebaranTarget() else fixtureTarget()
-- D-39/D-40 guided drive (demos/solar_departure.gd GUIDED_DRIVE mirrors it).
pure func guided() -> World {
  let w = newWorld(42, false, defaultParams());
  {w | params: {w.params | boostG: 3000000.0, mEffKg: 10.0, capOneMinusBeta: 0.000000002, standoffAu: 1000.0}}
}
pure func base() -> World = newWorld(42, false, defaultParams())
pure func started() -> World = match initialize(guided()) { Ok(w) => w, Err(_) => guided() }
export pure func checkInitial() -> bool =
  match bodyAt(solSystem(), "earth", (base()).params.epochJd) {
    None => false,
    Some(earth) => {
      let w = started();
      absf(norm(sub(scale(lyKm(), position(w.ship)), earth.pos)) - earthStandoffKm()) < 0.000001
      && w.ship.motion.phi == 0.0 && w.ship.motion.tau == 0.0 && w.ship.motion.t == 0.0 && w.tick == 0
      && dot(w.ship.heading, scale(1.0 / norm(earth.pos), earth.pos)) > 0.999999999
    }
  }
test "new demo starts exactly two Earth radii away at rest, zero clocks" { checkInitial() }
export pure func checkUnsafe() -> bool {
  let w = base();
  match initialize({w | params: {w.params | bubbleRadiusM: 1000000000.0}}) { Err(e) => e == "unsafe_solar_start", Ok(_) => false }
}
test "an unsafe giant bubble is rejected rather than intersecting Earth" { checkUnsafe() }
export pure func checkConfiguredStart() -> bool {
  let safe = 3.0 * 6378.1366;
  let minimum = safetyMinKm(6378.1366, (base()).params.bubbleRadiusM / 1000.0);
  (match initializeAtStandoff(base(), minimum - 1.0) { Err(e) => e == "unsafe_solar_start", _ => false })
  && (match initializeAtStandoff(base(), safe) {
    Ok(w) => match bodyAt(solSystem(), "earth", w.params.epochJd) {
      Some(b) => absf(norm(sub(scale(lyKm(), position(w.ship)), b.pos)) - safe) < 0.000001,
      None => false
    },
    Err(_) => false
  })
}
test "configured new Earth start accepts measured clearance and rejects below package minimum" { checkConfiguredStart() }
export pure func checkSunBoundary() -> bool {
  let w = started();
  let minimum = safetyMinKm((sun()).radiusKm, w.params.bubbleRadiusM / 1000.0);
  let request = IPlanBody({id: "sun", cruisePhi: rapidityOfBeta(0.002), mode: "stop", standoffKm: Some(minimum - 1.0), bKm: 0.0, clockDeg: 0.0, runOutKm: None, timing: None});
  let refused = tick(w, {dtau: 0.0, intents: [request]});
  match refused.refused { r :: _ => r.reason == "too_close" && norm(sub(position(refused.world.ship), position(w.ship))) == 0.0, [] => false }
}
test "bounded Sun adapter retains exact package minimum refusal and does not move ship" { checkSunBoundary() }
export pure func checkNoReinitialize() -> bool {
  let existing = (tick(started(), {dtau: 0.000000001, intents: []})).world;
  match initialize(existing) { Err(e) => e == "solar_start_requires_new_session", Ok(_) => false }
}
test "initialization cannot reposition an existing simulation" { checkNoReinitialize() }
export pure func finishLeg(w: World, n: int) -> World =
  match intentForLeg(w, n, targetFor(n)) {
    None => w,
    Some(intent) => {
      let planned = (tick(w, {dtau: 0.0, intents: [intent]})).world;
      match planned.journey {
        Planned(p) => {
          let committed = (tick(planned, {dtau: 0.0, intents: [ICommit(p.id)]})).world;
          (tick(committed, {dtau: p.trip.tauTotal, intents: []})).world
        },
        _ => planned
      }
    }
  }
pure func chain(w: World, n: int) -> bool =
  if n >= legCount() then true else {
    let before = position(w.ship);
    let landed = finishLeg(w, n);
    match landed.journey {
      Arrived(c) => c.plan.from.x == before.x && c.plan.from.y == before.y && c.plan.from.z == before.z
        && atStop(landed, c.plan)
        && landed.ship.motion.phi == 0.0 && landed.ship.motion.tau > w.ship.motion.tau && landed.ship.motion.t > w.ship.motion.t
        && landed.tick == w.tick + 3 && chain(landed, n + 1),
      _ => false
    }
  }
-- A body leg ends exactly on its planned point; a star leg ends at the catalogue
-- stand-off (1,000 AU short of the star, on the heading).
pure func atStop(w: World, p: Plan) -> bool =
  match p.nav {
    Some(_) => position(w.ship).x == p.target.pos.x && position(w.ship).y == p.target.pos.y && position(w.ship).z == p.target.pos.z,
    None => absf(norm(sub(p.target.pos, position(w.ship))) - 1000.0 * 149597870.7 / lyKm()) < 0.000000001
  }
export pure func checkSequence() -> bool = chain(started(), 0)
test "Earth to Aldebaran: every leg is a true successive commit without resetting clocks or endpoints" { checkSequence() }
-- D-39/D-40/D-41 cruise speeds, as exact 1 - beta (never 1 - beta computed near c).
pure func phiOf(n: int) -> float = match legs((guided()).params) { xs => phiAt(xs, n) }
pure func phiAt(xs: [TourLeg], n: int) -> float = match xs { [] => 0.0 - 1.0, x :: rest => if n == 0 then x.cruisePhi else phiAt(rest, n - 1) }
pure func idAt(xs: [TourLeg], n: int) -> string = match xs { [] => "", x :: rest => if n == 0 then x.id else idAt(rest, n - 1) }
export pure func checkSpeeds() -> bool {
  let sol = solCruisePhi();
  let xs = legs((guided()).params);
  sol == bodyPhiMax() && sol == rapidityOfBeta(0.99) && acenOneMinusBeta() == 0.001 && trappistOneMinusBeta() == 0.0001 && aldebaranOneMinusBeta() == 0.000001
  && legCount() == 10
  && phiOf(0) == sol && phiOf(1) == sol && phiOf(2) == sol && phiOf(3) == sol
  && phiOf(4) == rapidityOfOneMinusBeta(0.001) && phiOf(5) == sol
  && phiOf(6) == rapidityOfOneMinusBeta(0.0001) && phiOf(8) == rapidityOfOneMinusBeta(0.000001)
  && idAt(xs, 6) == "Gaia DR3 2635476908753563008" && idAt(xs, 7) == "trappist-1" && idAt(xs, 8) == "CNS5:1142" && idAt(xs, 9) == "aldebaran"
}
test "cruise speeds per leg: 0.99c Sol and A, 0.999c, 0.9999c, 0.999999c outbound" { checkSpeeds() }
export pure func checkGuidedDriveValid() -> bool = match scenarioError((guided()).params) { None => true, Some(_) => false }
test "the guided drive passes the unchanged brake-vs-drag scenario check" { checkGuidedDriveValid() }
export pure func checkDirectJupiterCollision() -> bool {
  let jupiter = finishLeg(finishLeg(started(), 0), 1);
  match intentForLeg(jupiter, 3, fixtureTarget()) {
    None => false,
    Some(intent) => {
      let result = tick(jupiter, {dtau: 0.0, intents: [intent]});
      match result.refused { r :: _ => r.reason == "collision" && norm(sub(position(result.world.ship), position(jupiter.ship))) == 0.0, [] => false }
    }
  }
}
test "direct close Jupiter to Saturn remains collision refused, requiring a genuine clearance leg" { checkDirectJupiterCollision() }
export pure func checkBounds() -> bool {
  let target = fixtureTarget();
  (match intentForLeg(started(), -1, fixtureTarget()) { None => true, _ => false })
  && (match intentForLeg(started(), legCount(), fixtureTarget()) { None => true, _ => false })
  && (match intentForLeg(started(), 6, aldebaranTarget()) { None => true, _ => false })
  && (match intentForLeg(started(), 4, {target | id: "wrong ID"}) { None => true, _ => false })
}
test "itinerary bounds and exact outbound identity are fail closed" { checkBounds() }
-- D-46 timed legs: each in-system leg boosts for 30 s, cruises about 60 s,
-- and ends with a 25 s final approach; the thrust differs per leg.
pure func planned(w: World, n: int) -> Option[Plan] =
  match intentForLeg(w, n, targetFor(n)) {
    None => None,
    Some(intent) => match ((tick(w, {dtau: 0.0, intents: [intent]})).world).journey { Planned(p) => Some(p), _ => None }
  }
pure func secs(y: float) -> float = y * 31557600.0
pure func timedOk(p: Plan) -> bool =
  absf(secs(p.trip.tauBurn) - 30.0) < 0.000001 && secs(p.trip.tauCoast) > 50.0 && secs(p.trip.tauCoast) < 70.0
  && absf(secs(p.trip.tauApproach) - 25.0) < 0.000001 && p.trip.phiApproach > 0.0 && p.trip.phiApproach < p.trip.phiPeak && !p.trip.fellBack
pure func timedChain(w: World, n: int, acc: [float]) -> [float] =
  if n >= 4 then acc else match planned(w, n) {
    None => [0.0 - 1.0],
    Some(p) => if timedOk(p) then timedChain(finishLeg(w, n), n + 1, acc ++ [p.trip.phiPeak, p.trip.a, p.trip.phiApproach]) else [0.0 - 2.0 - intToFloat(n)]
  }
export pure func checkTimedLegs() -> bool {
  let r = timedChain(started(), 0, []);
  match r {
    [sunPhi, sunA, sunAp, jupPhi, jupA, jupAp, calPhi, calA, calAp, satPhi, satA, satAp] =>
      jupPhi > rapidityOfBeta(0.999) && satPhi > rapidityOfBeta(0.999) && calPhi < rapidityOfBeta(0.2)
      && sunA != jupA && jupA != calA && jupA > (guided()).params.boostG * 1.0
      -- The Sun is 4 degrees across before its brake could begin: its approach starts at
      -- exactly half the cruise rapidity. Jupiter's starts at its 4-degree point, below that.
      && sunAp == 0.5 * sunPhi && jupAp < 0.5 * jupPhi && jupAp > 0.0 && satAp < 0.5 * satPhi && calAp < calPhi
    , _ => false
  }
}
test "timed in-system legs: 30 s boost, 50-70 s cruise, 25 s approach; Jupiter and Saturn above 0.999c, Callisto slow; the Sun approaches from half its cruise rapidity" { checkTimedLegs() }
export pure func checkApproachPhase() -> bool =
  match planned(started(), 0) {
    None => false,
    Some(p) => {
      let committed = (tick({started() | journey: Planned(p)}, {dtau: 0.0, intents: [ICommit(p.id)]})).world;
      let inside = (tick(committed, {dtau: p.trip.tauTotal - p.trip.tauApproach * 0.5, intents: []})).world;
      let braking = (tick(committed, {dtau: p.trip.tauTotal - p.trip.tauApproach * 1.5, intents: []})).world;
      phaseName(inside.ship.phase) == "approaching" && phaseName(braking.ship.phase) == "braking"
    }
  }
test "the ship reports approaching during the final approach and braking before it" { checkApproachPhase() }
export pure func checkTimedDrag() -> bool {
  let w = started();
  let weak = {w | params: {w.params | mEffKg: 0.000000000000000000000001}};
  match intentForLeg(weak, 1, targetFor(1)) {
    None => false,
    Some(intent) => match (tick(finishLeg(weak, 0), {dtau: 0.0, intents: [intent]})).refused { r :: _ => r.reason == "m_eff_too_small", [] => false }
  }
}
test "a timed leg whose thrust cannot hold against ISM drag is refused (m_eff_too_small)" { checkTimedDrag() }
-- Finite destination stars (D-47): the stop rule from the cited data rows.
pure func au() -> float = 149597870.7
export pure func checkStarStops() -> bool {
  let rAld = 45.212 * 695700.0;
  absf(destinationStopKm("trappist-1") / au() - 0.023515952032609692) < 0.000000000001
  && absf(destinationStopKm("aldebaran") / au() - 0.614751694642684) < 0.00001
  && absf(habitableZoneKm(1.521) / au() - 1.2332882874656679) < 0.000000000001
  && absf(destinationRadiusKm("aldebaran") - rAld) < 0.001
  -- the inferred rows recompute from their inputs (theta_LD x catalogue distance; Stefan-Boltzmann)
  && absf(destinationValue("aldebaran", "radius_sun") - (20.58 / 2000.0) * (66.6441325775892 / 3.261563777) * au() / 695700.0) < 0.001
  && absf(destinationValue("aldebaran", "luminosity_sun") - 45.212 * 45.212 * (3927.0 / 5772.0) * (3927.0 / 5772.0) * (3927.0 / 5772.0) * (3927.0 / 5772.0)) < 0.01
}
test "star stops follow D-47: TRAPPIST-1 HZ 0.0235 AU, Aldebaran 40 deg at 0.615 AU, alpha Cen A HZ 1.233 AU; inferred rows recompute" { checkStarStops() }
-- The destination-star feed (eval R1 finding 1): ids and order, finite radius, the
-- illuminance from V and distance, and the planner's body index equal to the star's
-- place in the system section the client receives.
pure func indexOf(bs: [BodyView], id: string, i: int) -> int = match bs { [] => 0 - 1, b :: rest => if b.id == id then i else indexOf(rest, id, i + 1) }
pure func viewOf(bs: [BodyView], id: string) -> Option[BodyView] = match bs { [] => None, b :: rest => if b.id == id then Some(b) else viewOf(rest, id) }
export pure func checkDestinationFeed() -> bool {
  let w = chainTo(started(), 0, 9);
  let sys = finiteSystemOf(w);
  match (viewOf(sys.bodies, "aldebaran"), planned(w, 9)) {
    (Some(b), Some(p)) => {
      let dKm = norm(b.relKm);
      let earthAu = norm(destinationLy("aldebaran")) * lyKm() / au();
      let want = illuminanceFromV(0.87) * (earthAu * au() / dKm) * (earthAu * au() / dKm);
      (match p.nav { Some(n) => n.index == indexOf(sys.bodies, "aldebaran", 0), None => false })
      && indexOf(sys.bodies, "trappist-1", 0) == indexOf(sys.bodies, "aldebaran", 0) + 1
      && indexOf(sys.bodies, "acen-b", 0) + 1 == indexOf(sys.bodies, "aldebaran", 0)
      && b.kind == "star" && b.radiusKm == destinationRadiusKm("aldebaran")
      && absf(b.eVLux / want - 1.0) < 0.000000001
    },
    _ => false
  }
}
pure func chainTo(w: World, n: int, stop: int) -> World = if n >= stop then w else chainTo(finishLeg(w, n), n + 1, stop)
test "destination stars are fed after alpha Cen in order; the planner's index is the feed's; illuminance is V at Earth scaled by distance" { checkDestinationFeed() }
export pure func checkGiantApproach() -> bool =
  match planned(chainTo(started(), 0, 9), 9) {
    Some(p) => absf(secs(p.trip.tauApproach) - 90.0) < 0.000001 && absf(secs(p.trip.tauBurn) - 30.0) < 0.000001 && p.trip.phiApproach < p.trip.phiPeak,
    None => false
  }
test "the giant (Aldebaran) gets a 90 s final approach; main-sequence stars and planets keep 25 s" { checkGiantApproach() }
export pure func solarDepartureVm(n: int) -> string =
  if checkInitial() && checkUnsafe() && checkConfiguredStart() && checkSunBoundary() && checkNoReinitialize() && checkSequence() && checkDirectJupiterCollision() && checkBounds() && checkSpeeds() && checkGuidedDriveValid() && checkTimedLegs() && checkApproachPhase() && checkTimedDrag() && checkStarStops() && checkDestinationFeed() && checkGiantApproach() then "solar-departure-pure: OK" else "solar-departure-pure: FAIL"

pure func clearance(w: World, id: string) -> string {
  let pl = (tick(w, {dtau: 0.0, intents: [IPlanBody({id: id, cruisePhi: rapidityOfBeta(0.002), mode: "stop", standoffKm: None, bKm: 0.0, clockDeg: 0.0, runOutKm: None, timing: None})]}));
  match pl.world.journey {
    Planned(p) => {
      let committed = (tick(pl.world, {dtau: 0.0, intents: [ICommit(p.id)]})).world;
      let arrived = (tick(committed, {dtau: p.trip.tauTotal, intents: []})).world;
      let saturn = finishLeg(arrived, 3);
      concat([id,": ", match saturn.journey { Arrived(c) => if c.plan.target.id == "saturn" then "accepted" else "saturn rejected", _ => "saturn rejected" }])
    },
    _ => concat([id,": ",match pl.refused { r :: _ => r.reason, [] => "unknown" }])
  }
}
export pure func clearanceVm(n: int) -> string {
  let jupiter = finishLeg(finishLeg(started(), 0), 1);
  concat([clearance(jupiter, "callisto"),"\n",clearance(jupiter, "ganymede"),"\n",clearance(jupiter,"europa"),"\n",clearance(jupiter,"io")])
}
