module stapledons/sim/ship

-- Stapledon's Voyage: simulation sidecar (I/O shell around sim/core).
-- Protocol: one JSON object per line on stdin, one per line on stdout.
--   in : {"cmd":"step","thrust":<-1..1>,"dtau":<ship years>} | {"cmd":"quit"}
--   out: {"tick","beta","gamma","tau","t","x"}
-- Units: light-years, years, c = 1. Motion is 1-D along the ship heading.

import std/io (readLine, println, flush)
import std/json (decode, encode, getNumber, getString, jo, kv, jnum, jint)
import std/option (Some, None)
import std/result (Ok, Err)
import ./core (Ship, initShip, step, beta, gamma)

pure func report(s: Ship) -> string =
  encode(jo([
    kv("tick", jint(s.tick)),
    kv("beta", jnum(beta(s))),
    kv("gamma", jnum(gamma(s))),
    kv("tau", jnum(s.motion.tau)),
    kv("t", jnum(s.motion.t)),
    kv("x", jnum(s.motion.x))
  ]))

func loop(s: Ship) -> () ! {IO} {
  let line = readLine(());
  match decode(line) {
    Ok(j) => {
      let cmd = match getString(j, "cmd") { Some(c) => c, None => "quit" };
      if cmd == "step" then {
        let thrust = match getNumber(j, "thrust") { Some(v) => v, None => 0.0 };
        let dtau = match getNumber(j, "dtau") { Some(v) => v, None => 0.0 };
        let s2 = step(s, thrust, dtau);
        println(report(s2));
        flush(());
        loop(s2)
      } else ()
    },
    Err(_) => ()
  }
}

export func main() -> () ! {IO} {
  println(report(initShip()));
  flush(());
  loop(initShip())
}
