module stapledons/sim/ship

-- NDJSON I/O shell for protocol v2 (sim/protocol.ail). The only effectful
-- code: read a line, hand it to the pure session server, print its reply.
-- Nothing is printed before the first line arrives, so a session's first
-- output is the answer to its first input (the hello).
import std/io (readLine, println, flush)
import std/result (Ok, Err)
import ./protocol (Session, GQuit, newSession, serve, decodeInput)

pure func isQuit(line: string) -> bool =
  match decodeInput(line) { Ok(m) => (match m { GQuit => true, _ => false }), Err(_) => false }

func loop(s: Session) -> () ! {IO} {
  let line = readLine(());
  if line == "" || isQuit(line) then ()
  else {
    let r = serve(s, line);
    println(r.reply);
    flush(());
    loop(r.session)
  }
}

export func main() -> () ! {IO} = loop(newSession())
