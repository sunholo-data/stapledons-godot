module stapledons/sim/cruise_digest

-- R2-INTERLUDE (design interlude-card.md D1): the cruise as the crossing review sees it. Pure: no
-- I/O, no hidden state; runs on the strict VM.
--
-- I1, the stop half. A long cruise is crossed in chunks: the sim publishes where the next stop is
-- (protocol 2.10 `cruise`) and the host steps exactly that, never computing ship time itself. The
-- next stop is the earliest of
--   braking   the cruise -> braking boundary (the host's interlude ends there);
--   check_in  the next auto-run decision day (D-76: monthly on a committed leg), when auto-run is
--             on and no hold is open. An escalation can only fire on a decision day, so a hold is
--             always the last thing in its chunk and the host stops before the next (Rulings §3);
--   chunk     the safety cap, chunkDays() crew days (Rulings §5).
-- Exactness: a stop k crew days away is stopYears(dayRem, k) ship years, the smallest float whose
-- whole days from the crew's carried remainder are exactly k (crew.daysIn), so floating rounding
-- can never land one day short (the hold slips into the next chunk) or over (plain days after it).
import std/option (Option, Some, None)
import std/math (intToFloat, floor, floatToInt)
import std/list (map, filter, foldl)
import std/string (startsWith, concat)
import std/json (decode, getString, getBool)
import std/result (Ok, Err)
import pkg/sunholo/crew_core/auto (Act)
import pkg/sunholo/social_dynamics/model (State, Actor, Value, Completed)
import ./crew (CrewState, CrewLine, CrewHold, daysIn, daysPerYear)
import ./crew_names (nameOf)
import ./protocol_crew (templateLine, emotionOf, holdLine)
import ./crew_auto (nextDecision, cadenceLongSkip)
import ./home_tiers (homeTier16, tierLine16, tierWord16, crossingLine16)

export type Stop = { years: float, kind: string } deriving (Eq)

-- Rulings §5: the safety cap on one chunk, in crew days.
export pure func chunkDays() -> int = 365

pure func daysAt(rem: float, y: float) -> int = (daysIn(rem, y)).days

-- Bisection on floats between lo (fewer than k days) and hi (k days or more): it stops when the
-- midpoint rounds onto an end, i.e. lo and hi are adjacent floats. A bracket whose width is ~1e-12
-- of a year closes in about 60 halvings.
pure func bisect(rem: float, k: int, lo: float, hi: float, left: int) -> (float, float) = {
  let mid = lo + (hi - lo) / 2.0;
  if left <= 0 || mid == lo || mid == hi then (lo, hi)
  else if daysAt(rem, mid) >= k then bisect(rem, k, lo, mid, left - 1)
  else bisect(rem, k, mid, hi, left - 1)
}
-- A float above `y` with at least k days: widen until it holds.
pure func above(rem: float, k: int, y: float, w: float, left: int) -> float =
  if left <= 0 || daysAt(rem, y + w) >= k then y + w else above(rem, k, y, w * 2.0, left - 1)
-- A float below `y` with fewer than k days (0 if none is needed).
pure func below(rem: float, k: int, y: float, w: float, left: int) -> float =
  if y - w <= 0.0 || left <= 0 then 0.0 else if daysAt(rem, y - w) < k then y - w else below(rem, k, y, w * 2.0, left - 1)

-- (lo, hi): lo has k - 1 days or fewer, hi exactly k, and they are adjacent floats (hi == 0 when
-- rem already holds k days).
export pure func stopBracket(rem: float, k: int) -> (float, float)
  requires { rem >= 0.0 }
= {
  let guess = intToFloat(k) / daysPerYear() - rem;
  let y0 = if guess > 0.0 then guess else 0.0;
  if daysAt(rem, 0.0) >= k then (0.0, 0.0) else {
    let w = (y0 + rem) * 0.000000000001 + 0.000000000000000001;
    let hi = above(rem, k, y0, w, 200);
    let lo = below(rem, k, y0, w, 200);
    bisect(rem, k, lo, hi, 2200)
  }
}
-- Ship years from a crew remainder `rem` to exactly k whole crew days.
export pure func stopYears(rem: float, k: int) -> float
  requires { rem >= 0.0 }
  ensures { result >= 0.0 }
= match stopBracket(rem, k) { (_, hi) => hi }

-- The crew's next stop in crew days: the next decision day when auto-run is on and no hold is open,
-- capped at chunkDays().
pure func crewStop(c: CrewState) -> (int, string) = match c.auto {
  Some(_) => if listEmpty(c.holds) then {
    let d = nextDecision(c.turn, cadenceLongSkip()) - c.turn;
    if d < chunkDays() then (d, "check_in") else (chunkDays(), "chunk")
  } else (chunkDays(), "chunk"),
  None => (chunkDays(), "chunk")
}
pure func listEmpty(xs: [a]) -> bool = match xs { [] => true, _ => false }

-- The next stop on a committed leg, `brake` ship years from the braking boundary. The braking
-- boundary wins a tie (the interlude ends there).
export pure func nextStop(crew: Option[CrewState], brake: float) -> Stop
  ensures { result.years >= 0.0 }
= {
  let b = if brake > 0.0 then brake else 0.0;
  let s = match crew {
    Some(c) => match crewStop(c) { (k, kind) => { years: stopYears(c.dayRem, k), kind: kind } },
    None => { years: stopYears(0.0, chunkDays()), kind: "chunk" }
  };
  if b <= s.years then { years: b, kind: "braking" } else s
}

-- ================================================================ I2: the cruise digest
-- What the crossing review shows (design D1): world state (core.ail World.cruiseDigest), begun at
-- the commit from the world before the commit tick, folded on every tick that starts or ends
-- committed (so the arrival tick is in it), kept through holds, frozen at arrival until the next
-- commit. Bounded: the moments are a top-momentsMax() fold, so the state is O(crew) per tick.
-- Counts come from crew_core's Act log (crew_auto.AutoStepped.log), the captain's answered lines
-- and accepted console commands, the tick's holds, and the archive counters (work done): the
-- game crew runs untraced, so there are no journal records to read.
-- Text: authored words only (protocol_crew.templateLine, holdLine; D-21: no digits). Numbers are
-- fields; Godot formats them.

-- ---------------------------------------------------------------- home time (Rulings §7)
-- Seven tiers by Earth years since departure: < 1, 10, 30, 80, 130, 1000, beyond.
export pure func homeTier(years: float) -> int =
  if years < 1.0 then 0 else if years < 10.0 then 1 else if years < 30.0 then 2 else if years < 80.0 then 3
  else if years < 130.0 then 4 else if years < 1000.0 then 5 else 6
-- The whole years the tier line's %s stands for.
export pure func tierYears(years: float) -> int = if years < 0.0 then 0 else floatToInt(floor(years))
-- %s is the whole Earth years since departure (tierYears), a bound field Godot formats.
export pure func tierLine(tier: int, whole: int) -> string =
  if tier <= 0 then "Less than a year at home. They are still watching for word from you."
  else if tier == 1 then (if whole == 1 then "A year at home. The news you left with is history." else "%s years at home. The news you left with is history.")
  else if tier == 2 then "%s years. The children you knew have grown up; your name is a story they half remember."
  else if tier == 3 then "%s years. Your parents' generation is gone; the friends you left are old."
  else if tier == 4 then "%s years. Everyone you knew is gone."
  else if tier == 5 then "%s years. No one alive on Earth was born when you left. The countries you knew may not exist."
  else "%s years. Longer than recorded history before you left. Whatever answers your signal will not be the Earth you left."

-- ---------------------------------------------------------------- the digest's state
export type MediumRef = { name: string, nH: float } deriving (Eq)
export type NewsRef = { templateId: int, starId: string, tier: int } deriving (Eq)
-- What the world shows at the end of a tick (core.ail digestSnap): the clocks (ship tau, galaxy t,
-- calendar year), Earth years since departure, the news epoch and age, the last arrival's news,
-- and the leg's dust (lism-1 only): the medium here, those crossed this tick, the grains swept
-- (>= 1 um) and the largest impact so far.
export type Snap = { tau: float, t: float, year: float, sinceDeparture: float, newsEpoch: float, newsAge: float, news: Option[NewsRef],
  lism: bool, medium: MediumRef, crossed: [MediumRef], grains: float, largestUm: float, largestJ: float } deriving (Eq)
-- One tick's crew happenings: the captain's answered asks (at crew turn turnBefore, before the
-- tick's days), crew_core's Act log for the auto-run days, the holds raised, and the crew_core
-- lines of the captain's accepted console commands.
export type CrewTick = { turnBefore: int, answered: [CrewLine], log: [Act], holds: [CrewHold], captain: [string] }

export type Ind = { stress: int, fatigue: int, morale: int, trust: int } deriving (Eq)
-- label0/label: the member's latest reply label at the commit and now (their face's emotion).
export type Member = { id: string, name: string, begin: Ind, end: Ind, label0: string, label: string } deriving (Eq)
-- day: crew days since the commit. kind: hold | refusal | relief | concern | accept | reply.
-- label: the reply label (or the hold's rule); text: the authored words; aiReq: the crew_reply AI
-- request that words it ("" when none: the authored text stands).
export type Moment = { day: int, actor: string, name: string, label: string, kind: string, emotion: string, aiReq: string, text: string } deriving (Eq)
-- standDowns* (crew_core 0.6, R2-CREW-CONSOLE-V2 V8): duty check-ins where they asked to stand down,
-- and the captain's (or auto-run's) answer; on the wire from protocol 2.11.
export type Counts = { refusals: int, concerns: int, concernsAuto: int, reliefsAsked: int, reliefsGranted: int, reliefsDenied: int, holds: int,
  standDownsAsked: int, standDownsGranted: int, standDownsDenied: int } deriving (Eq)
-- Open asks (kind request) and unresolved reliefs (kind relief) awaiting the captain.
export type Waiting = { kind: string, id: string, actor: string, name: string, task: string } deriving (Eq)
export type CrewDigest = { turn0: int, turn: int, work0: int, work: int, counts: Counts, members: [Member], moments: [Moment], waiting: [Waiting] } deriving (Eq)
-- tau0, t0, year0: the clocks at the commit; now: the latest snap; media: crossed, in order.
export type Digest = { tau0: float, t0: float, year0: float, now: Snap, media: [MediumRef], crew: Option[CrewDigest] } deriving (Eq)

export pure func noCounts() -> Counts = { refusals: 0, concerns: 0, concernsAuto: 0, reliefsAsked: 0, reliefsGranted: 0, reliefsDenied: 0, holds: 0,
  standDownsAsked: 0, standDownsGranted: 0, standDownsDenied: 0 }
export pure func momentsMax() -> int = 7

-- ---------------------------------------------------------------- moments
-- The pure salience rule until crew_core's skip report (E4, I3b) replaces it.
export pure func salience(kind: string) -> int =
  if kind == "hold" then 5 else if kind == "refusal" then 4 else if kind == "relief" then 3
  else if kind == "concern" then 2 else if kind == "accept" then 1 else 0
export pure func momentKind(label: string) -> string =
  if label == "decline" then "refusal" else if label == "request_relief" || label == "stand_down" then "relief" else if label == "concern" then "concern"
  else if label == "accept" then "accept" else "reply"
-- a ranks before b: higher salience, then the earlier day, then the actor id.
pure func before(a: Moment, b: Moment) -> bool = {
  let sa = salience(a.kind);
  let sb = salience(b.kind);
  if sa != sb then sa > sb else if a.day != b.day then a.day < b.day else a.actor < b.actor
}
pure func insertRanked(m: Moment, xs: [Moment]) -> [Moment] = match xs {
  [] => [m],
  x :: rest => if before(m, x) then m :: xs else x :: insertRanked(m, rest)
}
pure func takeN(n: int, xs: [a]) -> [a] = if n <= 0 then [] else match xs { [] => [], x :: r => x :: takeN(n - 1, r) }
-- The bounded fold: the ranked top momentsMax() of what came before and m.
export pure func insertMoment(m: Moment, xs: [Moment]) -> [Moment]
  ensures { lengthOf(result) <= momentsMax() }
= takeN(momentsMax(), insertRanked(m, xs))
pure func lengthOf(xs: [a]) -> int = match xs { [] => 0, _ :: r => 1 + lengthOf(r) }

-- ---------------------------------------------------------------- movement
pure func absI(x: int) -> int = if x < 0 then 0 - x else x
export pure func movedBy(m: Member) -> int =
  absI(m.end.stress - m.begin.stress) + absI(m.end.fatigue - m.begin.fatigue) + absI(m.end.morale - m.begin.morale) + absI(m.end.trust - m.begin.trust)
pure func movedBefore(a: Member, b: Member) -> bool = { let x = movedBy(a); let y = movedBy(b); if x != y then x > y else a.id < b.id }
pure func insertMember(m: Member, xs: [Member]) -> [Member] = match xs { [] => [m], x :: r => if movedBefore(m, x) then m :: xs else x :: insertMember(m, r) }
-- Members by total |delta| over stress, fatigue, morale and trust; ties by member id.
export pure func rankMovement(ms: [Member]) -> [Member] = foldl(\acc m. insertMember(m, acc), [], ms)

-- ---------------------------------------------------------------- reading the crew
pure func valueOf(vs: [Value], id: string) -> int = match vs { [] => 0, v :: r => if v.id == id then v.value else valueOf(r, id) }
pure func trustIn(st: State, id: string) -> int = match st.relationships {
  rs => match filter(\r. r.from == id && r.to == "captain" && r.dimension == "trust", rs) { r :: _ => r.value, [] => 0 }
}
pure func indOf(st: State, a: Actor) -> Ind =
  { stress: valueOf(a.indicators, "stress"), fatigue: valueOf(a.indicators, "fatigue"), morale: valueOf(a.indicators, "morale"), trust: trustIn(st, a.id) }
pure func lastLabel(ls: [CrewLine], id: string, acc: string) -> string = match ls { [] => acc, l :: r => lastLabel(r, id, if l.actor == id then l.label else acc) }
pure func nameIn(c: CrewState, id: string) -> string = match nameOf(c.names, id) { Some(n) => n, None => id }
pure func crewActors(c: CrewState) -> [Actor] = filter(\a. a.id != "captain", c.session.state.actors)
pure func stressOf(c: CrewState, id: string) -> int = match filter(\a. a.id == id, c.session.state.actors) { a :: _ => valueOf(a.indicators, "stress"), [] => 0 }
pure func isRest(recipe: string) -> bool = startsWith(recipe, "rest_")
-- Work finished (not rest), archived and live (crew_core completedCount, summed over work recipes).
export pure func workDone(c: CrewState) -> int = {
  let s = c.session;
  foldl(\acc t. if isRest(t.id) then acc else acc + t.count, 0, s.archive.completed)
    + lengthOf(filter(\t. t.status == Completed && !isRest(t.recipe), s.state.tasks))
}
pure func waitingOf(c: CrewState) -> [Waiting] =
  map(\q. { kind: "request", id: q.id, actor: q.actor, name: nameIn(c, q.actor), task: q.task }, c.session.pending)
  ++ map(\r. { kind: "relief", id: r.id, actor: r.author, name: nameIn(c, r.author), task: r.task }, filter(\r. !r.resolved, c.session.state.reliefs))

pure func beginCrew(c: CrewState) -> CrewDigest = {
  let st = c.session.state;
  let w = workDone(c);
  { turn0: c.turn, turn: c.turn, work0: w, work: w, counts: noCounts(),
    members: map(\a. { let i = indOf(st, a); let l = lastLabel(c.lines, a.id, ""); { id: a.id, name: nameIn(c, a.id), begin: i, end: i, label0: l, label: l } }, crewActors(c)),
    moments: [], waiting: waitingOf(c) }
}
-- The crew now: end indicators, work, waiting, the turn.
pure func refreshCrew(cd: CrewDigest, c: CrewState) -> CrewDigest = {
  let st = c.session.state;
  let now = \m. match filter(\a. a.id == m.id, st.actors) { a :: _ => { m | end: indOf(st, a), name: nameIn(c, m.id) }, [] => m };
  { cd | turn: c.turn, work: workDone(c), members: map(now, cd.members), waiting: waitingOf(c) }
}

-- ---------------------------------------------------------------- one tick's events
pure func bump(c: Counts, label: string) -> Counts =
  if label == "decline" then { c | refusals: c.refusals + 1 }
  else if label == "concern" then { c | concerns: c.concerns + 1 }
  else if label == "request_relief" then { c | reliefsAsked: c.reliefsAsked + 1 }
  else c
pure func actCount(c: Counts, a: Act) -> Counts =
  if a.kind == "reply" then bump(c, a.label)
  else if a.kind == "captain_reply" then { c | concernsAuto: c.concernsAuto + 1 }
  else if a.kind == "relief_decision" then (if a.label == "granted" then { c | reliefsGranted: c.reliefsGranted + 1 } else { c | reliefsDenied: c.reliefsDenied + 1 })
  else if a.kind == "stand_down_asked" then { c | standDownsAsked: c.standDownsAsked + 1 }
  else if a.kind == "stand_down_decision" then (if a.label == "granted" then { c | standDownsGranted: c.standDownsGranted + 1 } else { c | standDownsDenied: c.standDownsDenied + 1 })
  else c
-- A console resolve_relief the captain sent: release true grants it.
pure func captainCount(c: Counts, line: string) -> Counts = match decode(line) {
  Ok(j) => if getString(j, "command") == Some("resolve_relief") then (match getBool(j, "release") {
      Some(true) => { c | reliefsGranted: c.reliefsGranted + 1 },
      Some(false) => { c | reliefsDenied: c.reliefsDenied + 1 },
      None => c
    }) else if getString(j, "command") == Some("resolve_stand_down") then (match getBool(j, "release") {
      Some(true) => { c | standDownsGranted: c.standDownsGranted + 1 },
      Some(false) => { c | standDownsDenied: c.standDownsDenied + 1 },
      None => c
    }) else c,
  Err(_) => c
}
pure func labelled(ms: [Member], actor: string, label: string) -> [Member] = map(\m. if m.id == actor then { m | label: label } else m, ms)
pure func memberName(ms: [Member], id: string) -> string = match filter(\m. m.id == id, ms) { m :: _ => m.name, [] => id }
pure func replyMoment(cd: CrewDigest, day: int, actor: string, label: string, stress: int, aiReq: string) -> Moment =
  { day: day - cd.turn0, actor: actor, name: memberName(cd.members, actor), label: label, kind: momentKind(label), emotion: emotionOf(label, stress), aiReq: aiReq, text: templateLine(label) }
pure func onAnswered(cd: CrewDigest, crew: [Actor], turn: int, l: CrewLine) -> CrewDigest =
  { cd | counts: bump(cd.counts, l.label), members: labelled(cd.members, l.actor, l.label),
    moments: insertMoment(replyMoment(cd, turn, l.actor, l.label, match filter(\a. a.id == l.actor, crew) { a :: _ => valueOf(a.indicators, "stress"), [] => 0 }, l.aiReq), cd.moments) }
pure func onAct(cd: CrewDigest, a: Act) -> CrewDigest = {
  let counted = { cd | counts: actCount(cd.counts, a) };
  if a.kind == "reply" then { counted | members: labelled(cd.members, a.actor, a.label), moments: insertMoment(replyMoment(cd, a.tick, a.actor, a.label, a.stress, ""), cd.moments) }
  else if a.kind == "stand_down_asked" then { counted | moments: insertMoment(replyMoment(cd, a.tick, a.actor, "stand_down", a.stress, ""), cd.moments) }
  else counted
}
pure func onHold(cd: CrewDigest, h: CrewHold) -> CrewDigest =
  { cd | counts: { cd.counts | holds: cd.counts.holds + 1 },
    moments: insertMoment({ day: h.tick - cd.turn0, actor: h.actor, name: memberName(cd.members, h.actor), label: h.rule, kind: "hold", emotion: "sad", aiReq: "", text: holdLine(h.rule) }, cd.moments) }
-- One tick, in the order it happened: the captain's answered asks and console commands, then the
-- auto-run acts, then the holds. `crew` is the crew after the tick (stress for answered lines).
export pure func foldEvents(cd: CrewDigest, crew: [Actor], ct: CrewTick) -> CrewDigest = {
  let a = foldl(\acc l. onAnswered(acc, crew, ct.turnBefore, l), cd, ct.answered);
  let b = { a | counts: foldl(captainCount, a.counts, ct.captain) };
  let c = foldl(onAct, b, ct.log);
  foldl(onHold, c, ct.holds)
}

-- ---------------------------------------------------------------- begin and fold
pure func lastMedium(xs: [MediumRef]) -> Option[MediumRef] = match xs { [] => None, [x] => Some(x), _ :: r => lastMedium(r) }
pure func addMedium(xs: [MediumRef], m: MediumRef) -> [MediumRef] = match lastMedium(xs) { Some(l) => if l.name == m.name then xs else xs ++ [m], None => [m] }
-- The digest at the commit: the world before the commit tick (its clocks are the commit's, a commit
-- needs the ship at rest), its medium the first crossed.
export pure func beginDigest(s: Snap, crew: Option[CrewState]) -> Digest =
  { tau0: s.tau, t0: s.t, year0: s.year, now: s, media: if s.lism then [s.medium] else [], crew: match crew { Some(c) => Some(beginCrew(c)), None => None } }
export pure func foldDigest(d: Digest, s: Snap, crew: Option[CrewState], ct: CrewTick) -> Digest = {
  let media = if s.lism then addMedium(foldl(addMedium, d.media, s.crossed), s.medium) else d.media;
  { d | now: s, media: media, crew: match (d.crew, crew) {
      (Some(cd), Some(c)) => Some(refreshCrew(foldEvents(cd, c.session.state.actors, ct), c)),
      _ => d.crew
    } }
}
-- Ship days: the days lived since the commit, one definition for "You lived N days" (time.ship_days)
-- and "Your crew lived N days" (crew.counts.days). With a crew aboard they are the crew's day clock,
-- its turns since the commit: the crew carries a fraction of a day from before the commit (dayRem),
-- so its days and the proper time floored from the commit can differ by one (I3 polish: 38 against
-- 39 on the Aldebaran leg). With no crew the same clock runs from the commit with no carried
-- fraction: whole days of proper time.
export pure func shipDays(d: Digest) -> int = match d.crew {
  Some(cd) => cd.turn - cd.turn0,
  None => (daysIn(0.0, if d.now.tau > d.tau0 then d.now.tau - d.tau0 else 0.0)).days
}

-- ================================================================ I4: the Archive's authored framing
-- design D3, Rulings §6: the Archive frames the crossing review in its own words, always: one line on
-- the crossing page (by the home tier) and one on the aboard page (by the crew's counts band). The
-- key names both, and the host sends it with the live telling's request (ai_open purpose archive),
-- so the telling is asked about the same crossing. Authored: in-world (D-67), never a hint of what
-- the ship does not know (D-68), no digits (D-21), at most narrationMax() characters.
export type Narration = { key: string, crossing: string, aboard: string } deriving (Eq)
export pure func narrationMax() -> int = 280

-- empty: no crew aboard; held: auto-run stopped for the captain; strained: someone asked to step
-- back; restless: refusals or concerns; quiet: none of these.
export pure func countsBand(c: Option[CrewDigest]) -> string = match c {
  None => "empty",
  Some(cd) => if cd.counts.holds > 0 then "held" else if cd.counts.reliefsAsked > 0 then "strained"
    else if cd.counts.refusals > 0 || cd.counts.concerns > 0 then "restless" else "quiet"
}
-- The home tiers (homeTier) in words, for keys without digits.
export pure func tierWord(tier: int) -> string =
  if tier <= 0 then "launch" else if tier == 1 then "years" else if tier == 2 then "decades" else if tier == 3 then "generation"
  else if tier == 4 then "lifetimes" else if tier == 5 then "centuries" else "ages"

pure func crossingLine(tier: int) -> string =
  if tier <= 0 then "We crossed quickly, Captain. Home has barely turned since we left; the people there are still looking up."
  else if tier == 1 then "Our clock runs slow out here. At home the seasons have kept turning without us, and the news we carry has become history."
  else if tier == 2 then "Since we left, the children at home have grown up. My records of them stop where we left; theirs of us grow thinner."
  else if tier == 3 then "A lifetime has passed at home since we left, and far less for us. The voices I hold from that world are mostly the voices of the dead."
  else if tier == 4 then "Everyone who watched us leave is gone, Captain. My records of them are not. I keep them carefully."
  else if tier == 5 then "More than a century has turned at home since we left. The nations in my entries may be names in someone else's histories now."
  else "More than a thousand years have passed at home since we left. What answers our signal, I cannot predict from anything I hold."
pure func aboardLine(band: string) -> string =
  if band == "empty" then "No crew crossed with us, Captain. The crossing was yours and mine, and my log of it is short."
  else if band == "quiet" then "Aboard, the crew kept to their work. My log of the crossing is calm; the days ran into one another."
  else if band == "restless" then "Aboard, there was friction. Not every piece of work was taken on gladly, and I have kept what was said."
  else if band == "strained" then "Aboard, the crossing weighed on the crew. Someone asked to step back from their work. I have kept their words."
  else "Aboard, the crossing weighed on the crew, and the ship stopped to wait for you. I have kept their words."

export pure func narrationFor(tier: int, band: string) -> Narration =
  { key: concat([tierWord(tier), ".", band]), crossing: crossingLine(tier), aboard: aboardLine(band) }
export pure func narrationOf(d: Digest) -> Narration = narrationFor(homeTier(d.now.sinceDeparture), countsBand(d.crew))
export pure func narrationKey(d: Digest) -> string = (narrationOf(d)).key

-- ================================================================ R2-HOME-TIERS: the ladder switch
-- design home-tiers.md H1: protocol 2.12 sends the sixteen tiers of sim/home_tiers.ail; 2.10 and 2.11
-- keep the seven above, byte for byte (sixteen false is exactly homeTier, tierLine, narrationFor).
export pure func homeTierAt(sixteen: bool, years: float) -> int = if sixteen then homeTier16(years) else homeTier(years)
export pure func tierLineAt(sixteen: bool, tier: int, whole: int) -> string = if sixteen then tierLine16(tier, whole) else tierLine(tier, whole)
export pure func narrationForAt(sixteen: bool, tier: int, band: string) -> Narration =
  if sixteen then { key: concat([tierWord16(tier), ".", band]), crossing: crossingLine16(tier), aboard: aboardLine(band) } else narrationFor(tier, band)
export pure func narrationOfAt(sixteen: bool, d: Digest) -> Narration = narrationForAt(sixteen, homeTierAt(sixteen, d.now.sinceDeparture), countsBand(d.crew))
