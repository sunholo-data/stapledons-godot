module stapledons/sim/crew

-- R2-CREW C1 (design crew-integration.md §CI-1): the crew host aboard. sunholo/crew_core runs
-- inside the pure sim (vendor/crew-core until ailang#1811) on the scenario pack synced from the
-- crew lab (sim/data/crew_pack.ail). Pure: no I/O, no hidden state.
--
-- Every change to the crew goes through crew_core's own `input(session, line)`: the sim only
-- writes lines. A step returns the lines it fed (and, for a traced crew, crew_core's journal
-- records), so `crew_core.session.recording(scenario, lines)` replays the same crew standalone
-- (make crew-parity, AC3). The lab's claims then hold in the game by construction.
--
-- Time (D-70 OQ1): one crew tick per ship-day. A sim tick adds dtau ship-years; each whole day
-- is one `advance` line (absolute target tick, fixed budget, repeated while crew_core reports a
-- continuation); the remainder is carried exactly in `dayRem`.
-- Randomness: an authored answer draws one value from the crew stream (SCrew, id 2) as its seed.
-- No other stream moves (AC5).
import std/string (concat, intToStr)
import std/list (filter, head, map, any)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)
import std/json (encode, decode, get, getString, jo, ja, kv, js, jnum, jint)
import std/math (floor, floatToInt, intToFloat)
import pkg/sunholo/crew_core/scenario (Scenario, ShipEvent, decodeScenario, yieldsOf)
import pkg/sunholo/social_dynamics/model (Working)
import pkg/sunholo/crew_core/session (Session, Output, HostError, HostFailure, DomainFailure, start, input, untraced, encodeHostError)
import pkg/sunholo/crew_core/codec (CrewOutcome, AgreedStart, CompliedStart, StrainedStart, RefusedOrder, encodeOutcome)
import pkg/sunholo/crew_core/policy (Policy, decodePolicy, authoredAnswer)
import pkg/sunholo/crew_core/auto (Rule as AutoRule, AutoState)
import stapledons/sim/data/crew_pack (scenarioJson, policyJson)
import ./rng (Rng, SCrew, draw, top53)
import ./crew_events (forScenario)

-- C5: `lines` are the latest answered asks (newest last, at most linesMax), each with the AI request
-- that words it (aiReq "" until core opens one); `names` the crew's display names (D-74).
export type CrewLine = { request: string, actor: string, task: string, label: string, aiReq: string } deriving (Eq)
export type CrewName = { id: string, name: string } deriving (Eq)
-- C8 (CI-5): the auto-captain (sim/crew_auto.ail). `auto` is the standing-orders preset with its
-- escalation rules and crew_core's carried AutoState; None runs no decisions (the default). `holds`
-- are escalations awaiting the captain; while any is open, crew decisions wait (the ship and the
-- engine run on).
export type CrewHold = { id: string, rule: string, actor: string, task: string, tick: int, detail: string } deriving (Eq)
export type AutoRun = { preset: string, rules: [AutoRule], st: AutoState }
export type CrewState = { session: Session, policy: Policy, scenario: string, turn: int, dayRem: float, lines: [CrewLine], names: [CrewName],
  auto: Option[AutoRun], holds: [CrewHold] }
export pure func linesMax() -> int = 6
-- lines: the crew_core input lines fed, in order; traces: crew_core's journal record for each
-- (empty strings for an untraced crew); refused: the crew_core error that stopped the step.
export type CrewStepped = { crew: CrewState, rng: Rng, lines: [string], traces: [string], refused: Option[string], answered: [CrewLine] }

export pure func daysPerYear() -> float = 365.25
-- crew_core's per-call budget, as the lab's crew-sim uses.
export pure func advanceBudget() -> int = 64
-- An advance that still has a continuation after this many repeats is refused, never looped forever.
export pure func maxContinuations() -> int = 256

export pure func crewTurn(c: CrewState) -> int = c.turn
export pure func scenarioId(c: CrewState) -> string = c.scenario

-- The host profile line for a new crew: "watch-v3" carries personalities and conversations.
-- Archiving (crew_core 0.3.0 `keep`): finished work, resolved reliefs and old evidence older than
-- archiveKeep() crew days fold into summaries, so live state stays bounded on long skips (without it
-- a decade hits crew_core's 256-task cap; crew-lab measurement, 2026-10-13).
export pure func archiveKeep() -> int = 30
export pure func startLine(captaincy: string) -> string =
  encode(jo([kv("command", js("start")), kv("policy", js(captaincy)), kv("scenario", js("watch-v3")), kv("keep", jint(archiveKeep()))]))
export pure func advanceLine(tick: int) -> string =
  concat(["{\"command\":\"advance\",\"tick\":", intToStr(tick), ",\"budget\":", intToStr(advanceBudget()), "}"])

pure func hostError(e: HostError) -> string = encodeHostError(e)

-- The synced pack, decoded. Err names the field crew_core rejected.
export pure func pack() -> Result[(Scenario, Policy), string] = match decodeScenario(scenarioJson()) {
  Err(e) => Err(concat(["crew scenario: ", e])),
  Ok(sc) => match decodePolicy(policyJson()) {
    Err(e) => Err(concat(["crew policy: ", e])),
    Ok(p) => Ok((sc, p))
  }
}

-- A crew on the synced pack. `traced` keeps crew_core's journal records (the parity tool); the
-- game runs untraced (crew_core's batch mode). Returns the crew and the start record.
export pure func initCrewWith(captaincy: string, traced: bool) -> Result[(CrewState, string), string] =
  if captaincy != "consent" && captaincy != "orders" then Err(concat(["crew captaincy: ", captaincy])) else
  match pack() {
    Err(e) => Err(e),
    Ok((sc, p)) => match start(sc, startLine(captaincy)) {
      Err(e) => Err(hostError(e)),
      Ok(o) => Ok(({ session: if traced then o.session else untraced(o.session), policy: p, scenario: sc.id, turn: 0, dayRem: 0.0, lines: [], names: [], auto: None, holds: [] }, o.trace))
    }
  }
export pure func initCrew(captaincy: string) -> Result[CrewState, string] =
  match initCrewWith(captaincy, false) { Ok((c, _)) => Ok(c), Err(e) => Err(e) }

-- Whole ship-days in rem + dtau ship-years, and the ship-years left over.
export type Days = { days: int, left: float }
export pure func daysIn(rem: float, dtau: float) -> Days
  requires { dtau >= 0.0 && rem >= 0.0 }
{
  let total = rem + dtau;
  let n = floor(total * daysPerYear());
  let days = if n < 0.0 then 0 else floatToInt(n);
  let left = total - (intToFloat(days) / daysPerYear());
  { days: days, left: if left < 0.0 then 0.0 else left }
}

pure func stepped(c: CrewState, rng: Rng, lines: [string], traces: [string], refused: Option[string]) -> CrewStepped =
  { crew: c, rng: rng, lines: lines, traces: traces, refused: refused, answered: [] }

-- Keep the newest linesMax lines.
pure func lastLines(xs: [CrewLine]) -> [CrewLine] = if listLen(xs) <= linesMax() then xs else match xs { [] => [], _ :: r => lastLines(r) }
pure func listLen(xs: [a]) -> int = match xs { [] => 0, _ :: r => 1 + listLen(r) }
-- C5: core stamps an answered line with the AI request that words it.
export pure func noteLine(c: CrewState, l: CrewLine) -> CrewState = { c | lines: lastLines(c.lines ++ [l]) }
export pure func withNames(c: CrewState, ns: [CrewName]) -> CrewState = { c | names: ns }

-- Feed one line; Err keeps the crew unchanged and names the crew_core error.
pure func feed(c: CrewState, line: string) -> Result[Output, string] = match input(c.session, line) {
  Err(e) => Err(hostError(e)),
  Ok(o) => Ok(o)
}

-- Advance to the absolute crew tick `target`, repeating while crew_core holds a continuation.
pure func advanceTo(c: CrewState, rng: Rng, target: int, lines: [string], traces: [string], left: int) -> CrewStepped =
  if left <= 0 then stepped(c, rng, lines, traces, Some("advance: continuation limit")) else {
    let line = advanceLine(target);
    match feed(c, line) {
      Err(e) => stepped(c, rng, lines, traces, Some(e)),
      Ok(o) => {
        let c2 = { c | session: o.session };
        let ls = lines ++ [line];
        let ts = traces ++ [o.trace];
        if o.failed then stepped(c2, rng, ls, ts, Some("advance: blocked"))
        else match o.session.state.continuation {
          None => stepped({ c2 | turn: target }, rng, ls, ts, None),
          Some(_) => advanceTo(c2, rng, target, ls, ts, left - 1)
        }
      }
    }
  }

-- One advance line per crew day, as the lab's crew-sim turns: crew_core applies due yields and
-- scheduled events after an advance completes, so a single multi-day advance would fire a day-3
-- event at the end of the span, after the work holding the resource had finished. (CI-0's
-- `advance(n)` is the bulk path that keeps per-day semantics; until then a skip costs a line a day.)
-- C8, AC11: plain days in as few advance lines as is exact. crew_core applies flows (yields of
-- finished work, scheduled and run-time ship events) only after an advance completes, so an
-- advance may span days as long as it ends at every flow point: a working task's due tick when its
-- recipe yields, and each unseen ship event's tick. Between flow points a multi-day advance is the
-- per-day advance bit for bit (crew_hold_test checks the sessions are equal on every script).
-- When cohorts come aboard (crew_core 0.4.0, crew-population CP-2): cohorts drift on calendar weeks
-- and run a yearly step, reading state sampled at the advance, so every multiple of 7 and of 365
-- becomes a flow point too (crew-lab agent, 2026-10-13). Add them to nextFlow with the 0.4.0 bump.
export pure func plainDays(c: CrewState, rng: Rng, n: int) -> CrewStepped = fastDays(c, rng, c.turn + n, [], [])
export pure func perDays(c: CrewState, rng: Rng, n: int) -> CrewStepped = days(c, rng, n, [], [])
pure func seenEv(s: Session, id: string) -> bool = any(\e. e.id == concat(["ev-", id]), s.state.evidence) || listHas(s.archive.events, concat(["ev-", id]))
pure func listHas(xs: [string], x: string) -> bool = match xs { [] => false, y :: r => y == x || listHas(r, x) }
pure func minOr(xs: [int], d: int) -> int = match xs { [] => d, x :: r => { let m = minOr(r, d); if x < m then x else m } }
export pure func nextFlow(c: CrewState, target: int) -> int {
  let s = c.session;
  let t = c.turn;
  let evs = map(\e. if e.at <= t then t + 1 else e.at, filter(\e. !seenEv(s, e.id), s.scenario.events));
  let ys = map(\k. k.due, filter(\k. (match k.status { Working => true, _ => false }) && k.due > t && listLen(yieldsOf(s.scenario, k.recipe)) > 0, s.state.tasks));
  minOr(evs ++ ys, target)
}
pure func fastDays(c: CrewState, rng: Rng, target: int, lines: [string], traces: [string]) -> CrewStepped =
  if c.turn >= target then stepped(c, rng, lines, traces, None) else {
    let next = { let f = nextFlow(c, target); if f > target then target else if f <= c.turn then c.turn + 1 else f };
    let r = advanceTo(c, rng, next, lines, traces, maxContinuations());
    match r.refused { None => fastDays(r.crew, r.rng, target, r.lines, r.traces), Some(_) => r }
  }
pure func days(c: CrewState, rng: Rng, n: int, lines: [string], traces: [string]) -> CrewStepped =
  if n <= 0 then stepped(c, rng, lines, traces, None) else {
    let r = advanceTo(c, rng, c.turn + 1, lines, traces, maxContinuations());
    match r.refused { None => days(r.crew, r.rng, n - 1, r.lines, r.traces), Some(_) => r }
  }

-- Ship time passes: dtau ship-years become whole crew days (one turn each).
export pure func crewStep(c: CrewState, seed: int, rng: Rng, dtau: float) -> CrewStepped
  requires { dtau >= 0.0 }
  ensures { result.crew.turn >= c.turn }
{
  let d = daysIn(c.dayRem, dtau);
  days({ c | dayRem: d.left }, rng, d.days, [], [])
}

-- The authored policy's roll is content_library's MINSTD generator, which takes a seed in
-- [1, 2147483646]. A crew-stream draw (any 64-bit value) maps onto it from its top 53 bits.
export pure func answerSeed(v: int) -> int
  ensures { result >= 1 && result <= 2147483646 }
= 1 + top53(v) % 2147483646

-- An answer line for request `id` (the shape crew_core's `answer` command takes).
export pure func answerLine(id: string, body: string, roll: float) -> string =
  encode(jo([kv("command", js("answer")), kv("request", js(id)), kv("body", js(body)), kv("roll", jnum(roll))]))

-- After an `ask`, the crew member answers at once from the authored policy (D-20: the decision
-- is committed here; AI words never change it). The seed is one crew-stream draw.
pure func answerPending(c: CrewState, seed: int, rng: Rng, id: string, lines: [string], traces: [string]) -> CrewStepped =
  match head(filter(\q. q.id == id, c.session.pending)) {
    None => stepped(c, rng, lines, traces, None),
    Some(request) => {
      let d = draw(seed, rng, SCrew);
      match authoredAnswer(c.policy, request, answerSeed(d.value)) {
        Err(e) => stepped(c, d.rng, lines, traces, Some(concat(["answer: ", e]))),
        Ok(a) => {
          let line = answerLine(id, a.body, a.roll);
          match feed(c, line) {
            Err(e) => stepped(c, d.rng, lines, traces, Some(e)),
            Ok(o) => if o.failed then stepped({ c | session: o.session }, d.rng, lines ++ [line], traces ++ [o.trace], Some("answer: failed"))
              else { stepped({ c | session: o.session }, d.rng, lines ++ [line], traces ++ [o.trace], None) | answered: [{ request: id, actor: request.actor, task: request.task, label: a.label, aiReq: "" }] }
          }
        }
      }
    }
  }

-- Why crew_core refused a command, from its trace's `blocked` error: "blocked:<code>:<detail>"
-- (e.g. blocked:insufficient_resource:compute, the Crew console's "no compute slot free"),
-- else "command failed".
export pure func blockedReason(trace: string) -> string = match decode(trace) {
  Ok(j) => match get(j, "blocked") {
    Some(b) => match getString(b, "code") {
      Some(code) => match getString(b, "detail") { Some(d) => concat(["blocked:", code, ":", d]), None => concat(["blocked:", code]) },
      None => "command failed"
    },
    None => "command failed"
  },
  Err(_) => "command failed"
}
-- A crew_core host error in the same words: a social_error ({"code","detail"}) becomes
-- "blocked:<code>:<detail>"; any other error text is kept as it is.
export pure func errorReason(e: string) -> string = match decode(e) {
  Ok(j) => match getString(j, "code") {
    Some(code) => match getString(j, "detail") { Some(d) => concat(["blocked:", code, ":", d]), None => concat(["blocked:", code]) },
    None => e
  },
  Err(_) => e
}

-- One captain command (a crew_core input line from a crew intent). An `ask` is answered at once.
-- A refusal leaves the crew and the crew stream unchanged; a blocked one says why (blockedReason).
export pure func crewCommand(c: CrewState, seed: int, rng: Rng, line: string, askId: Option[string]) -> CrewStepped =
  match feed(c, line) {
    Err(e) => stepped(c, rng, [], [], Some(errorReason(e))),
    Ok(o) => if o.failed then stepped(c, rng, [], [], Some(blockedReason(o.trace))) else {
      let c2 = { c | session: o.session };
      match askId {
        None => stepped(c2, rng, [line], [o.trace], None),
        Some(id) => {
          let r = answerPending(c2, seed, rng, id, [line], [o.trace]);
          match r.refused { None => r, Some(e) => stepped(c, rng, [], [], Some(e)) }
        }
      }
    }
  }

-- R2-CREW C3: a ship event as crew_core's run-time `ship_event` line (crew_core 0.3.0).
export pure func shipEventLine(e: ShipEvent) -> string =
  encode(jo([kv("command", js("ship_event")), kv("event", jo([kv("id", js(e.id)), kv("text", js(e.text)),
    kv("transfers", ja(map(\t. jo([kv("resource", js(t.resource)), kv("delta", jint(t.delta))]), e.transfers)))]
    ++ (if e.major == "" then [] else [kv("major", js(e.major))])))]))

pure func supplies(c: CrewState) -> [string] = map(\r. r.id, c.session.scenario.resources)

-- Raise physics moments (sim/crew_events.ail) in order; each goes through crewCommand, so it is a
-- journalled line like any other. A refused event (crew_core's id dedupe) changes nothing.
export pure func raiseShipEvents(c: CrewState, seed: int, rng: Rng, es: [ShipEvent]) -> CrewStepped = match es {
  [] => stepped(c, rng, [], [], None),
  e :: rest => {
    let r = crewCommand(c, seed, rng, shipEventLine(forScenario(supplies(c), e)), None);
    let next = raiseShipEvents(r.crew, seed, r.rng, rest);
    { next | lines: r.lines ++ next.lines, traces: r.traces ++ next.traces }
  }
}

-- A crew intent (sim/protocol_crew.ail decodes it): one crew_core line; askId when it is an ask.
-- R2-CREW-CONSOLE-V2 V1 (protocol 2.11): two envelope fields beside the line, "" when absent.
--   asMode    crew_start only: "consent" | "orders", the captaincy for this start (crewCommandAs)
--   startMode crew_offer only: "on_accept" | "now", when the offer's work starts (crewIntents)
export type CrewCmd = { kind: string, line: string, askId: Option[string], asMode: string, startMode: string }
export type CrewRefusal = { i: int, reason: string }
export type CrewApplied = { crew: Option[CrewState], rng: Rng, refused: [CrewRefusal], answered: [CrewLine] }

-- crew_core's policy line (D-70 OQ5) and a start line, as the console sends them.
export pure func policyLine(p: string) -> string = encode(jo([kv("command", js("policy")), kv("policy", js(p))]))
export pure func startTaskLine(task: string) -> string = encode(jo([kv("command", js("start_task")), kv("task", js(task))]))

-- V1: a start "as" a captaincy other than the ship default is one all-or-nothing step: policy as,
-- the start, policy back. Each is a journalled crew_core line like any other (the journal stays
-- the truth). If any line is refused, the crew and the crew stream are unchanged and the step
-- carries that one reason. "" or the ship default's own value is today's start.
export pure func crewCommandAs(c: CrewState, seed: int, rng: Rng, line: string, asMode: string) -> CrewStepped
  ensures { result.refused == None || result.crew.session == c.session }
=
  if asMode == "" || asMode == c.session.command then crewCommand(c, seed, rng, line, None) else {
    let back = c.session.command;
    let p1 = crewCommand(c, seed, rng, policyLine(asMode), None);
    match p1.refused {
      Some(e) => stepped(c, rng, [], [], Some(e)),
      None => {
        let p2 = crewCommand(p1.crew, seed, p1.rng, line, None);
        match p2.refused {
          Some(e) => stepped(c, rng, [], [], Some(e)),
          None => {
            let p3 = crewCommand(p2.crew, seed, p2.rng, policyLine(back), None);
            match p3.refused {
              Some(e) => stepped(c, rng, [], [], Some(e)),
              None => stepped(p3.crew, p3.rng, p1.lines ++ p2.lines ++ p3.lines, p1.traces ++ p2.traces ++ p3.traces, None)
            }
          }
        }
      }
    }
  }

-- V1: a work's start terms, crew_core's report outcome for it (agreed_start, complied_start,
-- strained_start or refused_order); "" before it started.
export pure func workTerms(s: Session, task: string) -> string = match filter(\r. r.task == task && isStart(r.code), s.reports) {
  r :: _ => encodeOutcome(r.code),
  [] => ""
}
pure func isStart(o: CrewOutcome) -> bool = match o { AgreedStart => true, CompliedStart => true, StrainedStart => true, RefusedOrder => true, _ => false }

-- An offer that carried `start` this tick: the task, the mode, and the offer's intent index (a
-- refused start is reported there; the offer and their answer stand).
export type OfferStart = { task: string, mode: string, i: int }
pure func taskIdOf(line: string) -> string = match decode(line) { Ok(j) => match getString(j, "id") { Some(t) => t, None => "" }, Err(_) => "" }
pure func askTaskOf(line: string) -> string = match decode(line) { Ok(j) => match getString(j, "task") { Some(t) => t, None => "" }, Err(_) => "" }
pure func startFor(starts: [OfferStart], task: string) -> Option[OfferStart] = head(filter(\o. o.task == task, starts))

pure func joined(a: CrewStepped, b: CrewStepped) -> CrewStepped = { b | lines: a.lines ++ b.lines, traces: a.traces ++ b.traces, answered: a.answered }
-- One intent of the tick. crew_start goes through crewCommandAs; an answered crew_ask whose task
-- was offered with `start` this tick then starts it: on_accept only when the answer is accept (as
-- the ship default), now whatever the answer (as orders).
export type OneApplied = { st: CrewStepped, starts: [OfferStart], startRefused: Option[CrewRefusal] }
export pure func applyCmd(c: CrewState, seed: int, rng: Rng, i: int, cmd: CrewCmd, starts: [OfferStart]) -> OneApplied =
  if cmd.kind == "crew_start" then { st: crewCommandAs(c, seed, rng, cmd.line, cmd.asMode), starts: starts, startRefused: None }
  else if cmd.kind == "crew_reply" && cmd.startMode != "" then replyAt(c, seed, rng, i, cmd, starts)
  else {
    let s = crewCommand(c, seed, rng, cmd.line, cmd.askId);
    match s.refused {
      Some(_) => { st: s, starts: starts, startRefused: None },
      None => if cmd.kind == "crew_offer" && cmd.startMode != "" then { st: s, starts: starts ++ [{ task: taskIdOf(cmd.line), mode: cmd.startMode, i: i }], startRefused: None }
        else if cmd.kind == "crew_ask" then (match (startFor(starts, askTaskOf(cmd.line)), s.answered) {
          (Some(o), l :: _) => if o.mode == "on_accept" && l.label != "accept" then { st: s, starts: starts, startRefused: None } else {
            let g = crewCommandAs(s.crew, seed, s.rng, startTaskLine(o.task), if o.mode == "now" then "orders" else "");
            match g.refused {
              Some(e) => { st: s, starts: starts, startRefused: Some({ i: o.i, reason: concat(["crew:", e]) }) },
              None => { st: joined(s, g), starts: starts, startRefused: None }
            }
          },
          _ => { st: s, starts: starts, startRefused: None }
        })
        else { st: s, starts: starts, startRefused: None }
    }
  }

-- V4 (2.11): a captain's reply that carries `start` is reconsidered at once: crew_core asks again
-- (request reconsider-<reply id>) and the authored policy answers in the same step, as an ask is.
-- on_accept then starts the work if they now agree (as the ship default); a refused start is
-- reported on the reply's index, and the reply and their answer stand.
pure func replyAt(c: CrewState, seed: int, rng: Rng, i: int, cmd: CrewCmd, starts: [OfferStart]) -> OneApplied = {
  let rid = match decode(cmd.line) { Ok(j) => match getString(j, "id") { Some(x) => x, None => "" }, Err(_) => "" };
  let s = crewCommand(c, seed, rng, cmd.line, Some(concat(["reconsider-", rid])));
  match (s.refused, s.answered) {
    (None, l :: _) => if cmd.startMode == "on_accept" && l.label == "accept" then {
        let g = crewCommandAs(s.crew, seed, s.rng, startTaskLine(l.task), "");
        match g.refused {
          Some(e) => { st: s, starts: starts, startRefused: Some({ i: i, reason: concat(["crew:", e]) }) },
          None => { st: joined(s, g), starts: starts, startRefused: None }
        }
      } else { st: s, starts: starts, startRefused: None },
    _ => { st: s, starts: starts, startRefused: None }
  }
}

-- The tick's crew intents in order (each with its index in the tick's intent list). A refusal is
-- "crew:<crew_core error>" and changes nothing; "crew:no_crew" when no crew are aboard.
export pure func crewIntents(crew: Option[CrewState], seed: int, rng: Rng, cmds: [(int, CrewCmd)]) -> CrewApplied = crewIntentsS(crew, seed, rng, cmds, [])
pure func crewIntentsS(crew: Option[CrewState], seed: int, rng: Rng, cmds: [(int, CrewCmd)], starts: [OfferStart]) -> CrewApplied =
  match cmds {
    [] => { crew: crew, rng: rng, refused: [], answered: [] },
    (i, cmd) :: rest => match crew {
      None => { let r = crewIntentsS(crew, seed, rng, rest, starts); { r | refused: { i: i, reason: "crew:no_crew" } :: r.refused } },
      Some(c) => {
        let a = applyCmd(c, seed, rng, i, cmd, starts);
        let s = a.st;
        match s.refused {
          Some(e) => { let r = crewIntentsS(crew, seed, rng, rest, a.starts); { r | refused: { i: i, reason: concat(["crew:", e]) } :: r.refused } },
          None => {
            let r = crewIntentsS(Some(s.crew), seed, s.rng, rest, a.starts);
            { r | answered: s.answered ++ r.answered, refused: match a.startRefused { Some(x) => x :: r.refused, None => r.refused } }
          }
        }
      }
    }
  }

-- V1 (crew-parity console_v2, strict consoleScripted): a tick's console intents on a traced crew,
-- with every line fed and its journal record; the first refusal names its intent.
pure func withAnswered(s: CrewStepped, a: [CrewLine]) -> CrewStepped = { s | answered: a }
export pure func consoleCmds(c: CrewState, seed: int, rng: Rng, cmds: [CrewCmd]) -> CrewStepped = consoleCmdsS(c, seed, rng, cmds, 0, [], [], [], [])
pure func consoleCmdsS(c: CrewState, seed: int, rng: Rng, cmds: [CrewCmd], i: int, starts: [OfferStart], lines: [string], traces: [string], answered: [CrewLine]) -> CrewStepped =
  match cmds {
    [] => withAnswered(stepped(c, rng, lines, traces, None), answered),
    cmd :: rest => {
      let a = applyCmd(c, seed, rng, i, cmd, starts);
      match (a.st.refused, a.startRefused) {
        (Some(e), _) => withAnswered(stepped(c, rng, lines, traces, Some(concat(["intent ", intToStr(i), ": ", e]))), answered),
        (None, Some(x)) => withAnswered(stepped(a.st.crew, a.st.rng, lines ++ a.st.lines, traces ++ a.st.traces, Some(concat(["start ", intToStr(x.i), ": ", x.reason]))), answered ++ a.st.answered),
        (None, None) => consoleCmdsS(a.st.crew, seed, a.st.rng, rest, i + 1, a.starts, lines ++ a.st.lines, traces ++ a.st.traces, answered ++ a.st.answered)
      }
    }
  }

-- The world's crew on a sim tick: nothing when no crew are aboard (the default until C4).
export type CrewTicked = { crew: Option[CrewState], rng: Rng }
export pure func crewTick(crew: Option[CrewState], seed: int, rng: Rng, dtau: float) -> CrewTicked =
  match crew {
    None => { crew: None, rng: rng },
    Some(c) => { let r = crewStep(c, seed, rng, dtau); { crew: Some(r.crew), rng: r.rng } }
  }
