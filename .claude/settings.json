{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-broad-find.sh",
            "timeout": 10,
            "statusMessage": "Checking for unbounded filesystem walks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/brain-commit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/dev/sunholo-data/ailang/scripts/hooks/brain_on_prompt.sh\"; [ -x \"$f\" ] && exec \"$f\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
